<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Portable tests only: anything needing WPD/MTP lives in
         Kkindle.Tests.Windows. Keeping this at plain net10.0 means the bulk of
         the suite can run on Linux and macOS once those platforms are wired. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kkindle.Core\Kkindle.Core.csproj" />
    <ProjectReference Include="..\..\src\Kkindle.Infrastructure\Kkindle.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Kkindle.Layout\Kkindle.Layout.csproj" />
    <Compile Include="..\..\src\Kkindle.App\ReaderPlatformLayoutPolicy.cs" Link="ReaderPlatformLayoutPolicy.cs" />
    <Compile Include="..\..\src\Kkindle.App\ReaderLinuxTextFallbackTitleLinePolicy.cs" Link="ReaderLinuxTextFallbackTitleLinePolicy.cs" />
    <Compile Include="..\..\src\Kkindle.App\ReaderLinuxTextFallbackPagingPolicy.cs" Link="ReaderLinuxTextFallbackPagingPolicy.cs" />
    <Compile Include="..\..\src\Kkindle.App\ReaderLinuxVerticalPagingPolicy.cs" Link="ReaderLinuxVerticalPagingPolicy.cs" />
    <Compile Include="..\..\src\Kkindle.App\ReaderLinuxVerticalTextUnits.cs" Link="ReaderLinuxVerticalTextUnits.cs" />
    <Compile Include="..\..\src\Kkindle.App\LibraryDropImportPolicy.cs" Link="LibraryDropImportPolicy.cs" />
    <Compile Include="..\..\src\Kkindle.App\ReadingMaterialCoverMatcher.cs" Link="ReadingMaterialCoverMatcher.cs" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
