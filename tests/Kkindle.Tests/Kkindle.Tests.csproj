    <Compile Include="../Fixtures/MembershipHttpHandler.cs" Link="Fixtures/MembershipHttpHandler.cs" />
    <Compile Include="../Fixtures/FakePdfDocument.cs" Link="Fixtures/FakePdfDocument.cs" />
    <None Include="../Fixtures/Azw3/*" Link="Fixtures/Azw3/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\Kkindle.Core\Kkindle.Core.csproj" />
    <ProjectReference Include="..\..\src\Kkindle.Application\Kkindle.Application.csproj" />
    <ProjectReference Include="..\..\src\Kkindle.Infrastructure\Kkindle.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Kkindle.Layout\Kkindle.Layout.csproj" />
    <Compile Include="..\..\src\Kkindle.Reader\ReaderPlatformLayoutPolicy.cs" Link="ReaderPlatformLayoutPolicy.cs" />
    <Compile Include="..\..\src\Kkindle.App\ReaderTocScrollPolicy.cs" Link="ReaderTocScrollPolicy.cs" />
