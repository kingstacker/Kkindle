<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Shared reading surfaces (EPUB self-drawn typography and PDFium raster)
         used by the desktop window and the mobile shell. Plain net10.0: the
         controls must stay framework-neutral in the same way Kkindle.App is,
         so no head-specific API can leak into a platform without it. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keeps the historical Kkindle namespace so existing XAML (xmlns:local)
         and MainWindow code continue to resolve the controls unchanged. -->
    <RootNamespace>Kkindle</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reader chrome helpers (appearance resources, scroll-bar auto-hide,
         annotation tracing) are shared with the desktop shell's MainWindow and
         with the headless tests; they are implementation details, not part of
         the control API a second shell should build on. -->
    <InternalsVisibleTo Include="Kkindle.App" />
    <InternalsVisibleTo Include="Kkindle.App.Tests" />
    <ProjectReference Include="..\Kkindle.Core\Kkindle.Core.csproj" />
    <ProjectReference Include="..\Kkindle.Application\Kkindle.Application.csproj" />
    <ProjectReference Include="..\Kkindle.Infrastructure\Kkindle.Infrastructure.csproj" />
    <ProjectReference Include="..\Kkindle.Layout\Kkindle.Layout.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
</Project>
