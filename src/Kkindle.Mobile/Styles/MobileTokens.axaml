<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Quiet, neutral tokens. Hierarchy comes from spacing, type and soft gray;
       no surface is ever filled with solid black or white for emphasis. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SunkBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="SunkStrongBrush" Color="#E6E6E6" />
      <SolidColorBrush x:Key="SegmentOnBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1C1C" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E5E5E" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#767676" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="#9A9A9A" />
      <SolidColorBrush x:Key="DividerBrush" Color="#EFEFEF" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#59000000" />
      <BoxShadows x:Key="CoverShadow">0 2 10 0 #1F000000</BoxShadows>
      <BoxShadows x:Key="CardShadow">0 4 20 0 #1A000000</BoxShadows>
      <BoxShadows x:Key="SegmentShadow">0 1 3 0 #1F000000</BoxShadows>
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#E6E6E6" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#E6E6E6" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#E6E6E6" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="#121212" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="SunkBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="SunkStrongBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="SegmentOnBrush" Color="#404040" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDED" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#8C8C8C" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="#6E6E6E" />
      <SolidColorBrush x:Key="DividerBrush" Color="#262626" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#80000000" />
      <BoxShadows x:Key="CoverShadow">0 0 0 0 #00000000</BoxShadows>
      <BoxShadows x:Key="CardShadow">0 4 20 0 #66000000</BoxShadows>
      <BoxShadows x:Key="SegmentShadow">0 0 0 0 #00000000</BoxShadows>
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#121212" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#121212" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#121212" />
      <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#333333" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#8C8C8C" />
      <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#333333" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#8C8C8C" />
      <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#333333" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#8C8C8C" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
