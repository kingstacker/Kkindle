<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Kkindle.Mobile.Controls">
  <Styles.Resources>
    <CornerRadius x:Key="ControlRadius">12</CornerRadius>
    <CornerRadius x:Key="CoverRadius">6</CornerRadius>
  </Styles.Resources>

  <!-- The root paints before the first page lays out; it must not flash gray. -->
  <Style Selector="TopLevel">
    <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
  </Style>

  <!-- Foreground is inherited from the page so the reader's theme scope picks up
       the right ink without per-element colors. -->
  <Style Selector="UserControl, ContentControl.themed">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Match the bundled desktop application font. -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="avares://Kkindle.Mobile/Assets/Fonts#KingHwaOldSong" />
  </Style>
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="avares://Kkindle.Mobile/Assets/Fonts#KingHwaOldSong" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="avares://Kkindle.Mobile/Assets/Fonts#KingHwaOldSong" />
  </Style>

  <!-- Type scale. -->
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- The main action is a soft tint, never a solid slab. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource SunkBrush}" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkStrongBrush}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.tab">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tab:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.tab.active">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tab.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0,13" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- Filters: quiet text; the selected one sits on a small soft pill. -->
  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.chip.on">
    <Setter Property="Background" Value="{DynamicResource SunkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.chip.on:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Segmented control: a tinted track with a lightly raised selection. -->
  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{DynamicResource SunkBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.seg">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.seg:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.seg.on">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.seg.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegmentOnBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource SegmentShadow}" />
  </Style>
  <Style Selector="Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.seg.on:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegmentOnBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.row">
    <Setter Property="Padding" Value="0,13" />
  </Style>
  <Style Selector="Border.cover">
    <Setter Property="Background" Value="{DynamicResource SunkBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource CoverRadius}" />
    <Setter Property="BoxShadow" Value="{DynamicResource CoverShadow}" />
  </Style>
  <Style Selector="Border.coverclip">
    <Setter Property="CornerRadius" Value="{StaticResource CoverRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.floating">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
  </Style>

  <Style Selector="c|ThinProgress">
    <Setter Property="Height" Value="2" />
    <Setter Property="TrackBrush" Value="{DynamicResource SunkStrongBrush}" />
  </Style>

  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="MinWidth" Value="14" />
    <Setter Property="MinHeight" Value="14" />
  </Style>

  <!-- Scrollable on touch, with no bar painted over the content. -->
  <Style Selector="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="{DynamicResource SunkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement, TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SunkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
