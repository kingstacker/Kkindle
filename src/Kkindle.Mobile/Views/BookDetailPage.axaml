<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Kkindle.Mobile.Controls"
             xmlns:vm="using:Kkindle.Mobile.Views"
             x:Class="Kkindle.Mobile.Views.BookDetailPage"
             Background="{DynamicResource PageBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,6,8,0">
      <Button Grid.Column="0" Classes="icon" Name="BackButton" Click="OnBackClick">
        <c:LineIcon Data="{StaticResource IconBack}" StrokeThickness="1.4" />
      </Button>
      <Button Grid.Column="2" Classes="icon" Name="FavoriteButton" Click="OnFavoriteClick">
        <c:LineIcon Name="FavoriteIcon" Data="{StaticResource IconStar}" StrokeThickness="1.4" />
      </Button>
      <Button Grid.Column="3" Classes="icon" Name="MoreButton">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="编辑书籍信息" Click="OnEditClick" />
            <MenuItem Header="发送到 Kindle" Click="OnSendToKindleClick" />
            <MenuItem Header="加入收藏夹" Click="OnAddToShelfClick" />
            <MenuItem Header="重命名" Click="OnRenameClick" />
            <MenuItem Header="删除" Click="OnDeleteClick" />
          </MenuFlyout>
        </Button.Flyout>
        <c:LineIcon Data="{StaticResource IconMore}" StrokeThickness="2.2" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="28,12,28,24">
        <Border Classes="cover" Width="148" Height="214" HorizontalAlignment="Center">
          <Border Classes="coverclip">
            <Panel>
              <Image Name="CoverImage" Stretch="UniformToFill" />
              <TextBlock Name="CoverInitial" FontSize="40" Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Border>
        </Border>

        <TextBlock Name="TitleText" FontSize="21" FontWeight="Medium" TextWrapping="Wrap"
                   TextAlignment="Center" MaxLines="3" TextTrimming="CharacterEllipsis"
                   LineHeight="29" Margin="0,28,0,0" />
        <TextBlock Name="AuthorText" Classes="secondary" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,6,0,0" />
        <TextBlock Name="MetaText" Classes="muted" FontSize="12.5" TextAlignment="Center"
                   Margin="0,8,0,0" />

        <StackPanel Name="DescriptionPanel" Spacing="8" Margin="0,32,0,0">
          <TextBlock Name="DescriptionText" Classes="secondary" TextWrapping="Wrap" LineHeight="24"
                     MaxLines="5" TextTrimming="CharacterEllipsis" />
          <Button Name="ExpandButton" Classes="ghost" Content="展开全部" Click="OnExpandClick" />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" Margin="0,24,0,4">
          <TextBlock Classes="label" Text="书籍信息" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Content="编辑" Click="OnEditClick" />
        </Grid>
        <ItemsControl Name="FactsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BookFact">
              <Grid ColumnDefinitions="88,*" Margin="0,7">
                <TextBlock Text="{Binding Label}" Classes="muted" FontSize="14"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="secondary"
                           TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="28,8,28,14">
      <Button Classes="primary" Name="StartReadButton" Content="开始阅读" Click="OnStartReadClick" />
    </Border>
  </Grid>
</UserControl>
