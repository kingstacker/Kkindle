<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kkindle.Mobile.Views.Sheets.DoubanApplySheet">
  <StackPanel Margin="20,0,20,20" Spacing="4">
    <TextBlock Name="SummaryText" Classes="muted" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,8" />
    <CheckBox Name="TitleCheck" />
    <CheckBox Name="AuthorsCheck" />
    <CheckBox Name="SeriesCheck" />
    <CheckBox Name="PublicationCheck" Content="出版社、出版日期、ISBN、页数、装帧" IsChecked="True" />
    <CheckBox Name="DescriptionCheck" Content="简介" IsChecked="True" />
    <CheckBox Name="CoverCheck" Content="封面" IsChecked="True" />
    <Button Classes="primary" Content="填入表单" Margin="0,12,0,0" Click="OnApplyClick" />
  </StackPanel>
</UserControl>
