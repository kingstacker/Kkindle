<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kkindle.Mobile.Views.Sheets.PromptSheet">
  <StackPanel Margin="20,4,20,20" Spacing="14">
    <TextBlock Name="MessageText" Classes="secondary" TextWrapping="Wrap" LineHeight="22" />
    <TextBox Name="InputBox" Classes="field" IsVisible="False" />
    <Button Name="ConfirmButton" Classes="primary" Click="OnConfirmClick" />
  </StackPanel>
</UserControl>
