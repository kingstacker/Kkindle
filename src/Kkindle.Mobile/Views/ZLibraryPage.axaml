<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Kkindle.Mobile.Controls"
             xmlns:vm="using:Kkindle.Mobile.Views"
             x:Class="Kkindle.Mobile.Views.ZLibraryPage"
             Background="{DynamicResource PageBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,6,10,0">
      <Button Classes="icon" Click="OnBackClick">
        <c:LineIcon Data="{StaticResource IconBack}" StrokeThickness="1.4" />
      </Button>
      <TextBlock Grid.Column="1" Classes="title" Text="Z-Library" VerticalAlignment="Center" Margin="2,0,0,0" />
      <Button Grid.Column="2" Classes="ghost" Content="账号" Padding="8,6" Click="OnAccountClick" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="20,6,10,4">
      <TextBox Name="QueryBox" Classes="field" PlaceholderText="书名、作者或 ISBN" KeyDown="OnQueryKeyDown" />
      <Button Grid.Column="1" Classes="icon" Click="OnSearchClick">
        <c:LineIcon Data="{StaticResource IconSearch}" StrokeThickness="1.4" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="2" Name="ResultsScroller">
      <StackPanel Margin="20,4,20,28">
        <c:NativeSegmentGroup Margin="-12,0,0,6">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Name="FormatAll" Classes="chip on" Content="全部" Click="OnFormatClick" />
            <Button Name="FormatEpub" Classes="chip" Content="EPUB" Click="OnFormatClick" />
            <Button Name="FormatPdf" Classes="chip" Content="PDF" Click="OnFormatClick" />
            <Button Name="FormatMobi" Classes="chip" Content="MOBI" Click="OnFormatClick" />
            <Button Name="FormatAzw3" Classes="chip" Content="AZW3" Click="OnFormatClick" />
          </StackPanel>
        </c:NativeSegmentGroup>
        <TextBlock Name="StatusText" Classes="muted" IsVisible="False" TextWrapping="Wrap" Margin="0,6,0,6" />

        <ItemsControl Name="ResultsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ZLibraryRow">
              <Button Classes="row" Padding="0,10" Click="OnRowClick">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="cover" Width="52" Height="74">
                    <Border Classes="coverclip">
                      <Panel>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        <TextBlock Text="{Binding Initial}" IsVisible="{Binding !HasCover}" FontSize="18"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                    </Border>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Book.Title}" FontSize="15" MaxLines="2" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" LineHeight="20" />
                    <TextBlock Text="{Binding Book.Author}" Classes="secondary" FontSize="13" MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Info}" Classes="muted" FontSize="12" MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding State}" IsVisible="{Binding HasState}" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Name="MoreButton" Classes="secondary" Content="加载更多" IsVisible="False" Margin="0,12,0,0"
                Click="OnMoreClick" />

        <StackPanel Name="EmptyState" Spacing="6" Margin="0,80,0,0">
          <c:LineIcon Data="{StaticResource IconSearch}" Size="34" StrokeThickness="1.1"
                      HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Classes="muted" Text="搜索后点开一本书即可下载到书库" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
