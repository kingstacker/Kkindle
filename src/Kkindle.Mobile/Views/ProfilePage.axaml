<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Kkindle.Mobile.Controls"
             x:Class="Kkindle.Mobile.Views.ProfilePage"
             Background="{DynamicResource PageBackgroundBrush}">
  <ScrollViewer>
    <StackPanel Margin="24,20,24,32">
      <TextBlock Classes="display" Text="我的" />

      <Button Classes="row" Margin="0,16,0,0" Click="OnSyncClick">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="云同步" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="SyncSummaryText" Classes="muted" FontSize="14"
                     VerticalAlignment="Center" />
          <c:LineIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Size="16" StrokeThickness="1.4"
                      Margin="6,0,0,0" VerticalAlignment="Center"
                      Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
      </Button>

      <Button Classes="row" Click="OnAiClick">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="AI 助手" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="AiSummaryText" Classes="muted" FontSize="14"
                     VerticalAlignment="Center" />
          <c:LineIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Size="16" StrokeThickness="1.4"
                      Margin="6,0,0,0" VerticalAlignment="Center"
                      Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
      </Button>
      <Button Classes="row" Click="OnKindleClick">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="发送到 Kindle" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="KindleSummaryText" Classes="muted" FontSize="14"
                     VerticalAlignment="Center" />
          <c:LineIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Size="16" StrokeThickness="1.4"
                      Margin="6,0,0,0" VerticalAlignment="Center"
                      Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
      </Button>

      <TextBlock Classes="label" Text="外观" Margin="0,28,0,10" />
      <c:NativeSegmentGroup>
        <Border Classes="segments">
          <Grid ColumnDefinitions="*,*,*">
            <Button Grid.Column="0" Name="ThemeSystem" Classes="seg" Content="跟随系统" Click="OnThemeClick" />
            <Button Grid.Column="1" Name="ThemeLight" Classes="seg" Content="浅色" Click="OnThemeClick" />
            <Button Grid.Column="2" Name="ThemeDark" Classes="seg" Content="深色" Click="OnThemeClick" />
          </Grid>
        </Border>
      </c:NativeSegmentGroup>


      <TextBlock Classes="label" Text="数据" Margin="0,32,0,4" />
      <Border Classes="row">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="书籍占用" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="StorageText" Classes="muted" FontSize="14"
                     VerticalAlignment="Center" Text="—" />
        </Grid>
      </Border>
      <Button Name="ExportBackupButton" Classes="row" Click="OnExportBackupClick">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="导出备份" VerticalAlignment="Center" />
          <c:LineIcon Grid.Column="1" Data="{StaticResource IconChevronRight}" Size="16" StrokeThickness="1.4"
                      VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
      </Button>
      <Button Name="RestoreBackupButton" Classes="row" Click="OnRestoreBackupClick">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="恢复备份" VerticalAlignment="Center" />
          <c:LineIcon Grid.Column="1" Data="{StaticResource IconChevronRight}" Size="16" StrokeThickness="1.4"
                      VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
      </Button>
      <Button Classes="row" Click="OnTrashClick">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="回收站" VerticalAlignment="Center" />
          <c:LineIcon Grid.Column="1" Data="{StaticResource IconChevronRight}" Size="16" StrokeThickness="1.4"
                      VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
      </Button>
      <TextBlock Name="BackupStatusText" Classes="muted" Margin="0,8,0,0"
                 TextWrapping="Wrap" IsVisible="False" />

      <TextBlock Classes="label" Text="关于" Margin="0,24,0,4" />
      <Button Classes="row" Click="OnDeveloperClick">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="开发者" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="kingstacker" Classes="muted" FontSize="14" VerticalAlignment="Center" />
          <c:LineIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Size="16" StrokeThickness="1.4"
                      Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
      </Button>
      <Button Classes="row" Click="OnGroupClick">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="QQ 交流群" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="1109898894" Classes="muted" FontSize="14" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <Button Classes="row" Click="OnVersionClick">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="版本" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="VersionText" Classes="muted" FontSize="14"
                     VerticalAlignment="Center" />
        </Grid>
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>
