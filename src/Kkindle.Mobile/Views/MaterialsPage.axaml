<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Kkindle.Mobile.Controls"
             xmlns:vm="using:Kkindle.Mobile.Views"
             x:Class="Kkindle.Mobile.Views.MaterialsPage"
             Background="{DynamicResource PageBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,10">
      <TextBlock Classes="display" Text="阅读资料" />
      <TextBlock Grid.Column="1" Name="SummaryText" Classes="muted" FontSize="12"
                 VerticalAlignment="Bottom" Margin="0,0,0,5" />
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Margin="12,0,12,8">
      <Button Name="FilterAll" Classes="chip on" Content="全部" Click="OnFilterClick" />
      <Button Name="FilterHighlights" Classes="chip" Content="划线" Click="OnFilterClick" />
      <Button Name="FilterNotes" Classes="chip" Content="笔记" Click="OnFilterClick" />
      <Button Name="FilterBookmarks" Classes="chip" Content="书签" Click="OnFilterClick" />
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <StackPanel Margin="24,4,24,28">
        <ItemsControl Name="MaterialsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MaterialBookGroup">
              <Border BorderBrush="{DynamicResource SunkStrongBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                  <Button Padding="0,14" CornerRadius="0" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" Click="OnBookClick">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="cover" Width="48" Height="68">
                        <Border Classes="coverclip">
                          <Panel>
                            <Image Source="{Binding Cover}" Stretch="Uniform" />
                            <TextBlock Text="{Binding TitleInitial}" IsVisible="{Binding !HasCover}"
                                       FontSize="18" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Panel>
                        </Border>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Medium"
                                   MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CountText}" Classes="muted" FontSize="12" />
                      </StackPanel>
                      <Panel Grid.Column="2" VerticalAlignment="Center">
                        <c:LineIcon Data="{StaticResource IconChevronRight}" Size="18" StrokeThickness="1.4"
                                    IsVisible="{Binding !IsExpanded}" Foreground="{DynamicResource TextMutedBrush}" />
                        <c:LineIcon Data="{StaticResource IconChevronDown}" Size="18" StrokeThickness="1.4"
                                    IsVisible="{Binding IsExpanded}" Foreground="{DynamicResource TextMutedBrush}" />
                      </Panel>
                    </Grid>
                  </Button>
                  <ItemsControl ItemsSource="{Binding Entries}" IsVisible="{Binding IsExpanded}" Tapped="OnItemTapped"
                                Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MaterialEntry">
                        <Border Background="{DynamicResource SunkBrush}" CornerRadius="10"
                                Padding="12,11" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Panel Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                              <c:LineIcon Data="{StaticResource IconBookmark}" Size="17" StrokeThickness="1.3"
                                          IsVisible="{Binding IsBookmark}" Foreground="{DynamicResource TextMutedBrush}" />
                              <c:LineIcon Data="{StaticResource IconNotes}" Size="17" StrokeThickness="1.3"
                                          IsVisible="{Binding !IsBookmark}" Foreground="{DynamicResource TextMutedBrush}" />
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="5">
                              <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="12"
                                         MaxLines="1" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Quote}" FontSize="14" TextWrapping="Wrap" LineHeight="21" />
                              <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="secondary"
                                         FontSize="13" TextWrapping="Wrap" LineHeight="20" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Name="StatusText" Classes="muted" IsVisible="False" TextWrapping="Wrap" />

        <StackPanel Name="EmptyState" Spacing="6" IsVisible="False" Margin="0,96,0,0">
          <c:LineIcon Data="{StaticResource IconNotes}" Size="34" StrokeThickness="1.1"
                      HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Name="EmptyTitle" Classes="title" Text="还没有阅读资料"
                     HorizontalAlignment="Center" Margin="0,8,0,0" />
          <TextBlock Classes="muted" Text="书签、划线和笔记会汇集在这里"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
