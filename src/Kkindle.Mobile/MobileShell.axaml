<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Kkindle.Mobile.Controls"
             x:Class="Kkindle.Mobile.MobileShell"
             TopLevel.AutoSafeAreaPadding="True"
             Background="{DynamicResource PageBackgroundBrush}">
  <UserControl.Styles>
    <Style Selector="UserControl.page-enter">
      <Style.Animations>
        <Animation Duration="0:0:0.20" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(8px)" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border#SheetScrim">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#SheetScrim.open">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ContentControl#SheetPanel">
      <Setter Property="RenderTransform" Value="translateY(640px)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ContentControl#SheetPanel.open">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <!-- iPhone-only backdrop for the Liquid Glass theme. Hidden elsewhere, so
         Android keeps its flat white/dark pages. -->
    <Grid Grid.RowSpan="2" Name="GlassBackdrop"
          IsHitTestVisible="False" ClipToBounds="True">
      <Rectangle Fill="{DynamicResource GlassBackdropBrush}" />
      <Ellipse Name="GlassBlobBlue" Width="380" Height="380" Fill="{DynamicResource GlassBlobBlueBrush}"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-140,-160,0,0"
               RenderTransformOrigin="50%,50%">
        <Ellipse.Effect>
          <BlurEffect Radius="90" />
        </Ellipse.Effect>
      </Ellipse>
      <Ellipse Name="GlassBlobPink" Width="320" Height="320" Fill="{DynamicResource GlassBlobPinkBrush}"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,120"
               RenderTransformOrigin="50%,50%">
        <Ellipse.Effect>
          <BlurEffect Radius="90" />
        </Ellipse.Effect>
      </Ellipse>
      <Ellipse Name="GlassBlobMint" Width="260" Height="260" Fill="{DynamicResource GlassBlobMintBrush}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderTransformOrigin="50%,50%">
        <Ellipse.Effect>
          <BlurEffect Radius="80" />
        </Ellipse.Effect>
      </Ellipse>
    </Grid>

    <ContentControl Grid.Row="0" Name="PageHost" />

    <Border Grid.Row="1" Name="TabBarGlass" Classes="glassbar" ClipToBounds="True">
      <Panel>
        <Grid Name="TabBar" ColumnDefinitions="*,*,*,*" Margin="0,2,0,2">
          <Button Grid.Column="0" Name="LibraryTab" Classes="tab" Click="OnLibraryTabClick">
            <StackPanel Spacing="3">
              <c:LineIcon Data="{StaticResource IconBook}" Size="23" StrokeThickness="1.4"
                          HorizontalAlignment="Center" />
              <TextBlock Text="书库" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Name="MaterialsTab" Classes="tab" Click="OnMaterialsTabClick">
            <StackPanel Spacing="3">
              <c:LineIcon Data="{StaticResource IconNotes}" Size="23" StrokeThickness="1.4"
                          HorizontalAlignment="Center" />
              <TextBlock Text="阅读资料" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Name="ReadingDataTab" Classes="tab" Click="OnReadingDataTabClick">
            <StackPanel Spacing="3">
              <c:LineIcon Data="{StaticResource IconChart}" Size="23" StrokeThickness="1.4"
                          HorizontalAlignment="Center" />
              <TextBlock Text="阅读数据" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Name="ProfileTab" Classes="tab" Click="OnProfileTabClick">
            <StackPanel Spacing="3">
              <c:LineIcon Data="{StaticResource IconPerson}" Size="23" StrokeThickness="1.4"
                          HorizontalAlignment="Center" />
              <TextBlock Text="我的" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Slow specular sweep across the capsule. -->
        <Rectangle Name="GlassSheen" Width="120" HorizontalAlignment="Left"
                   VerticalAlignment="Stretch" IsHitTestVisible="False"
                   RenderTransformOrigin="50%,50%">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="#00FFFFFF" />
              <GradientStop Offset="0.5" Color="#4DFFFFFF" />
              <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Panel>
    </Border>

    <!-- Bottom sheet. Its theme scope follows the page that opened it, so reader
         controls on black paper are not shown in the app's light theme. -->
    <ThemeVariantScope Grid.RowSpan="2" Name="SheetScope" IsVisible="False" ZIndex="20">
      <Grid>
        <Border Name="SheetScrim" Background="{DynamicResource ScrimBrush}"
                PointerPressed="OnScrimPressed" />
        <ContentControl Name="SheetPanel" Classes="themed" VerticalAlignment="Bottom"
                        CornerRadius="20,20,0,0" Background="{DynamicResource SurfaceBrush}">
          <Grid RowDefinitions="Auto,Auto,*">
            <Border Width="36" Height="4" CornerRadius="2" Margin="0,8,0,0"
                    Background="{DynamicResource SunkStrongBrush}" HorizontalAlignment="Center" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="20,6,10,0">
              <TextBlock Name="SheetTitle" Classes="title" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="icon" Click="OnCloseSheetClick">
                <c:LineIcon Data="{StaticResource IconClose}" Size="18" StrokeThickness="1.4" />
              </Button>
            </Grid>
            <ContentControl Grid.Row="2" Name="SheetBody" />
          </Grid>
        </ContentControl>
      </Grid>
    </ThemeVariantScope>

    <Border Grid.RowSpan="2" Name="Toast" Classes="floating" IsVisible="False" IsHitTestVisible="False"
            ZIndex="30" Padding="16,10" Margin="24,0,24,160"
            VerticalAlignment="Bottom" HorizontalAlignment="Center">
      <TextBlock Name="ToastText" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
