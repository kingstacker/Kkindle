<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mobile shell views. Deliberately plain net10.0: the Android head wires
         platform services, and keeping this project platform-neutral makes the
         compiler reject Android-only API usage from creeping into view code. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kkindle.Mobile</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kkindle.App\ReaderTransitionPlayer.cs" Link="ReaderTransitionPlayer.cs" />
    <AvaloniaResource Include="..\Kkindle.App\Assets\Fonts\KingHwaOldSong-v3.0.ttf" Link="Assets\Fonts\KingHwaOldSong-v3.0.ttf" />
    <AvaloniaResource Include="..\Kkindle.App\Assets\Images\SupportWechatQr.png" Link="Assets\Images\SupportWechatQr.png" />
    <ProjectReference Include="..\Kkindle.Core\Kkindle.Core.csproj" />
    <ProjectReference Include="..\Kkindle.Application\Kkindle.Application.csproj" />
    <ProjectReference Include="..\Kkindle.Infrastructure\Kkindle.Infrastructure.csproj" />
    <ProjectReference Include="..\Kkindle.Layout\Kkindle.Layout.csproj" />
    <ProjectReference Include="..\Kkindle.Reader\Kkindle.Reader.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
