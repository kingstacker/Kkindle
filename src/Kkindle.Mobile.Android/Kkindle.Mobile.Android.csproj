<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Android head: owns MainActivity and the platform adapters, contains no
         UI. Everything shared lives in Kkindle.Mobile / ApplicationModules. -->
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Kkindle.AndroidHead</RootNamespace>
    <AssemblyName>Kkindle.Mobile.Android</AssemblyName>
    <ApplicationId>com.kingstacker.kkindle</ApplicationId>
    <ApplicationTitle>Kkindle</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.3</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Make Debug APKs installable without an IDE fast-deployment session. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Emulator + typical phones. Add android-arm only if a 32-bit device matters. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!-- Android's own HTTP stack rejects WebDAV methods such as PROPFIND, so
         HttpClient uses the managed handler. Certificates are still checked
         against the system trust store. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Ahead-of-time compile everything: interpreting the app's assemblies makes
         cold start several times slower on a phone. -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Android packs license texts as readable APK assets; ordinary desktop
         CopyToPublishDirectory items alone do not guarantee APK inclusion. -->
    <AndroidAsset Include="../../LICENSE" Link="LICENSE" LogicalName="LICENSE" />
    <AndroidAsset Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
    <AndroidAsset Include="../Kkindle.Infrastructure/ThirdParty/Notices/**/*"
                  Link="ThirdParty/Notices/%(RecursiveDir)%(Filename)%(Extension)"
                  LogicalName="ThirdParty/Notices/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../Kkindle.Infrastructure/ThirdParty/MdxParser/*.md;../Kkindle.Infrastructure/ThirdParty/MdxParser/*.txt;../Kkindle.Infrastructure/ThirdParty/MdxParser/*.html"
                  Link="ThirdParty/MdxParser/%(Filename)%(Extension)"
                  LogicalName="ThirdParty/MdxParser/%(Filename)%(Extension)" />
    <AndroidAsset Include="../Kkindle.Infrastructure/ThirdParty/KindleUnpack/*"
                  Link="ThirdParty/KindleUnpack/%(Filename)%(Extension)"
                  LogicalName="ThirdParty/KindleUnpack/%(Filename)%(Extension)" />
    <AndroidAsset Include="../Kkindle.Infrastructure/ThirdParty/PDFium/**/*"
                  Link="ThirdParty/PDFium/%(RecursiveDir)%(Filename)%(Extension)"
                  LogicalName="ThirdParty/PDFium/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../Kkindle.Infrastructure/ThirdParty/G2PW/LICENSE.txt;../Kkindle.Infrastructure/ThirdParty/G2PW/NOTICE.md"
                  Link="ThirdParty/G2PW/%(Filename)%(Extension)"
                  LogicalName="ThirdParty/G2PW/%(Filename)%(Extension)" />
    <AndroidAsset Include="../Kkindle.App/Assets/Fonts/*-LICENSE.txt"
                  Link="Assets/Assets/Fonts/%(Filename)%(Extension)"
                  LogicalName="Assets/Assets/Fonts/%(Filename)%(Extension)" />
    <!-- Android removes the first Assets prefix. The second preserves the
         shared Assets/Fonts and Assets/Icons paths referenced by our notices. -->
    <AndroidAsset Include="../Kkindle.App/Assets/Icons/Lucide-LICENSE.txt"
                  Link="Assets/Assets/Icons/Lucide-LICENSE.txt"
                  LogicalName="Assets/Assets/Icons/Lucide-LICENSE.txt" />
    <ProjectReference Include="..\Kkindle.Mobile\Kkindle.Mobile.csproj" />
    <PackageReference Include="Avalonia.Android" Version="12.1.1" />
    <!-- Local embeddings back the desktop AI features, which the phone app does
         not expose; the native runtime alone is about 70 MB. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" ExcludeAssets="native;build;buildTransitive" />
    <!-- PDFium for the native PDF surface; the desktop heads get their own
         platform binaries through Kkindle.Infrastructure. -->
    <PackageReference Include="bblanchon.PDFium.Android" Version="152.0.7961" />
  </ItemGroup>
</Project>
