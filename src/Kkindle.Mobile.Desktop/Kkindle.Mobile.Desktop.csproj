<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Development harness only: runs the mobile shell in a phone-sized window
         on desktop so layout and navigation can be iterated without an
         emulator. Not shipped. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kkindle.Mobile.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kkindle.Mobile\Kkindle.Mobile.csproj" />
    <ProjectReference Include="..\Kkindle.Platform.Common\Kkindle.Platform.Common.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>
</Project>
