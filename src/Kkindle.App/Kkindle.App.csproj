<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Deliberately plain net10.0, never net10.0-windows: this project holds all
         UI code, and keeping it platform-neutral makes the compiler reject any
         Windows-only API that creeps in. Platform services arrive through the
         Kkindle.Core interfaces, wired by a per-platform head project
         (Kkindle.Desktop.Windows today). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kkindle</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kkindle.Core\Kkindle.Core.csproj" />
    <ProjectReference Include="..\Kkindle.Infrastructure\Kkindle.Infrastructure.csproj" />
    <ProjectReference Include="..\Kkindle.Layout\Kkindle.Layout.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*" />
    <AvaloniaResource Include="Assets\Icons\*" />
    <!-- The reader CSS injects @font-face with a file:// URL so WebView2 can
         use the bundled font, mirroring the WinUI reference's
         ApplyReaderAppearanceAsync; copy it to the output for that reason. -->
    <Content Include="Assets\Fonts\KingHwaOldSong-v3.0.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\KingHwaOldSong-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
