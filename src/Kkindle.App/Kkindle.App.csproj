<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Deliberately plain net10.0, never net10.0-windows: this project holds all
         UI code, and keeping it platform-neutral makes the compiler reject any
         Windows-only API that creeps in. Platform services arrive through the
         Kkindle.Core interfaces, wired by a per-platform head project
         (Kkindle.Desktop.Windows today). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kkindle</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- BundledAppFontCollection uses the pinned 12.1.1 font factory to avoid
         its native stream lifetime crash. Recheck FontLifetimeTests before
         updating Avalonia, then remove this opt-in when upstream fixes it. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <!-- AVA3001 is emitted unconditionally by AvaloniaPrivateApis.targets for
         this intentional opt-in. The private font factory is required by the
         workaround above, so keep the warning out of the build rather than
         removing the crash protection. -->
    <NoWarn>$(NoWarn);AVA3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Disabled #if regions still recognize Markdown headings in raw strings
         as preprocessor directives. Exclude the offline Debug fixture entirely. -->
    <Compile Remove="MainWindow.ReaderAiPreview.cs" Condition="'$(Configuration)' != 'Debug'" />
    <InternalsVisibleTo Include="Kkindle.App.Tests" />
    <ProjectReference Include="..\Kkindle.Core\Kkindle.Core.csproj" />
    <ProjectReference Include="..\Kkindle.Application\Kkindle.Application.csproj" />
    <ProjectReference Include="..\Kkindle.Reader\Kkindle.Reader.csproj" />
    <ProjectReference Include="..\Kkindle.Infrastructure\Kkindle.Infrastructure.csproj" />
    <ProjectReference Include="..\Kkindle.Layout\Kkindle.Layout.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Sylinko.CSharpMath.Avalonia" Version="12.0.0" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <!-- Sandboxed interpreter for headless plugin scripts (dictionary and
         translator providers, background tasks). No CLR access is granted. -->
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*" />
    <AvaloniaResource Include="Assets\Icons\*" />
    <AvaloniaResource Include="Assets\Images\*" />
    <!-- The reader CSS injects @font-face with a file:// URL so WebView2 can
         use the bundled font, mirroring the WinUI reference's
         ApplyReaderAppearanceAsync; copy it to the output for that reason. -->
    <Content Include="Assets\Fonts\KingHwaOldSong-v3.0.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\KingHwaOldSong-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Glyph fallbacks for symbols and emoji that the reading face does not
         cover. The reader loads them by path when a .notdef is encountered. -->
    <Content Include="Assets\Fonts\NotoEmoji.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\NotoEmoji-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\NotoSansSymbols2-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\NotoSansSymbols2-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\Lucide-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Plugins that ship with the desktop app. They land in bundled-plugins/
       next to the executable and PluginManager.InstallBundled copies them
       into the user's plugin folder on first launch (and on version bumps). -->
  <ItemGroup>
    <Content Include="..\..\plugins\book-translation\**\*"
             Exclude="..\..\plugins\book-translation\**\.DS_Store;..\..\plugins\book-translation\**\*.kkplugin"
             Link="bundled-plugins\book-translation\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
