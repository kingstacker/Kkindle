<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kkindle.App"
             RequestedThemeVariant="Light">
    <!-- Kkindle is a paper-white reading tool: the palette is fixed light, not
         system-following. Dark mode is not a supported variant (AI_HANDOFF #13). -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kkindle.App/ScrollBarTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- The whole product is black, white and grey with square corners.
             Every value here is quoted from the WinUI App.xaml so the port can
             be compared against docs/images/ pixel by pixel. -->
        <Color x:Key="PaperColor">#FFFFFF</Color>
        <Color x:Key="InkColor">#000000</Color>
        <Color x:Key="PressedColor">#D9D9D9</Color>
        <Color x:Key="HairlineColor">#E2E2E2</Color>
        <Color x:Key="MutedInkColor">#5A5A5A</Color>
        <Color x:Key="SidebarIndicatorColor">#BFBFBF</Color>
        <Color x:Key="SoftHoverColor">#F2F2F2</Color>

        <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
        <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="{StaticResource MutedInkColor}" />
        <SolidColorBrush x:Key="SidebarIndicatorBrush" Color="{StaticResource SidebarIndicatorColor}" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource SidebarIndicatorColor}" />
        <SolidColorBrush x:Key="SoftHoverBrush" Color="{StaticResource SoftHoverColor}" />

        <!-- The font is bundled with the portable app. The suffix is the
             internal family name, not the filename. -->
        <FontFamily x:Key="DefaultAppFontFamily">avares://Kkindle.App/Assets/Fonts/KingHwaOldSong-v3.0.ttf#KingHwaOldSong</FontFamily>

        <!-- The migrated reader buttons use the same deliberately plain
             template as the WinUI reference instead of Fluent's extra button
             chrome. State colours remain supplied by the selector styles below. -->
        <ControlTemplate x:Key="ReaderToolbarButtonTemplate" TargetType="Button">
            <Border Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </ControlTemplate>

        <!-- Search result rows keep the WinUI OutlinedListItem behaviour:
             hovering darkens the outline to black while the fill stays
             paper white (the bound border brush is a local value, so the
             hover ink line is drawn as a template overlay instead). -->
        <ControlTemplate x:Key="ReaderSearchResultButtonTemplate" TargetType="Button">
            <Grid Background="{TemplateBinding Background}">
                <Border Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
                <Border x:Name="HoverInkOutline"
                        BorderBrush="#000000"
                        BorderThickness="1"
                        IsHitTestVisible="False"
                        Opacity="0" />
            </Grid>
        </ControlTemplate>

        <!-- ScrollBarTheme.axaml intentionally uses private resource names so
             it does not depend on FluentTheme's internal palette. -->
        <x:Double x:Key="KkindleScrollBarSize">10</x:Double>
        <SolidColorBrush x:Key="KkindleScrollBarBackgroundBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarExpandedBackgroundBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarThumbBrush" Color="#C9C9C9" />
        <SolidColorBrush x:Key="KkindleScrollBarThumbPointerOverBrush" Color="#B4B4B4" />
        <SolidColorBrush x:Key="KkindleScrollBarThumbPressedBrush" Color="#A4A4A4" />
        <SolidColorBrush x:Key="KkindleScrollBarThumbDisabledBrush" Color="#777777" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonPointerOverBrush" Color="#000000" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonPressedBrush" Color="#000000" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonDisabledBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonPointerOverBorderBrush" Color="#000000" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonPressedBorderBrush" Color="#000000" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonDisabledBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarArrowBrush" Color="#000000" />
        <SolidColorBrush x:Key="KkindleScrollBarArrowPointerOverBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="KkindleScrollBarArrowPressedBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="KkindleScrollBarArrowDisabledBrush" Color="#8A8A8A" />

        <!-- Fluent draws the Slider's filled track and thumb with the accent
             colour; the reader footer progress slider must stay monochrome.
             Same resource-key override the WinUI reference used. The layout
             sliders in the reader typography popup override these with darker
             greys locally (MainWindow.axaml). -->
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#C7C7C3" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#B7B7B3" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#A7A7A3" />
        <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#DEDEDB" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#B4B4B0" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#A4A4A0" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#949490" />
        <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#C9C9C5" />
        <!-- Square thumb: the product's corner language has no exception for
             the slider grip. -->
        <CornerRadius x:Key="SliderThumbCornerRadius">0</CornerRadius>

        <!-- Fluent paints the focused TextBox border with the accent colour;
             the reader search box and AI input must stay black-on-white. -->
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource InkColor}" />

        <!-- Fluent's popup templates read these values through DynamicResource
             from inside their templates. Keep the entire popup layer in the
             same square black/white language as the WinUI reference: context
             menus, MenuFlyouts and ComboBox dropdowns all use these keys. -->
        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
        <Thickness x:Key="FlyoutBorderThemePadding">0</Thickness>
        <!-- Let nested menu popups size to their own labels. The old WinUI
             menu did not impose Fluent's default 96-unit flyout minimum. -->
        <x:Double x:Key="FlyoutThemeMinWidth">0</x:Double>

        <x:Double x:Key="MenuFlyoutSeparatorThemeHeight">0.5</x:Double>
        <x:Double x:Key="MenuFlyoutThemeMinHeight">0</x:Double>
        <!-- Fluent defaults this to -4 so a submenu overlaps its parent menu.
             The reader menus use square, adjacent panels: their borders must
             meet at the parent's right edge without covering one another. -->
        <x:Double x:Key="MenuFlyoutSubItemPopupHorizontalOffset">0</x:Double>
        <Thickness x:Key="MenuFlyoutPresenterThemePadding">0</Thickness>
        <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
        <!-- The Fluent menu template reads this key directly. Use the compact
             row height from the old WinUI menu; the alias below keeps the
             explicit MenuItem style in sync. -->
        <Thickness x:Key="MenuFlyoutItemThemePadding">8,4,8,7</Thickness>
        <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,4,8,7</Thickness>
        <Thickness x:Key="MenuFlyoutItemChevronMargin">8,0,0,0</Thickness>
        <Thickness x:Key="MenuInputGestureTextMargin">0</Thickness>
        <Thickness x:Key="MenuFlyoutSeparatorThemePadding">0</Thickness>
        <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource PressedColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="{StaticResource SoftHoverColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#8A8A8A" />
        <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPressed" Color="{StaticResource InkColor}" />
        <!-- Opening the submenu must not make the parent chevron disappear
             against its white row. Its position remains controlled by the
             unchanged MenuFlyoutItemChevronMargin resource above. -->
        <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MenuFlyoutSubItemChevronDisabled" Color="#8A8A8A" />
        <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#8A8A8A" />

        <x:Double x:Key="ComboBoxThemeMinWidth">64</x:Double>
        <Thickness x:Key="ComboBoxBorderThemeThickness">1</Thickness>
        <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
        <Thickness x:Key="ComboBoxDropdownBorderPadding">0</Thickness>
        <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
        <Thickness x:Key="ComboBoxItemThemePadding">7,4,7,5</Thickness>
        <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#8A8A8A" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedDisabled" Color="#8A8A8A" />
        <SolidColorBrush x:Key="ComboBoxItemBackground" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{StaticResource PressedColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="{StaticResource SoftHoverColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedDisabled" Color="{StaticResource SoftHoverColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBorderBrushPressed" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBorderBrushDisabled" Color="#BFBFBF" />
        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedDisabled" Color="#BFBFBF" />
        <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource SoftHoverColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#8A8A8A" />
        <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{StaticResource MutedInkColor}" />
        <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#BFBFBF" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#8A8A8A" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource InkColor}" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Tooltips use the same restrained square treatment as the other
             popup surfaces: paper-white body, one-pixel ink outline, no
             rounded corners and no platform shadow. -->
        <Style Selector="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="ToolTip /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- Avalonia's ScrollBar already owns the interaction state needed for
             automatic hiding. This keeps the behavior in the control theme,
             rather than duplicating WinUI's visual-tree registration logic. -->
        <Style Selector="ScrollBar">
            <Setter Property="Theme" Value="{StaticResource {x:Type ScrollBar}}" />
            <Setter Property="AllowAutoHide" Value="True" />
            <Setter Property="HideDelay" Value="0:0:0.9" />
            <Setter Property="ShowDelay" Value="0:0:0" />
        </Style>

        <!-- Base typography and the monochrome interaction language used by
             the future library/reader views. More specific view styles can
             override sizes and spacing without changing the palette. -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Button.readerSelectionAction">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
        <Style Selector="Button.readerSelectionAction:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.readerSelectionAction:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.readerFootnoteMarker">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
        <Style Selector="Button.readerFootnoteMarker:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.readerFootnoteMarker:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <!-- Fluent replaces the template border thickness on focus. Override
             that inner state as well so typing never draws a rectangle. -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <!-- Caption buttons invert to black-on-white on hover, which is the
             product's hover language everywhere. Note there is no red close
             button: the three-colour rule has no exception for it. -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.caption:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Button.caption:pressed">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>

        <!-- The WinUI reference uses a small set of named visual languages:
             quiet outlined actions, narrow sidebar navigation, and square
             icon buttons. Keeping these as classes makes the Avalonia XAML
             read like the reference instead of relying on Fluent defaults. -->
        <Style Selector="Button.quiet">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="Button.quiet:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Button.quiet:pressed">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>

        <!-- Destructive action: the detail-pane delete button uses the
             WinUI reference's red outline language (#B3261E). -->
        <!-- Book-library scrollbar auto-collapse: the thumb is invisible while
             idle, appears while scrolling (the .scrolling class is toggled from
             code with a short idle delay) and stays visible while the pointer
             rests on the bar itself (IsExpanded). -->
        <Style Selector="ScrollViewer.bookScroll:not(.scrolling) /template/ ScrollBar /template/ Grid#Root Thumb">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ScrollViewer.bookScroll /template/ ScrollBar[IsExpanded=true] /template/ Grid#Root Thumb">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- The reader TOC uses the same transient thumb behavior, but owns a
             separate class because its ListBox has its own template ScrollViewer. -->
        <Style Selector="ScrollViewer.readerTocScroll /template/ ScrollBar /template/ Grid#Root Thumb">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ScrollViewer.readerTocScroll.readerTocScrolling /template/ ScrollBar /template/ Grid#Root Thumb">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ScrollViewer.readerTocScroll /template/ ScrollBar[IsExpanded=true] /template/ Grid#Root Thumb">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- The detail pane's save button rests grey (a secondary action next to
             the destructive delete) and turns ink-black on hover. Fluent paints
             hover on the template's ContentPresenter, so the overrides must
             target that part or the theme's light-grey hover wins. -->
        <Style Selector="Button.detailSave">
            <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.detailSave:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.detailSave:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="#333333" />
        </Style>
        <Style Selector="Button.detailDelete">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="#B3261E" />
            <Setter Property="BorderBrush" Value="#B3261E" />
        </Style>
        <Style Selector="Button.detailDelete:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B3261E" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="#B3261E" />
        </Style>
        <Style Selector="Button.detailDelete:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8F1D17" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="#8F1D17" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.icon:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.icon.active">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Section headers: same size as items but semibold gray, so the
             collapsible parents outweigh their children without ink. -->
        <Style Selector="Button.sidebarSection">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="12,2,0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Padding="4,6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.sidebarSection:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarSection:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarSection.active">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarSection Path">
            <Setter Property="Stroke" Value="{StaticResource MutedInkBrush}" />
        </Style>
        <Style Selector="Button.sidebarSection:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarSection:pressed Path, Button.sidebarSection.active Path">
            <Setter Property="Stroke" Value="{StaticResource InkBrush}" />
        </Style>
        <!-- Sidebar entries: quiet “ink dot” selection — no filled rows, only
             a 6 px dot beside the active item, with a faint rounded wash on
             hover so the rail reads like a paper table of contents. -->
        <Style Selector="Button.sidebarItem">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="12,2,0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <Grid ColumnDefinitions="6,5,*">
                            <Ellipse Width="6"
                                     Height="6"
                                     Fill="{TemplateBinding BorderBrush}"
                                     VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="2"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.sidebarItem:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarItem:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarItem.active">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- Settings category rail: same ink-dot language as the main
             sidebar, so selection reads identically across the app. -->
        <Style Selector="Button.settingsCategory">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <Grid ColumnDefinitions="4,7,*">
                            <Ellipse Width="4"
                                     Height="4"
                                     Fill="{TemplateBinding BorderBrush}"
                                     VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="2"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.settingsCategory:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.settingsCategory.active">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- The library shell and its feature pages share the sidebar's flat
             interaction language. Inputs are underline-only, secondary
             actions have no permanent box, and hover supplies the surface
             feedback. ReaderRoot is a sibling, so these rules never alter the
             reading canvas or its toolbars. -->
        <Style Selector="Grid.libraryShell Button.quiet">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.libraryShell Button.quiet:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="RenderTransform" Value="scale(1.12)" />
        </Style>
        <Style Selector="Grid.libraryShell Button.quiet:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>

        <!-- Kindle resource pages use one filled primary action and flat text
             actions. Keep this language local to the resource toolbar so
             dialogs and other library pages retain their own hierarchy. -->
        <Style Selector="Grid.libraryShell Button.deviceResourcePrimary">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ReaderToolbarButtonTemplate}" />
        </Style>
        <Style Selector="Grid.libraryShell Button.deviceResourcePrimary:pointerover">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell Button.deviceResourcePrimary:pressed">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell Button.deviceResourcePrimary:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector="Grid.libraryShell Button.deviceResourceAction">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ReaderToolbarButtonTemplate}" />
        </Style>
        <Style Selector="Grid.libraryShell Button.deviceResourceAction:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell Button.deviceResourceAction:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell Button.deviceResourceAction:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Grid.libraryShell Button.deviceResourceDestructive:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="#B3261E" />
        </Style>
        <Style Selector="Grid.libraryShell Button.deviceResourceDestructive:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="#8F1D17" />
        </Style>

        <Style Selector="Grid.libraryShell Button.deviceResourceBack">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ReaderToolbarButtonTemplate}" />
        </Style>
        <Style Selector="Grid.libraryShell Button.deviceResourceBack:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell Button.deviceResourceBack:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="Grid.libraryShell Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Grid.libraryShell Button.icon:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell Button.icon:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="2,7" />
        </Style>
        <Style Selector="Grid.libraryShell TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Grid.libraryShell ComboBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell NumericUpDown">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Grid.libraryShell CheckBox">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="18,Auto" ColumnSpacing="8" MinHeight="22">
                        <Border x:Name="FlatCheckIndicator"
                                Width="18"
                                Height="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="FlatCheckGlyph"
                                  Data="M 3,8 L 7,12 L 15,4"
                                  Stroke="{StaticResource PaperBrush}"
                                  StrokeThickness="2"
                                  IsVisible="False" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Grid.libraryShell CheckBox:pointerover /template/ Border#FlatCheckIndicator">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell CheckBox:checked /template/ Border#FlatCheckIndicator">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Grid.libraryShell CheckBox:checked /template/ Path#FlatCheckGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Grid.libraryShell CheckBox:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Grid.libraryShell Border.flatPanel">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>
        <Style Selector="Grid.libraryShell Border.flatMetric">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="Grid.libraryShell Border.flatRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Grid.libraryShell Border.flatSubsection">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <!-- Native form controls are explicitly kept in the product's
             monochrome language; Fluent's accent colour must not leak into
             settings or feature pages. -->
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="CheckBox:pointerover">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <!-- Reader layout switches use an explicit monochrome template so
             Fluent's blue system accent cannot leak into the checked state. -->
        <Style Selector="CheckBox.readerLayoutCheck">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="18,Auto" ColumnSpacing="8" MinHeight="22">
                        <Border x:Name="ReaderLayoutCheckIndicator"
                                Width="18"
                                Height="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="ReaderLayoutCheckGlyph"
                                  Data="M 3,8 L 7,12 L 15,4"
                                  Stroke="{StaticResource PaperBrush}"
                                  StrokeThickness="2"
                                  IsVisible="False" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.readerLayoutCheck:pointerover /template/ Border#ReaderLayoutCheckIndicator">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
        </Style>
        <Style Selector="CheckBox.readerLayoutCheck:checked /template/ Border#ReaderLayoutCheckIndicator">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="CheckBox.readerLayoutCheck:checked /template/ Path#ReaderLayoutCheckGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="CheckBox.readerLayoutCheck:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <!-- Long selected text (e.g. author names in a 145px filter box) must
             trim instead of pushing the dropdown chevron out of the border. -->
        <Style Selector="ComboBox /template/ ContentControl#ContentPresenter TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <!-- An auto-hiding popup scrollbar makes the dropdown widen/narrow while
             scrolling. Keep it permanently visible so the popup width is stable. -->
        <Style Selector="ComboBox.filterCombo">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        </Style>
        <!-- Filter popups can be wider than their ComboBox. Let the popup draw
             its complete top edge and suppress the control underline while open. -->
        <Style Selector="ComboBox.filterCombo:dropdownopen /template/ Border#Background,
                         ComboBox.filterCombo:dropdownopen /template/ Border#HighlightBackground">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="{DynamicResource ComboBoxItemThemePadding}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontStretch="{TemplateBinding FontStretch}"
                                   FontStyle="{TemplateBinding FontStyle}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="None" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover">
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
        </Style>
        <!-- Fluent paints the ProgressBar fill with the accent colour; keep
             every progress bar (import, transfer, conversion) ink-on-paper. -->
        <Style Selector="ProgressBar">
            <Style.Resources>
                <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{StaticResource InkColor}" />
                <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{StaticResource InkColor}" />
                <SolidColorBrush x:Key="SystemControlHighlightTransparentBrush" Color="#00FFFFFF" />
                <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="{StaticResource HairlineColor}" />
            </Style.Resources>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <!-- Fluent paints the spinner arrows as boxed rectangles and lights the
             focused box plus text selection with the accent blue; force the
             same ink-on-paper flatness as the rest of the settings forms. -->
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <!-- Fluent paints pressed/focused/disabled spinner arrows as filled
             rectangles too (a hit max/min disables one arrow); flatten those. -->
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pressed">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:focus">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="NumericUpDown:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="NumericUpDown:focus /template/ Border#BackgroundBorder">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- The setting label already provides the meaning, so the switch stays
             deliberately minimal: a thin grey line with a circular thumb. -->
        <Style Selector="ToggleSwitch">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource SidebarIndicatorBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="IsThreeState" Value="False" />
            <Setter Property="Width" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="36" Height="18">
                        <Border x:Name="SwitchTrack"
                                Width="24"
                                Height="1"
                                Background="{TemplateBinding Background}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        <Grid x:Name="PART_MovingKnobs" Width="36" Height="18">
                            <Border x:Name="SwitchThumb"
                                    Width="12"
                                    Height="12"
                                    Background="{StaticResource SidebarIndicatorBrush}"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleSwitch:checked">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchThumb">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ToggleSwitch:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- The device card uses the same minimal vector eject mark as the
             Kindle page toolbar; it stays font-independent and centred. -->
        <Style Selector="Button.eject">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Width" Value="25" />
            <Setter Property="MinWidth" Value="25" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.eject:pointerover">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Button.eject:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
        </Style>
        <Style Selector="Polygon.ejectGlyph">
            <Setter Property="Fill" Value="{StaticResource InkBrush}" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.eject:disabled Polygon.ejectGlyph">
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Button.eject:pointerover Polygon.ejectGlyph">
            <Setter Property="RenderTransform" Value="scale(1.22)" />
        </Style>
        <Style Selector="Border.ejectHoverArea:pointerover Polygon.ejectGlyph">
            <Setter Property="RenderTransform" Value="scale(1.22)" />
        </Style>
        <Style Selector="Button.eject:pressed Polygon.ejectGlyph">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
        <Style Selector="TextBlock.kindleStatusTrigger">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.kindleStatusTrigger:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.12)" />
        </Style>

        <Style Selector="ListBoxItem.bookCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="ListBoxItem.bookCard:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ListBoxItem.bookCard:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.readerToolbar">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="BorderBrush" Value="#D5D5D1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ReaderToolbarButtonTemplate}" />
        </Style>
        <Style Selector="Button.readerToolbar:pointerover">
            <Setter Property="Background" Value="#ECECEA" />
        </Style>
        <Style Selector="Button.readerToolbar:pressed">
            <Setter Property="Background" Value="#D9D9D5" />
        </Style>
        <Style Selector="Button.readerToolbar:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector="Button.readerSearchResult">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template" Value="{StaticResource ReaderSearchResultButtonTemplate}" />
        </Style>
        <Style Selector="Button.readerSearchResult:pointerover /template/ Border#HoverInkOutline">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.readerSearchResult:pressed /template/ Border#HoverInkOutline">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Inside the reader the small icon buttons follow the WinUI
             ReaderHeaderIconButtonStyle: no resting box, soft grey hover
             plane, dark ink glyphs. -->
        <Style Selector="Grid.readerShell Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Grid.readerShell Button.icon:pointerover">
            <Setter Property="Background" Value="#ECECEA" />
        </Style>
        <Style Selector="Grid.readerShell Button.icon:pressed">
            <Setter Property="Background" Value="#D9D9D5" />
        </Style>
        <!-- Quiet buttons in the reader stay outlined white boxes with a
             soft grey hover (WinUI QuietButtonStyle), no scale animation. -->
        <Style Selector="Grid.readerShell Button.quiet">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.readerShell Button.quiet:pointerover">
            <Setter Property="Background" Value="#ECECEA" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="Grid.readerShell Button.quiet:pressed">
            <Setter Property="Background" Value="#D9D9D5" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <!-- Reader inputs are black-framed square boxes (WinUI App.xaml
             TextBox/ComboBox baseline), not underline fields. -->
        <Style Selector="Grid.readerShell TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Grid.readerShell TextBox:focus">
            <Setter Property="BorderBrush" Value="#000000" />
        </Style>
        <Style Selector="Grid.readerShell ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Grid.readerShell ComboBox:focus">
            <Setter Property="BorderBrush" Value="#000000" />
        </Style>

        <!-- AI settings reuse the library form language inside the otherwise
             black-framed reader surface. -->
        <Style Selector="Grid.readerShell TextBox.readerSettingsField">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="2,7" />
        </Style>
        <Style Selector="Grid.readerShell TextBox.readerSettingsField:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Grid.readerShell ComboBox.readerSettingsField">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Grid.readerShell ComboBox.readerSettingsField:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="Button.readerAssistantTab">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ReaderToolbarButtonTemplate}" />
        </Style>
        <Style Selector="Button.readerAssistantTab:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.readerAssistantTab.active">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.readerMinimalAction">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ReaderToolbarButtonTemplate}" />
        </Style>
        <Style Selector="Button.readerMinimalAction:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
        </Style>
        <Style Selector="Button.readerMinimalAction:pressed">
            <Setter Property="Background" Value="#D9D9D5" />
        </Style>
        <Style Selector="Button.readerMinimalAction:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.readerNoteItem">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="2,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ReaderToolbarButtonTemplate}" />
        </Style>
        <Style Selector="Button.readerNoteItem:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
        </Style>
        <Style Selector="Grid.readerShell TextBox.readerMinimalField">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="2,7" />
        </Style>
        <Style Selector="Grid.readerShell TextBox.readerMinimalField:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Grid.readerShell ComboBox.readerMinimalField">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Grid.readerShell ComboBox.readerMinimalField:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- Hollow tabs (WinUI SetReaderTocTab): transparent fill for both
             states; the selected tab is outlined in black, the idle tab in
             light grey, hover is a quiet grey plane. -->
        <Style Selector="Button.readerTab">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="BorderBrush" Value="#D5D5D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ReaderToolbarButtonTemplate}" />
        </Style>
        <Style Selector="Button.readerTab:pointerover">
            <Setter Property="Background" Value="#ECECEA" />
        </Style>
        <Style Selector="Button.readerTab:pressed">
            <Setter Property="Background" Value="#D9D9D5" />
        </Style>
        <Style Selector="Button.readerTab.active">
            <Setter Property="BorderBrush" Value="#000000" />
        </Style>

        <!-- Reader header chrome buttons: stable sizes keep the reader header
             aligned when the WebView area becomes narrow (WinUI reference's
             ReaderHeaderButtonStyle / ReaderHeaderIconButtonStyle). -->
        <Style Selector="Button.readerHeader">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Width" Value="56" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="BorderBrush" Value="#D5D5D1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ReaderToolbarButtonTemplate}" />
        </Style>
        <Style Selector="Button.readerHeader:pointerover">
            <Setter Property="Background" Value="#ECECEA" />
        </Style>
        <Style Selector="Button.readerHeader:pressed">
            <Setter Property="Background" Value="#D9D9D5" />
        </Style>
        <Style Selector="Button.readerHeaderIcon">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="BorderBrush" Value="#D5D5D1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ReaderToolbarButtonTemplate}" />
        </Style>
        <Style Selector="Button.readerHeaderIcon:pointerover">
            <Setter Property="Background" Value="#ECECEA" />
        </Style>
        <Style Selector="Button.readerHeaderIcon:pressed">
            <Setter Property="Background" Value="#D9D9D5" />
        </Style>

        <!-- TOC rows stay paper-white in every interaction state. The current
             row is identified by the narrow marker in the item template;
             filling the whole row makes recycled selection state look like
             several chapters are active at once. -->
        <Style Selector="ListBox.readerTocList ListBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.readerTocList ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.readerTocList ListBoxItem:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.readerTocList ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBox.readerTocList ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBox.readerTocList ListBoxItem:selected:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <!-- A folded TOC can be shorter than the left rail. Fluent's default
             ItemsPresenter alignment centers short lists, which makes the
             whole directory appear to drift downward whenever a chapter
             switch rebuilds the visible branch. Keep the TOC anchored at the
             top while allowing long lists to scroll normally. -->
        <Style Selector="ListBox.readerTocList /template/ ItemsPresenter">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- Glyphs are drawn as vectors rather than Segoe MDL2 Assets glyphs:
             that font ships only with Windows, so a font-based title bar would
             compile here and render as tofu on Linux. Stroke follows the
             button's Foreground so the hover inversion carries through. -->
        <Style Selector="Button.caption Path">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <Style Selector="Button.icon Path">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <!-- Library action glyphs share one optical box. Keeping the vector
             artwork in a fixed square prevents uneven paths from looking
             off-centre inside otherwise centred icon buttons. -->
        <Style Selector="Path.libraryGlyph">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button Path.libraryGlyph">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="Button.icon:pointerover Path.libraryGlyph">
            <Setter Property="RenderTransform" Value="scale(1.22)" />
        </Style>
        <Style Selector="Button.icon:pressed Path.libraryGlyph">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
        <Style Selector="Button.icon.active Path.libraryGlyph">
            <Setter Property="RenderTransform" Value="scale(1.22)" />
        </Style>
        <Style Selector="Button.icon.active:pressed Path.libraryGlyph">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
        <Style Selector="Grid.libraryPresenceGlyph">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.libraryPresenceGlyph:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.22)" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>

        <!-- These TOC state overrides must follow the generic ListBoxItem
             rules above. Avalonia resolves matching application styles in
             declaration order, so placing them earlier lets the global black
             selected background win even with the TOC-specific template. -->
        <Style Selector="ListBox.readerTocList ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBox.readerTocList ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBox.readerTocList ListBoxItem:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBox.readerTocList ListBoxItem:selected,
                         ListBox.readerTocList ListBoxItem:selected:pointerover,
                         ListBox.readerTocList ListBoxItem:selected:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>

        <!-- The WinUI shelf selects the 154-DIP card content, never the
             172-DIP wrap slot around it. Keep the ListBox container visually
             transparent so the outline inside the card stays flush with the
             cover's left and right edges. Cards keep their fixed size; the
             WrapPanel slot width below just decides how many fit per row. -->
        <Style Selector="ListBox.bookGrid ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.bookGrid ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ListBox.bookGrid ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.bookGrid ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ListBox.bookGrid /template/ ItemsPresenter">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="ListBox.bookList /template/ ItemsPresenter">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="ListBox.bookList ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.bookList ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ListBox.bookList ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.bookList ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="WindowManagerAddShadowHint" Value="False" />
        </Style>
        <!-- Button.Flyout menus render inside a MenuFlyoutPresenter; the Fluent
             default border is grey, so the monochrome language must be applied
             here as well. -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="MenuFlyoutPresenter /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="{DynamicResource MenuFlyoutItemThemePaddingNarrow}" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
            <!-- Avalonia sizes are device-independent units. At the common
                 Windows 125% scale, 32 units render as the 40 px rows in the
                 WinUI reference screenshot. -->
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <!-- 选中某条：黑色矩形 + 白色反色文字。子菜单箭头等矢量图形同样
             只允许黑白两色，避免 Fluent 模板主题色渗入。 -->
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="MenuItem.readerSelectionStyle:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="MenuItem.readerSelectionStyle:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="MenuItem:pressed">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="MenuItem:disabled">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="#999999" />
        </Style>
        <Style Selector="MenuItem:open">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="MenuItem.instantMenuHover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="MenuItem:separator">
            <Setter Property="Height" Value="0.5" />
            <Setter Property="MaxHeight" Value="0.5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
        <Style Selector="MenuItem:open /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="MenuItem:open /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="MenuItem:open:not(:empty) /template/ Path#PART_ChevronPath">
            <Setter Property="Fill" Value="{StaticResource InkBrush}" />
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- A submenu parent is also marked selected while the pointer moves
             into the child popup. Keep its chevron in the same slot and ink
             colour instead of letting the selected-state theme hide it.
             Items without a submenu keep the theme's :empty chevron hidden. -->
        <Style Selector="MenuItem:selected:not(:empty) /template/ Path#PART_ChevronPath">
            <Setter Property="Fill" Value="{StaticResource InkBrush}" />
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="MenuItem.instantMenuHover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="MenuItem.instantMenuHover /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="MenuItem.instantMenuHover /template/ Path#PART_ChevronPath">
            <Setter Property="Fill" Value="{StaticResource PaperBrush}" />
        </Style>
        <!-- Keep vector colours scoped to each MenuItem's own template.
             A broad descendant selector also reaches into an open submenu and
             can turn a nested chevron white while its row is still white. -->
        <Style Selector="MenuItem /template/ Path">
            <Setter Property="Fill" Value="{StaticResource InkBrush}" />
        </Style>
        <!-- 带子菜单的项：右箭头在任何交互状态下都保持可见（普通、悬停、
             按下、子菜单展开/选中），只按所在行的底色切换黑白，不隐藏。 -->
        <Style Selector="MenuItem:not(:empty) /template/ Path#PART_ChevronPath">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Path, MenuItem:pressed /template/ Path">
            <Setter Property="Fill" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="MenuItem.instantMenuHover /template/ Path">
            <Setter Property="Fill" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="MenuItem:disabled /template/ Path">
            <Setter Property="Fill" Value="#999999" />
        </Style>
        <!-- Menu separators: solid black line instead of the Fluent grey. -->
        <Style Selector="Separator">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Height" Value="0.5" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- Book cover frames: the cover keeps a thin grey border so covers
             read as images in the gallery. Hover and selection frames are
             drawn by the whole-card overlay in the card template
             (BookCardViewModel.IsFrameVisible); the cover border itself never
             turns black. -->
        <Style Selector="Border.bookCover">
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.bookCover Image">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bookCover:pointerover Image">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <!-- The gallery card keeps its light-grey resting outline from the
             template. Draw a one-unit black inset frame only while hovered.
             Do not use ListBoxItem:selected here: the ListBox can retain a
             current item independently of the app's real book selection. -->
        <Style Selector="ListBox.bookGrid ListBoxItem:pointerover Border.bookOutline">
            <Setter Property="BoxShadow" Value="inset 0 0 0 1 #000000" />
        </Style>
        <!-- List-view rows follow the same rule: grey at rest, black thin
             border on hover (and black when selected via the overlay). -->
        <Style Selector="Border.bookRow">
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bookRow:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
    </Application.Styles>
</Application>
