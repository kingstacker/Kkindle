                                </Border>
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Border Width="44" Height="44" Background="{DynamicResource SoftHoverBrush}" CornerRadius="22">
                                                <Grid Width="32" Height="30">
                                                    <Path Data="M 11,8 C 9,6 11,4 10,2" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" StrokeLineCap="Round" />
                                                    <Path Data="M 18,8 C 16,6 18,4 17,2" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" StrokeLineCap="Round" />
                                                    <Path Data="M 23,14 H 25 C 28,14 29,16 29,19 C 29,22 27,24 23,24" Fill="Transparent" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" />
                                                    <Path Data="M 7,12 H 23 V 19 C 23,24 20,26 15,26 C 10,26 7,24 7,19 Z" Fill="{DynamicResource PaperBrush}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" />
                                                    <Path Data="M 8,14 C 12,15.5 18,15.5 22,14" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" StrokeLineCap="Round" />
                                                    <Path Data="M 5,28 H 25" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" StrokeLineCap="Round" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Ui.Auto.EF51FA34002047BB}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{DynamicResource Ui.Auto.2D1996A469BDAB92}" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="76" Height="76" Background="{DynamicResource SoftHoverBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                            <ToolTip.Tip>
                                                <Border Background="#FFFFFFFF" Padding="8">
                                                    <Image Source="avares://Kkindle.App/Assets/Images/SupportWechatQr.png" Width="220" Height="220" Stretch="Uniform" />
                                                </Border>
                                            </ToolTip.Tip>
                                            <Image Source="avares://Kkindle.App/Assets/Images/SupportWechatQr.png" Stretch="Uniform" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
