<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Kkindle"
        xmlns:core="using:Kkindle.Core"
        xmlns:infra="using:Kkindle.Infrastructure"
        xmlns:converters="using:Avalonia.Data.Converters"
        mc:Ignorable="d"
        d:DesignWidth="1294"
        d:DesignHeight="804"
        x:Class="Kkindle.MainWindow"
        x:DataType="local:MainWindow"
        Title="Kkindle"
        Width="1294"
        Height="804"
        MinWidth="1024"
        MinHeight="664"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        UseLayoutRounding="True"
        WindowDecorations="None"
        DragDrop.AllowDrop="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        KeyDown="MainWindow_KeyDown">

    <Window.Resources>
        <!-- Minimal library-presence glyph shared by the PC grid/list and the
             Kindle cards. Every state uses the same centred optical box. -->
        <DataTemplate x:Key="LibraryPresenceGlyph" x:CompileBindings="False">
            <Grid Classes="libraryPresenceGlyph" Width="20" Height="20">
                <Path Classes="libraryGlyph"
                      Data="M 4,5 H 20 V 15 H 4 Z M 2,19 H 22"
                      Stroke="{StaticResource InkBrush}"
                      IsVisible="{Binding ComputerOnlyPresenceVisibility}" />
                <Path Classes="libraryGlyph"
                      Data="M 7,3 H 17 V 21 H 7 Z M 10,17 H 14"
                      Stroke="{StaticResource InkBrush}"
                      IsVisible="{Binding KindleOnlyPresenceVisibility}" />
                <Path Classes="libraryGlyph"
                      Data="M 3,5 H 17 V 15 H 3 Z M 2,18 H 17 M 15,9 H 21 V 21 H 15 Z"
                      Stroke="{StaticResource InkBrush}"
                      IsVisible="{Binding BothLibrariesPresenceVisibility}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- The content reaches the client-area edges. Resize handles are layered
         over those edges instead of reserving a transparent outer gutter; on
         Windows that gutter can be composed as an opaque white strip. -->
    <Grid>
        <Border x:Name="WindowShadowHost"
                Margin="0"
                Background="{StaticResource PaperBrush}"
                BorderBrush="#000000"
                BorderThickness="1">
        <Grid Background="{StaticResource PaperBrush}">
        <!-- Self-drawn square title bar. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Background="Transparent"
              Height="38"
              VerticalAlignment="Top"
              ZIndex="50">
            <Grid Grid.Column="0">
                <Border x:Name="TitleBarDragRegion"
                        Background="Transparent"
                        PointerPressed="TitleBarDragRegion_PointerPressed" />
                <TextBlock x:Name="WindowBrandText"
                           Text="Kreader"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           LetterSpacing="1.08"
                           IsHitTestVisible="False"
                           IsVisible="False" />
            </Grid>

            <Border x:Name="ReaderZenActivationRegion"
                    Grid.ColumnSpan="2"
                    Width="380"
                    Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    IsVisible="False"
                    ZIndex="0"
                    PointerEntered="ReaderTitleControls_PointerEntered"
                    PointerExited="ReaderTitleControls_PointerExited" />

            <StackPanel x:Name="ReaderTitleControls"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="0"
                        ZIndex="1"
                        PointerEntered="ReaderTitleControls_PointerEntered"
                        PointerExited="ReaderTitleControls_PointerExited">
                <Button x:Name="ReaderZenTitleTocButton"
                        Classes="caption"
                        Width="92"
                        Height="38"
                        Padding="0"
                        FontSize="11"
                        AutomationProperties.Name="切换极简目录"
                        ToolTip.Tip="显示或隐藏禅模式极简目录"
                        IsVisible="False"
                        Click="ReaderZenMinimalTocButton_Click">
                    <TextBlock x:Name="ReaderZenTitleTocText"
                               Text="极简目录"
                               Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button x:Name="ReaderZenTitleExitButton"
                        Classes="caption"
                        Width="104"
                        Height="38"
                        Padding="0"
                        FontSize="11"
                        AutomationProperties.Name="退出禅模式"
                        ToolTip.Tip="退出禅模式，恢复目录与阅读助手"
                        IsVisible="False"
                        Click="ReaderExitZenButton_Click">
                    <TextBlock Text="退出禅模式"
                               Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button x:Name="MinimizeWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="MinimizeWindowButton_Click"
                        AutomationProperties.Name="最小化">
                    <Path Data="M 0,0 H 10" />
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="MaximizeWindowButton_Click"
                        AutomationProperties.Name="最大化">
                    <Path x:Name="MaximizeWindowGlyph" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                </Button>
                <Button x:Name="CloseWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="CloseWindowButton_Click"
                        AutomationProperties.Name="关闭">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                </Button>
            </StackPanel>
            <!-- Modal overlays live in the content layer below this custom
                 title bar. Mirror their visibility over the caption-button
                 column so minimize/maximize/close are dimmed and blocked too. -->
            <Border Grid.Column="1"
                    Background="#66000000"
                    ZIndex="100">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static converters:BoolConverters.Or}">
                        <Binding Path="IsVisible" ElementName="DevicePromptOverlay" />
                        <Binding Path="IsVisible" ElementName="ConfirmationOverlay" />
                        <Binding Path="IsVisible" ElementName="CollectionNameOverlay" />
                        <Binding Path="IsVisible" ElementName="DeviceModelInputOverlay" />
                        <Binding Path="IsVisible" ElementName="DoubanCandidateOverlay" />
                        <Binding Path="IsVisible" ElementName="DoubanPreviewOverlay" />
                        <Binding Path="IsVisible" ElementName="ImportFormatSelectionOverlay" />
                        <Binding Path="IsVisible" ElementName="MessageOverlay" />
                        <Binding Path="IsOpen" ElementName="ReaderLayoutSettingsPopup" />
                    </MultiBinding>
                </Border.IsVisible>
            </Border>
        </Grid>

        <Grid x:Name="LibraryRoot"
              Classes="libraryShell"
              Grid.Row="0"
              ColumnDefinitions="200,*,0"
              Background="{StaticResource PaperBrush}"
              ZIndex="0"
              SizeChanged="LibraryRoot_SizeChanged">
            <!-- Left navigation -->
            <Border Grid.Column="0"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="18,24,18,18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="34" Height="34" Background="{StaticResource InkBrush}">
                            <TextBlock Text="K"
                                       Foreground="{StaticResource PaperBrush}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="Kkindle"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <!-- Update-available badge: a small amber dot beside the
                                     app title. Hovering shows the release notes; clicking
                                     offers to download and install the new version. -->
                                <Button x:Name="UpdateBadgeButton"
                                        IsVisible="False"
                                        Click="UpdateBadgeButton_Click"
                                        Cursor="Hand"
                                        Padding="3"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Focusable="False">
                                    <Ellipse Width="8" Height="8" Fill="#E0A100" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="个人电子书架"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,24,0,16"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="3">
                                <Button x:Name="BookManagementSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="书籍管理" />
                                            <Path x:Name="BookManagementChevron"
                                                  Data="M 1,2 L 5,6 L 9,2"
                                                  Width="10"
                                                  Height="8"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="BookManagementChildren" Spacing="3">
                                    <Button x:Name="AllBooksButton"
                                            Classes="sidebarItem active"
                                            ToolTip.Tip="电脑书库：本地导入的书籍"
                                            Click="ShowAllBooksButton_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <TextBlock Text="电脑书库" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="9"
                                                    Background="#10000000"
                                                    Padding="6,1">
                                                <TextBlock x:Name="SidebarCountText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="KindleBooksButton"
                                            Classes="sidebarItem"
                                            ToolTip.Tip="Kindle 书库：设备上的书籍"
                                            Click="KindleBooksButton_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <TextBlock Text="Kindle书库" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="9"
                                                    Background="#10000000"
                                                    Padding="6,1">
                                                <TextBlock x:Name="DeviceBookCountText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="ZLibraryBooksButton"
                                            Classes="sidebarItem"
                                            Content="Z-Library 在线书库"
                                            ToolTip.Tip="Z-Library 在线书库：搜索并下载电子书"
                                            Click="ZLibraryBooksButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="DeviceManagementSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="设备管理" />
                                            <Path x:Name="DeviceManagementChevron"
                                                  Data="M 2,1 L 6,5 L 2,9"
                                                  Width="10"
                                                  Height="10"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="DeviceManagementChildren" Spacing="3" IsVisible="False">
                                <Button x:Name="FontManagementButton"
                                            Classes="sidebarItem"
                                            Content="字体管理"
                                            ToolTip.Tip="管理 Kindle 上的字体"
                                            Click="FontManagementButton_Click" />
                                <Button x:Name="DictionaryManagementButton"
                                            Classes="sidebarItem"
                                            Content="字典管理"
                                            ToolTip.Tip="管理 Kindle 上的字典"
                                            Click="DictionaryManagementButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="ReadingSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="阅读资料" />
                                            <Path x:Name="ReadingChevron"
                                                  Data="M 1,2 L 5,6 L 9,2"
                                                  Width="10"
                                                  Height="8"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="ReadingChildren" Spacing="3" IsVisible="False">
                                    <Button x:Name="ReaderNotesNavigationButton"
                                            Classes="sidebarItem"
                                            Content="笔记与标注"
                                            ToolTip.Tip="统一浏览本地书籍与 Kindle 的划线、笔记和批注"
                                            Click="ReaderNotesNavigationButton_Click" />
                                    <Button x:Name="ReaderExportNavigationButton"
                                            Classes="sidebarItem"
                                            Content="导出记录"
                                            ToolTip.Tip="筛选并导出阅读资料"
                                            Click="ReaderExportNavigationButton_Click" />
                                    <Button x:Name="ReadingDashboardButton"
                                            Classes="sidebarItem"
                                            Content="阅读数据"
                                            ToolTip.Tip="查看阅读进度、时长与标注统计"
                                            Click="ReadingDashboardButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="SystemSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="系统设置" />
                                            <Path x:Name="SystemChevron"
                                                  Data="M 2,1 L 6,5 L 2,9"
                                                  Width="10"
                                                  Height="10"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="SystemChildren" Spacing="3" IsVisible="False">
                                    <Button x:Name="SettingsNavigationButton"
                                            Classes="sidebarItem"
                                            Content="基础设置"
                                            ToolTip.Tip="应用基础设置：常规、书库、Kindle、阅读、备份"
                                            Click="SettingsButton_Click" />
                                    <Button x:Name="KindleEmailSettingsNavigationButton"
                                            Classes="sidebarItem"
                                            Content="Kindle 邮箱设置"
                                            ToolTip.Tip="配置 SMTP 发送到 Kindle 个人文档邮箱"
                                            Click="KindleEmailSettingsButton_Click" />
                                    <Button x:Name="ZLibraryAccountNavigationButton"
                                            Classes="sidebarItem"
                                            Content="Z-Library 账号设置"
                                            ToolTip.Tip="配置 Z-Library 账号用于下载书籍"
                                            Click="ZLibraryAccountButton_Click" />
                                    <Button x:Name="ReaderAiSettingsNavigationButton"
                                            Classes="sidebarItem"
                                            Content="AI 助手设置"
                                            ToolTip.Tip="配置阅读 AI 助手的服务与 API Key"
                                            Click="ReaderAiSettingsButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="DeviceStatusBox"
                            Grid.Row="2"
                            Padding="10"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                                <TextBlock x:Name="KindleStatusText"
                                           Classes="kindleStatusTrigger"
                                           Text="正在检查设备…"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Tapped="DeviceStatusBox_Tapped"
                                           ToolTip.Tip="点击选择或自定义设备型号（按串码记忆）；未连接时点击可重新检测 Kindle" />
                                <TextBlock x:Name="KindleConnectionText"
                                           Grid.Row="1"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="10" />
                                <Border Grid.Column="1"
                                        Grid.Row="0"
                                        Classes="ejectHoverArea"
                                        Width="25"
                                        Height="23"
                                        Background="Transparent"
                                        VerticalAlignment="Center">
                                    <Button x:Name="DeviceStatusEjectButton"
                                            Classes="eject"
                                            Width="25"
                                            MinWidth="25"
                                            Height="23"
                                            IsEnabled="False"
                                            LayoutUpdated="DeviceStatusEjectButton_LayoutUpdated"
                                            ToolTip.Tip="未连接设备"
                                            AutomationProperties.Name="弹出设备"
                                            Click="EjectDeviceButton_Click">
                                        <Polygon x:Name="DeviceEjectTriangleGlyph"
                                                 Classes="ejectGlyph"
                                                 Points="0,8 7,0 14,8"
                                                 Width="14"
                                                 Height="8"
                                                 Stroke="{StaticResource InkBrush}"
                                                 StrokeThickness="1"
                                                 Stretch="Fill"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Button>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="DeviceStorageText"
                                       Text="无存储信息"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <Grid x:Name="DeviceStorageBar"
                                  Height="10"
                                  Background="{StaticResource PaperBrush}"
                                  SizeChanged="DeviceStorageBar_SizeChanged">
                                <Rectangle x:Name="DeviceStorageUsedBar" HorizontalAlignment="Left" Fill="{StaticResource InkBrush}" Width="0" />
                                <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="1" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Local library -->
            <Grid x:Name="LibraryWorkspace"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  RowDefinitions="Auto,Auto,Auto,*,Auto">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="本地" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="电脑书库" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="LibrarySummaryText"
                               Text="{Binding ViewModel.StatusText}"
                               FontSize="12"
                               Foreground="#666666"
                               IsVisible="False" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,18" ColumnDefinitions="420,*">
                    <TextBox x:Name="SearchBox"
                             Height="38"
                             Padding="13,7"
                             PlaceholderText="搜索标题或作者"
                             Text="{Binding ViewModel.SearchText, Mode=TwoWay}"
                             TextChanged="SearchBox_TextChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                        <Button x:Name="FilterButton" Classes="icon" ToolTip.Tip="显示或隐藏筛选条件" Click="FilterButton_Click" AutomationProperties.Name="筛选">
                            <Path Classes="libraryGlyph"
                                  UseLayoutRounding="True"
                                  Data="M 5,5.4 H 19 L 14.2,11 V 17.6 L 9.8,19.8 V 11 Z" />
                        </Button>
                        <!-- One click cycles 网格 → 列表 → 收藏夹; the glyph
                             mirrors the active view and the tooltip names what
                             the next click switches to. -->
                        <Button x:Name="LibraryViewToggleButton"
                                Classes="icon"
                                ToolTip.Tip="切换到列表视图"
                                Click="LibraryViewToggleButton_Click"
                                AutomationProperties.Name="切换视图">
                            <Path x:Name="LibraryViewToggleIcon"
                                  Classes="libraryGlyph"
                                  Data="M 3,3 H 9 V 9 H 3 Z M 15,3 H 21 V 9 H 15 Z M 3,15 H 9 V 21 H 3 Z M 15,15 H 21 V 21 H 15 Z" />
                        </Button>
                        <Button x:Name="ImportButton" Classes="icon" ToolTip.Tip="导入书籍文件或文件夹" Click="ImportButton_Click" AutomationProperties.Name="导入">
                            <Path Classes="libraryGlyph"
                                  Data="M 12,3 V 16 M 7,11 L 12,16 L 17,11 M 4,21 H 20" />
                        </Button>
                        <Button x:Name="DoubanBatchMatchButton"
                                Classes="icon"
                                ToolTip.Tip="一键豆瓣匹配：用书名和作者自动补全书籍的评分、简介与封面"
                                Click="DoubanBatchMatchButton_Click"
                                AutomationProperties.Name="一键豆瓣匹配">
                            <Path Classes="libraryGlyph"
                                  UseLayoutRounding="True"
                                  Data="M 11,4.5 L 12.6,9.4 L 17.5,11 L 12.6,12.6 L 11,17.5 L 9.4,12.6 L 4.5,11 L 9.4,9.4 Z M 18.5,15.5 L 19.3,17.7 L 21.5,18.5 L 19.3,19.3 L 18.5,21.5 L 17.7,19.3 L 15.5,18.5 L 17.7,17.7 Z" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="FilterPanel"
                        Classes="flatSubsection"
                        Grid.Row="2"
                        Margin="0,0,0,12"
                        Padding="10"
                        IsVisible="False">
                    <!-- Keep the filter chips tight so the bar reads as one row of controls. -->
                    <Grid ColumnDefinitions="112,112,112,112,112,100,Auto,Auto" ColumnSpacing="4">
                        <ComboBox x:Name="AuthorFilterBox" Classes="filterCombo" PlaceholderText="全部作者" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="TagFilterBox" Classes="filterCombo" Grid.Column="1" PlaceholderText="全部标签" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="FormatFilterBox" Classes="filterCombo" Grid.Column="2" PlaceholderText="全部格式" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="CategoryFilterBox" Classes="filterCombo" Grid.Column="3" PlaceholderText="全部分类" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="ReadingStatusFilterBox" Classes="filterCombo" Grid.Column="4" PlaceholderText="全部状态" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="LibrarySortBox" Classes="filterCombo" Grid.Column="5" PlaceholderText="排序" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <CheckBox x:Name="FavoritesOnlyCheckBox" Grid.Column="6" Content="收藏" VerticalAlignment="Center" Click="FavoritesOnlyCheckBox_Click" />
                        <Button Grid.Column="7" Classes="quiet" Content="清除筛选" Click="ClearFiltersButton_Click" />
                    </Grid>
                </Border>

            <Grid x:Name="LibraryContentHost"
                  Grid.Row="3"
                  RowDefinitions="Auto,*"
                  Background="Transparent">
                    <Border x:Name="CollectionHeader"
                            Padding="0,0,0,10"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="BackToCollectionsButton"
                                    Content="返回收藏夹"
                                    Padding="10,5"
                                    ToolTip.Tip="返回收藏夹列表"
                                    Click="BackToCollectionsButton_Click" />
                            <Button Content="返回全部书籍" Padding="10,5" Click="ShowAllBooksButton_Click" />
                            <TextBlock x:Name="ActiveCollectionTitleText" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                            <Button x:Name="CreateCollectionButton" Content="新建收藏夹" Padding="10,5" Click="CreateCollectionButton_Click" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="BookGrid" Classes="bookGrid" ItemsSource="{Binding ViewModel.Books}" SelectionMode="Multiple" SelectionChanged="BookList_SelectionChanged" PointerPressed="BookGrid_PointerPressed" PointerMoved="BookGrid_PointerMoved" PointerReleased="BookGrid_PointerReleased" PointerCaptureLost="BookGrid_PointerCaptureLost" KeyDown="BookGrid_KeyDown" Focusable="True" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="166" ItemHeight="304" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate>                                 <DataTemplate x:DataType="local:BookCardViewModel">                                     <Grid Width="154"                                           Height="{Binding CardHeight}"                                           Margin="6"                                           RowDefinitions="214,Auto"                                           PointerPressed="BookCard_PointerPressed"                                           ContextRequested="BookCard_ContextRequested"                                           DoubleTapped="BookCard_DoubleTapped">                                         <Border Grid.Row="0"                                                 Classes="bookCover"                                                 Background="#D9D9D9"                                                 BorderThickness="1">                                             <Grid Background="Transparent">                                                 <TextBlock Text="BOOK"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center"                                                            Foreground="{StaticResource MutedInkBrush}"                                                            FontSize="17"                                                            IsHitTestVisible="False" />                                                 <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />                                             </Grid>                                         </Border>                                         <Grid Grid.Row="1" Margin="2,8,2,0" ColumnDefinitions="*,30" RowDefinitions="40,16,14" IsVisible="{Binding GalleryTextVisibility}">                                             <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="15" LineHeight="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />                                             <TextBlock Grid.Row="1" Text="{Binding Authors}" FontSize="11" LineHeight="14" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />                                             <TextBlock Grid.Row="2" Text="{Binding FormatLabel}" FontSize="10" LineHeight="12" Foreground="#777777" TextTrimming="CharacterEllipsis" />                                         </Grid>                                         <ContentControl Grid.RowSpan="2"                                                 Width="24"                                                 Height="24"                                                 Margin="0,0,5,5"                                                 HorizontalAlignment="Right"                                                 VerticalAlignment="Bottom"                                                 Content="{Binding}"                                                 Padding="0"                                                 HorizontalContentAlignment="Center"                                                 VerticalContentAlignment="Center"                                                 ContentTemplate="{StaticResource LibraryPresenceGlyph}"                                                 ToolTip.Tip="{Binding PresenceLabel}"                                                 AutomationProperties.Name="{Binding PresenceLabel}"                                                 IsVisible="{Binding PresenceVisibility}" />                                         <!-- 格式转换进度徽标：点击可恢复转换弹窗 -->                                         <Border Grid.Row="0"                                                 Width="68"                                                 Height="25"                                                 Margin="0,0,5,38"                                                 HorizontalAlignment="Right"                                                 VerticalAlignment="Bottom"                                                 Background="{StaticResource PaperBrush}"                                                 BorderBrush="{StaticResource InkBrush}"                                                 BorderThickness="1"                                                 Tapped="BookConversionProgressIndicator_Tapped"                                                 AutomationProperties.Name="打开格式转换进度"                                                 ToolTip.Tip="格式转换进行中，点击恢复进度窗口"                                                 IsVisible="{Binding ConversionProgressVisibility}">                                             <Grid Width="66" Height="23">                                                 <ProgressBar Minimum="0"                                                              Maximum="100"                                                              Value="{Binding ConversionProgress}"                                                              Height="5"                                                              Margin="5,0,5,3"                                                              VerticalAlignment="Bottom"                                                              Background="{StaticResource PaperBrush}" />                                                 <TextBlock Text="{Binding ConversionProgressLabel}"                                                            FontSize="10"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center" />                                             </Grid>                                         </Border>                                         <Border Grid.RowSpan="2"                                                 Classes="bookOutline"                                                 BorderBrush="{StaticResource CardBorderBrush}"                                                 BorderThickness="1"                                                 IsHitTestVisible="False" />                                         <Border Grid.RowSpan="2"                                                 BorderBrush="{StaticResource InkBrush}"                                                 BorderThickness="1.5"                                                 IsVisible="{Binding IsMultiSelected}"                                                 IsHitTestVisible="False">                                             <Border Width="22"                                                     Height="22"                                                     Margin="6"                                                     HorizontalAlignment="Left"                                                     VerticalAlignment="Top"                                                     Background="{StaticResource InkBrush}">                                                 <TextBlock Text="✓"                                                            Foreground="{StaticResource PaperBrush}"                                                            FontSize="14"                                                            FontWeight="Bold"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center" />                                             </Border>                                         </Border>                                     </Grid></DataTemplate>                             </ListBox.ItemTemplate>
                        </ListBox>

                        <Canvas IsHitTestVisible="False" ZIndex="25">
                            <Border x:Name="RubberBandRectangle"
                                    Background="#33000000"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1"
                                    IsVisible="False" />
                        </Canvas>

                        <ListBox x:Name="BookList"
                                 Classes="bookList"
                                 ItemsSource="{Binding ViewModel.Books}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="BookList_SelectionChanged"
                                 IsVisible="False"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:BookCardViewModel">
                                        <Border Margin="0,0,0,7"
                                                Classes="bookRow flatRow"
                                                Padding="10"
                                                Background="{StaticResource PaperBrush}"
                                                PointerPressed="BookCard_PointerPressed"
                                            ContextRequested="BookCard_ContextRequested"
                                            DoubleTapped="BookCard_DoubleTapped">
                                        <Grid ColumnDefinitions="48,1.55*,1.65*,1.2*,140" ColumnSpacing="12">
                                            <Border Width="40" Height="56" VerticalAlignment="Center" Background="#F2F2F2" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />                                             <TextBlock Text="{Binding Authors}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FileSummaryLabel}" FontSize="10" Foreground="#777777" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding OrganizationLabel}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PublicationLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding IdentifierLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding ReadingStateLabel}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DescriptionSummaryLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="5">
                                                <TextBlock Text="{Binding UpdatedLabel}" Foreground="#777777" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Border Width="26"
                                                            Height="26"
                                                            Background="{StaticResource PaperBrush}"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1"
                                                            ToolTip.Tip="{Binding PresenceLabel}"
                                                            AutomationProperties.Name="{Binding PresenceLabel}"
                                                            IsVisible="{Binding PresenceVisibility}">
                                                        <ContentControl Content="{Binding}"
                                                       Padding="0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       HorizontalContentAlignment="Center"
                                                       VerticalContentAlignment="Center"
                                                       ContentTemplate="{StaticResource LibraryPresenceGlyph}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.ColumnSpan="5"
                                                    BorderBrush="{StaticResource InkBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding IsSelected}"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer x:Name="CollectionScroll"
                                      IsVisible="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ContextRequested="CollectionScroll_ContextRequested">
                            <ItemsControl x:Name="CollectionList" ItemsSource="{Binding CollectionFolders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemWidth="210" ItemHeight="142" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:BookCollectionFolderViewModel">
                                        <Grid Width="210"
                                              Height="142"
                                              Tapped="CollectionFolder_Tapped"
                                              ContextRequested="CollectionFolder_ContextRequested">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="94" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <!-- Folder icon: light-grey body, top tab and
                                                 three overlapping cover thumbnails. -->
                                            <Grid Width="174" Height="86" Margin="8,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Border Margin="0,14,0,0"
                                                        Background="#F1F1F1"
                                                        BorderBrush="{StaticResource InkBrush}"
                                                        BorderThickness="1" />
                                                <Border Width="72"
                                                        Height="21"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="#F1F1F1"
                                                        BorderBrush="{StaticResource InkBrush}"
                                                        BorderThickness="1,1,1,0" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="-6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="0,6,0,0">
                                                    <Border Width="44"
                                                            Height="62"
                                                            Background="#E4E4E4"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#5A5A5A"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover1}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="44"
                                                            Height="62"
                                                            Margin="0,4,0,0"
                                                            Background="#E4E4E4"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#5A5A5A"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover2}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="44"
                                                            Height="62"
                                                            Background="#E4E4E4"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#5A5A5A"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover3}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="9,7,1,0" Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding BookCountLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyLibraryState"
                                    Width="320"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    IsVisible="False"
                                    IsHitTestVisible="False">
                            <Path Data="M 3.5,6.5 C 6.5,5.4 9.9,5.9 12,7.8 C 14.1,5.9 17.5,5.4 20.5,6.5 V 18.2 C 17.5,17.1 14.1,17.6 12,19.4 C 9.9,17.6 6.5,17.1 3.5,18.2 Z M 12,7.8 V 19.4"
                                  Width="48"
                                  Height="48"
                                  Margin="0,0,0,4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  UseLayoutRounding="True"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Fill="Transparent" />
                            <TextBlock x:Name="EmptyLibraryTitleText"
                                       Text="电脑书库还是空的"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="EmptyLibraryMessageText"
                                       Text="拖入书籍文件，或使用上方的导入按钮"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border x:Name="LibraryDropOverlay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                        Padding="34,24"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                ZIndex="30">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <TextBlock Text="松开以导入书籍或文件夹"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="支持 EPUB、PDF、MOBI、AZW3，并自动扫描子目录"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MultiSelectionBar"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,16"
                                Padding="14,8"
                                Background="{StaticResource PaperBrush}"
                                BorderBrush="{StaticResource InkBrush}"
                                BorderThickness="1"
                                BoxShadow="0 6 16 0 #22000000"
                                IsVisible="False"
                                ZIndex="20">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="MultiSelectionText" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Content="发送到 Kindle" Padding="12,6" Click="SendSelectedBooksToKindleBatchButton_Click" />
                                <Button Content="邮件发送" Padding="12,6" Click="SendSelectedBooksByEmailBatchButton_Click" />
                                <Button x:Name="DeleteSelectedBooksButton" Content="删除所选" Padding="12,6" Click="DeleteSelectedBooksButton_Click" />
                                <Button Content="取消选择" Padding="12,6" Click="ClearMultiSelectionButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock x:Name="TaskStatusText"
                               Text="准备就绪"
                               FontSize="11"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               IsVisible="False" />
                    <ProgressBar x:Name="LibraryBusyProgress" Grid.Column="1" Width="120" Height="5" IsIndeterminate="True" IsVisible="False" />
                </Grid>
            </Grid>

            <!-- Details panel: the layout follows the old WinUI detail pane:
                 cover and three square action buttons first, then labelled
                 metadata fields and the save/delete row. -->
            <Border x:Name="LibraryDetailPane"
                    Grid.Column="1"
                    Width="320"
                    HorizontalAlignment="Right"
                    ZIndex="40"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DetailContentStack" Margin="24,70,24,24" Spacing="13">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="180,34" ColumnSpacing="12">
                                <Border Width="180"
                                        Height="250"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource PaperBrush}"
                                        BorderBrush="{StaticResource InkBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="DetailCoverImage" Stretch="UniformToFill" />
                                        <TextBlock x:Name="DetailCoverPlaceholder"
                                                   Text="未选择书籍"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1"
                                      Height="250"
                                      VerticalAlignment="Top"
                                      RowDefinitions="*,*,*">
                                    <Button x:Name="DetailDoubanButton"
                                            Classes="quiet"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="从豆瓣匹配书籍信息"
                                            ToolTip.Tip="豆瓣匹配"
                                            Click="DoubanMatchButton_Click">
                                        <!-- Magnifier glyph (WinUI E721). -->
                                        <Path Classes="libraryGlyph"
                                              Data="M 11,4 A 7,7 0 1,0 11,18 A 7,7 0 1,0 11,4 M 16,16 L 21,21" />
                                    </Button>
                                    <Button x:Name="DetailFavoriteButton"
                                            Grid.Row="1"
                                            Classes="quiet"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="收藏状态"
                                            ToolTip.Tip="收藏状态"
                                            Click="DetailFavoriteButton_Click">
                                        <Path x:Name="DetailFavoriteIcon"
                                              Classes="libraryGlyph"
                                              Data="M 12,3 L 14.8,8.7 L 21,9.6 L 16.5,14 L 17.6,20.2 L 12,17.3 L 6.4,20.2 L 7.5,14 L 3,9.6 L 9.2,8.7 Z" />
                                    </Button>
                                    <Button x:Name="DetailReadingStatusButton"
                                            Grid.Row="2"
                                            Classes="quiet"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="阅读状态"
                                            ToolTip.Tip="阅读状态"
                                            Click="DetailReadingStatusButton_Click">
                                        <Path x:Name="DetailReadingStatusIcon"
                                              Classes="libraryGlyph"
                                              Data="M 12,4 A 8,8 0 1 0 12,20 A 8,8 0 1 0 12,4" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <StackPanel Spacing="5">
                                <TextBlock Text="标题" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailTitleText" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="作者" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailAuthorsText" FontSize="13" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="豆瓣评分（只读）" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailDoubanRatingBox" IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="标签" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailTagsBox" PlaceholderText="多个标签用逗号分隔" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="分类" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailCategoryBox" PlaceholderText="例如：技术、文学" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="简介" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailDescriptionBox" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="出版信息"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedInkBrush}" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="系列" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailSeriesBox" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="出版社" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailPublisherBox" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="出版年" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailPublishDateBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="ISBN" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailIsbnBox" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="页数" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailPageCountBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="装帧" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailBindingBox" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,8,0,2" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button x:Name="SaveDetailsButton"
                                        Classes="detailSave"
                                        Content="保存修改"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="SaveDetailsButton_Click" />
                                <Button Grid.Column="1"
                                        Classes="detailDelete"
                                        Content="从书库删除"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="DeleteSelectedBookButton_Click" />
                            </Grid>

                            <!-- Compatibility fields used by the current
                                 Avalonia handlers but hidden because the old
                                 detail pane does not show these sections. -->
                            <StackPanel IsVisible="False">
                                <TextBlock x:Name="DetailStateText" />
                                <TextBlock x:Name="DetailOrganizationText" />
                                <TextBlock x:Name="DetailPublicationText" />
                                <TextBlock x:Name="DetailIdentifierText" />
                                <TextBlock x:Name="DetailDescriptionText" />
                                <ItemsControl x:Name="DetailFiles" />
                                <ComboBox x:Name="DetailCollectionBox" />
                                <Button x:Name="CollectionMembershipButton" Click="CollectionMembershipButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Keep scrolled detail content out of the custom title-bar
                         drag area, as in the old WinUI pane. -->
                    <Border Height="38"
                            VerticalAlignment="Top"
                            Background="{StaticResource PaperBrush}"
                            IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Stage 3: Kindle book library. The page stays deliberately
                 simple and monochrome; all device work is performed by the
                 platform service behind the portable UI. -->
            <Grid x:Name="DevicePage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="设备" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="Kindle书库" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <Button x:Name="DeviceNameButton"
                                Classes="quiet"
                                Padding="6,3"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                AutomationProperties.Name="设备型号"
                                ToolTip.Tip="点击选择设备型号"
                                Click="DeviceNameButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="DevicePageDeviceText" Text="未检测到设备" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                <Path Data="M 1,2 L 5,6 L 9,2" Width="10" Height="8" Stroke="{StaticResource MutedInkBrush}" StrokeThickness="1.25" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="DevicePageStatusText" Text="正在检查设备…" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,18" ColumnDefinitions="420,*">
                    <TextBox x:Name="DeviceBookSearchBox"
                             Height="38"
                             Padding="13,7"
                             PlaceholderText="搜索标题或作者"
                             TextChanged="DeviceBookSearchBox_TextChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                        <Button x:Name="DeviceBookFilterButton" Classes="icon" ToolTip.Tip="显示或隐藏筛选条件" Click="DeviceBookFilterButton_Click" AutomationProperties.Name="筛选">
                            <Path Classes="libraryGlyph" UseLayoutRounding="True" Data="M 5,5.4 H 19 L 14.2,11 V 17.6 L 9.8,19.8 V 11 Z" />
                        </Button>
                        <!-- One click cycles 网格 ↔ 列表; the glyph mirrors the
                             active view and the tooltip names the next one. -->
                        <Button x:Name="DeviceViewToggleButton" Classes="icon" ToolTip.Tip="当前：网格视图，点击切换到列表视图" AutomationProperties.Name="切换视图" Click="DeviceViewToggleButton_Click">
                            <Path x:Name="DeviceViewToggleIcon" Classes="libraryGlyph" Data="M 3,3 H 9 V 9 H 3 Z M 15,3 H 21 V 9 H 15 Z M 3,15 H 9 V 21 H 3 Z M 15,15 H 21 V 21 H 15 Z" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="刷新设备书库" AutomationProperties.Name="刷新设备书库" Click="RefreshDevicesButton_Click">
                            <Path Classes="libraryGlyph" Data="M 20,8 A 9,9 0 1,0 20,16 M 20,8 V 3 M 20,8 H 15" />
                        </Button>
                        <Button x:Name="EjectDeviceButton" Classes="icon" ToolTip.Tip="安全弹出设备" AutomationProperties.Name="安全弹出设备" Click="EjectDeviceButton_Click" IsEnabled="False">
                            <Path Classes="libraryGlyph" Data="M 6,15 L 12,9 L 18,15 M 6,20 H 18" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="DeviceBookFilterPanel" Classes="flatSubsection" Grid.Row="2" Margin="0,0,0,12" Padding="10" IsVisible="False">
                    <Grid ColumnDefinitions="128,150,150,Auto" ColumnSpacing="8">
                        <ComboBox x:Name="DeviceBookFormatFilterBox" Classes="filterCombo" PlaceholderText="全部格式" SelectionChanged="DeviceBookFilter_SelectionChanged">
                            <ComboBoxItem Content="全部格式" Tag="" />
                            <ComboBoxItem Content="EPUB" Tag="epub" />
                            <ComboBoxItem Content="PDF" Tag="pdf" />
                            <ComboBoxItem Content="MOBI" Tag="mobi" />
                            <ComboBoxItem Content="AZW3" Tag="azw3" />
                            <ComboBoxItem Content="AZW" Tag="azw" />
                            <ComboBoxItem Content="KFX" Tag="kfx" />
                        </ComboBox>
                        <ComboBox x:Name="DeviceBookPresenceFilterBox" Classes="filterCombo" Grid.Column="1" PlaceholderText="全部所在书库" SelectionChanged="DeviceBookFilter_SelectionChanged">
                            <ComboBoxItem Content="全部所在书库" Tag="" />
                            <ComboBoxItem Content="仅 Kindle" Tag="kindle" />
                            <ComboBoxItem Content="电脑与 Kindle" Tag="both" />
                        </ComboBox>
                        <ComboBox x:Name="DeviceBookSortBox" Classes="filterCombo" Grid.Column="2" PlaceholderText="排序" SelectionChanged="DeviceBookFilter_SelectionChanged">
                            <ComboBoxItem Content="标题" Tag="title" />
                            <ComboBoxItem Content="作者" Tag="author" />
                            <ComboBoxItem Content="最近修改" Tag="modified" />
                            <ComboBoxItem Content="文件大小" Tag="size" />
                        </ComboBox>
                        <Button Grid.Column="3" Classes="quiet" Content="清除筛选" Click="ClearDeviceBookFiltersButton_Click" />
                    </Grid>
                </Border>
                <ScrollViewer x:Name="DeviceBookGridScroll"
                              Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PointerPressed="DeviceBookGrid_PointerPressed"
                              PointerMoved="DeviceBookGrid_PointerMoved"
                              PointerReleased="DeviceBookGrid_PointerReleased"
                              PointerCaptureLost="DeviceBookGrid_PointerCaptureLost">
                    <ItemsControl x:Name="DeviceBookGridItems" ItemsSource="{Binding VisibleDeviceBooks}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="166" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:KindleBookCardViewModel">
                                <Grid Width="154"
                                      Height="{Binding CardHeight}"
                                      Margin="6"
                                      RowDefinitions="214,Auto"
                                      PointerPressed="DeviceBook_PointerPressed"
                                      PointerEntered="DeviceBook_PointerEntered"
                                      PointerExited="DeviceBook_PointerExited"
                                      DoubleTapped="DeviceBook_DoubleTapped"
                                      ContextRequested="DeviceBook_ContextRequested">
                                    <Border Grid.Row="0" Classes="bookCover" Background="#D9D9D9" BorderThickness="1">
                                        <ToolTip.Tip>
                                            <ToolTip>
                                                <StackPanel MaxWidth="360" Spacing="4">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Authors}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding RelativePath}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ToolTip>
                                        </ToolTip.Tip>
                                        <Grid Background="Transparent">
                                            <TextBlock Text="BOOK" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" FontSize="17" IsHitTestVisible="False" />
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="2,8,2,0" ColumnDefinitions="*,30" RowDefinitions="40,16,14" IsVisible="{Binding GalleryTextVisibility}">
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="15" LineHeight="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding Authors}" FontSize="11" LineHeight="14" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Text="{Binding FormatLabel}" FontSize="10" LineHeight="12" Foreground="#777777" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <ContentControl Grid.RowSpan="2"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,5,5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Content="{Binding}"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ContentTemplate="{StaticResource LibraryPresenceGlyph}"
                                                    ToolTip.Tip="{Binding PresenceLabel}"
                                                    AutomationProperties.Name="{Binding PresenceLabel}"
                                                    IsVisible="{Binding PresenceVisibility}" />
                                    <Border Grid.RowSpan="2"
                                            Classes="bookOutline"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            IsHitTestVisible="False" />
                                    <Border Grid.RowSpan="2"
                                            BorderBrush="{StaticResource InkBrush}"
                                            BorderThickness="1.5"
                                            IsVisible="{Binding IsMultiSelected}"
                                            IsHitTestVisible="False">
                                        <Border Width="22" Height="22" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource InkBrush}">
                                            <TextBlock Text="✓" Foreground="{StaticResource PaperBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Canvas Grid.Row="3" IsHitTestVisible="False" ZIndex="25">
                    <Border x:Name="DeviceRubberBandRectangle"
                            Background="#33000000"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1"
                            IsVisible="False" />
                </Canvas>
                <ScrollViewer x:Name="DeviceBookListScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                    <ItemsControl ItemsSource="{Binding VisibleDeviceBooks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:KindleBookCardViewModel">
                                <Border BorderBrush="{StaticResource HairlineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,9"
                                        PointerPressed="DeviceBook_PointerPressed"
                                        PointerEntered="DeviceBook_PointerEntered"
                                        PointerExited="DeviceBook_PointerExited"
                                        DoubleTapped="DeviceBook_DoubleTapped"
                                        ContextRequested="DeviceBook_ContextRequested">
                                    <Grid ColumnDefinitions="54,2*,*,180" ColumnSpacing="10" MinHeight="72">
                                        <Grid Width="42" Height="56" VerticalAlignment="Center">
                                            <Border Background="#D9D9D9" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border Width="18"
                                                    Height="18"
                                                    Margin="0,0,0,2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Background="{StaticResource PaperBrush}"
                                                    BorderBrush="{StaticResource InkBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding PresenceVisibility}"
                                                    ToolTip.Tip="{Binding PresenceLabel}"
                                                    AutomationProperties.Name="{Binding PresenceLabel}">
                                                <ContentControl Content="{Binding}"
                                                                Padding="0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                ContentTemplate="{StaticResource LibraryPresenceGlyph}"
                                                                RenderTransformOrigin="0.5,0.5">
                                                    <ContentControl.RenderTransform>
                                                        <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                                                    </ContentControl.RenderTransform>
                                                </ContentControl>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding GalleryTextVisibility}">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />                                             <TextBlock Text="{Binding Authors}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FileName}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding InfoLabel}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ModifiedLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding RelativePath}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip.Tip="{Binding RelativePath}" />
                                            <TextBlock Text="{Binding HashLabel}" Foreground="#999999" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" IsVisible="{Binding IsFrameVisible}" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border x:Name="DeviceBookSelectionBar"
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        Padding="14,8"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        BoxShadow="0 6 16 0 #22000000"
                        IsVisible="False"
                        ZIndex="20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="DeviceBookSelectionText" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Content="导出到电脑书库" Padding="11,6" Click="ExportSelectedDeviceBooksButton_Click" />
                        <Button Content="删除所选" Padding="11,6" Click="DeleteSelectedDeviceBooksButton_Click" />
                        <Button Content="取消选择" Padding="11,6" Click="ClearDeviceBookSelectionButton_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="DeviceBookEmptyState" Grid.Row="3" Background="{StaticResource PaperBrush}" IsVisible="True" ZIndex="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
                        <Path Width="46" Height="46" Stretch="Uniform" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              Data="M 3.5,6.5 C 6.5,5.4 9.9,5.9 12,7.8 C 14.1,5.9 17.5,5.4 20.5,6.5 V 18.2 C 17.5,17.1 14.1,17.6 12,19.4 C 9.9,17.6 6.5,17.1 3.5,18.2 Z M 12,7.8 V 19.4" />
                        <TextBlock x:Name="DeviceBookEmptyText" Text="连接 Kindle 后扫描书籍。" Foreground="{StaticResource MutedInkBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Stage 3: fonts and dictionaries on the connected Kindle. -->
            <Grid x:Name="DeviceResourcePage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*,Auto"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragOver="DeviceResourcePage_DragOver"
                  DragDrop.Drop="DeviceResourcePage_Drop">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="设备" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="DeviceResourcePageTitle" Text="Kindle 字体" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Name="DeviceResourceDeviceText" Text="未检测到设备" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="USB 磁盘" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock x:Name="DeviceResourcePathText" Text="Kindle\fonts" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock x:Name="DeviceResourceCountText" Text="0 个文件" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="DeviceResourceStatusText" Text="请连接 Kindle" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Name="ImportDeviceResourceButton" Content="导入到 Kindle" Padding="11,6" Click="ImportDeviceResourceButton_Click" />
                        <Button x:Name="ExportDeviceResourceButton" Content="导出所选" Classes="quiet" IsEnabled="False" Padding="11,6" Click="ExportDeviceResourceButton_Click" />
                        <Button x:Name="DeleteDeviceResourceButton" Content="删除所选" Classes="quiet" IsEnabled="False" Padding="11,6" Click="DeleteDeviceResourceButton_Click" />
                        <Button Content="刷新" Classes="quiet" Padding="11,6" Click="RefreshDeviceResourcesButton_Click" />
                        <Button Content="返回书架" Padding="11,6" Click="ShowAllBooksButton_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <ListBox x:Name="DeviceResourceList"
                             ItemsSource="{Binding DeviceResources}"
                             SelectionMode="Single"
                             SelectionChanged="DeviceResourceList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:KindleDeviceResource">
                    <Border Classes="flatRow" Padding="10,8">
                                    <Grid ColumnDefinitions="2*,90,110" ColumnSpacing="16">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Format}" Foreground="{StaticResource MutedInkBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="DeviceResourceEmptyText"
                               Text="此目录中没有可管理的文件"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedInkBrush}" />
                </Grid>
                <TextBlock Grid.Row="2" x:Name="DeviceResourceSafetyText" Margin="0,12,0,0" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
            </Grid>

            <!-- Stage 3: local and Kindle reading materials. -->
            <Grid x:Name="ReadingMaterialsPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,Auto,Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="资料" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="ReadingMaterialsPageTitle" Text="笔记与标注" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock x:Name="ReadingMaterialsStatusText" Text="本地资料已读取 · Kindle 0 条" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ReadingMaterialsNotesActions" Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Name="ReadingMaterialsLocateButton" Content="在阅读器中定位" Classes="quiet" IsEnabled="False" Padding="11,6" Click="ReadingMaterialsLocateButton_Click" />
                        <Button x:Name="DeleteReadingMaterialsButton" Content="删除所选" Classes="quiet" IsEnabled="False" Padding="11,6" Click="DeleteReadingMaterialsButton_Click" />
                        <Button Content="刷新" Classes="quiet" Padding="11,6" Click="RefreshReadingMaterialsButton_Click" />
                        <Button x:Name="ReadingMaterialsBackButton" Content="返回书架" Padding="11,6" Click="ShowAllBooksButton_Click" />
                    </StackPanel>
                    <StackPanel x:Name="ReadingMaterialsExportActions" Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" IsVisible="False">
                        <Button x:Name="SelectAllReadingMaterialsButton" Content="全选" Classes="quiet" Padding="11,6" Click="SelectAllReadingMaterialsButton_Click" />
                        <Button Content="刷新资料" Classes="quiet" Padding="11,6" Click="RefreshReadingMaterialsButton_Click" />
                        <Button Content="返回书架" Padding="11,6" Click="ShowAllBooksButton_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,14,0,14" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                        <StackPanel Spacing="11">
                            <TextBlock Text="来源" FontSize="12" />
                            <ComboBox x:Name="ReadingMaterialsSourceBox" SelectedIndex="0" SelectionChanged="ReadingMaterialsSourceBox_SelectionChanged">
                                <ComboBoxItem Content="全部来源" Tag="all" />
                                <ComboBoxItem Content="本地书库" Tag="local" />
                                <ComboBoxItem Content="Kindle" Tag="kindle" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="11">
                            <TextBlock Text="搜索" FontSize="12" />
                            <TextBox x:Name="ReadingMaterialsSearchBox" PlaceholderText="书名、划线、笔记或位置" TextChanged="ReadingMaterialsSearchBox_TextChanged" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border x:Name="ReadingMaterialsSummaryBorder"
                        Classes="flatPanel"
                        Grid.Row="2"
                        Padding="16,12"
                        Background="{StaticResource PaperBrush}">
                    <TextBlock x:Name="ReadingMaterialsSummaryText" Text="本地 0 条 · Kindle 0 条 · 当前显示 0 条" FontSize="16" FontWeight="Bold" />
                </Border>
                <Border x:Name="ReadingMaterialsExportPanel"
                        Classes="flatPanel"
                        Grid.Row="2"
                        Padding="16,14"
                        Background="{StaticResource PaperBrush}"
                        IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="导出当前筛选结果" FontSize="16" FontWeight="Bold" />
                            <TextBlock x:Name="ReadingMaterialsExportScopeText"
                                       Text="当前筛选范围：全部来源 · 共 0 条记录"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Markdown 适合保留标题层级；纯文本适合在任意设备上阅读。"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="导出 Markdown" Padding="11,6" Click="ExportReadingMaterialsMarkdownButton_Click" />
                            <Button Content="导出文本" Classes="quiet" Padding="11,6" Click="ExportReadingMaterialsTextButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="ReadingMaterialsExportSummaryBorder"
                        Classes="flatPanel"
                        Grid.Row="3"
                        Margin="0,18,0,0"
                        Padding="16,12"
                        Background="{StaticResource PaperBrush}"
                        IsVisible="False">
                    <TextBlock x:Name="ReadingMaterialsExportSummaryText" Text="导出预览 · 本地 0 条 · Kindle 0 条 · 当前将导出 0 条" FontSize="16" FontWeight="Bold" />
                </Border>
                <Grid Grid.Row="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReadingMaterialGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:Stage3ReadingMaterialGroupViewModel">
                                    <Border Classes="flatRow" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="12" Margin="12">
                                                <Border Width="48" Height="64" Background="#E4E4E4" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="BOOK" FontSize="8" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoCover}" />
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BookTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                                        <TextBlock Text="{Binding CountLabel}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Tag="{Binding}"
                                                        Content="{Binding ExpandLabel}"
                                                        Classes="quiet"
                                                        Padding="10,5"
                                                        VerticalAlignment="Center"
                                                        Click="ReadingMaterialGroupToggleButton_Click" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:Stage3ReadingMaterialViewModel">
                                                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="12,10" DoubleTapped="ReadingMaterialEntry_DoubleTapped">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                                          VerticalAlignment="Top"
                                                                          Click="ReadingMaterialSelectionChanged" />
                                                                <StackPanel Grid.Column="1" Spacing="5">
                                                                    <TextBlock Text="{Binding SourceLabel}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource MutedInkBrush}" />
                                                                    <TextBlock Text="{Binding ChapterDisplayLabel}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding SelectedContentLabel}"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding NoteLabel}"
                                                                               FontSize="11"
                                                                               Foreground="#555555"
                                                                               IsVisible="{Binding HasNote}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="ReadingMaterialsEmptyText" Text="没有符合条件的阅读资料。" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Reading dashboard keeps the WinUI statistics surface separate
                 from editable application settings. -->
            <Grid x:Name="ReadingDashboardPage"
                  Grid.Column="1"
                  Margin="30,48,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="阅读数据" FontSize="28" FontWeight="Bold" />
                        <TextBlock x:Name="DashboardStatusText"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="刷新统计" Click="RefreshReadingDashboardButton_Click" />
                        <Button Content="导出 CSV" Classes="quiet" Click="ExportReadingDashboardButton_Click" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                            <Border Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="累计阅读" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardTotalTimeText" Text="0" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashboardDailyAverageText" Text="近 7 天日均 —" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="连续阅读" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardStreakText" Text="0 天" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="近 14 天内连续" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="已开始" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBooksStartedText" Text="0 本" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashboardAverageProgressText" Text="平均进度 —" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="已读完" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBooksFinishedText" Text="0 本" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="书签 / 批注" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBookmarksText" Text="0 / 0" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <Border Classes="flatPanel" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="近 14 天阅读时长" FontSize="14" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding DashboardDays}" AutomationProperties.Name="近十四天每天阅读时长柱状图">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardDayViewModel">
                                                <Grid Width="30" Height="170" RowDefinitions="*,Auto,Auto" Margin="0,0,4,0">
                                                    <Border VerticalAlignment="Bottom"
                                                            Height="{Binding BarHeight}"
                                                            CornerRadius="2"
                                                            Opacity="{Binding BarOpacity}"
                                                            Background="{StaticResource InkBrush}"
                                                            ToolTip.Tip="{Binding TimeLabel}" />
                                                    <TextBlock Grid.Row="1" Text="{Binding TimeLabel}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <TextBlock Grid.Row="2" Text="{Binding DateLabel}" FontSize="9" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="flatPanel" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="单本阅读时长" FontSize="14" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding DashboardBookTimes}" AutomationProperties.Name="单本书累计阅读时长排行">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardBarViewModel">
                                                <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8" Margin="0,4" ToolTip.Tip="{Binding ValueLabel}">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Width="{Binding BarWidth}" Height="10" CornerRadius="2" Background="{StaticResource InkBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Classes="flatPanel" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="阅读进度分布" FontSize="14" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding DashboardProgressBuckets}" AutomationProperties.Name="阅读进度区间分布柱状图">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardBarViewModel">
                                                <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8" Margin="0,4" ToolTip.Tip="{Binding ValueLabel}">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Width="{Binding BarWidth}" Height="10" CornerRadius="2" Background="{StaticResource InkBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Classes="flatPanel" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="最近阅读" FontSize="14" FontWeight="SemiBold" />
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto"
                                                  AutomationProperties.Name="最近阅读记录">
                                        <ItemsControl ItemsSource="{Binding DashboardRecentItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:Stage3DashboardRecentViewModel">
                                                    <Border Padding="0,8"
                                                            BorderBrush="{StaticResource HairlineBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding UpdatedLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DurationLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ProgressLabel}" FontSize="12" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="DashboardRecentEmptyText"
                                               Text="还没有阅读记录。打开一本 EPUB 后，这里会显示最近进度。"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="False" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Stage 3: Z-Library search and download. -->
            <Grid x:Name="ZLibraryPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,*,Auto">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="在线" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="Z-Library 在线书库" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="让全球的知识和文献对所有人触手可及"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ZLibraryStatusText"
                               Margin="0,3,0,0"
                               Text="未配置账号，可搜索书籍；下载前需要登录 Z-Library。"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,22,0,18">
                    <TextBox x:Name="ZLibrarySearchBox"
                             Height="38"
                             Padding="13,7"
                             PlaceholderText="搜索书名或作者"
                             KeyDown="ZLibrarySearchBox_KeyDown" />
                    <ComboBox x:Name="ZLibraryExtensionBox"
                              Grid.Column="1"
                              Width="110"
                              Height="38"
                              SelectedIndex="0">
                        <ComboBoxItem Content="全部格式" Tag="" />
                        <ComboBoxItem Content="EPUB" Tag="epub" />
                        <ComboBoxItem Content="PDF" Tag="pdf" />
                        <ComboBoxItem Content="MOBI" Tag="mobi" />
                        <ComboBoxItem Content="AZW3" Tag="azw3" />
                        <ComboBoxItem Content="FB2" Tag="fb2" />
                        <ComboBoxItem Content="DJVU" Tag="djvu" />
                        <ComboBoxItem Content="TXT" Tag="txt" />
                    </ComboBox>
                    <ComboBox x:Name="ZLibraryLanguageBox"
                              Grid.Column="2"
                              Width="110"
                              Height="38"
                              SelectedIndex="0">
                        <ComboBoxItem Content="全部语言" Tag="" />
                        <ComboBoxItem Content="中文" Tag="chinese" />
                        <ComboBoxItem Content="英文" Tag="english" />
                        <ComboBoxItem Content="日文" Tag="japanese" />
                        <ComboBoxItem Content="韩文" Tag="korean" />
                        <ComboBoxItem Content="俄文" Tag="russian" />
                        <ComboBoxItem Content="德文" Tag="german" />
                        <ComboBoxItem Content="法文" Tag="french" />
                        <ComboBoxItem Content="西班牙文" Tag="spanish" />
                    </ComboBox>
                    <Button x:Name="ZLibrarySearchButton"
                            Classes="icon"
                            Grid.Column="3"
                            Width="38"
                            Height="38"
                            Padding="0"
                            AutomationProperties.Name="搜索"
                            ToolTip.Tip="搜索"
                            Click="ZLibrarySearchButton_Click">
                        <Path Classes="libraryGlyph"
                              Data="M 11,4 A 7,7 0 1,0 11,18 A 7,7 0 1,0 11,4 M 16,16 L 21,21" />
                    </Button>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding ZLibraryBooks}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ZLibraryBookCardViewModel">
                                            <Border Classes="flatRow"
                                                    Margin="0,0,0,8"
                                            Padding="10,10,22,10"
                                            MinHeight="112"
                                            Tapped="ZLibraryBookRow_Tapped">
                                        <Grid ColumnDefinitions="66,*,Auto" ColumnSpacing="14">
                                            <Border Width="66"
                                                    Height="92"
                                                    VerticalAlignment="Center"
                                                    Background="#D9D9D9"
                                                    BorderBrush="{StaticResource HairlineBrush}"
                                                    BorderThickness="1">
                                                <Grid Background="Transparent">
                                                    <TextBlock Text="BOOK"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="#5A5A5A"
                                                               FontSize="10" />
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2" />
                                                <TextBlock Text="{Binding Authors}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PublicationLabel}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding InfoLabel}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ExtraInfoLabel}"
                                                           Foreground="#777777"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Width="110" VerticalAlignment="Center" Spacing="5">
                                                <Grid Width="110" Height="38">
                                                    <Button Width="110"
                                                            Height="38"
                                                            Padding="0"
                                                            Classes="quiet"
                                                            Background="{StaticResource PaperBrush}"
                                                            Foreground="{StaticResource InkBrush}"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="0"
                                                            Tag="{Binding}"
                                                            IsVisible="{Binding IsDownloadIdle}"
                                                            AutomationProperties.Name="下载"
                                                            ToolTip.Tip="下载"
                                                            Click="ZLibraryDownloadButton_Click">
                                                        <Path Width="18"
                                                              Height="18"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding $parent[Button].Foreground}"
                                                              StrokeThickness="1.5"
                                                              Fill="Transparent"
                                                              Data="M 9,2 L 9,12 M 5,8 L 9,12 L 13,8 M 3,15 L 15,15" />
                                                    </Button>
                                                    <Border Width="110"
                                                            Height="38"
                                                            Background="{StaticResource PaperBrush}"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1"
                                                            IsVisible="{Binding IsDownloading}">
                                                        <Grid ClipToBounds="True">
                                                            <Border Width="{Binding DownloadFillWidth}"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{StaticResource InkBrush}" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="110"
                                                            Height="38"
                                                            Background="{StaticResource InkBrush}"
                                                            IsVisible="{Binding IsDownloadCompleted}"
                                                            AutomationProperties.Name="下载完成">
                                                        <Path Width="18"
                                                              Height="14"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Stretch="Uniform"
                                                              Stroke="{StaticResource PaperBrush}"
                                                              StrokeThickness="2"
                                                              StrokeLineCap="Round"
                                                              StrokeJoin="Round"
                                                              Fill="Transparent"
                                                              Data="M 2,7 L 7,12 L 16,2" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding StatusMessage}"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="110"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="ZLibraryDetailPanel"
                            x:DataType="local:ZLibraryBookCardViewModel"
                            Grid.Column="1"
                            Width="330"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            IsVisible="False">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Margin="16,12,10,10" ColumnDefinitions="*,Auto">
                                <TextBlock Text="书籍详情" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="icon" Content="×" Click="ZLibraryDetailCloseButton_Click" AutomationProperties.Name="关闭书籍详情" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,4,16,16" Spacing="10">
                                    <Border Width="112" Height="156" HorizontalAlignment="Left" Background="#D9D9D9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="BOOK" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666" FontSize="11" />
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Authors}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailMetadataLabel}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Text="卷号" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding VolumeLabel}" FontSize="11" />
                                    </Grid>
                                    <TextBlock Text="简介" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding DetailDescription}"
                                               Foreground="#555555"
                                               FontSize="11"
                                               LineHeight="18"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Margin="16,12,16,16" Spacing="7">
                                <Button Content="官网详情" HorizontalAlignment="Stretch" IsEnabled="{Binding CanOpenOfficialDetail}" Click="ZLibraryOfficialDetailButton_Click" />
                                <Button Content="在线阅读" Classes="quiet" HorizontalAlignment="Stretch" IsEnabled="{Binding CanReadOnline}" Click="ZLibraryReadOnlineButton_Click" />
                                <Button Content="发送到 Kindle 邮箱" Classes="quiet" HorizontalAlignment="Stretch" IsEnabled="{Binding CanSendToEmail}" Click="ZLibrarySendEmailButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                    <TextBlock Grid.Column="0"
                               x:Name="ZLibraryResultText"
                               Text="输入书名或作者开始搜索。"
                               Foreground="{StaticResource MutedInkBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ZLibraryPrevPageButton"
                                Content="上一页"
                                Classes="quiet"
                                IsEnabled="False"
                                Click="ZLibraryPrevPageButton_Click" />
                        <TextBlock x:Name="ZLibraryPageText"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ZLibraryNextPageButton"
                                Content="下一页"
                                Classes="quiet"
                                IsEnabled="False"
                                Click="ZLibraryNextPageButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Stage 3: the settings surface follows the WinUI reference:
                 title/subtitle, a narrow category rail, and one focused card
                 at a time. All fields remain in this view so the Avalonia port
                 stays testable without platform-specific flyouts. -->
            <Grid x:Name="SettingsPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="基础设置" FontSize="28" FontWeight="Bold" />
                    <TextBlock x:Name="SettingsStatusText"
                               Text="管理本地数据、阅读偏好与设备设置。"
                               FontSize="12"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,0" RowDefinitions="*,Auto" ColumnDefinitions="168,*" ColumnSpacing="26">
                    <StackPanel Grid.RowSpan="2" Spacing="2">
                        <StackPanel x:Name="SettingsCategoryButtons" Spacing="2">
                            <Button x:Name="SettingsLibraryButton"
                                    Classes="settingsCategory active"
                                    Content="书库"
                                    Tag="Library"
                                    Click="SettingsCategoryButton_Click" />
                            <Button x:Name="SettingsReadingButton"
                                    Classes="settingsCategory"
                                    Content="阅读"
                                    Tag="Reading"
                                    Click="SettingsCategoryButton_Click" />
                            <Button x:Name="SettingsCalibreButton"
                                    Classes="settingsCategory"
                                    Content="Calibre"
                                    Tag="Calibre"
                                    Click="SettingsCategoryButton_Click" />
                            <Button x:Name="SettingsKindleButton"
                                    Classes="settingsCategory"
                                    Content="Kindle"
                                    Tag="Kindle"
                                    Click="SettingsCategoryButton_Click" />
                            <Button x:Name="SettingsBackupButton"
                                    Classes="settingsCategory"
                                    Content="备份"
                                    Tag="Backup"
                                    Click="SettingsCategoryButton_Click" />
                            <Button x:Name="SettingsAboutButton"
                                    Classes="settingsCategory"
                                    Content="关于"
                                    Tag="About"
                                    Click="SettingsCategoryButton_Click" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Row="0"
                               Grid.Column="1"
                               Width="1"
                               Height="{Binding Bounds.Height, ElementName=SettingsCategoryButtons}"
                               Margin="0,20,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Fill="{StaticResource HairlineBrush}"
                               IsHitTestVisible="False"
                               ZIndex="1" />

                    <ScrollViewer x:Name="SettingsScrollViewer"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                <Border x:Name="SettingsLibrarySection"
                        Classes="flatPanel"
                        BorderThickness="0"
                        IsVisible="False"
                        Padding="18,18,18,32"
                        Background="{StaticResource PaperBrush}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="书库" FontSize="18" FontWeight="SemiBold" />
                                    <StackPanel Spacing="15">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="允许网络功能" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="NetworkEnabledCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="关闭后豆瓣匹配、Z-Library、邮件发送与工具下载安装等联网功能不可用" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="导入时自动豆瓣匹配" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="AutoDoubanMatchCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="导入完成后自动按书名和作者在豆瓣搜索，置信度高的直接补全评分、简介与封面" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="导入后补齐 EPUB 与 AZW3" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="AutoGenerateReaderFormatsCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="导入后自动为缺失的格式生成 EPUB 与 AZW3 文件" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="收藏夹互斥" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="CollectionsMutuallyExclusiveCheck" Grid.Column="1" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="比较 Kindle 与电脑书库" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="CompareKindleLibraryCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="在书卡角标显示书籍在电脑与 Kindle 上的分布" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="网格画廊显示" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="GridGalleryDisplayCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="网格只显示封面，隐藏标题与作者文字" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                <Border x:Name="SettingsCalibreSection"
                        Classes="flatPanel"
                        BorderThickness="0"
                        IsVisible="False"
                        Padding="18,18,18,32"
                        Background="{StaticResource PaperBrush}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Calibre" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="ebook-convert 用于导入时的格式转换与 Kindle 词典导入；路径留空时自动查找系统中已安装的 Calibre。"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="ebook-convert 路径" FontSize="12" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                <Ellipse x:Name="CalibreDetectionStatusDot"
                                         Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"
                                         Fill="#D6A100"
                                         ToolTip.Tip="未检测到 Calibre"
                                         AutomationProperties.Name="未检测到 Calibre" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="CalibrePathBox" PlaceholderText="留空时自动查找" />
                                <Button Grid.Column="1" Content="浏览" Classes="quiet" Click="BrowseCalibreButton_Click" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button x:Name="InstallCalibreButton"
                                        Content="下载/安装 Calibre"
                                        Classes="quiet"
                                        Click="InstallCalibreButton_Click" />
                                <Button x:Name="InstallKfxInputButton"
                                        Content="安装 KFX Input"
                                        Classes="quiet"
                                        Click="InstallKfxInputButton_Click" />
                            </StackPanel>
                            <ProgressBar x:Name="CalibreSetupProgressBar"
                                         Height="3"
                                         Minimum="0"
                                         Maximum="100"
                                         IsVisible="False" />
                            <TextBlock x:Name="CalibreSetupStatusText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="SettingsKindleSection"
                        Classes="flatPanel"
                        BorderThickness="0"
                        IsVisible="False"
                        Padding="18"
                        Background="{StaticResource PaperBrush}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Kindle" FontSize="18" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,11,0,0">
                                        <TextBlock Text="发现 Kindle 后自动连接" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="AutoConnectDeviceCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="开启后检测到 Kindle 自动连接；关闭时每次询问" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                <Border x:Name="SettingsReadingSection"
                        Classes="flatPanel"
                        BorderThickness="0"
                        IsVisible="False"
                        Padding="18"
                        Background="{StaticResource PaperBrush}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="默认打开格式" FontSize="12" Foreground="{StaticResource MutedInkBrush}" />
                                        <ComboBox x:Name="PreferredOpenFormatBox" SelectedIndex="0" MaxWidth="360" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="EPUB" Tag="epub" />
                                            <ComboBoxItem Content="PDF" Tag="pdf" />
                                            <ComboBoxItem Content="AZW3" Tag="azw3" />
                                            <ComboBoxItem Content="MOBI（转换为 EPUB）" Tag="mobi" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="竖排模式（全局）" FontSize="13" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="DefaultVerticalWritingCheck" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="启用 AI 阅读助手" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="AiEnabledCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="启用阅读器内的 AI 对话与解释" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="False">
                                        <TextBlock Text="笔记批注默认收起" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="ReadingMaterialsCollapsedByDefaultCheck" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                            <Border x:Name="LocalResourcesSettingsSection"
                                    Classes="flatSubsection"
                                    Margin="0,11,0,0"
                                    Padding="0,12,0,0">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="本地字体" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="导入 TTF、OTF、WOFF 或 WOFF2 字体，导入后可作为每本书的阅读排版设置中选择。请自行确认字体许可。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap" />
                                            <ListBox x:Name="ManagedFontList" ItemsSource="{Binding ManagedFonts}" MaxHeight="150" SelectionMode="Single">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="core:ManagedFont">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="导入字体" Click="ImportFontButton_Click" />
                                                <Button Content="移除所选" Classes="quiet" Click="RemoveFontButton_Click" />
                                                <Button Content="刷新" Classes="quiet" IsVisible="False" Click="RefreshLocalResourcesButton_Click" />
                                                <TextBlock x:Name="FontManagementStatusText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                            <Border x:Name="DictionaryManagementSection"
                                    Classes="flatSubsection"
                                    Padding="0,12,0,0">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="本地词典" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="支持 MDX、Kindle 词典（AZW/AZW3/MOBI/KFX）及 UTF-8 文本词典。Kindle 词典导入需要 Calibre，受 DRM 保护的词典无法导入。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap" />
                                            <ListBox x:Name="ManagedDictionaryList" ItemsSource="{Binding ManagedDictionaries}" MaxHeight="150" SelectionMode="Single">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="core:DictionaryDefinition">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="导入词典" Click="ImportDictionaryButton_Click" />
                                                <Button Content="移除所选" Classes="quiet" Click="RemoveDictionaryButton_Click" />
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox x:Name="DictionaryTestBox" PlaceholderText="输入词条测试查询" KeyDown="DictionaryTestBox_KeyDown" />
                                                <Button Grid.Column="1" Content="查询" Classes="quiet" Click="DictionaryTestButton_Click" />
                                            </Grid>
                                            <TextBlock x:Name="DictionaryResultText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                <Border x:Name="SettingsBackupSection"
                        Classes="flatPanel"
                        BorderThickness="0"
                        IsVisible="False"
                        Padding="18"
                        Background="{StaticResource PaperBrush}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="数据备份与迁移" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="一键打包书籍文件、封面、书库信息和阅读记录，生成 .kkindle 备份文件。导入备份会覆盖当前书库；导入前会自动校验备份内容。"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="AI API Key 和 Kindle 邮箱密码不会导出；导入后保留当前设备已有的密钥，没有密钥时需要重新填写。"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="启动时自动备份（每日）" FontSize="13" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="AutoBackupCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="启动时若距上次备份超过 20 小时则自动生成备份" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                                        <TextBlock Text="自动备份保留数量" FontSize="13" VerticalAlignment="Center" />
                                        <NumericUpDown x:Name="AutoBackupRetentionBox" Grid.Column="1" Minimum="1" Maximum="30" Increment="1" Value="5" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="导出备份" Click="ExportBackupButton_Click" />
                                        <Button Content="导入备份" Classes="quiet" Click="ImportBackupButton_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsBackupStatusText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="SettingsAboutSection"
                                        IsVisible="False"
                                        Spacing="16">
                                <Border Classes="flatPanel"
                                        BorderThickness="0"
                                        Padding="18"
                                        Background="{StaticResource PaperBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="本地数据目录" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SettingsDataPathText"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="书籍和阅读记录保存在本机；备份包可以复制到其他设备使用。"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="打开数据目录" Classes="quiet" Click="OpenDataDirectoryButton_Click" />
                                            <Button Content="迁移数据目录" Classes="quiet" Click="MigrateDataDirectoryButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="flatPanel"
                                        BorderThickness="0"
                                        Padding="18"
                                        Background="{StaticResource PaperBrush}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="开发者" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                                <TextBlock Text="kingstacker" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="AboutVersionText"
                                                   Text="版本未知"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="自动检查应用更新" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="AutoUpdateCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="启动后自动检查 GitHub Releases 中的稳定版本" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock x:Name="AboutUpdateStatusText"
                                                       Text="尚未检查更新"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button x:Name="CheckForUpdatesButton"
                                                    Grid.Column="1"
                                                    Content="检查更新"
                                                    Classes="quiet"
                                                    Click="CheckForUpdatesButton_Click" />
                                        </Grid>
                                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <!-- Minimal black-and-white cat: outline, eyes and nose only. -->
                                                <Grid Width="32" Height="30">
                                                    <Polygon Points="4,11 6,2 13,8" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                                    <Polygon Points="19,8 26,2 28,11" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                                    <Ellipse Margin="3,6,3,1" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                                    <Ellipse Width="2.5" Height="3" Margin="9,14,0,0" Fill="{StaticResource InkBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    <Ellipse Width="2.5" Height="3" Margin="0,14,9,0" Fill="{StaticResource InkBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                    <Polygon Points="14,20 18,20 16,22.5" Fill="{StaticResource InkBrush}" />
                                                </Grid>
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="请我喝杯咖啡" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="感谢你的支持" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Width="88"
                                                    Height="88"
                                                    Background="{StaticResource PaperBrush}"
                                                    BorderBrush="{StaticResource InkBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="二维码预留"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- The three system-setting forms are separate right-side panes in
                 the reference UI. Keeping them outside the Kindle category
                 preserves the same navigation flow on Avalonia. -->
            <Border x:Name="KindleEmailSettingsPane"
                    Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,50,20,12">
                        <TextBlock Text="Kindle 邮箱设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,0" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,14" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="通过 SMTP 将 EPUB 或 PDF 发送到你的 Kindle 个人文档邮箱。请把 Kindle 收件地址加入发件邮箱的信任列表；密码建议使用应用专用密码。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <Button Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Focusable="False"
                                    Click="KindleEmailGuideLink_Click">
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource InkBrush}"
                                           TextDecorations="Underline"
                                           Text="配置说明参考：书伴《Kindle 邮箱推送设置》" />
                            </Button>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Kindle 收件邮箱" FontSize="11" />
                                <TextBox x:Name="KindleEmailRecipientBox" PlaceholderText="例如 name@kindle.com" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="发件邮箱" FontSize="11" />
                                <TextBox x:Name="KindleEmailSenderBox" PlaceholderText="例如 you@example.com" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="SMTP 服务器" FontSize="11" />
                                    <TextBox x:Name="KindleEmailSmtpHostBox" PlaceholderText="smtp.example.com" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="端口" FontSize="11" />
                                    <TextBox x:Name="KindleEmailSmtpPortBox" Text="587" PlaceholderText="587" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="SMTP 用户名" FontSize="11" />
                                <TextBox x:Name="KindleEmailUsernameBox" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="SMTP 密码 / 应用专用密码" FontSize="11" />
                                <TextBox x:Name="KindleEmailPasswordBox" PasswordChar="●" PlaceholderText="输入密码或应用专用密码" />
                            </StackPanel>
                            <CheckBox x:Name="KindleEmailSslCheck" Content="使用 SSL/TLS" IsChecked="True" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="20,12,20,20"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock x:Name="KindleEmailSettingsStatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="取消" Classes="quiet" Click="KindleEmailSettingsCancelButton_Click" />
                        <Button Grid.Column="2" Content="保存" Click="KindleEmailSettingsSaveButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ZLibraryAccountPane"
                    Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,50,20,12">
                        <TextBlock Text="Z-Library 账号设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,14" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="使用 Z-Library 账号登录后即可搜索和下载书籍。下载受账号每日额度限制；密码仅加密保存在本机，不会写入备份包。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="Z-Library 账号邮箱" FontSize="11" />
                                <TextBox x:Name="ZLibraryEmailBox" PlaceholderText="例如 name@example.com" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="密码" FontSize="11" />
                                <TextBox x:Name="ZLibraryPasswordBox" PasswordChar="●" PlaceholderText="输入 Z-Library 账号密码" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="API 服务地址" FontSize="11" />
                                <TextBox x:Name="ZLibraryBaseUrlBox" PlaceholderText="https://api.z-lib.org" />
                                <TextBlock Text="默认使用官方 API；域名变更或访问受限时可在此修改为可用的镜像地址。"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="20,12,20,20"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock x:Name="ZLibraryAccountStatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="取消" Classes="quiet" Click="ZLibraryAccountCancelButton_Click" />
                        <Button Grid.Column="2" Content="保存并验证" Click="ZLibraryAccountSaveButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ReaderAiSettingsPane"
                    Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,50,20,12">
                        <TextBlock Text="AI 助手设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,14" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="API Key 使用当前用户加密后保存在本机。DeepSeek、OpenAI 与自定义 OpenAI-compatible 服务均可在此配置。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="服务" FontSize="11" />
                                <ComboBox x:Name="MainReaderAiProviderBox"
                                          SelectedIndex="0"
                                          SelectionChanged="MainReaderAiProviderBox_SelectionChanged">
                                    <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                    <ComboBoxItem Content="OpenAI" Tag="openai" />
                                    <ComboBoxItem Content="自定义 OpenAI-compatible" Tag="custom" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Base URL" FontSize="11" />
                                <TextBox x:Name="MainReaderAiBaseUrlBox" PlaceholderText="https://api.deepseek.com" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="模型" FontSize="11" />
                                <TextBox x:Name="MainReaderAiModelBox" PlaceholderText="模型名称" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="API Key" FontSize="11" />
                                <TextBox x:Name="MainReaderAiApiKeyBox" PasswordChar="●" PlaceholderText="输入 API Key" />
                            </StackPanel>
                            <TextBlock Text="自定义服务可填写本地模型或其他兼容接口；Base URL 应填写到 /v1 或服务根地址。"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="20,12,20,20"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock x:Name="MainReaderAiSettingsStatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="取消" Classes="quiet" Click="MainReaderAiSettingsCancelButton_Click" />
                        <Button Grid.Column="2" Content="保存" Click="MainReaderAiSettingsSaveButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Format conversion progress, anchored bottom-right like the
                 WinUI reference. Tapping the card badge restores this popup;
                 tapping the popup background sends it back to the card. -->
            <Border x:Name="BookConversionPopup"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1"
                    IsVisible="False"
                    ZIndex="80"
                    Tapped="BookConversionPopup_Tapped">
                <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="BookConversionPopupTitleText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock x:Name="BookConversionPopupFormatText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <Button x:Name="BookConversionBackgroundButton"
                                    Classes="quiet"
                                    Content="后台"
                                    Padding="8,4"
                                    Click="BookConversionBackgroundButton_Click" />
                            <Button x:Name="BookConversionCancelButton"
                                    Classes="quiet"
                                    Content="取消"
                                    Padding="8,4"
                                    Click="BookConversionCancelButton_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ProgressBar x:Name="BookConversionPopupProgress"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="10"
                                     VerticalAlignment="Center" />
                        <TextBlock x:Name="BookConversionPopupPercentageText"
                                   Grid.Column="1"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   MinWidth="28"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="BookConversionPopupMessageText"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Unified task progress surface for import/backup/douban/email
                 and other long operations, matching the WinUI reference. -->
            <Border x:Name="TaskProgressPopup"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1"
                    IsVisible="False"
                    ZIndex="75"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="9">
                    <TextBlock Text="任务进度" FontSize="15" FontWeight="SemiBold" />
                    <Border Height="10"
                            Padding="1"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1">
                        <ProgressBar x:Name="TaskProgressPopupBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Background="Transparent"
                                     IsIndeterminate="False" />
                    </Border>
                    <TextBlock x:Name="TaskProgressPopupText"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Transfer toast: the progress surface for Kindle send/export
                 operations. It replaces the generic task popup while active. -->
            <Border x:Name="TransferToast"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1"
                    IsVisible="False"
                    ZIndex="90"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="7">
                    <TextBlock x:Name="TransferToastTitleText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TransferToastMessageText"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="TransferToastProgress"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="5"
                                 Background="{StaticResource PaperBrush}"
                                 IsVisible="False" />
                </StackPanel>
            </Border>

            <!-- Settings feedback capsule: a bottom-center pill for auto-save
                 confirmations ("设置已保存", 1 s) and longer-lived settings
                 notices. It rises into place, then sinks away after a delay;
                 the check glyph only appears for success messages. -->
            <Border x:Name="SettingsSavedCapsule"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,34"
                    Padding="20,9"
                    CornerRadius="999"
                    Background="{StaticResource InkBrush}"
                    BoxShadow="0 6 18 0 #26000000"
                    RenderTransform="translateY(12px)"
                    IsVisible="False"
                    Opacity="0"
                    ZIndex="95"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path x:Name="SettingsCapsuleCheckIcon"
                          Data="M 1,5.5 L 4.5,9 L 11,1.5"
                          Stroke="{StaticResource PaperBrush}"
                          StrokeThickness="2"
                          Width="12"
                          Height="11"
                          Stretch="None"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="SettingsSavedCapsuleText"
                               Foreground="{StaticResource PaperBrush}"
                               FontSize="12"
                               MaxWidth="460"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Device connection confirmation from the WinUI reference. Keep
                 this separate from destructive confirmations so the two
                 actions retain their original labels and keyboard behavior. -->
            <Grid x:Name="DevicePromptOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100"
                  Focusable="True"
                  KeyDown="DevicePromptOverlay_KeyDown">
                <Border Width="560"
                        MaxWidth="560"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10"
                                           Height="24"
                                           Margin="0,-2,0,0"
                                           Fill="{StaticResource InkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DevicePromptTitleText"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DevicePromptMessageText"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="28,18,28,22"
                              Background="{StaticResource PaperBrush}"
                              ColumnDefinitions="*,12,*">
                            <Button x:Name="DevicePromptPrimaryButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DevicePromptPrimaryButton_Click" />
                            <Button x:Name="DevicePromptCancelButton"
                                    Grid.Column="2"
                                    Content="取消"
                                    Classes="quiet"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DevicePromptCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Confirmation overlay -->
            <Grid x:Name="ConfirmationOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="430"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ConfirmationTitleText" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="ConfirmationMessageText" TextWrapping="Wrap" Foreground="#555555" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7" Margin="0,8,0,0">
                            <Button Content="取消" Padding="13,7" Click="ConfirmationCancelButton_Click" />
                            <Button x:Name="ConfirmationOkButton" Content="确认删除" Padding="13,7" Click="ConfirmationOkButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Collection-name overlay -->
            <Grid x:Name="CollectionNameOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="101">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="430"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock Text="新建收藏夹" FontSize="18" FontWeight="Bold" />
                        <TextBox x:Name="CollectionNameBox" PlaceholderText="收藏夹名称" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7" Margin="0,8,0,0">
                            <Button Content="取消" Padding="13,7" Click="CollectionNameCancelButton_Click" />
                            <Button Content="创建" Padding="13,7" Click="CollectionNameOkButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Device model editor opened from the lower-left Kindle card. -->
            <Grid x:Name="DeviceModelInputOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100">
                <Border Width="560"
                        MaxWidth="560"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10"
                                           Height="24"
                                           Margin="0,-2,0,0"
                                           Fill="{StaticResource InkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DeviceModelInputTitleText"
                                           Text="自定义设备型号"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceModelInputMessageText"
                                       Text="输入该设备的型号名称，下次连接时会按 USB 串码自动匹配。"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                            <TextBox x:Name="DeviceModelInputBox"
                                     FontSize="15"
                                     Padding="10,7"
                                     MaxLength="80"
                                     PlaceholderText="例如 Kindle Paperwhite 11 代"
                                     KeyDown="DeviceModelInputBox_KeyDown" />
                            <TextBlock x:Name="DeviceModelInputStatusText"
                                       IsVisible="False"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="28,18,28,22"
                              Background="{StaticResource PaperBrush}"
                              ColumnDefinitions="*,12,*">
                            <Button x:Name="DeviceModelInputOkButton"
                                    Content="确定"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DeviceModelInputOkButton_Click" />
                            <Button Grid.Column="2"
                                    Content="取消"
                                    Classes="quiet"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DeviceModelInputCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Douban candidate picker: keep the old version's explicit
                 choice instead of silently applying the first search hit. -->
            <Grid x:Name="DoubanCandidateOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="102">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="760"
                        MaxHeight="680"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                        <TextBlock Text="选择豆瓣条目" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1"
                                   Text="请选择与当前书籍匹配的结果；没有合适的条目时，可修改关键词后重新搜索。"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="DoubanSearchBox"
                                     PlaceholderText="书名 / 作者关键词"
                                     KeyDown="DoubanSearchBox_KeyDown" />
                            <Button x:Name="DoubanResearchButton"
                                    Grid.Column="1"
                                    Content="搜索"
                                    MinWidth="72"
                                    Padding="13,7"
                                    Click="DoubanResearchButton_Click" />
                        </Grid>
                        <ListBox x:Name="DoubanCandidateList"
                                 Grid.Row="3"
                                 ItemsSource="{Binding DoubanCandidates}"
                                 SelectionChanged="DoubanCandidateList_SelectionChanged"
                                 DoubleTapped="DoubanCandidateList_DoubleTapped"
                                 Background="Transparent"
                                 BorderBrush="{StaticResource HairlineBrush}"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:DoubanCandidateViewModel">
                                    <Border Padding="12,10"
                                            Margin="0,0,0,8"
                                            Background="{StaticResource PaperBrush}"
                                            BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="14">
                                            <Border Width="68"
                                                    Height="96"
                                                    Background="#E4E4E4"
                                                    BorderBrush="{StaticResource HairlineBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="BOOK"
                                                               FontSize="9"
                                                               Foreground="{StaticResource MutedInkBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           MaxLines="2"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Abstract}"
                                                           FontSize="11"
                                                           Foreground="#505050"
                                                           MaxLines="3"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SubjectText}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    MinWidth="92"
                                                    Padding="9,6"
                                                    Background="{StaticResource InkBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RatingText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource PaperBrush}"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <Button Grid.Column="1"
                                    Content="取消"
                                    Classes="quiet"
                                    MinWidth="72"
                                    Padding="13,7"
                                    Click="DoubanCandidateCancelButton_Click" />
                            <Button x:Name="DoubanCandidateSourceButton"
                                    Grid.Column="2"
                                    Content="打开豆瓣来源"
                                    Classes="quiet"
                                    MinWidth="116"
                                    Padding="13,7"
                                    IsEnabled="False"
                                    Click="DoubanCandidateSourceButton_Click" />
                            <Button x:Name="DoubanCandidateApplyButton"
                                    Grid.Column="3"
                                    Content="查看详情"
                                    MinWidth="92"
                                    Padding="13,7"
                                    IsEnabled="False"
                                    Click="DoubanCandidateApplyButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Douban metadata preview: shows the fetched details and lets the
                 user choose which fields are written back, with a back button
                 to return to the candidate list (WinUI reference flow). -->
            <Grid x:Name="DoubanPreviewOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="102"
                  Focusable="True"
                  KeyDown="DoubanPreviewOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="720"
                        MaxHeight="660"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10"
                                       Height="24"
                                       Fill="{StaticResource InkBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="确认豆瓣匹配结果" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="核对书籍信息并选择需要写入本地书库的字段；未勾选的本地字段不会被修改。"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Grid.Row="2" ColumnDefinitions="104,*" ColumnSpacing="14" Margin="0,4,0,2">
                            <Border Width="96" Height="132" HorizontalAlignment="Left" Background="#E4E4E4" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="BOOK"
                                               FontSize="9"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image x:Name="DoubanPreviewCoverImage" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Column="1" MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="DoubanPreviewSummaryText"
                                           FontSize="12"
                                           LineHeight="20"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      BorderBrush="{StaticResource HairlineBrush}"
                                      BorderThickness="1"
                                      Padding="12,8">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="DoubanUpdateTitleCheck" Content="更新书名" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateAuthorsCheck" Content="更新作者" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateSeriesCheck" Content="更新系列（丛书）" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateDescriptionCheck" Content="更新简介" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdatePublicationCheck" Content="更新出版信息（出版社、出版年、ISBN、页数、装帧、评分）" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateCoverCheck" Content="下载并更新封面" FontSize="13" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                            <TextBlock x:Name="DoubanPreviewStatusText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="DoubanPreviewSourceButton"
                                    Grid.Column="1"
                                    Content="打开豆瓣来源"
                                    Classes="quiet"
                                    Padding="13,7"
                                    Click="DoubanPreviewSourceButton_Click" />
                            <Button x:Name="DoubanPreviewBackButton"
                                    Grid.Column="2"
                                    Content="返回候选列表"
                                    Classes="quiet"
                                    Padding="13,7"
                                    Click="DoubanPreviewBackButton_Click" />
                            <Button x:Name="DoubanPreviewApplyButton"
                                    Grid.Column="3"
                                    Content="应用所选字段"
                                    Padding="13,7"
                                    Click="DoubanPreviewApplyButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ImportFormatSelectionOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="105"
                  Focusable="True"
                  KeyDown="ImportFormatSelectionOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="620"
                        MaxHeight="650"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10" Height="24" Fill="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="导入书籍 · 选择格式补齐" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ImportFormatSelectionSummaryText" FontSize="14" TextWrapping="Wrap" />
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ImportFormatSelectionList" Spacing="10" />
                            </ScrollViewer>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="28,18,28,22" ColumnDefinitions="*,12,*">
                            <Button Content="导入" HorizontalAlignment="Stretch" Click="ImportFormatSelectionPrimaryButton_Click" />
                            <Button Grid.Column="2" Content="取消" Classes="quiet" HorizontalAlignment="Stretch" Click="ImportFormatSelectionCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Fully custom monochrome message dialog; replaces the WinUI
                 ShowMessageAsync flow. -->
            <Grid x:Name="MessageOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="110"
                  Focusable="True"
                  KeyDown="MessageOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="560"
                        MaxWidth="560"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10"
                                           Height="24"
                                           Margin="0,-2,0,0"
                                           Fill="{StaticResource InkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="MessageTitleText"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="MessageBodyText"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="28,18,28,22"
                              Background="{StaticResource PaperBrush}">
                            <Button x:Name="MessageOkButton"
                                    Content="知道了"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="MessageOkButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
        <!-- Stage 4: the EPUB reader surface. Two native webview hosts
             stay attached so the next chapter can be prepared offscreen.
             Layout mirrors the WinUI reference: three fixed columns
             (TOC 286 / content * / assistant 360), a 52-DIP header bar and
             50-DIP footer bar inside the content column, and a six-row TOC
             panel ending in the full-width 返回书架 button. -->
        <Grid x:Name="ReaderRoot"
              Classes="readerShell"
              Grid.Row="0"
              Grid.ColumnSpan="3"
              IsVisible="False"
              Margin="0"
              ZIndex="40"
              Background="{StaticResource PaperBrush}"
              PointerMoved="ReaderRoot_PointerMoved">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Opaque transition cover used when leaving zen mode: the reader
                 pane sits above the library, so fading the pane itself would
                 reveal the bookshelf behind it. This cover hides the layout
                 restore/window resize instead and is faded away afterwards. -->
            <Border x:Name="ReaderTransitionCover"
                    Grid.ColumnSpan="3"
                    Background="{StaticResource PaperBrush}"
                    Opacity="0"
                    IsHitTestVisible="False"
                    ZIndex="200" />

            <!-- Table of contents and reading progress. -->
            <Border x:Name="ReaderTocPanel"
                    Grid.Column="0"
                    Margin="0,38,0,0"
                    Background="#FFFFFF">
                <Border.Resources>
                    <!-- Softer, quieter scrollbar for the TOC so the side
                         panel stays out of the reading flow (WinUI values). -->
                    <SolidColorBrush x:Key="KkindleScrollBarBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="KkindleScrollBarExpandedBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="KkindleScrollBarBorderBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbBrush" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbPointerOverBrush" Color="#B4B4B0" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbPressedBrush" Color="#A4A4A0" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbDisabledBrush" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#777777" />
                </Border.Resources>
                <Grid RowDefinitions="52,Auto,Auto,*,Auto,50">
                    <!-- Start the divider below the shared header rule. Keep it
                         above search content so it remains continuous. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="5"
                               Width="1"
                               HorizontalAlignment="Right"
                               Fill="#EEEEEA"
                               IsHitTestVisible="False"
                               ZIndex="100" />

                    <Border Padding="14,8"
                            BorderBrush="#EEEEEA"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                            <TextBlock x:Name="ReaderBookInfoText"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        <Button x:Name="ReaderTocMinimalToggleButton"
                                Grid.Column="1"
                                Classes="icon"
                                Width="38"
                                MinWidth="38"
                                Height="34"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="切换极简目录"
                                ToolTip.Tip="切换极简目录"
                                Click="ReaderTocMinimalToggleButton_Click">
                            <Path Width="13"
                                  Height="13"
                                  Data="M 1.5,1.5 H 11.5 V 11.5 H 1.5 Z M 3.2,4 H 9.8 M 3.2,6.5 H 9.8 M 3.2,9 H 9.8"
                                  Stroke="#242424"
                                  StrokeThickness="0.85"
                                  StrokeLineCap="Square"
                                  StrokeJoin="Miter"
                                  IsHitTestVisible="False" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="icon"
                                Width="38"
                                MinWidth="38"
                                Height="34"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="收起目录"
                                ToolTip.Tip="收起目录"
                                Click="ReaderTocButton_Click">
                            <Path Width="12"
                                  Height="12"
                                  Data="M 3,1.5 L 9,6 L 3,10.5"
                                  Stroke="#242424"
                                  StrokeThickness="0.85"
                                  StrokeLineCap="Square"
                                  StrokeJoin="Miter"
                                  IsHitTestVisible="False" />
                        </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid x:Name="ReaderTocView">
                            <ListBox x:Name="ReaderTocList"
                                     Classes="readerTocList"
                                     Background="#FFFFFF"
                                     SelectionChanged="ReaderTocList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="infra:EpubReaderNavigationItem">
                                        <Grid ColumnDefinitions="3,*">
                                            <Rectangle Fill="#5E5E5E"
                                                       IsVisible="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="13,9,11,9"
                                                       Text="{Binding Title}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ReaderTocEmptyText"
                                       Margin="20"
                                       Text="此文档没有可用目录。"
                                       FontSize="12"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="False" />
                        </Grid>

                        <Grid x:Name="ReaderBookmarkPane"
                              Background="#FFFFFF"
                              IsVisible="False">
                            <ListBox x:Name="ReaderBookmarkList"
                                     Classes="readerTocList"
                                     Background="#FFFFFF"
                                     ItemsSource="{Binding ReaderBookmarks}"
                                     SelectionMode="Single"
                                     SelectionChanged="ReaderBookmarkList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:ReaderBookmark">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                            <StackPanel Grid.Column="0" Margin="12,7,4,7" Spacing="3">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34" />
                                                <TextBlock Text="{Binding DisplayQuote}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34" />
                                                <TextBlock Text="{Binding DisplayTime}"
                                                           FontSize="9" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="icon"
                                                    Width="28"
                                                    MinWidth="28"
                                                    Height="28"
                                                    Margin="0,0,6,0"
                                                    Content="×"
                                                    Tag="{Binding}"
                                                    Click="ReaderBookmarkDeleteButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ReaderBookmarkEmptyText"
                                       Margin="20"
                                       Text="还没有书签。"
                                       FontSize="12"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Whole-book search reuses the normal TOC surface. -->
                        <Grid x:Name="ReaderSearchPanel" IsVisible="False">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <TextBox x:Name="ReaderTocSearchBox"
                                         Margin="14,4,14,10"
                                         Height="34"
                                         Padding="10,5"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="搜索整本书…"
                                         TextChanged="ReaderTocSearchBox_TextChanged" />
                                <TextBlock x:Name="ReaderWholeSearchCountText"
                                           Grid.Row="1"
                                           Margin="14,0,14,8"
                                           FontSize="10"
                                           Foreground="#5E5E5E" />
                                <Grid Grid.Row="2">
                                    <ScrollViewer Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ReaderSearchResultList"
                                                      ItemsSource="{Binding ReaderSearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ReaderSearchResultViewModel">
                                                    <Button Classes="readerSearchResult"
                                                            Margin="0,0,14,6"
                                                            Padding="0"
                                                            BorderBrush="{Binding ResultBorderBrush}"
                                                            BorderThickness="{Binding ResultBorderThickness}"
                                                            Background="#FFFFFF"
                                                            Tag="{Binding}"
                                                            Click="ReaderSearchResultButton_Click">
                                                        <Border Padding="14,9,14,9">
                                                            <StackPanel Spacing="3"
                                                                        HorizontalAlignment="Stretch">
                                                            <local:ReaderSearchHighlightTextBlock Source="{Binding Title}"
                                                                                                  Query="{Binding Query}"
                                                                                                  FontSize="12"
                                                                                                  FontWeight="SemiBold"
                                                                                                  TextWrapping="Wrap"
                                                                                                  TextTrimming="CharacterEllipsis"
                                                                                                  MaxLines="2" />
                                                            <local:ReaderSearchHighlightTextBlock Source="{Binding Excerpt}"
                                                                                                  Query="{Binding Query}"
                                                                                                  HighlightRanges="{Binding ExcerptHighlightRanges}"
                                                                                                  FontSize="10"
                                                                                                  LineHeight="15"
                                                                                                  TextWrapping="Wrap"
                                                                                                  TextTrimming="CharacterEllipsis"
                                                                                                  MaxLines="4" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="ReaderSearchStatusText"
                                               Margin="20"
                                               Text="输入关键词，实时搜索整本书。"
                                               TextAlignment="Center"
                                               FontSize="11"
                                               Foreground="#5E5E5E"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="ReaderReadingInfoPanel"
                                Grid.Row="4"
                                Margin="14,4,14,8"
                                Spacing="2">
                        <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                            <TextBlock x:Name="ReaderReadingProgressText"
                                       Text="准备阅读"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="ReaderProgressPercentText"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock x:Name="ReaderStatsText"
                                   FontSize="10"
                                   Foreground="#5E5E5E"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="5"
                            BorderBrush="#E2E2DE"
                            BorderThickness="1"
                            CornerRadius="0">
                        <Button Content="返回书架"
                                Margin="0"
                                Height="48"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                Classes="readerToolbar"
                                Click="CloseReaderButton_Click" />
                    </Border>
                </Grid>
            </Border>

            <!-- Minimal TOC rail (极简目录): a 52-DIP marker rail that keeps the
                 chapter map visible without taking the reading column away. -->
            <Border x:Name="ReaderTocCompactPanel"
                    Grid.Column="0"
                    Width="52"
                    Margin="0,38,0,0"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="#D8D8D4"
                    BorderThickness="0,0,1,0"
                    Loaded="ReaderTocCompactPanel_Loaded"
                    IsVisible="False">
                <Grid RowDefinitions="52,*,50">
                    <Grid Grid.Row="0"
                          Width="28"
                          HorizontalAlignment="Center"
                          RowDefinitions="34,18">
                        <Button x:Name="ReaderTocCompactExpandButton"
                                Grid.Row="0"
                                Classes="icon"
                                Width="28"
                                MinWidth="28"
                                Height="34"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="展开完整目录"
                                ToolTip.Tip="展开完整目录"
                                Click="ReaderTocCompactExpandButton_Click">
                            <Path Width="13"
                                  Height="13"
                                  Data="M 1.5,1.5 H 11.5 V 11.5 H 1.5 Z M 3.2,4 H 9.8 M 3.2,6.5 H 9.8 M 3.2,9 H 9.8"
                                  Stroke="#242424"
                                  StrokeThickness="0.85"
                                  StrokeLineCap="Square"
                                  StrokeJoin="Miter"
                                  IsHitTestVisible="False" />
                        </Button>
                        <TextBlock x:Name="ReaderTocCompactUpIndicator"
                                   Grid.Row="1"
                                   Text="△"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer x:Name="ReaderTocCompactScrollViewer"
                                  Grid.Row="1"
                                  HorizontalContentAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="0,8"
                                  ScrollChanged="ReaderTocCompactScrollViewer_ScrollChanged"
                                  PointerMoved="ReaderTocCompactScrollViewer_PointerMoved"
                                  PointerExited="ReaderTocCompactScrollViewer_PointerExited"
                                  PointerWheelChanged="ReaderTocCompactScrollViewer_PointerWheelChanged">
                        <ItemsControl x:Name="ReaderTocCompactList"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ReaderTocMarker">
                                    <Button Width="50"
                                            Height="10"
                                            MinWidth="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="{Binding Title}"
                                            IsTabStop="False">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalContentAlignment="Center"
                                                                  VerticalContentAlignment="Center" />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Border Width="8"
                                                Height="2"
                                                Background="{Binding Fill}"
                                                BorderThickness="0"
                                                IsHitTestVisible="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="ReaderTocCompactDownIndicator"
                               Grid.Row="2"
                               Text="▽"
                               FontFamily="Segoe UI Symbol"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Reading canvas and compact controls. -->
            <Grid x:Name="ReaderContentPanel"
                  Grid.Column="1"
                  Margin="0,38,0,0"
                  Background="{StaticResource PaperBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Border x:Name="ReaderHeaderBar"
                        BorderBrush="#E2E2DE"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="ReaderTocToggleButton"
                                    Classes="readerHeader"
                                    Content="目录"
                                    Width="64"
                                    ToolTip.Tip="显示或隐藏目录"
                                    Click="ReaderTocButton_Click" />
                            <Button x:Name="ReaderSearchToolbarButton"
                                    Classes="readerHeader"
                                    Content="搜索"
                                    AutomationProperties.Name="书内搜索"
                                    ToolTip.Tip="搜索整本书（Ctrl+F）"
                                    Click="ReaderSearchToolbarButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ReaderStatusText"
                                   Grid.Column="1"
                                   Margin="4,0"
                                   FontSize="10"
                                   Foreground="#858585"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <ScrollViewer Grid.Column="2"
                                      MaxWidth="920"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Button x:Name="ReaderZoomOutButton"
                                        Classes="readerHeaderIcon"
                                        Content="A−"
                                        ToolTip.Tip="减小字号"
                                        AutomationProperties.Name="减小字号"
                                        Click="ReaderDecreaseFontButton_Click" />
                                <TextBlock x:Name="ReaderZoomText"
                                           Width="44"
                                           Text="100%"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ReaderZoomInButton"
                                        Classes="readerHeaderIcon"
                                        Content="A+"
                                        ToolTip.Tip="增大字号"
                                        AutomationProperties.Name="增大字号"
                                        Click="ReaderIncreaseFontButton_Click" />
                                <Rectangle Width="1" Height="20" Margin="12,0" Fill="#E2E2DE" VerticalAlignment="Center" />
                                <Button x:Name="ReaderFlowButton"
                                        Classes="readerHeader"
                                        Content="分页"
                                        ToolTip.Tip="选择滚动、单页或双栏阅读模式"
                                        AutomationProperties.Name="选择阅读分页模式">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem x:Name="ReaderScrollModeItem"
                                                      Header="滚动"
                                                      ToggleType="Radio"
                                                      IsChecked="True"
                                                      Tag="scroll"
                                                      Click="ReaderFlowModeItem_Click" />
                                            <MenuItem x:Name="ReaderSinglePageModeItem"
                                                      Header="单页"
                                                      ToggleType="Radio"
                                                      Tag="single"
                                                      Click="ReaderFlowModeItem_Click" />
                                            <MenuItem x:Name="ReaderTwoPageModeItem"
                                                      Header="双栏"
                                                      ToggleType="Radio"
                                                      Tag="double"
                                                      Click="ReaderFlowModeItem_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="ReaderMoreButton"
                                        Classes="readerHeader"
                                        Content="更多"
                                        ToolTip.Tip="阅读设置"
                                        AutomationProperties.Name="阅读设置">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem x:Name="ReaderZenMenuItem"
                                                      Header="禅模式"
                                                      ToggleType="CheckBox"
                                                      ToolTip.Tip="隐藏目录与阅读助手，最大化正文区域"
                                                      Click="ReaderZenMenuItem_Click" />
                                            <MenuItem Header="阅读排版设置"
                                                      ToolTip.Tip="字号、行距、正文宽度、字体与竖排"
                                                      Click="ReaderLayoutSettingsMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="翻页动画">
                                                <MenuItem x:Name="ReaderAnimationNoneItem"
                                                          Header="无动画"
                                                          ToggleType="Radio"
                                                          Tag="none"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationFadeItem"
                                                          Header="淡入淡出"
                                                          ToggleType="Radio"
                                                          IsChecked="True"
                                                          Tag="fade"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationSlideItem"
                                                          Header="左右滑动"
                                                          ToggleType="Radio"
                                                          Tag="slide"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationWaveItem"
                                                          Header="电子墨水刷新"
                                                          ToggleType="Radio"
                                                          Tag="wave"
                                                          Click="ReaderAnimationItem_Click" />
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="ReaderBookmarkButton"
                                        Classes="readerHeader"
                                        Content="书签"
                                        AutomationProperties.Name="打开书签详情"
                                        ToolTip.Tip="打开书签详情"
                                        Click="ReaderBookmarkButton_Click" />
                                <Rectangle Width="1" Height="20" Margin="12,0" Fill="#E2E2DE" VerticalAlignment="Center" />
                                <Button x:Name="ReaderAssistantToggleButton"
                                        Classes="readerHeader"
                                        Content="助手"
                                        ToolTip.Tip="显示或隐藏阅读助手"
                                        Click="ReaderAssistantToggleButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="{StaticResource PaperBrush}">
                    <Grid x:Name="ReaderWebViewHost"
                          Margin="0,12,2,10"
                          Background="{StaticResource PaperBrush}"
                          SizeChanged="ReaderWebViewHost_SizeChanged">
                        <ContentControl x:Name="ReaderActiveHostSlot"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                        <ContentControl x:Name="ReaderPreloadHostSlot"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </Grid>

                    <Border x:Name="ReaderLinuxTextFallbackOverlay"
                            Margin="0,12,2,10"
                            Background="{StaticResource PaperBrush}"
                            IsVisible="False"
                            Focusable="True"
                            Tapped="ReaderLinuxTextFallback_Tapped"
                            PointerMoved="ReaderLinuxTextFallback_PointerMoved"
                            PointerWheelChanged="ReaderLinuxTextFallback_PointerWheelChanged"
                            KeyDown="ReaderLinuxTextFallback_KeyDown"
                            ZIndex="25">
                        <Grid x:Name="ReaderLinuxTextFallbackContent">
                            <ScrollViewer x:Name="ReaderLinuxTextFallbackScroll"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="24,18"
                                          ScrollChanged="ReaderLinuxTextFallbackScroll_ScrollChanged">
                                <StackPanel Spacing="0">
                                    <SelectableTextBlock x:Name="ReaderLinuxTextFallbackText"
                                                        IsVisible="False" />
                                    <ItemsControl ItemsSource="{Binding ReaderLinuxTextFallbackBlocks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="{Binding DisplayMargin}">
                                                    <Grid>
                                                        <local:ReaderLinuxTextFallbackTextBlock Block="{Binding}"
                                                                                                  IsVisible="{Binding IsText}"
                                                                                                  FontFamily="{StaticResource DefaultAppFontFamily}"
                                                                                                  FontSize="{Binding FontSize}"
                                                                                                  LineHeight="{Binding LineHeight}"
                                                                                                  MaxWidth="{Binding MaxWidth}"
                                                                                                  Width="{Binding Width}"
                                                                                                  Foreground="{StaticResource InkBrush}"
                                                                                                  SelectionBrush="#C9C9C9"
                                                                                                  AnnotationRanges="{Binding AnnotationRanges}"
                                                                                                  InvertedSelectionBackground="{StaticResource InkBrush}"
                                                                                                  InvertedSelectionForeground="{StaticResource PaperBrush}"
                                                                                                  TextWrapping="Wrap"
                                                                                                  HorizontalAlignment="Center"
                                                                                                  PointerReleased="ReaderLinuxTextFallback_ContentPointerReleased"
                                                                                                  FootnotePointerEntered="ReaderLinuxTextFallbackFootnoteButton_PointerEntered"
                                                                                                  FootnotePointerExited="ReaderLinuxTextFallbackFootnoteButton_PointerExited" />
                                                        <Image Source="{Binding Image.Source}"
                                                               IsVisible="{Binding IsImage}"
                                                               MaxWidth="{Binding Image.MaxWidth}"
                                                               MaxHeight="{Binding Image.MaxHeight}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="ReaderLinuxTextFallbackPagedRoot"
                                    IsVisible="False"
                                    Padding="24,18">
                                <Grid x:Name="ReaderLinuxTextFallbackPagedContent"
                                      ColumnDefinitions="*,28,*">
                                    <Image x:Name="ReaderLinuxTextFallbackPageImageLeft"
                                           Grid.Column="0"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="False" />
                                    <local:ReaderLinuxTextFallbackTextBlock x:Name="ReaderLinuxTextFallbackPageLeft"
                                                        Grid.Column="0"
                                                        FontFamily="{StaticResource DefaultAppFontFamily}"
                                                        Foreground="{StaticResource InkBrush}"
                                                        SelectionBrush="#C9C9C9"
                                                        InvertedSelectionBackground="{StaticResource InkBrush}"
                                                        InvertedSelectionForeground="{StaticResource PaperBrush}"
                                                        TextAlignment="Left"
                                                        TextWrapping="Wrap"
                                                        HorizontalAlignment="Stretch"
                                                        PointerReleased="ReaderLinuxTextFallback_ContentPointerReleased" />
                                    <Button x:Name="ReaderLinuxTextFallbackPageFootnoteLeft"
                                            Grid.Column="0"
                                            Classes="readerFootnoteMarker"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="False"
                                            PointerEntered="ReaderLinuxTextFallbackFootnoteButton_PointerEntered"
                                            PointerExited="ReaderLinuxTextFallbackFootnoteButton_PointerExited" />
                                    <Image x:Name="ReaderLinuxTextFallbackPageImageRight"
                                           Grid.Column="2"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="False" />
                                    <local:ReaderLinuxTextFallbackTextBlock x:Name="ReaderLinuxTextFallbackPageRight"
                                                        Grid.Column="2"
                                                        FontFamily="{StaticResource DefaultAppFontFamily}"
                                                        Foreground="{StaticResource InkBrush}"
                                                        SelectionBrush="#C9C9C9"
                                                        InvertedSelectionBackground="{StaticResource InkBrush}"
                                                        InvertedSelectionForeground="{StaticResource PaperBrush}"
                                                        TextAlignment="Left"
                                                        TextWrapping="Wrap"
                                                        HorizontalAlignment="Stretch"
                                                        IsVisible="False"
                                                        PointerReleased="ReaderLinuxTextFallback_ContentPointerReleased" />
                                    <Button x:Name="ReaderLinuxTextFallbackPageFootnoteRight"
                                            Grid.Column="2"
                                            Classes="readerFootnoteMarker"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="False"
                                            PointerEntered="ReaderLinuxTextFallbackFootnoteButton_PointerEntered"
                                            PointerExited="ReaderLinuxTextFallbackFootnoteButton_PointerExited" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Native webviews paint over child Avalonia content. Keep
                         these decorations as later siblings so they render on
                         top of the active reading surface, matching WinUI. -->
                    <Border x:Name="ReaderWebViewBottomCover"
                            Height="2"
                            Margin="0,0,0,10"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource PaperBrush}"
                            IsHitTestVisible="False"
                            ZIndex="30" />
                    <Border x:Name="ReaderBookmarkCornerButton"
                            Width="34"
                            Height="34"
                            Margin="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ZIndex="40"
                            AutomationProperties.Name="添加或取消当前位置书签"
                            ToolTip.Tip="添加或取消当前位置书签"
                            Cursor="Hand"
                            IsVisible="False"
                            PointerPressed="ReaderBookmarkCornerButton_PointerPressed">
                        <Path x:Name="ReaderBookmarkCornerMarker"
                              Width="26"
                              Height="26"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Data="M 0,0 L 26,0 L 26,26 Z"
                              Fill="#000000"
                              Stretch="None"
                              IsHitTestVisible="False"
                              IsVisible="False" />
                    </Border>

                    <!-- This must remain a sibling after the native WebView
                         slots. Native child windows paint over Avalonia
                         children, so an in-page search bar nested inside
                         ReaderWebViewHost is not reliably visible/clickable. -->
                    <Border x:Name="ReaderInPageSearchBar"
                            Width="430"
                            Padding="10,8"
                            Margin="0,16,24,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="#000000"
                            BorderThickness="1"
                            IsVisible="False"
                            ZIndex="45">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <TextBox x:Name="ReaderInPageSearchBox"
                                     Height="32"
                                     Padding="8,4"
                                     PlaceholderText="查找当前正文…"
                                     TextChanged="ReaderInPageSearchBox_TextChanged"
                                     KeyDown="ReaderInPageSearchBox_KeyDown" />
                            <TextBlock x:Name="ReaderInPageSearchCountText"
                                       Grid.Column="1"
                                       MinWidth="48"
                                       Text="0/0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="icon" Width="32" MinWidth="32" Height="32" Content="↑" Click="ReaderInPageSearchPreviousButton_Click" />
                            <Button Grid.Column="3" Classes="icon" Width="32" MinWidth="32" Height="32" Content="↓" Click="ReaderInPageSearchNextButton_Click" />
                            <Button Grid.Column="4" Classes="icon" Width="32" MinWidth="32" Height="32" Content="×" Click="ReaderInPageSearchCloseButton_Click" />
                        </Grid>
                    </Border>

                    <!-- Slim floating bar shown only in zen mode. -->
                    <Border x:Name="ReaderZenBar"
                            Padding="2,2,2,2"
                            Margin="0,16,24,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="#000000"
                            BorderThickness="1"
                            IsVisible="False"
                            ZIndex="70">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="禅模式"
                                       Margin="10,0,2,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ReaderZenTocButton"
                                    Classes="readerToolbar"
                                    Content="极简目录"
                                    ToolTip.Tip="显示或隐藏极简目录"
                                    Click="ReaderZenMinimalTocButton_Click" />
                            <Button x:Name="ReaderExitZenButton"
                                    Classes="readerToolbar"
                                    Content="退出禅模式"
                                    ToolTip.Tip="退出禅模式，恢复目录与阅读助手"
                                    Click="ReaderExitZenButton_Click" />
                            <Button x:Name="ReaderZenCloseButton"
                                    Classes="icon"
                                    Content="×"
                                    FontSize="15"
                                    AutomationProperties.Name="关闭阅读器"
                                    ToolTip.Tip="返回书架"
                                    Click="CloseReaderButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="ReaderFooterBar"
                        Grid.Row="2"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#E2E2DE"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="14,4" ColumnDefinitions="34,34,*,Auto,Auto" ColumnSpacing="10">
                        <Button x:Name="ReaderPreviousButton"
                                Classes="readerToolbar"
                                Content="‹"
                                FontSize="16"
                                Width="34"
                                Height="30"
                                AutomationProperties.Name="上一章"
                                ToolTip.Tip="上一章"
                                Click="ReaderPreviousButton_Click" />
                        <Button x:Name="ReaderNextButton"
                                Grid.Column="1"
                                Classes="readerToolbar"
                                Content="›"
                                FontSize="16"
                                Width="34"
                                Height="30"
                                AutomationProperties.Name="下一章"
                                ToolTip.Tip="下一章"
                                Click="ReaderNextButton_Click" />
                        <Slider x:Name="ReaderProgressSlider"
                                Grid.Column="2"
                                Classes="noAutoToolTip"
                                Margin="6,0,14,0"
                                MinWidth="120"
                                Minimum="1"
                                Maximum="1"
                                Value="1"
                                VerticalAlignment="Center"
                                Loaded="ReaderProgressSlider_Loaded"
                                ValueChanged="ReaderProgressSlider_ValueChanged"
                                PointerPressed="ReaderProgressSlider_PointerPressed"
                                PointerMoved="ReaderProgressSlider_PointerMoved"
                                PointerReleased="ReaderProgressSlider_PointerReleased"
                                PointerExited="ReaderProgressSlider_PointerExited">
                            <Slider.Resources>
                                <CornerRadius x:Key="SliderThumbCornerRadius">999</CornerRadius>
                            </Slider.Resources>
                            <Slider.Styles>
                                <Style Selector="Slider /template/ Thumb">
                                    <Setter Property="Width" Value="12" />
                                    <Setter Property="Height" Value="12" />
                                    <Setter Property="MinWidth" Value="12" />
                                    <Setter Property="MinHeight" Value="12" />
                                    <Setter Property="MaxWidth" Value="12" />
                                    <Setter Property="MaxHeight" Value="12" />
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Slider.Styles>
                        </Slider>
                        <TextBlock x:Name="ReaderChapterText"
                                   Grid.Column="4"
                                   MinWidth="44"
                                   FontSize="11"
                                   Foreground="#5E5E5E"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Border x:Name="ReaderPdfBadge"
                                Grid.Column="3"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="#F2F2F0"
                                BorderBrush="#D5D5D1"
                                BorderThickness="1">
                            <TextBlock x:Name="ReaderPdfBottomText"
                                       Text="PDF"
                                       FontSize="9"
                                       Foreground="#5E5E5E" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- AI conversation and persistent annotations. -->
            <Border x:Name="ReaderAssistantPanel"
                    Grid.Column="2"
                    Margin="0,38,0,0"
                    IsVisible="False"
                    Background="{StaticResource PaperBrush}">
                <Grid RowDefinitions="52,42,*,Auto">
                    <!-- Long separator below the assistant header. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="3"
                               Width="1"
                               HorizontalAlignment="Left"
                               Fill="#EEEEEA"
                               IsHitTestVisible="False" />

                    <Border Background="{StaticResource PaperBrush}"
                            BorderBrush="#EEEEEA"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="14,8" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="AI 助手" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ReaderAiProviderText"
                                           Text="DeepSeek · 未配置"
                                           FontSize="9"
                                           MaxWidth="150"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon"
                                    Width="38"
                                    MinWidth="38"
                                    Height="34"
                                    AutomationProperties.Name="收起阅读助手"
                                    ToolTip.Tip="收起阅读助手"
                                    Click="ReaderAssistantToggleButton_Click">
                                <Path Width="12"
                                      Height="12"
                                      Data="M 9,1.5 L 3,6 L 9,10.5"
                                      Stroke="{StaticResource InkBrush}"
                                      StrokeThickness="1.35"
                                      StrokeLineCap="Square"
                                      StrokeJoin="Miter"
                                      IsHitTestVisible="False" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="18,2,18,0" ColumnSpacing="12">
                        <Button x:Name="ReaderAiTabButton"
                                Classes="readerAssistantTab active"
                                Content="AI 对话"
                                HorizontalAlignment="Stretch"
                                Click="ReaderAiTabButton_Click" />
                        <Button x:Name="ReaderNotesTabButton"
                                Grid.Column="1"
                                Classes="readerAssistantTab"
                                Content="划线与笔记"
                                HorizontalAlignment="Stretch"
                                Click="ReaderNotesTabButton_Click" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid x:Name="ReaderAiView">
                            <ScrollViewer x:Name="ReaderAiScrollViewer" Padding="20,18,20,22" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="18">
                                    <StackPanel x:Name="ReaderAiEmptyState" Spacing="4">
                                        <TextBlock Text="基于当前选文和本地书籍索引对话"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                        <Button Classes="readerMinimalAction" Content="总结本章" HorizontalAlignment="Stretch" Click="ReaderAiSummarizeChapterButton_Click" />
                                        <Button Grid.Column="1" Classes="readerMinimalAction" Content="解释选中" HorizontalAlignment="Stretch" Click="ReaderAiExplainSelectionButton_Click" />
                                        <Button Grid.Row="1" Classes="readerMinimalAction" Content="全书概览" HorizontalAlignment="Stretch" Click="ReaderAiSummarizeBookButton_Click" />
                                        <Button Grid.Row="1" Grid.Column="1" Classes="readerMinimalAction" Content="清空对话" HorizontalAlignment="Stretch" Click="ReaderAiClearButton_Click" />
                                    </Grid>
                                    <ItemsControl x:Name="ReaderChatMessagesPanel" ItemsSource="{Binding ReaderAiMessages}" Margin="0,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:ReaderAiMessageViewModel">
                                                <Border MaxWidth="306"
                                                        Padding="2,9,2,10"
                                                        Margin="0,1"
                                                        HorizontalAlignment="{Binding BubbleAlignment}"
                                                        Background="Transparent"
                                                        BorderBrush="{StaticResource HairlineBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        CornerRadius="0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding RoleLabel}" FontSize="9" Foreground="{Binding RoleBrush}" Opacity="0.72" />
                                                        <TextBlock Text="{Binding Reasoning}" IsVisible="{Binding IsReasoningVisible}" FontSize="10" Foreground="#5F5F5F" TextWrapping="Wrap" />
                                                        <local:KreaderMarkdownTextBlock Text="{Binding Content}" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ReaderAiStatusText"
                                               Text="本地索引将在打开 EPUB 后自动准备"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <StackPanel x:Name="ReaderAiSourcesPanel" Spacing="5" IsVisible="False">
                                        <TextBlock Text="本次参考" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                        <ItemsControl ItemsSource="{Binding ReaderAiSources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ReaderAiSourceViewModel">
                                                    <Button Classes="readerNoteItem" Tag="{Binding}" HorizontalContentAlignment="Left" Click="ReaderAiSourceButton_Click">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="10" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="ReaderNotesView" IsVisible="False">
                            <ScrollViewer Padding="20,18,20,22" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="为正文中选中的文字添加划线和笔记。批注仅保存在本机。"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <Border Padding="2,8"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="0">
                                        <TextBlock x:Name="ReaderAnnotationSelectionText"
                                                   Text="请先在正文中选择一段文字，再点击顶部“批注”。"
                                                   FontSize="12"
                                                   MaxHeight="80"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <TextBox x:Name="ReaderAnnotationNoteBox"
                                             Classes="readerMinimalField"
                                             MinHeight="76"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             PlaceholderText="写下对这段文字的想法（可留空）" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="划线颜色" FontSize="11" />
                                            <ComboBox x:Name="ReaderAnnotationColorBox" Classes="readerMinimalField" SelectedIndex="0" MinHeight="32" FontSize="10">
                                                <ComboBoxItem Content="黑色" Tag="#000000" />
                                                <ComboBoxItem Content="黄色" Tag="#F1C40F" />
                                                <ComboBoxItem Content="蓝色" Tag="#4A90E2" />
                                                <ComboBoxItem Content="绿色" Tag="#38A169" />
                                                <ComboBoxItem Content="红色" Tag="#D95F76" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="线条样式" FontSize="11" />
                                            <ComboBox x:Name="ReaderAnnotationStyleBox" Classes="readerMinimalField" SelectedIndex="0" MinHeight="32" FontSize="10">
                                                <ComboBoxItem Content="直线" Tag="solid" />
                                                <ComboBoxItem Content="双线" Tag="double" />
                                                <ComboBoxItem Content="虚线" Tag="dashed" />
                                                <ComboBoxItem Content="点线" Tag="dotted" />
                                                <ComboBoxItem Content="波浪线" Tag="wavy" />
                                                <ComboBoxItem Content="荧光标记（黑白反色）" Tag="marker" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Button Classes="readerMinimalAction" Content="保存划线与笔记" HorizontalAlignment="Stretch" Click="ReaderAnnotationSaveButton_Click" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="本书批注" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="点击条目回到正文" FontSize="9" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button x:Name="ReaderDeleteAnnotationButton"
                                                Grid.Column="1"
                                                Classes="readerMinimalAction"
                                                Content="删除选中"
                                                IsEnabled="False"
                                                Click="ReaderDeleteAnnotationButton_Click" />
                                    </Grid>
                                    <ItemsControl x:Name="ReaderAnnotationList" ItemsSource="{Binding ReaderAnnotations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:ReaderAnnotation">
                                                <Button Classes="readerNoteItem"
                                                        Margin="0,0,0,7"
                                                        Tag="{Binding}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="ReaderAnnotationItemButton_Click">
                                                    <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                                                        <TextBlock Text="{Binding DisplayQuote}" FontSize="11" FontWeight="SemiBold" MaxHeight="54" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding DisplayNote}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" MaxHeight="54" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <Button Classes="readerMinimalAction" Content="导出 Markdown" HorizontalAlignment="Stretch" Click="ReaderExportMarkdownButton_Click" />
                                        <Button Grid.Column="1" Classes="readerMinimalAction" Content="导出文本" HorizontalAlignment="Stretch" Click="ReaderExportTextButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="ReaderExportStatusText" FontSize="10" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer x:Name="ReaderAiSettingsView"
                                      IsVisible="False"
                                      Padding="18,16,18,18"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <TextBlock Text="AI 助手设置" FontSize="16" FontWeight="SemiBold" />
                                <StackPanel Spacing="5">
                                    <TextBlock Text="服务" FontSize="11" />
                                    <ComboBox x:Name="ReaderAiProviderBox"
                                              Classes="readerSettingsField"
                                              SelectedIndex="0"
                                              SelectionChanged="ReaderAiProviderBox_SelectionChanged">
                                        <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                        <ComboBoxItem Content="OpenAI" Tag="openai" />
                                        <ComboBoxItem Content="自定义 OpenAI-compatible" Tag="custom" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Base URL" FontSize="11" />
                                    <TextBox x:Name="ReaderAiBaseUrlBox"
                                             Classes="readerSettingsField"
                                             PlaceholderText="https://api.deepseek.com" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="模型" FontSize="11" />
                                    <TextBox x:Name="ReaderAiModelBox"
                                             Classes="readerSettingsField"
                                             PlaceholderText="模型名称" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="API Key" FontSize="11" />
                                    <TextBox x:Name="ReaderAiApiKeyBox"
                                             Classes="readerSettingsField"
                                             PasswordChar="●"
                                             PlaceholderText="输入 API Key" />
                                    <TextBlock Text="API Key 仅加密保存在本机。"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ReaderAiSettingsStatusText"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <Button Grid.Column="1"
                                            Classes="quiet"
                                            Content="取消"
                                            Click="ReaderAiSettingsCancelButton_Click" />
                                    <Button Grid.Column="2"
                                            Content="保存"
                                            Click="ReaderAiSettingsSaveButton_Click" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="3"
                            Padding="20,14,20,18"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid x:Name="ReaderAiComposer" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="思考深度" FontSize="11" />
                                    <ComboBox x:Name="ReaderAiReasoningDepthBox" Classes="readerMinimalField" MinHeight="32" FontSize="10" SelectionChanged="ReaderAiReasoningDepthBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="模型" FontSize="11" />
                                    <ComboBox x:Name="ReaderAiModelSelectorBox" Classes="readerMinimalField" MinHeight="32" FontSize="10" PlaceholderText="选择模型" SelectionChanged="ReaderAiModelSelectorBox_SelectionChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="ReaderAiQuestionBox"
                                     Grid.Row="1"
                                     Classes="readerMinimalField"
                                     MinHeight="74"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     PlaceholderText="询问这本书…（Ctrl+Enter 发送）"
                                     KeyDown="ReaderAiQuestionBox_KeyDown" />
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Text="仅发送相关片段，不上传整本书" FontSize="9" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                <Button x:Name="ReaderAiSendButton"
                                        Grid.Column="1"
                                        Classes="readerMinimalAction"
                                        Content="发送"
                                        MinWidth="66"
                                        Click="ReaderAiSendButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Reading layout settings. Typography remains per book while
                 the vertical-writing switch is global. A native popup is required:
                 the WebView2 HWND island covers ordinary Avalonia overlays. -->
            <Popup x:Name="ReaderLayoutSettingsPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="True">
                <Grid x:Name="ReaderLayoutSettingsOverlay"
                      Background="#66000000">
                <Border Width="580"
                        MaxHeight="760"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#000000"
                        BorderThickness="2"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Margin="22,20" Spacing="12">
                                <TextBlock Text="阅读排版设置" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="字号、行高、宽度、边距和字体按当前书保存；竖排和段首缩进对所有书生效。"
                                           FontSize="11"
                                           Foreground="#666666"
                                           TextWrapping="Wrap" />
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="字号" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderFontScaleValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderFontScaleSlider" Minimum="0.8" Maximum="1.8" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="1" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="行高" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderLineHeightValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderLineHeightSlider" Minimum="1.3" Maximum="2.6" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1.88" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="正文最大宽度" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderMaxWidthValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderMaxWidthSlider" Minimum="480" Maximum="3840" TickFrequency="20" IsSnapToTickEnabled="True" Value="800" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="左右边距" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderBodyPaddingValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderBodyPaddingSlider" Minimum="24" Maximum="160" TickFrequency="8" IsSnapToTickEnabled="True" Value="68" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="正文字体（CJK 覆盖）" FontSize="11" />
                                    <ComboBox x:Name="ReaderFontFamilyBox"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="ReaderFontFamilyBox_SelectionChanged">
                                        <ComboBoxItem Content="京华老宋体" Tag="京华老宋体" />
                                        <ComboBoxItem Content="微软雅黑 Microsoft YaHei UI" Tag="Microsoft YaHei UI" />
                                        <ComboBoxItem Content="宋体 SimSun" Tag="SimSun" />
                                        <ComboBoxItem Content="黑体 SimHei" Tag="SimHei" />
                                        <ComboBoxItem Content="楷体 KaiTi" Tag="KaiTi" />
                                        <ComboBoxItem Content="等线 DengXian" Tag="DengXian" />
                                        <ComboBoxItem Content="思源宋体 / Noto Serif CJK" Tag="Source Han Serif SC, Noto Serif CJK SC" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="ReaderVerticalWritingCheck"
                                          Classes="readerLayoutCheck"
                                          Content="竖排排版（全局，仅支持单页）"
                                          FontSize="12"
                                          IsCheckedChanged="ReaderVerticalWritingCheck_IsCheckedChanged" />
                                <CheckBox x:Name="ReaderParagraphIndentCheck"
                                          Classes="readerLayoutCheck"
                                          Content="正文段落起始缩进两个字（全局）"
                                          FontSize="12"
                                          IsCheckedChanged="ReaderParagraphIndentCheck_IsCheckedChanged" />
                                <TextBlock x:Name="ReaderLayoutSettingsStatusText"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                                <Button Classes="quiet"
                                        Content="恢复默认值"
                                        HorizontalAlignment="Left"
                                        Click="ReaderLayoutResetButton_Click" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="22,14,22,20">
                                <Button Classes="quiet"
                                        Content="关闭"
                                        HorizontalAlignment="Right"
                                        Click="ReaderLayoutSettingsCloseButton_Click" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
                </Grid>
            </Popup>

            <Popup x:Name="ReaderSelectionHostPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="True"
                   OverlayDismissEventPassThrough="True"
                   ShouldUseOverlayLayer="True"
                   TakesFocusFromNativeControl="False">
                <Border x:Name="ReaderSelectionPopupBar"
                        Padding="3"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#000000"
                        BorderThickness="1"
                        CornerRadius="0">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button Content="复制"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionCopyButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                        <Button x:Name="ReaderSelectionHighlightMenuButton"
                                Content="划线 ▾"
                                Classes="readerSelectionAction"
                                PointerEntered="ReaderSelectionHighlightMenuButton_PointerEntered">
                            <Button.Flyout>
                                <MenuFlyout ShowMode="Transient"
                                            Placement="Bottom"
                                            VerticalOffset="4"
                                            OverlayDismissEventPassThrough="True">
                                    <MenuItem x:Name="ReaderSelectionHighlightSolidItem" Header="直线  ───" Classes="readerSelectionStyle" Tag="solid" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="双线  ═══" Classes="readerSelectionStyle" Tag="double" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="虚线  ┄┄┄" Classes="readerSelectionStyle" Tag="dashed" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="点线  ···" Classes="readerSelectionStyle" Tag="dotted" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="波浪线  ﹏﹏" Classes="readerSelectionStyle" Tag="wavy" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <Separator />
                                    <MenuItem Header="荧光标记（黑白反色）  ▰" Classes="readerSelectionStyle" Tag="marker" Click="ReaderSelectionHighlightStyleItem_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                        <Button Content="批注"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionAnnotateButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                        <Button Content="AI 解释"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionAiButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                        <Button Content="搜索"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionSearchButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                        <Button Content="词典"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionDictionaryButton_Click" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- A native popup keeps the footnote above the HWND-backed
                 WebView2 surface, matching the WinUI reference reader. -->
            <Popup x:Name="ReaderFootnoteHostPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="False"
                   IsHitTestVisible="False">
                <Border x:Name="ReaderFootnotePopup"
                        Width="360"
                        MaxHeight="260"
                        Padding="12,10"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#000000"
                        BorderThickness="2"
                        CornerRadius="0"
                        IsHitTestVisible="False"
                        IsVisible="False">
                    <ScrollViewer MaxHeight="236"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReaderFootnoteText"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="12"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- A native popup is required here: the reading surface is an
                 embedded WebView2 HWND and would cover a normal Avalonia
                 overlay regardless of ZIndex. -->
            <Popup x:Name="ReaderChapterPreviewPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="False">
                <Border MinWidth="150"
                        MaxWidth="340"
                        Padding="12,8"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#000000"
                        BorderThickness="1"
                        CornerRadius="0"
                        IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock x:Name="ReaderChapterPreviewTitleText"
                                   MaxWidth="316"
                                   Foreground="#222222"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ReaderChapterPreviewBodyText"
                                   MaxWidth="316"
                                   Margin="0,6,0,0"
                                   Foreground="#666666"
                                   FontSize="11"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   MaxLines="4"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="False" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
        </Grid>
    </Border>

        <!-- Device connection/eject floating bubble: a hollow paper-white
             toast with a 1-DIP black outline and a matching outlined pointer
             aligned to the sidebar eject button's triangle apex. The
             host positions it in window coordinates (PositionDeviceStatusToast)
             and it floats above the whole UI, never clipped by the sidebar. -->
        <StackPanel x:Name="DeviceStatusToast"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    MaxWidth="360"
                    RenderTransformOrigin="0,0"
                    IsVisible="False"
                    IsHitTestVisible="False">
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                </Transitions>
            </StackPanel.Transitions>
            <Border Padding="8,7"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="DeviceStatusToastText"
                           MaxWidth="342"
                           Text="设备已连接"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Foreground="{StaticResource InkBrush}"
                           FontSize="11" />
            </Border>
            <!-- The filled triangle masks the bubble's bottom border, then the
                 open path draws both sides from the exact border break points.
                 Keeping fill and outline separate avoids erasing the joins. -->
            <Grid x:Name="DeviceStatusToastPointer"
                  Width="12"
                  Height="6"
                  Margin="0,-1,0,0"
                  UseLayoutRounding="True"
                  RenderTransformOrigin="0,0"
                  HorizontalAlignment="Left">
                <Polygon Points="0,0 12,0 6,6"
                         Fill="{StaticResource PaperBrush}"
                         Stretch="Fill" />
                <Path Data="M 0,0 L 6,6 L 12,0"
                      Stroke="{StaticResource InkBrush}"
                      StrokeThickness="1"
                      StrokeLineCap="Square"
                      StrokeJoin="Miter" />
            </Grid>
        </StackPanel>

        <!-- Zen controls must use a native popup: the full-screen WebView is
             an HWND island and otherwise paints over Avalonia title content. -->
        <Popup x:Name="ReaderZenControlsPopup"
               IsOpen="False"
               IsLightDismissEnabled="False"
               ShouldUseOverlayLayer="False"
               TakesFocusFromNativeControl="True">
            <!-- NativeWebView is a child window on Windows and paints over the
                 ordinary title-bar grid. Keep the complete old title-button
                 row in one native popup so Zen mode never leaves a black gap
                 or splits the controls across two composition surfaces. -->
            <Border Background="{StaticResource PaperBrush}"
                    PointerEntered="ReaderTitleControls_PointerEntered"
                    PointerExited="ReaderTitleControls_PointerExited">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button x:Name="ReaderZenPopupTocButton"
                            Classes="caption"
                            Width="92"
                            Height="38"
                            Padding="0"
                            FontSize="11"
                            AutomationProperties.Name="切换极简目录"
                            ToolTip.Tip="显示或隐藏禅模式极简目录"
                            Click="ReaderZenMinimalTocButton_Click">
                        <TextBlock x:Name="ReaderZenPopupTocText"
                                   Text="显示极简目录"
                                   Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button x:Name="ReaderZenPopupExitButton"
                            Classes="caption"
                            Width="104"
                            Height="38"
                            Padding="0"
                            FontSize="11"
                            AutomationProperties.Name="退出禅模式"
                            ToolTip.Tip="退出禅模式，恢复目录与阅读助手"
                            Click="ReaderExitZenButton_Click">
                        <TextBlock Text="退出禅模式"
                                   Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button x:Name="ReaderZenPopupMinimizeButton"
                            Classes="caption"
                            Width="46"
                            Height="38"
                            Padding="0"
                            Click="MinimizeWindowButton_Click"
                            AutomationProperties.Name="最小化">
                        <Path Data="M 0,0 H 10" />
                    </Button>
                    <Button x:Name="ReaderZenPopupMaximizeButton"
                            Classes="caption"
                            Width="46"
                            Height="38"
                            Padding="0"
                            Click="MaximizeWindowButton_Click"
                            AutomationProperties.Name="最大化">
                        <Path x:Name="ReaderZenPopupMaximizeGlyph"
                              Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                    </Button>
                    <Button x:Name="ReaderZenPopupCloseButton"
                            Classes="caption"
                            Width="46"
                            Height="38"
                            Padding="0"
                            Click="CloseWindowButton_Click"
                            AutomationProperties.Name="关闭">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Draw the frame as a sibling above the content. The native WebView
             is a separate child window and can cover WindowShadowHost's own
             right stroke; this overlay keeps all four sides on one geometry. -->
        <Border x:Name="WindowFrameOverlay"
                Margin="0"
                Background="Transparent"
                BorderBrush="#000000"
                BorderThickness="1"
                IsHitTestVisible="False"
                ZIndex="1000" />

        <!-- Invisible resize handles around the window edge. They hand the
             gesture to the platform so native window resizing stays atomic. -->
        <Grid x:Name="WindowResizeLayer">
            <Rectangle Fill="Transparent"
                       Width="8"
                       HorizontalAlignment="Left"
                       Cursor="SizeWestEast"
                       Tag="Left"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="8"
                       HorizontalAlignment="Right"
                       Cursor="SizeWestEast"
                       Tag="Right"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Height="8"
                       VerticalAlignment="Top"
                       Cursor="SizeNorthSouth"
                       Tag="Top"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Height="8"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNorthSouth"
                       Tag="Bottom"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Cursor="TopLeftCorner"
                       Tag="TopLeft"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Cursor="TopRightCorner"
                       Tag="TopRight"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Cursor="BottomLeftCorner"
                       Tag="BottomLeft"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="BottomRightCorner"
                       Tag="BottomRight"
                       PointerPressed="WindowResize_PointerPressed" />
        </Grid>
    </Grid>
</Window>
