                                    <Border x:Name="SettingsDiagnosticsSection" Padding="0">
                                        <StackPanel Spacing="13">
                                            <TextBlock x:Name="SettingsDiagnosticsTitleText" Text="跨平台诊断" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SettingsDiagnosticsDescriptionText" Text="检测数据目录、阅读器、PDF、Calibre 和设备能力；缺少可安装依赖时可在这里一键修复。" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="RepairDiagnosticsButton" Content="一键修复" IsEnabled="False" Classes="quiet" Click="RepairDiagnosticsButton_Click" />
                                                <Button x:Name="RefreshDiagnosticsButton" Content="重新检测" Classes="quiet" Click="RefreshDiagnosticsButton_Click" />
                                            </StackPanel>
                                            <ItemsControl x:Name="PlatformDiagnosticsList" ItemsSource="{Binding PlatformDiagnostics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:PlatformDiagnosticViewModel">
                                                        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,8,8,8">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" MinWidth="0">
                                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="2" MinWidth="0">
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" MinWidth="0" />
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        <Button Content="{Binding RepairLabel}" IsVisible="{Binding CanRepair}" Classes="quiet" Padding="8,3" VerticalAlignment="Center" Click="RepairDiagnosticButton_Click" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" MinWidth="0" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="DiagnosticsStatusText" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="SettingsS3ActionBar" Grid.Row="3" IsVisible="False" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PaperBrush}" Padding="0,12,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="S3DraftStatusText" FontSize="12" TextWrapping="Wrap" />
                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="S3SaveSettingsButton" Content="{DynamicResource Ui.Auto.C8550237BA701F64}" Margin="0,0,8,8" Click="S3SaveSettingsButton_Click" />
                                <Button x:Name="S3DiscardSettingsButton" Content="{DynamicResource Ui.Auto.9B7824CEFA1E8B16}" Classes="quiet" Margin="0,0,8,8" Click="S3DiscardSettingsButton_Click" />
                                <Button x:Name="S3TestConnectionButton" Content="{DynamicResource Ui.Auto.0A98A48EAAAC4175}" Margin="0,0,8,8" Classes="quiet" Click="S3TestConnectionButton_Click" />
                                <Button x:Name="S3SyncNowButton" Content="{DynamicResource Ui.Auto.36E7A43A1C674E50}" Margin="0,0,8,8" Classes="quiet" Click="S3SyncNowButton_Click" />
                                <Button x:Name="S3CancelSyncButton" Content="{DynamicResource Ui.Auto.5034DDC8102C5DF8}" Margin="0,0,0,8" Classes="quiet" IsVisible="False" Click="S3CancelSyncButton_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="S3SyncStatusText" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Format conversion progress, anchored bottom-right like the
                 WinUI reference. Tapping the card badge restores this popup;
                 tapping the popup background sends it back to the card. -->
            <Border x:Name="BookConversionPopup"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{DynamicResource PaperBrush}"
                    BorderBrush="{DynamicResource InkBrush}"
                    BorderThickness="1"
                    IsVisible="False"
                    ZIndex="80"
                    Tapped="BookConversionPopup_Tapped">
                <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="BookConversionPopupTitleText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock x:Name="BookConversionPopupFormatText"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedInkBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <Button x:Name="BookConversionBackgroundButton"
                                    Classes="quiet"
                                    Content="{DynamicResource Ui.Auto.F97DE1B381D60005}"
                                    Padding="8,4"
                                    Click="BookConversionBackgroundButton_Click" />
                            <Button x:Name="BookConversionCancelButton"
                                    Classes="quiet"
                                    Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                    Padding="8,4"
                                    Click="BookConversionCancelButton_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ProgressBar x:Name="BookConversionPopupProgress"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="10"
                                     VerticalAlignment="Center" />
                        <TextBlock x:Name="BookConversionPopupPercentageText"
                                   Grid.Column="1"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   MinWidth="28"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="BookConversionPopupMessageText"
                               FontSize="11"
                               Foreground="{DynamicResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Unified task progress surface for import/backup/douban/email
                 and other long operations, matching the WinUI reference. -->
            <Border x:Name="TaskProgressPopup"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{DynamicResource PaperBrush}"
                    BorderBrush="{DynamicResource InkBrush}"
                    BorderThickness="1"
                    IsVisible="False"
                    ZIndex="75"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="9">
                    <TextBlock Text="{DynamicResource Ui.Auto.B341B84A73883BDA}" FontSize="15" FontWeight="SemiBold" />
                    <Border Height="10"
                            Padding="1"
                            Background="{DynamicResource PaperBrush}"
                            BorderBrush="{DynamicResource InkBrush}"
                            BorderThickness="1">
                        <ProgressBar x:Name="TaskProgressPopupBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Background="Transparent"
                                     IsIndeterminate="False" />
                    </Border>
                    <TextBlock x:Name="TaskProgressPopupText"
                               FontSize="11"
                               Foreground="{DynamicResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Transfer toast: the progress surface for Kindle send/export
                 operations. It replaces the generic task popup while active. -->
            <Border x:Name="TransferToast"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{DynamicResource PaperBrush}"
                    BorderBrush="{DynamicResource InkBrush}"
                    BorderThickness="1"
                    IsVisible="False"
                    ZIndex="90"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="7">
                    <TextBlock x:Name="TransferToastTitleText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TransferToastMessageText"
                               FontSize="11"
                               Foreground="{DynamicResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="TransferToastProgress"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="5"
                                 Background="{DynamicResource PaperBrush}"
                                 IsVisible="False" />
                </StackPanel>
            </Border>

            <!-- Settings feedback capsule: a bottom-center pill for explicit
                 settings confirmations and longer-lived notices. Library view
                 switches save silently because they are navigation. It rises
                 into place, then sinks away after a delay; the check glyph
                 only appears for success messages. -->
            <Border x:Name="SettingsSavedCapsule"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,34"
                    Padding="20,9"
                    CornerRadius="999"
                    Background="{DynamicResource InkBrush}"
                    BoxShadow="0 6 18 0 #26000000"
                    RenderTransform="translateY(12px)"
                    IsVisible="False"
                    Opacity="0"
                    ZIndex="95"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path x:Name="SettingsCapsuleCheckIcon"
                          Data="M 1,5.5 L 4.5,9 L 11,1.5"
                          Stroke="{DynamicResource PaperBrush}"
                          StrokeThickness="2"
                          Width="12"
                          Height="11"
                          Stretch="None"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="SettingsSavedCapsuleText"
                               Foreground="{DynamicResource PaperBrush}"
                               FontSize="12"
                               MaxWidth="460"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Device connection confirmation from the WinUI reference. Keep
                 this separate from destructive confirmations so the two
                 actions retain their original labels and keyboard behavior. -->
            <Grid x:Name="DevicePromptOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100"
                  Focusable="True"
                  KeyDown="DevicePromptOverlay_KeyDown">
                <Border Width="560"
                        MaxWidth="560"
                        Background="{DynamicResource PaperBrush}"
                        BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10"
                                           Height="24"
                                           Margin="0,-2,0,0"
                                           Fill="{DynamicResource InkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DevicePromptTitleText"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DevicePromptMessageText"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="28,18,28,22"
                              Background="{DynamicResource PaperBrush}"
                              ColumnDefinitions="*,12,*">
                            <Button x:Name="DevicePromptPrimaryButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DevicePromptPrimaryButton_Click" />
                            <Button x:Name="DevicePromptCancelButton"
                                    Grid.Column="2"
                                    Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                    Classes="quiet"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DevicePromptCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Confirmation overlay -->
            <Grid x:Name="ConfirmationOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="430"
                        Padding="22"
                        Background="{DynamicResource PaperBrush}"
                        BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ConfirmationTitleText" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="ConfirmationMessageText" TextWrapping="Wrap" Foreground="{DynamicResource MutedInkBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7" Margin="0,8,0,0">
                            <Button x:Name="ConfirmationCancelButton" Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}" Classes="quiet" Padding="13,7" Click="ConfirmationCancelButton_Click" />
                            <Button x:Name="ConfirmationOkButton" Content="{DynamicResource Ui.Auto.A3EA3C17B401BD2F}" Padding="13,7" Click="ConfirmationOkButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Collection-name overlay -->
            <Grid x:Name="CollectionNameOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="101">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="430"
                        Padding="22"
                        Background="{DynamicResource PaperBrush}"
                        BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Ui.Auto.FDF0B569D820ADE8}" FontSize="18" FontWeight="Bold" />
                        <TextBox x:Name="CollectionNameBox" PlaceholderText="{DynamicResource Ui.Auto.B161B3F76A603FB9}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7" Margin="0,8,0,0">
                            <Button Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}" Classes="quiet" Padding="13,7" Click="CollectionNameCancelButton_Click" />
                            <Button Content="{DynamicResource Ui.Auto.CDE2CD071D25BBAB}" Padding="13,7" Click="CollectionNameOkButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Device model editor opened from the lower-left Kindle card. -->
            <Grid x:Name="DeviceModelInputOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100">
                <Border Width="560"
                        MaxWidth="560"
                        Background="{DynamicResource PaperBrush}"
                        BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10"
                                           Height="24"
                                           Margin="0,-2,0,0"
                                           Fill="{DynamicResource InkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DeviceModelInputTitleText"
                                           Text="{DynamicResource Ui.Auto.D1ECEBCCE6DFA757}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceModelInputMessageText"
                                       Text="{DynamicResource Ui.Auto.1FB528C81918B9CC}"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                            <TextBox x:Name="DeviceModelInputBox"
                                     FontSize="15"
                                     Padding="10,7"
                                     MaxLength="80"
                                     PlaceholderText="{DynamicResource Ui.Device.ModelExample}"
                                     KeyDown="DeviceModelInputBox_KeyDown" />
                            <TextBlock x:Name="DeviceModelInputStatusText"
                                       IsVisible="False"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="28,18,28,22"
                              Background="{DynamicResource PaperBrush}"
                              ColumnDefinitions="*,12,*">
                            <Button x:Name="DeviceModelInputOkButton"
                                    Content="{DynamicResource Ui.Auto.FAC2A67AD87807C4}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DeviceModelInputOkButton_Click" />
                            <Button Grid.Column="2"
                                    Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                    Classes="quiet"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DeviceModelInputCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Douban candidate picker: keep the old version's explicit
                 choice instead of silently applying the first search hit. -->
            <Grid x:Name="DoubanCandidateOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="102">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="760"
                        MaxHeight="680"
                        Padding="22"
                        Background="{DynamicResource PaperBrush}"
                        BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                        <TextBlock Text="{DynamicResource Ui.Auto.70CB42E21940694F}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1"
                                   Text="{DynamicResource Ui.Auto.E5327DA0211C4F19}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="DoubanSearchBox"
                                     PlaceholderText="{DynamicResource Ui.Auto.DFFE0AC3F6015D93}"
                                     KeyDown="DoubanSearchBox_KeyDown" />
                            <Button x:Name="DoubanResearchButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource Ui.Auto.44CE7AE909BBB28B}"
                                    MinWidth="72"
                                    Padding="13,7"
                                    Click="DoubanResearchButton_Click" />
                        </Grid>
                        <ListBox x:Name="DoubanCandidateList"
                                 Classes="doubanCandidateList"
                                 Grid.Row="3"
                                 ItemsSource="{Binding DoubanCandidates}"
                                 SelectionChanged="DoubanCandidateList_SelectionChanged"
                                 DoubleTapped="DoubanCandidateList_DoubleTapped"
                                 Background="Transparent"
                                 BorderBrush="{DynamicResource HairlineBrush}"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:DoubanCandidateViewModel">
                                    <Border Classes="doubanCandidateRow"
                                            Padding="12,10"
                                            Margin="0,0,0,8"
                                            Background="{DynamicResource PaperBrush}"
                                            BorderBrush="{DynamicResource HairlineBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="14">
                                            <Border Width="68"
                                                    Height="96"
                                                    Background="{DynamicResource CoverBrush}"
                                                    BorderBrush="{DynamicResource HairlineBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="BOOK"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource MutedInkBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           MaxLines="2"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Abstract}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedInkBrush}"
                                                           MaxLines="3"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SubjectText}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource MutedInkBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    MinWidth="92"
                                                    Padding="9,6"
                                                    Background="{DynamicResource InkBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RatingText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PaperBrush}"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <Button Grid.Column="1"
                                    Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                    Classes="quiet"
                                    MinWidth="72"
                                    Padding="13,7"
                                    Click="DoubanCandidateCancelButton_Click" />
                            <Button x:Name="DoubanCandidateSourceButton"
                                    Grid.Column="2"
                                    Content="{DynamicResource Ui.Auto.EEA44F68ED6CD8BF}"
                                    Classes="quiet"
                                    MinWidth="116"
                                    Padding="13,7"
                                    IsEnabled="False"
                                    Click="DoubanCandidateSourceButton_Click" />
                            <Button x:Name="DoubanCandidateApplyButton"
                                    Grid.Column="3"
                                    Content="{DynamicResource Ui.Auto.A748CC074F78DE00}"
                                    MinWidth="92"
                                    Padding="13,7"
                                    IsEnabled="False"
                                    Click="DoubanCandidateApplyButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Douban metadata preview: shows the fetched details and lets the
                 user choose which fields are written back, with a back button
                 to return to the candidate list (WinUI reference flow). -->
            <Grid x:Name="DoubanPreviewOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="102"
                  Focusable="True"
                  KeyDown="DoubanPreviewOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="720"
                        MaxHeight="660"
                        Padding="22"
                        Background="{DynamicResource PaperBrush}"
                        BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10"
                                       Height="24"
                                       Fill="{DynamicResource InkBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Ui.Auto.FC131B57EB71A076}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{DynamicResource Ui.Auto.01E2B52FC5974BB9}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Grid.Row="2" ColumnDefinitions="104,*" ColumnSpacing="14" Margin="0,4,0,2">
                            <Border Width="96" Height="132" HorizontalAlignment="Left" Background="{DynamicResource CoverBrush}" BorderBrush="{DynamicResource InkBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="BOOK"
                                               FontSize="9"
                                               Foreground="{DynamicResource MutedInkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image x:Name="DoubanPreviewCoverImage" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Column="1" MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="DoubanPreviewSummaryText"
                                           FontSize="12"
                                           LineHeight="20"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      BorderBrush="{DynamicResource HairlineBrush}"
                                      BorderThickness="1"
                                      Padding="12,8">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="DoubanUpdateTitleCheck" Content="{DynamicResource Ui.Auto.7E1BB8CB2E864B77}" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateAuthorsCheck" Content="{DynamicResource Ui.Auto.D5BAD65FDC48569A}" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateSeriesCheck" Content="{DynamicResource Ui.Auto.D9100FAC799FD371}" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateDescriptionCheck" Content="{DynamicResource Ui.Auto.1FFF8D91DB541377}" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdatePublicationCheck" Content="{DynamicResource Ui.Auto.F44DC9D32AA88EB1}" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateCoverCheck" Content="{DynamicResource Ui.Auto.A050FE75C024404B}" FontSize="13" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                            <TextBlock x:Name="DoubanPreviewStatusText"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedInkBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="DoubanPreviewSourceButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource Ui.Auto.EEA44F68ED6CD8BF}"
                                    Classes="quiet"
                                    Padding="13,7"
                                    Click="DoubanPreviewSourceButton_Click" />
                            <Button x:Name="DoubanPreviewBackButton"
                                    Grid.Column="2"
                                    Content="{DynamicResource Ui.Auto.B062EE4E5C2C9E1B}"
                                    Classes="quiet"
                                    Padding="13,7"
                                    Click="DoubanPreviewBackButton_Click" />
                            <Button x:Name="DoubanPreviewApplyButton"
                                    Grid.Column="3"
                                    Content="{DynamicResource Ui.Auto.2326E4996E2C8C85}"
                                    Padding="13,7"
                                    Click="DoubanPreviewApplyButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ImportFormatSelectionOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="105"
                  Focusable="True"
                  KeyDown="ImportFormatSelectionOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="620"
                        MaxHeight="650"
                        Background="{DynamicResource PaperBrush}"
                        BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10" Height="24" Fill="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Ui.Auto.038105A4C83EB5F0}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ImportFormatSelectionSummaryText" FontSize="14" TextWrapping="Wrap" />
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ImportFormatSelectionList" Spacing="10" />
                            </ScrollViewer>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="28,18,28,22" ColumnDefinitions="*,12,*">
                            <Button Content="{DynamicResource Ui.Auto.576D81BB0631B165}" HorizontalAlignment="Stretch" Click="ImportFormatSelectionPrimaryButton_Click" />
                            <Button Grid.Column="2" Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}" Classes="quiet" HorizontalAlignment="Stretch" Click="ImportFormatSelectionCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ImportConflictOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="106"
                  Focusable="True"
                  KeyDown="ImportConflictOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="620"
                        MaxWidth="620"
                        Background="{DynamicResource PaperBrush}"
                        BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Margin="28,24,28,22" Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10" Height="24" Fill="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ImportConflictTitleText" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ImportConflictSummaryText" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="ImportConflictExistingFilesText"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,10,*,10,*" Margin="0,8,0,0">
                            <Button x:Name="ImportConflictMergeButton"
                                    Content="添加为格式"
                                    HorizontalAlignment="Stretch"
                                    Click="ImportConflictMergeButton_Click" />
                            <Button x:Name="ImportConflictSeparateButton"
                                    Grid.Column="2"
                                    Content="作为新版本"
                                    Classes="quiet"
                                    HorizontalAlignment="Stretch"
                                    Click="ImportConflictSeparateButton_Click" />
                            <Button x:Name="ImportConflictSkipButton"
                                    Grid.Column="4"
                                    Content="跳过"
                                    Classes="quiet"
                                    HorizontalAlignment="Stretch"
                                    Click="ImportConflictSkipButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="DevicePaginationBar"
                            Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Margin="0,10,0,0"
                            IsVisible="False">
                    <Button x:Name="DevicePreviousPageButton" Classes="quiet" Padding="12,5" Click="DevicePreviousPageButton_Click" />
                    <TextBlock x:Name="DevicePageText" VerticalAlignment="Center" Foreground="{DynamicResource MutedInkBrush}" />
                    <Button x:Name="DeviceNextPageButton" Classes="quiet" Padding="12,5" Click="DeviceNextPageButton_Click" />
                </StackPanel>
            </Grid>

        </Grid>
        <!-- Stage 4: the EPUB reader surface. Two native webview hosts
             stay attached so the next chapter can be prepared offscreen.
             Layout mirrors the WinUI reference: three fixed columns
             (TOC 286 / content * / assistant 360), a 52-DIP header bar and
             50-DIP footer bar inside the content column, and a full-height
             TOC panel. -->
        <ThemeVariantScope x:Name="ReaderThemeScope"
                           Grid.Row="0"
                           Grid.ColumnSpan="3"
                           ZIndex="40"
                           IsVisible="False">
        <Grid x:Name="ReaderRoot"
              Classes="readerShell"
              Grid.Row="0"
              Grid.ColumnSpan="3"
              IsVisible="False"
              Margin="0"
              ZIndex="40"
              Background="{DynamicResource ReaderPageBrush}"
              PointerMoved="ReaderRoot_PointerMoved">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Opaque transition cover used when leaving zen mode: the reader
                 pane sits above the library, so fading the pane itself would
                 reveal the bookshelf behind it. This cover hides the layout
                 restore/window resize instead and is faded away afterwards. -->
            <Border x:Name="ReaderTransitionCover"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource ReaderPageBrush}"
                    Opacity="0"
                    IsHitTestVisible="False"
                    ZIndex="200" />

            <!-- Table of contents. -->
            <Border x:Name="ReaderTocPanel"
                    Grid.Column="0"
                    Margin="0,38,0,0"
                    Background="{DynamicResource ReaderSidebarBrush}"
                    ZIndex="10">
                <Border.Resources>
                    <!-- Softer, quieter scrollbar for the TOC so the side
                         panel stays out of the reading flow (WinUI values). -->
                    <SolidColorBrush x:Key="KkindleScrollBarBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="KkindleScrollBarExpandedBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="KkindleScrollBarBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbBrush" Color="{DynamicResource ReaderBorderColor}" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbPointerOverBrush" Color="{DynamicResource ReaderMutedColor}" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbPressedBrush" Color="{DynamicResource ReaderMutedColor}" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbDisabledBrush" Color="{DynamicResource ReaderBorderColor}" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource ReaderMutedColor}" />
                </Border.Resources>
                <Grid RowDefinitions="52,Auto,Auto,*">
                    <!-- Start the divider below the shared header rule. Keep it
                         above search content so it remains continuous. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="3"
                               Width="1"
                               HorizontalAlignment="Right"
                               Fill="{DynamicResource ReaderBorderBrush}"
                               IsHitTestVisible="False"
                               ZIndex="100" />

                    <Border Padding="14,8"
                            Background="{DynamicResource ReaderChromeBrush}"
                            BorderBrush="{DynamicResource ReaderBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                            <TextBlock x:Name="ReaderBookInfoText"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        <Button x:Name="ReaderTocMinimalToggleButton"
                                Grid.Column="1"
                                Classes="icon"
                                Width="38"
                                MinWidth="38"
                                Height="34"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.0474752B788B123E}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.0474752B788B123E}"
                                Click="ReaderTocMinimalToggleButton_Click">
                            <Path Width="24"
                                  Height="24"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M8 6H16 M8 12H16 M8 18H16"
                                  Stroke="{DynamicResource ReaderInkBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  IsHitTestVisible="False" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="icon"
                                Width="38"
                                MinWidth="38"
                                Height="34"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.47C91FADCC3E4775}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.47C91FADCC3E4775}"
                                Click="ReaderTocButton_Click">
                            <Path Width="18"
                                  Height="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M7 4.5L13 9L7 13.5"
                                  Stroke="{DynamicResource ReaderInkBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  IsHitTestVisible="False" />
                        </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid x:Name="ReaderTocView">
                            <ListBox x:Name="ReaderTocList"
                                     Classes="readerTocList"
                                     Background="Transparent"
                                     SelectionMode="Single"
                                     AutoScrollToSelectedItem="False"
                                     AttachedToVisualTree="ReaderTocList_AttachedToVisualTree"
                                     TemplateApplied="ReaderTocList_TemplateApplied"
                                     SelectionChanged="ReaderTocList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:ReaderTocRow">
                                        <Grid ColumnDefinitions="3,*">
                                            <Border Grid.ColumnSpan="2"
                                                    Background="{DynamicResource ReaderSelectedBrush}"
                                                    IsVisible="{Binding IsCurrent}"
                                                    IsHitTestVisible="False" />
                                            <Rectangle Fill="{DynamicResource ReaderMutedBrush}"
                                                       IsVisible="{Binding IsCurrent}" />
                                            <Grid Grid.Column="1"
                                                  Margin="{Binding Indent}"
                                                  ColumnDefinitions="27,*">
                                                <Button Classes="readerTocToggle"
                                                        Width="18"
                                                        Height="18"
                                                        MinHeight="0"
                                                        Margin="9,9,0,9"
                                                        Padding="0"
                                                        VerticalAlignment="Top"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Focusable="False"
                                                        IsVisible="{Binding HasChildren}"
                                                        Click="ReaderTocToggle_Click">
                                                    <Path Data="M 3,1.5 L 9,6 L 3,10.5"
                                                          Width="12"
                                                          Height="12"
                                                          Stretch="None"
                                                          Stroke="{DynamicResource ReaderMutedBrush}"
                                                          StrokeThickness="0.85"
                                                          StrokeLineCap="Square"
                                                          StrokeJoin="Miter"
                                                          Fill="Transparent"
                                                          RenderTransformOrigin="50%,50%"
                                                          IsHitTestVisible="False">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="{Binding ToggleRotation}">
                                                                <RotateTransform.Transitions>
                                                                    <Transitions>
                                                                        <DoubleTransition Property="Angle"
                                                                                           Duration="0:0:0.18"
                                                                                           Easing="CubicEaseOut" />
                                                                    </Transitions>
                                                                </RotateTransform.Transitions>
                                                            </RotateTransform>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Button>
                                                <TextBlock Grid.Column="1"
                                                           Margin="4,9,11,9"
                                                           Text="{Binding Title}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ReaderTocEmptyText"
                                       Margin="20"
                                       Text="{DynamicResource Ui.Auto.A37165A983502AE5}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ReaderMutedBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="False" />
                        </Grid>

                        <Grid x:Name="ReaderBookmarkPane"
                              Background="{DynamicResource ReaderSidebarBrush}"
                              IsVisible="False">
                            <ListBox x:Name="ReaderBookmarkList"
                                     Classes="readerTocList"
                                     Background="Transparent"
                                     ItemsSource="{Binding ReaderBookmarks}"
                                     SelectionMode="Single"
                                     SelectionChanged="ReaderBookmarkList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:ReaderBookmark">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                            <StackPanel Grid.Column="0" Margin="12,7,4,7" Spacing="3">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34" />
                                                <TextBlock Text="{Binding DisplayQuote}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34" />
                                                <TextBlock Text="{Binding DisplayTime}"
                                                           FontSize="9" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="icon"
                                                    Width="28"
                                                    MinWidth="28"
                                                    Height="28"
                                                    Margin="0,0,6,0"
                                                    Content="×"
                                                    Tag="{Binding}"
                                                    Click="ReaderBookmarkDeleteButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ReaderBookmarkEmptyText"
                                       Margin="20"
                                       Text="{DynamicResource Ui.Auto.F0389D3DDD00BD1D}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ReaderMutedBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Whole-book search reuses the normal TOC surface. -->
                        <Grid x:Name="ReaderSearchPanel" IsVisible="False">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <TextBox x:Name="ReaderTocSearchBox"
                                         Margin="14,4,14,10"
                                         Height="34"
                                         Padding="10,5"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="{DynamicResource Ui.Auto.64295B76D26336F3}"
                                         TextChanged="ReaderTocSearchBox_TextChanged" />
                                <TextBlock x:Name="ReaderWholeSearchCountText"
                                           Grid.Row="1"
                                           Margin="14,0,14,8"
                                           FontSize="10"
                                           Foreground="{DynamicResource ReaderMutedBrush}" />
                                <Grid Grid.Row="2">
                                    <ScrollViewer Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ReaderSearchResultList"
                                                      ItemsSource="{Binding ReaderSearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ReaderSearchResultViewModel">
                                                    <Button Classes="readerSearchResult"
                                                            Margin="0,0,14,6"
                                                            Padding="0"
                                                            BorderBrush="{DynamicResource ReaderBorderBrush}"
                                                            BorderThickness="{Binding ResultBorderThickness}"
                                                            Background="{DynamicResource ReaderPageBrush}"
                                                            Tag="{Binding}"
                                                            Click="ReaderSearchResultButton_Click">
                                                        <Border Padding="14,9,14,9">
                                                            <StackPanel Spacing="3"
                                                                        HorizontalAlignment="Stretch">
                                                            <local:ReaderSearchHighlightTextBlock Source="{Binding Title}"
                                                                                                  Query="{Binding Query}"
                                                                                                  FontSize="12"
                                                                                                  FontWeight="SemiBold"
                                                                                                  TextWrapping="Wrap"
                                                                                                  TextTrimming="CharacterEllipsis"
                                                                                                  MaxLines="2" />
                                                            <local:ReaderSearchHighlightTextBlock Source="{Binding Excerpt}"
                                                                                                  Query="{Binding Query}"
                                                                                                  HighlightRanges="{Binding ExcerptHighlightRanges}"
                                                                                                  FontSize="10"
                                                                                                  LineHeight="15"
                                                                                                  TextWrapping="Wrap"
                                                                                                  TextTrimming="CharacterEllipsis"
                                                                                                  MaxLines="4" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="ReaderSearchStatusText"
                                               Margin="20"
                                               Text="{DynamicResource Ui.Auto.2B1CF18C033FE28A}"
                                               TextAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource ReaderMutedBrush}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>

            <!-- Minimal TOC rail (极简目录): a 52-DIP marker rail that keeps the
                 chapter map visible without taking the reading column away. -->
            <Border x:Name="ReaderTocCompactPanel"
                    Grid.Column="0"
                    Width="52"
                    Margin="0,38,0,0"
                    Background="{DynamicResource ReaderSidebarBrush}"
                    BorderBrush="{DynamicResource ReaderBorderBrush}"
                    BorderThickness="0,0,1,0"
                    ZIndex="10"
                    Loaded="ReaderTocCompactPanel_Loaded"
                    IsVisible="False">
                <!-- Keep the toggle in a full toolbar row; the scroll hint
                     occupies its own row below the neighbouring header. -->
                <Grid RowDefinitions="70,*,50">
                    <Grid Grid.Row="0"
                          Width="28"
                          HorizontalAlignment="Center"
                          RowDefinitions="52,18">
                        <Button x:Name="ReaderTocCompactExpandButton"
                                Grid.Row="0"
                                Classes="readerHeader"
                                Width="28"
                                MinWidth="28"
                                Height="34"
                                Padding="0"
                                Margin="0,0,0,1"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.EDCDBACEBE531DBF}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.EDCDBACEBE531DBF}"
                                Click="ReaderTocCompactExpandButton_Click">
                            <Path Width="24"
                                  Height="24"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M8 6H16 M8 12H16 M8 18H16"
                                  Stroke="{DynamicResource ReaderInkBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  IsHitTestVisible="False" />
                        </Button>
                        <TextBlock x:Name="ReaderTocCompactUpIndicator"
                                   Grid.Row="1"
                                   Text="△"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer x:Name="ReaderTocCompactScrollViewer"
                                  Grid.Row="1"
                                  HorizontalContentAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="0,8"
                                  ScrollChanged="ReaderTocCompactScrollViewer_ScrollChanged"
                                  PointerMoved="ReaderTocCompactScrollViewer_PointerMoved"
                                  PointerExited="ReaderTocCompactScrollViewer_PointerExited"
                                  PointerWheelChanged="ReaderTocCompactScrollViewer_PointerWheelChanged">
                        <ItemsControl x:Name="ReaderTocCompactList"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ReaderTocMarker">
                                    <Button Width="50"
                                            Height="10"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="{Binding Title}"
                                            IsTabStop="False">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalContentAlignment="Center"
                                                                  VerticalContentAlignment="Center" />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Border Width="8"
                                                Height="2"
                                                Background="{Binding Fill}"
                                                BorderThickness="0"
                                                IsHitTestVisible="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="ReaderTocCompactDownIndicator"
                               Grid.Row="2"
                               Text="▽"
                               FontFamily="Segoe UI Symbol"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Reading canvas and compact controls. -->
            <Grid x:Name="ReaderContentPanel"
                  Grid.Column="1"
                  Margin="0,38,0,0"
                  Background="{DynamicResource ReaderPageBrush}"
                  ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Border x:Name="ReaderHeaderBar"
                        ZIndex="100"
                        Background="{DynamicResource ReaderChromeBrush}"
                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid Margin="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="5"
                                    VerticalAlignment="Center">
                            <Button x:Name="ReaderTocToggleButton"
                                    Classes="readerHeader"
                                    Width="38"
                                    MinWidth="38"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.Name="{DynamicResource Ui.Auto.ECDD3E4A16F4CD30}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.741925AF773FDAE3}"
                                    Click="ReaderTocButton_Click">
                                <Path x:Name="ReaderTocToggleIcon"
                                      Width="24"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M4.5 6h1.5 M9.5 6h10 M4.5 12h1.5 M9.5 12h10 M4.5 18h1.5 M9.5 18h10" />
                            </Button>
                            <Button x:Name="ReaderSearchToolbarButton"
                                    Classes="readerHeader"
                                    Width="38"
                                    MinWidth="38"
                                    AutomationProperties.Name="{DynamicResource Ui.Auto.D40E1B4E4A622EB2}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.43A641217D7F134F}"
                                    Click="ReaderSearchToolbarButton_Click">
                                <Path Width="24"
                                      Height="24"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M10 4.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 1 0 0-11Z M14.2 14.2L19.5 19.5" />
                            </Button>
                            <Button x:Name="ReaderTtsButton"
                                    Classes="readerHeader"
                                    Width="38"
                                    MinWidth="38"
                                    AutomationProperties.Name="{DynamicResource Ui.Auto.50E6C34A9A5257C7}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.57E9D77DA9EFA036}"
                                    Click="ReaderTtsButton_Click">
                                <Grid Width="24"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path x:Name="ReaderTtsButtonIcon"
                                          Width="24"
                                          Height="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4Z M15 9.5a4 4 0 0 1 0 5 M17.5 7.5a7 7 0 0 1 0 9" />
                                    <StackPanel x:Name="ReaderTtsSpectrum"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="False">
                                        <Border x:Name="ReaderTtsSpectrumBar1"
                                                Width="3"
                                                Height="6"
                                                Background="{DynamicResource ReaderInkBrush}" />
                                        <Border x:Name="ReaderTtsSpectrumBar2"
                                                Width="3"
                                                Height="11"
                                                Background="{DynamicResource ReaderInkBrush}" />
                                        <Border x:Name="ReaderTtsSpectrumBar3"
                                                Width="3"
                                                Height="17"
                                                Background="{DynamicResource ReaderInkBrush}" />
                                        <Border x:Name="ReaderTtsSpectrumBar4"
                                                Width="3"
                                                Height="22"
                                                Background="{DynamicResource ReaderInkBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="ReaderStatusText"
                                   Grid.Column="1"
                                   Margin="4,0"
                                   FontSize="10"
                                   Foreground="#858585"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <ScrollViewer Grid.Column="2"
                                      MaxWidth="920"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="5"
                                        VerticalAlignment="Center">
                                <Button x:Name="ReaderZoomOutButton"
                                        Classes="readerHeaderIcon"
                                        Content="A−"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.F9A21B596D67D9C4}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.F9A21B596D67D9C4}"
                                        Click="ReaderDecreaseFontButton_Click" />
                                <TextBlock x:Name="ReaderZoomText"
                                           Width="44"
                                           Text="100%"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ReaderZoomInButton"
                                        Classes="readerHeaderIcon"
                                        Content="A+"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.8B247B82F012C614}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.8B247B82F012C614}"
                                        Click="ReaderIncreaseFontButton_Click" />
                                <Button x:Name="ReaderPdfFitButton"
                                        Classes="readerHeader"
                                        Width="38"
                                        MinWidth="38"
                                        IsVisible="False"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.6EA534CB62BCA05C}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.6EA534CB62BCA05C}">
                                    <Path Width="24" Height="24"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="M4 5h16v14H4Z M7 12h10 M9 9.5L6.5 12L9 14.5 M15 9.5L17.5 12L15 14.5" />
                                    <Button.Flyout>
                                        <MenuFlyout FlyoutPresenterClasses="readerMenu">
                                            <MenuItem x:Name="ReaderPdfFitWidthItem"
                                                      Header="{DynamicResource Ui.Auto.C1F31E481AAA0B3B}"
                                                      ToggleType="Radio" Tag="width" Click="ReaderPdfFitItem_Click" />
                                            <MenuItem x:Name="ReaderPdfFitPageItem"
                                                      Header="{DynamicResource Ui.Auto.45F54AAA27F02EB8}"
                                                      ToggleType="Radio" Tag="page" Click="ReaderPdfFitItem_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="ReaderPdfRotateButton"
                                        Classes="readerHeader"
                                        Width="38"
                                        MinWidth="38"
                                        IsVisible="False"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.980EDB5BF6FDE833}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.980EDB5BF6FDE833}"
                                        Click="ReaderPdfRotateButton_Click">
                                    <Path Width="24" Height="24"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="M20 5v5h-5 M20 10a8 8 0 1 0-1 8" />
                                </Button>
                                <Button x:Name="ReaderFlowButton"
                                        Classes="readerHeader"
                                        Width="38"
                                        MinWidth="38"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.12856C8BCE9C08EF}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.0498D4E5A749540F}">
                                    <Path x:Name="ReaderFlowIcon"
                                          Width="24"
                                          Height="24"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="M5 4.5h14v15h-14Z M12 8.5v6.5 M9.3 12.3L12 15L14.7 12.3" />
                                    <Button.Flyout>
                                        <MenuFlyout FlyoutPresenterClasses="readerMenu">
                                            <MenuItem x:Name="ReaderScrollModeItem"
                                                      Header="{DynamicResource Ui.Auto.34DEDAFFD3CC55F0}"
                                                      ToggleType="Radio"
                                                      IsChecked="True"
                                                      Tag="scroll"
                                                      Click="ReaderFlowModeItem_Click" />
                                            <MenuItem x:Name="ReaderSinglePageModeItem"
                                                      Header="{DynamicResource Ui.Auto.5407E215AEF82C28}"
                                                      ToggleType="Radio"
                                                      Tag="single"
                                                      Click="ReaderFlowModeItem_Click" />
                                            <MenuItem x:Name="ReaderTwoPageModeItem"
                                                      Header="{DynamicResource Ui.Auto.8F1387BE20D72938}"
                                                      ToggleType="Radio"
                                                      Tag="double"
                                                      Click="ReaderFlowModeItem_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="ReaderBookmarkButton"
                                        Classes="readerHeader"
                                        Width="38"
                                        MinWidth="38"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.3FF66E53453FEC82}"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.3FF66E53453FEC82}"
                                        Click="ReaderBookmarkButton_Click">
                                    <Path Width="24"
                                          Height="24"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="M7 4.5h10v15l-5-4.2-5 4.2Z" />
                                </Button>
                                <Button x:Name="ReaderAssistantToggleButton"
                                        Classes="readerHeader"
                                        Width="38"
                                        MinWidth="38"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.11FB682BE0A0233D}"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.90298AE01BB88F61}"
                                        Click="ReaderAssistantToggleButton_Click">
                                    <Path Width="24"
                                          Height="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="M12 3.5C12.7 7.9 16.1 11.3 20.5 12 16.1 12.7 12.7 16.1 12 20.5 11.3 16.1 7.9 12.7 3.5 12 7.9 11.3 11.3 7.9 12 3.5Z" />
                                </Button>
                                <Button x:Name="ReaderMoreButton"
                                        Classes="readerHeader"
                                        Width="38"
                                        MinWidth="38"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.863C2A1656503DF6}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.863C2A1656503DF6}">
                                    <Path Width="24"
                                          Height="24"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="2.4"
                                          StrokeLineCap="Round"
                                          Data="M5 12h.01 M12 12h.01 M19 12h.01" />
                                    <Button.Flyout>
                                        <MenuFlyout FlyoutPresenterClasses="readerMenu">
                                            <MenuItem x:Name="ReaderZenMenuItem"
                                                      Header="{DynamicResource Ui.Auto.DA97EC360354D5D9}"
                                                      ToggleType="CheckBox"
                                                      ToolTip.Tip="{DynamicResource Ui.Auto.1DD7FE5E8D54B499}"
                                                      Click="ReaderZenMenuItem_Click" />
                                            <MenuItem Header="{DynamicResource Ui.Reader.Settings}"
                                                      ToolTip.Tip="{DynamicResource Ui.Auto.08C4E230A0A0C905}"
                                                      Click="ReaderLayoutSettingsMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Ui.Auto.CFC1C4D46546AA1B}">
                                                <MenuItem x:Name="ReaderAnimationNoneItem"
                                                          Header="{DynamicResource Ui.Auto.75C526D48AF0482C}"
                                                          ToggleType="Radio"
                                                          Tag="none"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationFadeItem"
                                                          Header="{DynamicResource Ui.Auto.CB8E98402CFBCDF5}"
                                                          ToggleType="Radio"
                                                          IsChecked="True"
                                                          Tag="fade"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationSlideItem"
                                                          Header="{DynamicResource Ui.Auto.453D08190DDC92EB}"
                                                          ToggleType="Radio"
                                                          Tag="slide"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationWaveItem"
                                                          Header="{DynamicResource Ui.Auto.365742C670872BDF}"
                                                          ToggleType="Radio"
                                                          Tag="wave"
                                                          Click="ReaderAnimationItem_Click" />
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid x:Name="ReaderReadingArea"
                      Grid.Row="1"
                      Background="{DynamicResource ReaderPageBrush}">
                    <Grid x:Name="ReaderWebViewHost"
                          Margin="0,12,2,10"
                          Background="{DynamicResource ReaderPageBrush}"
                          SizeChanged="ReaderWebViewHost_SizeChanged">
                        <ContentControl x:Name="ReaderActiveHostSlot"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                        <ContentControl x:Name="ReaderPreloadHostSlot"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                        <!-- Native page-turn transition overlay for the
                             self-drawn reader surface. The captured old-page
                             snapshot sits above the live content while fade,
                             slide or e-ink wave animations reveal the new
                             page; the band/edge rectangles are driven by
                             ReaderTransitionPlayer. -->
                        <Panel x:Name="ReaderNativeTransitionLayer"
                               IsHitTestVisible="False"
                               ClipToBounds="True"
                               ZIndex="25">
                            <Image x:Name="ReaderNativeTransitionSnapshot"
                                   IsHitTestVisible="False"
                                   Stretch="None"
                                   IsVisible="False" />
                            <Rectangle x:Name="ReaderNativeTransitionTrail"
                                       IsHitTestVisible="False"
                                       IsVisible="False" />
                            <Rectangle x:Name="ReaderNativeTransitionFront"
                                       IsHitTestVisible="False"
                                       IsVisible="False" />
                            <Rectangle x:Name="ReaderNativeTransitionEdge"
                                       IsHitTestVisible="False"
                                       IsVisible="False"
                                       Fill="#22000000" />
                        </Panel>
                    </Grid>

                    <Border x:Name="ReaderLinuxTextFallbackOverlay"
                            Margin="0,12,2,10"
                            Background="{DynamicResource ReaderPageBrush}"
                            ClipToBounds="True"
                            IsVisible="False"
                            Focusable="True"
                            Tapped="ReaderLinuxTextFallback_Tapped"
                            PointerMoved="ReaderLinuxTextFallback_PointerMoved"
                            PointerWheelChanged="ReaderLinuxTextFallback_PointerWheelChanged"
                            KeyDown="ReaderLinuxTextFallback_KeyDown"
                            ZIndex="25">
                        <Grid x:Name="ReaderLinuxTextFallbackContent">
                            <ScrollViewer x:Name="ReaderLinuxTextFallbackScroll"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="24,18"
                                          ScrollChanged="ReaderLinuxTextFallbackScroll_ScrollChanged">
                                <StackPanel Spacing="0">
                                    <SelectableTextBlock x:Name="ReaderLinuxTextFallbackText"
                                                         IsVisible="False"
                                                         FontFamily="{StaticResource ReaderFallbackFontFamily}"
                                                         SelectionBrush="{DynamicResource ReaderInkBrush}"
                                                         SelectionForegroundBrush="{DynamicResource ReaderPageBrush}" />
                                    <ItemsControl ItemsSource="{Binding ReaderLinuxTextFallbackBlocks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="{Binding DisplayMargin}">
                                                    <Grid>
                                                        <local:ReaderLinuxTextFallbackTextBlock Block="{Binding}"
                                                                                                  IsVisible="{Binding IsText}"
                                                                                                   FontFamily="{StaticResource ReaderFallbackFontFamily}"
                                                                                                  FontSize="{Binding FontSize}"
                                                                                                  LineHeight="{Binding LineHeight}"
                                                                                                  MaxWidth="{Binding MaxWidth}"
                                                                                                  Width="{Binding Width}"
                                                                                                  Foreground="{DynamicResource ReaderInkBrush}"
                                                                                                   SelectionBrush="{DynamicResource ReaderInkBrush}"
                                                                                                  AnnotationRanges="{Binding AnnotationRanges}"
                                                                                                  InvertedSelectionBackground="{DynamicResource ReaderInkBrush}"
                                                                                                  InvertedSelectionForeground="{DynamicResource ReaderInputBrush}"
                                                                                                  TextWrapping="Wrap"
                                                                                                  HorizontalAlignment="Center"
                                                                                                  PointerReleased="ReaderLinuxTextFallback_ContentPointerReleased"
                                                                                                  FootnotePointerEntered="ReaderLinuxTextFallbackFootnoteButton_PointerEntered"
                                                                                                  FootnotePointerExited="ReaderLinuxTextFallbackFootnoteButton_PointerExited" />
                                                        <Image Source="{Binding Image.Source}"
                                                               IsVisible="{Binding IsImage}"
                                                               MaxWidth="{Binding Image.MaxWidth}"
                                                               MaxHeight="{Binding Image.MaxHeight}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="ReaderLinuxTextFallbackPagedRoot"
                                    IsVisible="False"
                                    Padding="24">
                                <Grid x:Name="ReaderLinuxTextFallbackPagedContent"
                                      ColumnDefinitions="*,28,*">
                                    <Image x:Name="ReaderLinuxTextFallbackPageImageLeft"
                                           Grid.Column="0"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="False" />
                                    <local:ReaderLinuxTextFallbackTextBlock x:Name="ReaderLinuxTextFallbackPageLeft"
                                                        Grid.Column="0"
                                                         FontFamily="{StaticResource ReaderFallbackFontFamily}"
                                                        Foreground="{DynamicResource ReaderInkBrush}"
                                                        SelectionBrush="{DynamicResource ReaderInkBrush}"
                                                        InvertedSelectionBackground="{DynamicResource ReaderInkBrush}"
                                                        InvertedSelectionForeground="{DynamicResource ReaderInputBrush}"
                                                        TextAlignment="Left"
                                                        TextWrapping="Wrap"
                                                        HorizontalAlignment="Stretch"
                                                        PointerReleased="ReaderLinuxTextFallback_ContentPointerReleased" />
                                    <Button x:Name="ReaderLinuxTextFallbackPageFootnoteLeft"
                                            Grid.Column="0"
                                            Classes="readerFootnoteMarker"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="False"
                                            PointerEntered="ReaderLinuxTextFallbackFootnoteButton_PointerEntered"
                                            PointerExited="ReaderLinuxTextFallbackFootnoteButton_PointerExited" />
                                    <Image x:Name="ReaderLinuxTextFallbackPageImageRight"
                                           Grid.Column="2"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="False" />
                                    <local:ReaderLinuxTextFallbackTextBlock x:Name="ReaderLinuxTextFallbackPageRight"
                                                        Grid.Column="2"
                                                         FontFamily="{StaticResource ReaderFallbackFontFamily}"
                                                        Foreground="{DynamicResource ReaderInkBrush}"
                                                        SelectionBrush="{DynamicResource ReaderInkBrush}"
                                                        InvertedSelectionBackground="{DynamicResource ReaderInkBrush}"
                                                        InvertedSelectionForeground="{DynamicResource ReaderInputBrush}"
                                                        TextAlignment="Left"
                                                        TextWrapping="Wrap"
                                                        HorizontalAlignment="Stretch"
                                                        IsVisible="False"
                                                        PointerReleased="ReaderLinuxTextFallback_ContentPointerReleased" />
                                    <Button x:Name="ReaderLinuxTextFallbackPageFootnoteRight"
                                            Grid.Column="2"
                                            Classes="readerFootnoteMarker"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="False"
                                            PointerEntered="ReaderLinuxTextFallbackFootnoteButton_PointerEntered"
                                            PointerExited="ReaderLinuxTextFallbackFootnoteButton_PointerExited" />
                                    <!-- Vertical writing renders through a custom
                                         drawing surface: Avalonia's text stack has no
                                         vertical layout. Single page only — the
                                         layout defaults force vertical into paged
                                         single-page mode on every platform. -->
                                    <local:ReaderLinuxTextFallbackVerticalPage x:Name="ReaderLinuxTextFallbackPageVertical"
                                                        Grid.Column="0"
                                                         FontFamily="{StaticResource ReaderFallbackFontFamily}"
                                                        Foreground="{DynamicResource ReaderInkBrush}"
                                                        InvertedSelectionBackground="{DynamicResource ReaderInkBrush}"
                                                        InvertedSelectionForeground="{DynamicResource ReaderInputBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="False" />
                                </Grid>
                            </Border>
                            <!-- Native page-turn transition overlay for the
                                 fallback reader. The captured old-page snapshot
                                 sits above the live content while fade, slide or
                                 e-ink wave animations reveal the new page; the
                                 band/edge rectangles are driven by
                                 ReaderTransitionPlayer. -->
                            <Panel x:Name="ReaderLinuxTextFallbackTransitionLayer"
                                   IsVisible="True"
                                   IsHitTestVisible="False"
                                   ClipToBounds="True">
                                <Image x:Name="ReaderLinuxTextFallbackTransitionSnapshot"
                                       IsHitTestVisible="False"
                                       Stretch="None"
                                       IsVisible="False" />
                                <Rectangle x:Name="ReaderLinuxTextFallbackTransitionTrail"
                                           IsHitTestVisible="False"
                                           IsVisible="False" />
                                <Rectangle x:Name="ReaderLinuxTextFallbackTransitionFront"
                                           IsHitTestVisible="False"
                                           IsVisible="False" />
                                <Rectangle x:Name="ReaderLinuxTextFallbackTransitionEdge"
                                           IsHitTestVisible="False"
                                           IsVisible="False"
                                           Fill="#22000000" />
                            </Panel>
                        </Grid>
                    </Border>

                    <!-- Native webviews paint over child Avalonia content. Keep
                         these decorations as later siblings so they render on
                         top of the active reading surface, matching WinUI. -->
                    <Border x:Name="ReaderWebViewBottomCover"
                            Height="2"
                            Margin="0,0,0,10"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource ReaderPageBrush}"
                            IsHitTestVisible="False"
                            ZIndex="30" />
                    <Border x:Name="ReaderBookmarkCornerButton"
                            Width="34"
                            Height="34"
                            Margin="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ZIndex="40"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.1A1C1F1C22E9FD05}"
                            ToolTip.Tip="{DynamicResource Ui.Auto.1A1C1F1C22E9FD05}"
                            Cursor="Hand"
                            IsVisible="False"
                            PointerPressed="ReaderBookmarkCornerButton_PointerPressed">
                        <Path x:Name="ReaderBookmarkCornerMarker"
                              Width="26"
                              Height="26"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Data="M 0,0 L 26,0 L 26,26 Z"
                              Fill="{DynamicResource ReaderInkBrush}"
                              Stretch="None"
                              IsHitTestVisible="False"
                              IsVisible="False" />
                    </Border>

                    <!-- This must remain a sibling after the native WebView
                         slots. Native child windows paint over Avalonia
                         children, so an in-page search bar nested inside
                         ReaderWebViewHost is not reliably visible/clickable. -->
                    <Border x:Name="ReaderInPageSearchBar"
                            Width="430"
                            Padding="10,8"
                            Margin="0,16,24,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource ReaderPageBrush}"
                            BorderBrush="{DynamicResource ReaderBorderBrush}"
                            BorderThickness="1"
                            IsVisible="False"
                            ZIndex="45">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <TextBox x:Name="ReaderInPageSearchBox"
                                     Height="32"
                                     Padding="8,4"
                                     PlaceholderText="{DynamicResource Ui.Auto.74433F289DA5E5AD}"
                                     TextChanged="ReaderInPageSearchBox_TextChanged"
                                     KeyDown="ReaderInPageSearchBox_KeyDown" />
                            <TextBlock x:Name="ReaderInPageSearchCountText"
                                       Grid.Column="1"
                                       MinWidth="48"
                                       Text="0/0"
                                       FontSize="11"
                                       Foreground="{DynamicResource ReaderMutedBrush}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="icon" Width="32" MinWidth="32" Height="32" Content="↑" Click="ReaderInPageSearchPreviousButton_Click" />
                            <Button Grid.Column="3" Classes="icon" Width="32" MinWidth="32" Height="32" Content="↓" Click="ReaderInPageSearchNextButton_Click" />
                            <Button Grid.Column="4" Classes="icon" Width="32" MinWidth="32" Height="32" Content="×" Click="ReaderInPageSearchCloseButton_Click" />
                        </Grid>
                    </Border>

                    <!-- Slim floating bar shown only in zen mode. -->
                    <Border x:Name="ReaderZenBar"
                            Padding="2,2,2,2"
                            Margin="0,16,24,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource ReaderPageBrush}"
                            BorderBrush="{DynamicResource ReaderBorderBrush}"
                            BorderThickness="1"
                            IsVisible="False"
                            ZIndex="70">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{DynamicResource Ui.Auto.DA97EC360354D5D9}"
                                       Margin="10,0,2,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ReaderZenTocButton"
                                    Classes="readerToolbar"
                                    Content="{DynamicResource Ui.Auto.73C9B3F7F3A16007}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.73D49673812F4264}"
                                    Click="ReaderZenMinimalTocButton_Click" />
                            <Button x:Name="ReaderExitZenButton"
                                    Classes="readerToolbar"
                                    Content="{DynamicResource Ui.Auto.AF30F6FFB6EA23CF}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.987BA0B5C2710754}"
                                    Click="ReaderExitZenButton_Click" />
                            <Button x:Name="ReaderZenCloseButton"
                                    Classes="icon readerCloseButton"
                                    Content="×"
                                    FontSize="15"
                                    AutomationProperties.Name="{DynamicResource Ui.Auto.A8B1F579ACBCC5D5}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.A51CE8191584FCF7}"
                                    Click="CloseReaderButton_Click" />
                        </StackPanel>
                    </Border>
                    <!-- iPod-style click wheel for in-page playback. It rests
                         just beyond the right edge while listening and slides
                         out when the pointer reaches the edge handle. -->
                    <Border x:Name="ReaderTtsFloatingEdgeActivationRegion"
                            Width="36"
                            Height="160"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Cursor="Hand"
                            ZIndex="79"
                            PointerEntered="ReaderTtsFloatingEdgeActivationRegion_PointerEntered"
                            PointerExited="ReaderTtsFloatingEdgeActivationRegion_PointerExited"
                            PointerMoved="ReaderTtsFloatingEdgeActivationRegion_PointerMoved" />
                    <Canvas x:Name="ReaderTtsFloatingPanel"
                            Width="128"
                            Height="128"
                            Margin="0,0,22,20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            IsVisible="False"
                            PointerEntered="ReaderTtsFloatingPanel_PointerEntered"
                            PointerExited="ReaderTtsFloatingPanel_PointerExited"
                            PointerMoved="ReaderTtsFloatingPanel_PointerMoved"
                            RenderTransformOrigin="50%,50%"
                            ZIndex="80">
                    <Canvas.RenderTransform>
                        <TranslateTransform X="134">
                            <TranslateTransform.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="X"
                                                       Duration="0:0:0.28"
                                                       Easing="CubicEaseOut" />
                                </Transitions>
                            </TranslateTransform.Transitions>
                        </TranslateTransform>
                    </Canvas.RenderTransform>
                    <!-- Transparent input surface keeps the gaps between the
                         wheel buttons part of the hover target. -->
                    <Border Width="128"
                            Height="128"
                            Background="Transparent"
                            PointerEntered="ReaderTtsFloatingPanel_PointerEntered"
                            PointerExited="ReaderTtsFloatingPanel_PointerExited"
                            PointerMoved="ReaderTtsFloatingPanel_PointerMoved" />
                    <Ellipse Width="128"
                             Height="128"
                             Fill="{DynamicResource ReaderPageBrush}"
                             Stroke="{DynamicResource ReaderBorderBrush}"
                             StrokeThickness="1"
                             IsHitTestVisible="False" />
                    <Button x:Name="ReaderTtsFloatingMenuButton"
                            Canvas.Left="46"
                            Canvas.Top="6"
                            Classes="readerTtsWheelButton"
                            Content="MENU"
                            ContentTemplate="{StaticResource ReaderTtsFloatingGlyphTemplate}"
                            FontSize="10"
                            ToolTip.Tip="听书菜单"
                            Click="ReaderTtsFloatingMenuButton_Click" />
                    <Button x:Name="ReaderTtsFloatingPreviousButton"
                            Canvas.Left="5"
                            Canvas.Top="53"
                            Classes="readerTtsWheelButton"
                            Content="‹‹"
                            ContentTemplate="{StaticResource ReaderTtsFloatingGlyphTemplate}"
                            FontSize="15"
                            ToolTip.Tip="上一章"
                            IsEnabled="False"
                            Click="ReaderTtsFloatingPreviousButton_Click" />
                    <Button x:Name="ReaderTtsFloatingNextButton"
                            Canvas.Left="91"
                            Canvas.Top="53"
                            Classes="readerTtsWheelButton"
                            Content="››"
                            ContentTemplate="{StaticResource ReaderTtsFloatingGlyphTemplate}"
                            FontSize="15"
                            ToolTip.Tip="下一章"
                            IsEnabled="False"
                            Click="ReaderTtsFloatingNextButton_Click" />
                    <Button x:Name="ReaderTtsFloatingToggleButton"
                            Canvas.Left="46"
                            Canvas.Top="102"
                            Classes="readerTtsWheelButton"
                            Content="Ⅱ"
                            ContentTemplate="{StaticResource ReaderTtsFloatingGlyphTemplate}"
                            FontSize="12"
                            ToolTip.Tip="暂停/继续"
                            Click="ReaderTtsFloatingToggleButton_Click" />
                    <Button x:Name="ReaderTtsFloatingStopButton"
                            Canvas.Left="41"
                            Canvas.Top="41"
                            Classes="readerTtsWheelCenter"
                            Content="■"
                            ContentTemplate="{StaticResource ReaderTtsFloatingGlyphTemplate}"
                            ToolTip.Tip="停止听书"
                            Click="ReaderTtsFloatingStopButton_Click" />
                </Canvas>

                </Grid>

                <Border x:Name="ReaderFooterBar"
                        Grid.Row="2"
                        ZIndex="100"
                        Background="{DynamicResource ReaderChromeBrush}"
                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid Margin="14,4" ColumnDefinitions="34,34,*,Auto,Auto" ColumnSpacing="10">
                        <Button x:Name="ReaderPreviousButton"
                                Classes="readerToolbar"
                                Content="‹"
                                FontSize="16"
                                Width="34"
                                Height="30"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.393F2A5120AC2098}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.393F2A5120AC2098}"
                                Click="ReaderPreviousButton_Click" />
                        <Button x:Name="ReaderNextButton"
                                Grid.Column="1"
                                Classes="readerToolbar"
                                Content="›"
                                FontSize="16"
                                Width="34"
                                Height="30"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.9443994BC3B186C5}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.9443994BC3B186C5}"
                                Click="ReaderNextButton_Click" />
                        <Slider x:Name="ReaderProgressSlider"
                                Grid.Column="2"
                                Classes="noAutoToolTip"
                                Margin="6,0,14,0"
                                MinWidth="120"
                                Minimum="1"
                                Maximum="1"
                                Value="1"
                                VerticalAlignment="Center"
                                Loaded="ReaderProgressSlider_Loaded"
                                ValueChanged="ReaderProgressSlider_ValueChanged"
                                PointerPressed="ReaderProgressSlider_PointerPressed"
                                PointerMoved="ReaderProgressSlider_PointerMoved"
                                PointerReleased="ReaderProgressSlider_PointerReleased"
                                PointerExited="ReaderProgressSlider_PointerExited">
                            <Slider.Resources>
                                <CornerRadius x:Key="SliderThumbCornerRadius">999</CornerRadius>
                            </Slider.Resources>
                            <Slider.Styles>
                                <Style Selector="Slider /template/ Thumb">
                                    <Setter Property="Width" Value="12" />
                                    <Setter Property="Height" Value="12" />
                                    <Setter Property="MinWidth" Value="12" />
                                    <Setter Property="MinHeight" Value="12" />
                                    <Setter Property="MaxWidth" Value="12" />
                                    <Setter Property="MaxHeight" Value="12" />
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Slider.Styles>
                        </Slider>
                        <TextBlock x:Name="ReaderChapterText"
                                   Grid.Column="4"
                                   MinWidth="44"
                                   FontSize="11"
                                   Foreground="{DynamicResource ReaderMutedBrush}"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Border x:Name="ReaderPdfBadge"
                                Grid.Column="3"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ReaderHoverBrush}"
                                BorderBrush="{DynamicResource ReaderBorderBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="ReaderPdfBottomText"
                                       Text="PDF"
                                       FontSize="9"
                                       Foreground="{DynamicResource ReaderMutedBrush}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- AI conversation and persistent annotations. -->
            <Border x:Name="ReaderAssistantPanel"
                    Grid.Column="2"
                    Margin="0,38,0,0"
                    IsVisible="False"
                    Background="{DynamicResource ReaderSidebarBrush}">
                <Grid RowDefinitions="52,*,Auto">
                    <!-- Match the TOC divider: start below the shared tab
                         header so the separator does not protrude above it. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="2"
                               Width="1"
                               HorizontalAlignment="Left"
                               Fill="{DynamicResource ReaderBorderBrush}"
                               IsHitTestVisible="False"
                               ZIndex="21" />

                    <Border Background="{DynamicResource ReaderChromeBrush}"
                            BorderBrush="{DynamicResource ReaderBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,2" ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                            <Button x:Name="ReaderAiTabButton"
                                    Grid.Column="0"
                                    Classes="readerAssistantTab active"
                                    Content="{DynamicResource Ui.Auto.69825479A95E6330}"
                                    HorizontalAlignment="Stretch"
                                    Click="ReaderAiTabButton_Click" />
                            <Button x:Name="ReaderNotesTabButton"
                                    Grid.Column="1"
                                    Classes="readerAssistantTab"
                                    Content="{DynamicResource Ui.Auto.3062C477D4C1E1FA}"
                                    HorizontalAlignment="Stretch"
                                    Click="ReaderNotesTabButton_Click" />
                            <Button Grid.Column="2"
                                    Classes="icon"
                                    Width="38"
                                    MinWidth="38"
                                    Height="34"
                                    AutomationProperties.Name="{DynamicResource Ui.Auto.2CCF650A61080689}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.2CCF650A61080689}"
                                    Click="ReaderAssistantToggleButton_Click">
                                <Path Width="18"
                                      Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M11 4.5L5 9L11 13.5"
                                      Stroke="{DynamicResource ReaderInkBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      IsHitTestVisible="False" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid x:Name="ReaderAiView" RowDefinitions="*,Auto" Background="Transparent">
                            <ScrollViewer x:Name="ReaderAiScrollViewer" Padding="20,24,20,12" VerticalScrollBarVisibility="Auto" ScrollChanged="ReaderAiScrollViewer_ScrollChanged">
                                <StackPanel Spacing="24">
                                    <StackPanel x:Name="ReaderAiEmptyState" Spacing="12" Margin="0,24,0,12">
                                        <TextBlock Text="{DynamicResource Ui.Auto.A3628E64A4842E6F}" FontSize="20" Foreground="{DynamicResource ReaderInkBrush}" />
                                        <TextBlock Text="{DynamicResource Ui.Auto.5F14F7F49C437BA2}" FontSize="12" Foreground="{DynamicResource ReaderMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ItemsControl x:Name="ReaderChatMessagesPanel" ItemsSource="{Binding ReaderAiMessages}" Margin="0,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:ReaderAiMessageViewModel">
                                                <Grid HorizontalAlignment="Stretch" Margin="0,3">
                                                    <Border MaxWidth="520"
                                                            MinWidth="96"
                                                            Padding="10,10"
                                                            HorizontalAlignment="{Binding BubbleAlignment}"
                                                            Classes="readerAiBubble" Classes.user="{Binding IsUser}"
                                                            BorderBrush="{Binding BorderBrush}"
                                                            BorderThickness="0"
                                                            CornerRadius="4">
                                                        <StackPanel Spacing="10">
                                                        <TextBlock Text="{Binding RoleLabel}" FontSize="11" Foreground="{DynamicResource ReaderMutedBrush}" />
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="5"
                                                                    IsVisible="{Binding IsThinkingRowVisible}">
                                                            <Button Classes="readerAiReasoningToggle"
                                                                    Content="{Binding ReasoningToggleLabel}"
                                                                    IsVisible="{Binding HasReasoning}"
                                                                    HorizontalAlignment="Left"
                                                                    Click="ReaderAiReasoningToggleButton_Click" />
                                                            <TextBlock Text="{Binding ThinkingLabel}"
                                                                       IsVisible="{Binding IsThinkingLabelVisible}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource ReaderMutedBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Path Width="11"
                                                                  Height="11"
                                                                  Stretch="Uniform"
                                                                  Fill="{DynamicResource ReaderMutedBrush}"
                                                                  Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 H 17.65 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 H 20 V 4 Z"
                                                                  IsVisible="{Binding IsThinking}"
                                                                  RenderTransformOrigin="50%,50%"
                                                                  IsHitTestVisible="False">
                                                                <Path.RenderTransform>
                                                                    <RotateTransform Angle="{Binding ThinkingRotation}" />
                                                                </Path.RenderTransform>
                                                            </Path>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Reasoning}"
                                                                   IsVisible="{Binding IsReasoningVisible}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ReaderMutedBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Content}"
                                                                   IsVisible="{Binding IsUser}"
                                                                   Foreground="{DynamicResource ReaderInkBrush}"
                                                                   FontSize="14"
                                                                   TextWrapping="Wrap" />
                                                         <local:KreaderMarkdownTextBlock Markdown="{Binding Content}"
                                                                                          IsVisible="{Binding IsAssistant}"
                                                                                          CitationAction="{Binding CitationAction}"
                                                                                          Foreground="{DynamicResource ReaderInkBrush}"
                                                                                          FontSize="14"
                                                                                          LineHeight="24"
                                                                                          TextWrapping="Wrap" />
                                                         <StackPanel Spacing="4" IsVisible="{Binding HasSources}">
                                                             <Button Classes="readerAiReasoningToggle"
                                                                     HorizontalAlignment="Left"
                                                                     Click="ReaderAiMessageSourcesToggleButton_Click">
                                                                 <StackPanel Orientation="Horizontal" Spacing="4">
                                                                     <TextBlock Text="{Binding SourcesToggleGlyph}" FontSize="10" />
                                                                     <TextBlock Text="{DynamicResource Ui.Auto.DA3968C80FE7A060}" />
                                                                 </StackPanel>
                                                             </Button>
                                                             <ItemsControl ItemsSource="{Binding Sources}"
                                                                           IsVisible="{Binding IsSourcesExpanded}">
                                                                 <ItemsControl.ItemTemplate>
                                                                     <DataTemplate x:DataType="local:ReaderAiSourceViewModel">
                                                                         <Button Classes="readerNoteItem"
                                                                                 Tag="{Binding}"
                                                                                 HorizontalContentAlignment="Left"
                                                                                 Click="ReaderAiSourceButton_Click">
                                                                             <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="11" />
                                                                         </Button>
                                                                     </DataTemplate>
                                                                 </ItemsControl.ItemTemplate>
                                                             </ItemsControl>
                                                         </StackPanel>
                                                         <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsAssistant}">
                                                             <Button Content="{DynamicResource Ui.Auto.63D90D977348AB1F}" Classes="readerAiReasoningToggle" IsVisible="{Binding CanCopy}" Click="ReaderAiCopyButton_Click" />
                                                             <Button Content="{DynamicResource Ui.Auto.A3030BF8F16DC63C}" Classes="readerAiReasoningToggle" IsVisible="{Binding CanCopy}" Click="ReaderAiSaveAnswerButton_Click" />
                                                             <Button Content="{DynamicResource Ui.Auto.3221A042EA3677A8}" Classes="readerAiReasoningToggle" IsVisible="{Binding CanRetry}" Click="ReaderAiRetryButton_Click" />
                                                         </StackPanel>
                                                         <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" FontSize="11" Foreground="{DynamicResource ReaderMutedBrush}" TextWrapping="Wrap" />
                                                         </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid x:Name="ReaderAiComposer" Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" Margin="20,8,20,16" SizeChanged="ReaderAiComposer_SizeChanged">
                                <Button x:Name="ReaderAiNewContentButton" Content="{DynamicResource Ui.Auto.07E68FA158F2077C}" Classes="readerAiQuickOption" IsVisible="False" HorizontalAlignment="Center" Click="ReaderAiNewContentButton_Click" />
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                        <Ellipse x:Name="ReaderAiVectorStatusDot"
                                                 Width="7"
                                                 Height="7"
                                                 VerticalAlignment="Center"
                                                 Fill="#D6A100"
                                                 ToolTip.Tip="{DynamicResource Ui.Auto.8372A76EAD8077A9}"
                                                 AutomationProperties.Name="{DynamicResource Ui.Auto.8372A76EAD8077A9}" />
                                        <TextBlock x:Name="ReaderAiScopeText" Grid.Column="1" Text="{DynamicResource Ui.Auto.C558C087EB70654C}" FontSize="11" Foreground="{DynamicResource ReaderMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                    <Button x:Name="ReaderAiOptionsButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource Ui.Auto.B94E8C2A0D642FC5}"
                                            Classes="readerAiReasoningToggle">
                                        <Button.Flyout>
                                            <MenuFlyout FlyoutPresenterClasses="readerMenu" ShowMode="Transient"
                                                        Placement="Bottom"
                                                        VerticalOffset="4">
                                                <MenuItem x:Name="ReaderAiModelMenuItem"
                                                          Header="{DynamicResource Ui.Auto.C98E118E0A43F078}" />
                                                <MenuItem x:Name="ReaderAiReasoningMenuItem"
                                                          Header="{DynamicResource Ui.Auto.2FD1FCDA22E20FF7}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button x:Name="ReaderAiClearButton" Grid.Column="2" Content="{DynamicResource Ui.Auto.1EF3DE06B32E521B}" Classes="readerAiReasoningToggle" Click="ReaderAiClearButton_Click" />
                                </Grid>
                                <Border Grid.Row="2" BorderBrush="{DynamicResource ReaderBorderBrush}" BorderThickness="1" CornerRadius="0" Background="{DynamicResource ReaderPageBrush}">
                                <Grid RowDefinitions="Auto,Auto" ClipToBounds="True">
                                    <TextBox x:Name="ReaderAiQuestionBox"
                                             Classes="readerMinimalField readerAiQuestionInput"
                                             MinHeight="68"
                                             MaxHeight="160"
                                             FontSize="14"
                                             Background="{DynamicResource ReaderPageBrush}"
                                             BorderThickness="0"
                                             Padding="12,10"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             PlaceholderText="{DynamicResource Ui.Auto.8513176BCF21002D}"
                                             />
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,0,6,6">
                                    <StackPanel x:Name="ReaderAiQuickActions" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Ui.Auto.04830193B408EEB1}" ToolTip.Tip="{DynamicResource Ui.Auto.98B4E0EFFCF15443}" Classes="readerAiReasoningToggle" Click="ReaderAiSummarizeChapterButton_Click" />
                                        <Button Content="{DynamicResource Ui.Auto.23CEC14BBCFAB6FA}" ToolTip.Tip="{DynamicResource Ui.Auto.9B4D1CC07395F4B1}" Classes="readerAiReasoningToggle" Click="ReaderAiExplainSelectionButton_Click" />
                                        <Button Content="{DynamicResource Ui.Auto.51AFFFDDE76EA35A}" ToolTip.Tip="{DynamicResource Ui.Auto.7A4BBB19D1387A93}" Classes="readerAiReasoningToggle" Click="ReaderAiSummarizeBookButton_Click" />
                                    </StackPanel>
                                    <Button x:Name="ReaderAiSendButton"
                                            Grid.Column="1"
                                            Classes="readerAiSendButton"
                                            Width="34"
                                            MinWidth="34"
                                            Height="34"
                                            MinHeight="34"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.EDECF0AE6E5144F9}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.EDECF0AE6E5144F9}"
                                            Click="ReaderAiSendButton_Click">
                                        <Path x:Name="ReaderAiSendGlyph" Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Fill="{Binding $parent[Button].Foreground}"
                                              Data="M 12,3 L 18.2,9.2 L 17.3,10.1 L 12.45,5.25 L 12.45,21 L 11.55,21 L 11.55,5.25 L 6.7,10.1 L 5.8,9.2 Z"
                                              IsHitTestVisible="False" />
                                    </Button>
                                    </Grid>
                                </Grid>
                                </Border>
                                <TextBlock x:Name="ReaderAiStatusText"
                                           IsVisible="False"
                                           Width="0"
                                           Height="0" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="ReaderNotesView" IsVisible="False" RowDefinitions="*,Auto">
                            <ScrollViewer Grid.Row="0" Padding="20,18,20,12" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <TextBlock x:Name="ReaderAnnotationEmptyText"
                                               Text="{DynamicResource Ui.Auto.E801393E50EE0F3D}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ReaderMutedBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="False" />
                                    <ItemsControl x:Name="ReaderAnnotationList" ItemsSource="{Binding ReaderAnnotations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:ReaderAnnotation">
                                                <Border BorderBrush="{DynamicResource ReaderBorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,0,0,5"
                                                        Margin="0,0,0,6"
                                                        HorizontalAlignment="Stretch">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Button Classes="readerNoteItem"
                                                                Tag="{Binding}"
                                                                MinHeight="0"
                                                                Padding="2,4"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalContentAlignment="Stretch"
                                                                Click="ReaderAnnotationItemButton_Click">
                                                            <StackPanel Spacing="3" HorizontalAlignment="Stretch">
                                                                <TextBlock Text="{Binding DisplayQuote}" FontSize="11" FontWeight="SemiBold" MaxHeight="54" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding DisplayNote}" FontSize="10" Foreground="{DynamicResource ReaderMutedBrush}" MaxHeight="54" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="1"
                                                                Classes="icon"
                                                                Width="30"
                                                                MinWidth="30"
                                                                Height="30"
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Top"
                                                                AutomationProperties.Name="{DynamicResource Ui.Auto.E06985CB8EEAACEB}"
                                                                ToolTip.Tip="{DynamicResource Ui.Auto.E06985CB8EEAACEB}"
                                                                Tag="{Binding}"
                                                                Click="ReaderAnnotationItemDeleteButton_Click">
                                                            <Path Width="10"
                                                                  Height="10"
                                                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                                                  Stroke="{DynamicResource ReaderInkBrush}"
                                                                  StrokeThickness="1.2"
                                                                  StrokeLineCap="Square"
                                                                  IsHitTestVisible="False" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ReaderExportStatusText" FontSize="10" Foreground="{DynamicResource ReaderMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer x:Name="ReaderAiSettingsView"
                                      IsVisible="False"
                                      Padding="18,16,18,18"
                                      VerticalScrollBarVisibility="Auto"
                                      SizeChanged="ReaderAiSettingsView_SizeChanged">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{DynamicResource Ui.Auto.6F5D72AA32F2C95E}" FontSize="16" FontWeight="SemiBold" />
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.EC309AB207EF7FA3}" FontSize="11" />
                                    <ComboBox x:Name="ReaderAiProviderBox"
                                              Classes="readerSettingsField"
                                              SelectedIndex="0"
                                              SelectionChanged="ReaderAiProviderBox_SelectionChanged">
                                        <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                        <ComboBoxItem Content="OpenAI" Tag="openai" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.988FB59B290B037D}" Tag="custom" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Base URL" FontSize="11" />
                                    <TextBox x:Name="ReaderAiBaseUrlBox"
                                             Classes="readerSettingsField"
                                             PlaceholderText="https://api.deepseek.com" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.C98E118E0A43F078}" FontSize="11" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBox x:Name="ReaderAiModelBox"
                                                 Classes="readerSettingsField"
                                                 PlaceholderText="{DynamicResource Ui.Auto.CB2F1709F983D2F4}" />
                                        <ComboBox x:Name="ReaderAiSettingsModelSelectorBox"
                                                  Grid.Column="0"
                                                  Classes="readerSettingsField aiModelSelector"
                                                  IsVisible="False"
                                                  PlaceholderText="{DynamicResource Ui.Auto.1AFED6A81A2512D2}"
                                                  SelectionChanged="ReaderAiSettingsModelSelectorBox_SelectionChanged" />
                                        <Button x:Name="ReaderAiFetchModelsButton"
                                                Grid.Column="1"
                                                Classes="quiet"
                                                Content="{DynamicResource Ui.Auto.83FCFB4C1F2C1641}"
                                                Click="ReaderAiFetchModelsButton_Click" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="API Key" FontSize="11" />
                                    <TextBox x:Name="ReaderAiApiKeyBox"
                                             Classes="readerSettingsField"
                                             PasswordChar="●"
                                             PlaceholderText="{DynamicResource Ui.Auto.CA478C91D3839A44}" />
                                    <TextBlock Text="{DynamicResource Ui.Auto.7BCD9260C3109BB3}"
                                               FontSize="10"
                                               Foreground="{DynamicResource ReaderMutedBrush}"
                                               TextWrapping="Wrap" />
                                <Border Margin="0,4,0,0"
                                        Padding="12"
                                        Background="{DynamicResource ReaderHoverBrush}"
                                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="本地语义检索模型" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="用于书籍问答的向量检索。"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource ReaderMutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="ReaderEmbeddingModelStatusText"
                                                       Grid.Column="1"
                                                       MaxWidth="126"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource ReaderMutedBrush}"
                                                       TextAlignment="Right"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <ProgressBar x:Name="ReaderEmbeddingModelProgressBar"
                                                     Height="4"
                                                     IsVisible="False"
                                                     IsIndeterminate="False" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                                            <ComboBox x:Name="ReaderEmbeddingModelSelectorBox"
                                                      FontSize="10"
                                                      MinWidth="150"
                                                      VerticalAlignment="Center"
                                                      SelectionChanged="ReaderEmbeddingModelSelectorBox_SelectionChanged" />
                                            <Button x:Name="ReaderEmbeddingModelDownloadButton"
                                                    Grid.Column="1"
                                                    Classes="quiet"
                                                    Padding="9,5"
                                                    FontSize="10"
                                                    Content="下载"
                                                    Click="ReaderEmbeddingModelDownloadButton_Click" />
                                            <Button x:Name="ReaderEmbeddingModelCancelButton"
                                                    Grid.Column="2"
                                                    Classes="quiet"
                                                    Padding="9,5"
                                                    FontSize="10"
                                                    Content="取消"
                                                    IsVisible="False"
                                                    Click="ReaderEmbeddingModelCancelButton_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                                <TextBlock x:Name="ReaderAiSettingsStatusText"
                                           FontSize="10"
                                           Foreground="{DynamicResource ReaderMutedBrush}"
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <Button Grid.Column="1"
                                            Classes="quiet"
                                            Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                            Click="ReaderAiSettingsCancelButton_Click" />
                                    <Button x:Name="ReaderAiSettingsTestButton"
                                            Grid.Column="2"
                                            Classes="quiet"
                                            Content="{DynamicResource Ui.Auto.D5061C58DDC3BB77}"
                                            Click="ReaderAiSettingsTestButton_Click" />
                                    <Button Grid.Column="3"
                                            Content="{DynamicResource Ui.Auto.A3030BF8F16DC63C}"
                                            Click="ReaderAiSettingsSaveButton_Click" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Notes keep their export actions in the bottom row; AI
                         sends directly from the composer above. -->
                    <Border Grid.Row="2">
                        <Grid>
                            <Grid x:Name="ReaderNotesExportBar" Margin="20,6,20,7" IsVisible="False">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Button Classes="readerMinimalAction"
                                            Content="{DynamicResource Ui.Auto.AC8B027CC1E3A493}"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            Click="ReaderExportMarkdownButton_Click" />
                                    <Button Grid.Column="1"
                                            Classes="readerMinimalAction"
                                            Content="{DynamicResource Ui.Auto.8E1B126E634DCA98}"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            Click="ReaderExportTextButton_Click" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- The AI rail is resizable from its left edge. Keep the
                         hit area wider than the one-pixel divider so it is
                         easy to grab without covering the conversation. -->
                    <Border x:Name="ReaderAssistantResizeHandle"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Width="9"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Cursor="SizeWestEast"
                            ZIndex="20"
                            PointerPressed="ReaderAssistantResizeHandle_PointerPressed"
                            PointerMoved="ReaderAssistantResizeHandle_PointerMoved"
                            PointerReleased="ReaderAssistantResizeHandle_PointerReleased" />
                </Grid>
            </Border>

            <!-- TTS controls backed by the cross-platform edge-tts engine. -->
            <Popup x:Name="ReaderTtsPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="True"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="True"
                   Closed="ReaderTtsPopup_Closed">
                <Border Width="480"
                        MaxHeight="640"
                        Background="{DynamicResource ReaderPageBrush}"
                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                        BorderThickness="1"
                        Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10"
                                    Margin="0,0,18,0">
                            <TextBlock x:Name="ReaderTtsTitleText"
                                       Text="听书"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ReaderTtsDescriptionText"
                                       Text="按句朗读当前 EPUB；edge-tts 需要联网。"
                                       FontSize="11"
                                       Foreground="{DynamicResource ReaderMutedBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ReaderTtsProviderLabelText"
                                           Text="语音引擎"
                                           FontSize="11" />
                                <TextBlock x:Name="ReaderTtsEngineText"
                                           Text="edge-tts"
                                           FontSize="13" />
                            </StackPanel>

                            <StackPanel x:Name="ReaderTtsVoicePanel" Spacing="4">
                                <TextBlock x:Name="ReaderTtsVoiceLabelText"
                                           Text="声音"
                                           FontSize="11" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <ComboBox x:Name="ReaderTtsVoiceBox"
                                              Classes="readerTtsVoice"
                                              PlaceholderText="选择 edge-tts 语音" />
                                    <Button x:Name="ReaderTtsPreviewButton"
                                            Grid.Column="1"
                                            Classes="quiet"
                                            Content="试听"
                                            Click="ReaderTtsPreviewButton_Click" />
                                    <Button x:Name="ReaderTtsRefreshVoicesButton"
                                            Grid.Column="2"
                                            Classes="quiet"
                                            Content="刷新语音"
                                            Click="ReaderTtsRefreshVoicesButton_Click" />
                                </Grid>
                                <TextBlock x:Name="ReaderTtsPreviewSampleText"
                                           Text="试听内容：你好，这是声音试听。"
                                           FontSize="11"
                                           Foreground="{DynamicResource ReaderMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock x:Name="ReaderTtsSpeedLabelText"
                                               Text="语速"
                                               FontSize="11" />
                                    <TextBlock x:Name="ReaderTtsSpeedValueText"
                                               Grid.Column="1"
                                               FontSize="11"
                                               Foreground="{DynamicResource ReaderMutedBrush}" />
                                </Grid>
                                <Slider x:Name="ReaderTtsSpeedSlider"
                                        Minimum="0.5"
                                        Maximum="2"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"
                                        Value="1"
                                        ValueChanged="ReaderTtsSpeedSlider_ValueChanged" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock x:Name="ReaderTtsVolumeLabelText"
                                               Text="音量"
                                               FontSize="11" />
                                    <TextBlock x:Name="ReaderTtsVolumeValueText"
                                               Grid.Column="1"
                                               FontSize="11"
                                               Foreground="{DynamicResource ReaderMutedBrush}" />
                                </Grid>
                                <Slider x:Name="ReaderTtsVolumeSlider"
                                        Minimum="0"
                                        Maximum="200"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="True"
                                        Value="100"
                                        ValueChanged="ReaderTtsVolumeSlider_ValueChanged" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock x:Name="ReaderTtsPitchLabelText"
                                               Text="音调"
                                               FontSize="11" />
                                    <TextBlock x:Name="ReaderTtsPitchValueText"
                                               Grid.Column="1"
                                               FontSize="11"
                                               Foreground="{DynamicResource ReaderMutedBrush}" />
                                </Grid>
                                <Slider x:Name="ReaderTtsPitchSlider"
                                        Minimum="-100"
                                        Maximum="100"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="True"
                                        Value="0"
                                        ValueChanged="ReaderTtsPitchSlider_ValueChanged" />
                            </StackPanel>
                            <CheckBox x:Name="ReaderTtsAutoAdvanceCheck"
                                      Classes="readerTtsCheck"
                                      Content="自动朗读下一章"
                                      IsChecked="True"
                                      FontSize="12" />
                            <TextBlock x:Name="ReaderTtsStatusText"
                                       FontSize="10"
                                       Foreground="{DynamicResource ReaderMutedBrush}"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8"
                                  HorizontalAlignment="Center">
                                <Button x:Name="ReaderTtsApplyButton"
                                        Classes="readerTtsAction"
                                        Content="应用设置"
                                        Click="ReaderTtsApplyButton_Click" />
                                <Button x:Name="ReaderTtsPlayButton"
                                        Grid.Column="1"
                                        Classes="readerTtsAction primary"
                                        Background="{DynamicResource ReaderPageBrush}"
                                        Foreground="{DynamicResource ReaderInkBrush}"
                                        BorderBrush="{DynamicResource ReaderInkBrush}"
                                        ContentTemplate="{StaticResource ReaderTtsButtonTextTemplate}"
                                        Content="播放"
                                        Click="ReaderTtsPlayButton_Click" />
                                <Button x:Name="ReaderTtsPreviousSegmentButton"
                                        Grid.Column="2"
                                        Classes="readerTtsAction"
                                        Content="上一段"
                                        Click="ReaderTtsPreviousSegmentButton_Click" />
                                <Button x:Name="ReaderTtsNextSegmentButton"
                                        Grid.Column="3"
                                        Classes="readerTtsAction"
                                        Content="下一段"
                                        Click="ReaderTtsNextSegmentButton_Click" />
                                <Button x:Name="ReaderTtsStopButton"
                                        Grid.Column="4"
                                        Classes="readerTtsAction"
                                        Content="停止"
                                        Click="ReaderTtsStopButton_Click" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Reading layout settings. All layout options are global. A native popup is required:
                 the WebView2 HWND island covers ordinary Avalonia overlays. -->
            <Popup x:Name="ReaderLayoutSettingsPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="True">
                <Grid x:Name="ReaderLayoutSettingsOverlay"
                      Background="#66000000">
                <Border x:Name="ReaderLayoutSettingsCard"
                        Width="580"
                        MaxHeight="760"
                        Margin="16"
                        Background="{DynamicResource ReaderPageBrush}"
                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="*,Auto">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,20" Spacing="12">
                                <TextBlock Text="{DynamicResource Ui.Reader.Settings}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Ui.Reader.Appearance}" FontSize="13" FontWeight="SemiBold" />
                                <UniformGrid Columns="5" Rows="1">
                                    <RadioButton x:Name="ReaderClassicThemeOption" Classes="readerThemeOption" GroupName="ReaderTheme" Tag="Classic"
                                                 IsCheckedChanged="ReaderThemeOption_IsCheckedChanged">
                                        <StackPanel Spacing="7">
                                            <Border Background="#FFFFFF" Height="38">
                                                <TextBlock Text="Aa" Foreground="#111111" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource Ui.Reader.Theme.Classic}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ReaderNightThemeOption" Classes="readerThemeOption" GroupName="ReaderTheme" Tag="Night"
                                                 IsCheckedChanged="ReaderThemeOption_IsCheckedChanged">
                                        <StackPanel Spacing="7">
                                            <Border Background="#242623" Height="38">
                                                <TextBlock Text="Aa" Foreground="#DDDACE" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource Ui.Reader.Theme.Night}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ReaderGreenThemeOption" Classes="readerThemeOption" GroupName="ReaderTheme" Tag="Green"
                                                 IsCheckedChanged="ReaderThemeOption_IsCheckedChanged">
                                        <StackPanel Spacing="7">
                                            <Border Background="#EEF3EC" Height="38">
                                                <TextBlock Text="Aa" Foreground="#29382D" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource Ui.Reader.Theme.Green}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ReaderBrownThemeOption" Classes="readerThemeOption" GroupName="ReaderTheme" Tag="WarmBrown"
                                                 IsCheckedChanged="ReaderThemeOption_IsCheckedChanged">
                                        <StackPanel Spacing="7">
                                            <Border Background="#F7F0E4" Height="38">
                                                <TextBlock Text="Aa" Foreground="#3E352A" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource Ui.Reader.Theme.Brown}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ReaderIvoryThemeOption" Classes="readerThemeOption" GroupName="ReaderTheme" Tag="Ivory"
                                                 IsCheckedChanged="ReaderThemeOption_IsCheckedChanged">
                                        <StackPanel Spacing="7">
                                            <Border Background="#F8F5EC" Height="38">
                                                <TextBlock Text="Aa" Foreground="#37342D" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource Ui.Reader.Theme.Ivory}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                                <CheckBox x:Name="ReaderPaperEnabledCheck" Classes="readerLayoutCheck"
                                          Content="{DynamicResource Ui.Reader.Paper}" FontSize="12"
                                          IsCheckedChanged="ReaderPaperCheck_IsCheckedChanged" />
                                <StackPanel x:Name="ReaderPaperOptions" Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource Ui.Reader.PaperStrength}" FontSize="11" />
                                        <TextBlock x:Name="ReaderPaperStrengthValueText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource ReaderMutedBrush}" />
                                    </Grid>
                                    <Slider x:Name="ReaderPaperStrengthSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="{DynamicResource Ui.Reader.PaperStrength}"
                                            ValueChanged="ReaderPaperStrength_ValueChanged" />
                                    <CheckBox x:Name="ReaderFibersEnabledCheck" Classes="readerLayoutCheck"
                                              Content="{DynamicResource Ui.Reader.Fibers}" FontSize="12"
                                              IsCheckedChanged="ReaderPaperCheck_IsCheckedChanged" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Ui.Reader.PaperHint}" FontSize="11" Foreground="{DynamicResource ReaderMutedBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ReaderNightPaperHint" Text="{DynamicResource Ui.Reader.NightPaperHint}" FontSize="11"
                                           Foreground="{DynamicResource ReaderMutedBrush}" TextWrapping="Wrap" IsVisible="False" />
                                <TextBlock x:Name="ReaderAppearanceSaveStatus" FontSize="11" TextWrapping="Wrap" IsVisible="False" />
                                <Border Height="1" Background="{DynamicResource ReaderBorderBrush}" Margin="0,4" />
                                <TextBlock Text="{DynamicResource Ui.Reader.Layout}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Ui.Auto.C66EF0B208DF7017}"
                                           FontSize="11"
                                           Foreground="{DynamicResource ReaderMutedBrush}"
                                           TextWrapping="Wrap" />
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Auto.F71561B5AF0ABCED}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderFontScaleValueText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource ReaderMutedBrush}" />
                                    </Grid>
                                    <Slider x:Name="ReaderFontScaleSlider" Minimum="0.8" Maximum="1.8" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="1" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource ReaderAccentColor}" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource ReaderAccentColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource ReaderInkColor}" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Auto.6B44B7BA432ABF47}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderLineHeightValueText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource ReaderMutedBrush}" />
                                    </Grid>
                                    <Slider x:Name="ReaderLineHeightSlider" Minimum="1.3" Maximum="2.6" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1.88" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource ReaderAccentColor}" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource ReaderAccentColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource ReaderInkColor}" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Auto.598EA039C0563336}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderMaxWidthValueText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource ReaderMutedBrush}" />
                                    </Grid>
                                    <Slider x:Name="ReaderMaxWidthSlider" Minimum="480" Maximum="3840" TickFrequency="20" IsSnapToTickEnabled="True" Value="800" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource ReaderAccentColor}" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource ReaderAccentColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource ReaderInkColor}" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Auto.93DCCA57490B4267}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderBodyPaddingValueText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource ReaderMutedBrush}" />
                                    </Grid>
                                    <Slider x:Name="ReaderBodyPaddingSlider" Minimum="24" Maximum="160" TickFrequency="8" IsSnapToTickEnabled="True" Value="68" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource ReaderAccentColor}" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource ReaderAccentColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource ReaderInkColor}" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource ReaderInkColor}" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.F818CA93CE983E65}" FontSize="11" />
                                    <ComboBox x:Name="ReaderFontFamilyBox"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="ReaderFontFamilyBox_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.97F24E62001955CC}" Tag="京华老宋体" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.709E6BFBD8FBEF3E}" Tag="Microsoft YaHei UI" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.67ABB8F1EFAC16D0}" Tag="SimSun" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.FE154AC80068C997}" Tag="SimHei" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.9BACE6A0041701EC}" Tag="KaiTi" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.94CC5EA6C71365C7}" Tag="DengXian" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.41BE03CE89F68E74}" Tag="Source Han Serif SC, Noto Serif CJK SC" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="ReaderVerticalWritingCheck"
                                          Classes="readerLayoutCheck"
                                          Content="{DynamicResource Ui.Auto.FA133D5DE7088336}"
                                          FontSize="12"
                                          IsCheckedChanged="ReaderVerticalWritingCheck_IsCheckedChanged" />
                                <CheckBox x:Name="ReaderParagraphIndentCheck"
                                          Classes="readerLayoutCheck"
                                          Content="{DynamicResource Ui.Auto.F7044E3D685ABD03}"
                                          FontSize="12"
                                          IsCheckedChanged="ReaderParagraphIndentCheck_IsCheckedChanged" />
                                <Button Classes="quiet"
                                        Content="{DynamicResource Ui.Auto.F242C947972CE621}"
                                        HorizontalAlignment="Left"
                                        Click="ReaderLayoutResetButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                            <Grid Grid.Row="1" Margin="22,14,22,20">
                                <Button Classes="quiet"
                                        Content="{DynamicResource Ui.Auto.3FD47EDCE45B3603}"
                                        HorizontalAlignment="Right"
                                        Click="ReaderLayoutSettingsCloseButton_Click" />
                            </Grid>
                    </Grid>
                </Border>
                </Grid>
            </Popup>

            <Popup x:Name="ReaderSelectionHostPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="True"
                   OverlayDismissEventPassThrough="True"
                   ShouldUseOverlayLayer="True"
                   TakesFocusFromNativeControl="False">
                <Border x:Name="ReaderSelectionPopupBar"
                        Padding="3"
                        Background="{DynamicResource ReaderPageBrush}"
                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button Content="{DynamicResource Ui.Auto.63D90D977348AB1F}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionCopyButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="{DynamicResource ReaderBorderBrush}" VerticalAlignment="Center" />
                        <Button x:Name="ReaderSelectionHighlightMenuButton"
                                Content="{DynamicResource Ui.Auto.830CB845237C81B5}"
                                Classes="readerSelectionAction"
                                PointerEntered="ReaderSelectionHighlightMenuButton_PointerEntered">
                            <Button.Flyout>
                                <MenuFlyout FlyoutPresenterClasses="readerMenu" ShowMode="Transient"
                                            Placement="Bottom"
                                            VerticalOffset="4"
                                            Opened="ReaderSelectionHighlightFlyout_Opened"
                                            Closed="ReaderSelectionHighlightFlyout_Closed"
                                            OverlayDismissEventPassThrough="True">
                                    <MenuItem x:Name="ReaderSelectionHighlightSolidItem" Header="{DynamicResource Ui.Auto.91F5C1B272FBDAFD}" Classes="readerSelectionStyle" Tag="solid" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="{DynamicResource Ui.Auto.A6698E0626B4FA35}" Classes="readerSelectionStyle" Tag="double" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="{DynamicResource Ui.Auto.91B03E325F4CA55F}" Classes="readerSelectionStyle" Tag="dashed" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="{DynamicResource Ui.Auto.BDDE3C3FF3DD4E89}" Classes="readerSelectionStyle" Tag="dotted" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="{DynamicResource Ui.Auto.B601C29A9B51CF20}" Classes="readerSelectionStyle" Tag="wavy" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ReaderSelectionMarkerItem" Classes="readerSelectionStyle" Tag="marker" Click="ReaderSelectionHighlightStyleItem_Click">
                                        <MenuItem.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="ReaderSelectionMarkerLabel" Text="{DynamicResource Ui.Auto.51CBFC596D18C946}" VerticalAlignment="Center" />
                                                <Button x:Name="ReaderSelectionMarkerColorButton" Grid.Column="1" Classes="readerMarkerColorPicker" Margin="12,0,0,0"
                                                        ToolTip.Tip="{DynamicResource Ui.Auto.AE3A39B9007FBC10}"
                                                        AutomationProperties.Name="{DynamicResource Ui.Auto.AE3A39B9007FBC10}"
                                                        Click="ReaderSelectionMarkerColorButton_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Border x:Name="ReaderSelectionMarkerColorPreview" Width="14" Height="14" Background="#000000" BorderBrush="{DynamicResource ReaderBorderBrush}" BorderThickness="0.5" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="ReaderSelectionMarkerColorText" Text="{DynamicResource Ui.Auto.078472BE6C94CB17}" FontSize="12" VerticalAlignment="Center" />
                                                        <Path Width="8" Height="5" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource ReaderInkBrush}" StrokeThickness="1" Fill="{x:Null}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <FlyoutBase.AttachedFlyout>
                                                        <Flyout FlyoutPresenterClasses="readerMarkerPalette" Placement="Bottom" VerticalOffset="3" ShowMode="Standard">
                                                            <StackPanel x:Name="ReaderSelectionMarkerPalette" Orientation="Horizontal" Spacing="3">
                                                                <Button Classes="readerMarkerColorOption" Tag="#000000" Click="ReaderSelectionHighlightColorItem_Click"
                                                                        ToolTip.Tip="{DynamicResource Ui.Auto.078472BE6C94CB17}" AutomationProperties.Name="{DynamicResource Ui.Auto.078472BE6C94CB17}">
                                                                    <Border Width="16" Height="16" Background="#000000" BorderBrush="{DynamicResource ReaderBorderBrush}" BorderThickness="0.5" />
                                                                </Button>
                                                                <Button Classes="readerMarkerColorOption" Tag="#FFD54F" Click="ReaderSelectionHighlightColorItem_Click"
                                                                        ToolTip.Tip="{DynamicResource Ui.Auto.D451C07D739B3306}" AutomationProperties.Name="{DynamicResource Ui.Auto.D451C07D739B3306}">
                                                                    <Border Width="16" Height="16" Background="#FFD54F" BorderBrush="{DynamicResource ReaderBorderBrush}" BorderThickness="0.5" />
                                                                </Button>
                                                                <Button Classes="readerMarkerColorOption" Tag="#81C784" Click="ReaderSelectionHighlightColorItem_Click"
                                                                        ToolTip.Tip="{DynamicResource Ui.Auto.30C83DC25B12C32C}" AutomationProperties.Name="{DynamicResource Ui.Auto.30C83DC25B12C32C}">
                                                                    <Border Width="16" Height="16" Background="#81C784" BorderBrush="{DynamicResource ReaderBorderBrush}" BorderThickness="0.5" />
                                                                </Button>
                                                                <Button Classes="readerMarkerColorOption" Tag="#64B5F6" Click="ReaderSelectionHighlightColorItem_Click"
                                                                        ToolTip.Tip="{DynamicResource Ui.Auto.67035E6B7F82ACDB}" AutomationProperties.Name="{DynamicResource Ui.Auto.67035E6B7F82ACDB}">
                                                                    <Border Width="16" Height="16" Background="#64B5F6" BorderBrush="{DynamicResource ReaderBorderBrush}" BorderThickness="0.5" />
                                                                </Button>
                                                                <Button Classes="readerMarkerColorOption" Tag="#F48FB1" Click="ReaderSelectionHighlightColorItem_Click"
                                                                        ToolTip.Tip="{DynamicResource Ui.Auto.DBD379B39F0D3537}" AutomationProperties.Name="{DynamicResource Ui.Auto.DBD379B39F0D3537}">
                                                                    <Border Width="16" Height="16" Background="#F48FB1" BorderBrush="{DynamicResource ReaderBorderBrush}" BorderThickness="0.5" />
                                                                </Button>
                                                                <Button Classes="readerMarkerColorOption" Tag="#B39DDB" Click="ReaderSelectionHighlightColorItem_Click"
                                                                        ToolTip.Tip="{DynamicResource Ui.Auto.2ED9C6FABAC2013A}" AutomationProperties.Name="{DynamicResource Ui.Auto.2ED9C6FABAC2013A}">
                                                                    <Border Width="16" Height="16" Background="#B39DDB" BorderBrush="{DynamicResource ReaderBorderBrush}" BorderThickness="0.5" />
                                                                </Button>
                                                                <Button Classes="readerMarkerColorOption" Tag="#FFB74D" Click="ReaderSelectionHighlightColorItem_Click"
                                                                        ToolTip.Tip="{DynamicResource Ui.Auto.AA1E899DD35771B0}" AutomationProperties.Name="{DynamicResource Ui.Auto.AA1E899DD35771B0}">
                                                                    <Border Width="16" Height="16" Background="#FFB74D" BorderBrush="{DynamicResource ReaderBorderBrush}" BorderThickness="0.5" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </FlyoutBase.AttachedFlyout>
                                                </Button>
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="{DynamicResource ReaderBorderBrush}" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Ui.Auto.85C5C1F5567B4D67}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionAnnotateButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="{DynamicResource ReaderBorderBrush}" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Ui.Auto.A264DF6D2A1F209D}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionAiButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="{DynamicResource ReaderBorderBrush}" VerticalAlignment="Center" />
                        <Button x:Name="ReaderSelectionTranslationButton"
                                Content="{DynamicResource Ui.Auto.A52A08335185F048}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionTranslationButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="{DynamicResource ReaderBorderBrush}" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Ui.Auto.44CE7AE909BBB28B}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionSearchButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="{DynamicResource ReaderBorderBrush}" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Ui.Auto.854581A8F04CE575}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionDictionaryButton_Click" />
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="ReaderTranslationHostPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="True"
                   OverlayDismissEventPassThrough="True"
                   ShouldUseOverlayLayer="True"
                   TakesFocusFromNativeControl="False"
                   Closed="ReaderTranslationHostPopup_Closed">
                <Border x:Name="ReaderTranslationPopup"
                        Width="420"
                        MaxHeight="420"
                        Padding="12"
                        Background="{DynamicResource ReaderPageBrush}"
                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0">
                    <Grid RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="9">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <TextBlock x:Name="ReaderTranslationProviderText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ReaderTranslationCloseButton"
                                    Grid.Column="1"
                                    Classes="quiet"
                                    Content="{DynamicResource Ui.Auto.3FD47EDCE45B3603}"
                                    Click="ReaderTranslationCloseButton_Click" />
                        </Grid>
                        <Border Grid.Row="1"
                                Padding="8"
                                Background="{DynamicResource ReaderHoverBrush}"
                                BorderBrush="{DynamicResource ReaderBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{DynamicResource ReaderMutedBrush}"
                                           FontSize="11"
                                           Text="{DynamicResource Ui.Auto.354B28C853334568}" />
                                <TextBlock x:Name="ReaderTranslationSourceText"
                                           MaxHeight="62"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="2"
                                      MaxHeight="220"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{DynamicResource ReaderMutedBrush}"
                                           FontSize="11"
                                           Text="{DynamicResource Ui.Auto.80461C2DECC549DC}" />
                                <TextBlock x:Name="ReaderTranslationResultText"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="3"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <TextBlock x:Name="ReaderTranslationStatusText"
                                       Foreground="{DynamicResource ReaderMutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ReaderTranslationCopyButton"
                                    Grid.Column="1"
                                    Classes="quiet"
                                    Content="{DynamicResource Ui.Auto.032EB48C7A431EC0}"
                                    IsEnabled="False"
                                    Click="ReaderTranslationCopyButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Popup>

            <!-- In-body annotation editor: picking 批注 on a selection opens
                 this small input window right at the selection instead of
                 routing through the notes pane. It needs the same native
                 popup treatment as the selection bar to paint over the
                 HWND-backed reader surface. -->
            <Popup x:Name="ReaderAnnotationInputPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="True"
                   OverlayDismissEventPassThrough="True"
                   ShouldUseOverlayLayer="True"
                   TakesFocusFromNativeControl="False"
                   Closed="ReaderAnnotationInputPopup_Closed">
                <Border x:Name="ReaderAnnotationInputPanel"
                        Width="320"
                        Padding="12"
                        Background="{DynamicResource ReaderPageBrush}"
                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ReaderAnnotationInputQuote"
                                   FontSize="11"
                                   Foreground="{DynamicResource ReaderMutedBrush}"
                                   MaxHeight="40"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="ReaderAnnotationInputBox"
                                 Classes="readerMinimalField"
                                 MinHeight="64"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 PlaceholderText="{DynamicResource Ui.Auto.39700B6351624E48}"
                                 KeyDown="ReaderAnnotationInputBox_KeyDown" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Classes="readerMinimalAction"
                                    Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    Click="ReaderAnnotationInputCancelButton_Click" />
                            <Button Grid.Column="1"
                                    Classes="readerMinimalAction"
                                    Content="{DynamicResource Ui.Auto.49DD2BD35DD7E743}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    Click="ReaderAnnotationInputSaveButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- A native popup keeps the footnote above the HWND-backed
                 WebView2 surface, matching the WinUI reference reader. -->
            <Popup x:Name="ReaderFootnoteHostPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="False"
                   IsHitTestVisible="False">
                <Border x:Name="ReaderFootnotePopup"
                        Width="360"
                        MaxHeight="260"
                        Padding="12,10"
                        Background="{DynamicResource ReaderPageBrush}"
                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        IsHitTestVisible="False"
                        IsVisible="False">
                    <ScrollViewer MaxHeight="236"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReaderFootnoteText"
                                   Foreground="{DynamicResource ReaderInkBrush}"
                                   FontSize="12"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Annotation hover preview over the reading surface. Same native
                 popup treatment as the footnote preview: the reading surface
                 would cover an ordinary overlay. -->
            <Popup x:Name="ReaderAnnotationHoverHostPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="False"
                   IsHitTestVisible="False">
                <Border x:Name="ReaderAnnotationHoverPopup"
                        MaxWidth="360"
                        MaxHeight="260"
                        Padding="12,10"
                        Background="{DynamicResource ReaderPageBrush}"
                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="0"
                        IsHitTestVisible="False"
                        IsVisible="False">
                    <ScrollViewer MaxHeight="236"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="ReaderAnnotationHoverNote"
                                       Foreground="{DynamicResource ReaderMutedBrush}"
                                       FontSize="11"
                                       LineHeight="18"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- A native popup is required here: the reading surface is an
                 embedded WebView2 HWND and would cover a normal Avalonia
                 overlay regardless of ZIndex. -->
            <Popup x:Name="ReaderChapterPreviewPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="False">
                <Border MinWidth="150"
                        MaxWidth="340"
                        Padding="12,8"
                        Background="{DynamicResource ReaderPageBrush}"
                        BorderBrush="{DynamicResource ReaderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock x:Name="ReaderChapterPreviewTitleText"
                                   MaxWidth="316"
                                   Foreground="{DynamicResource ReaderInkBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ReaderChapterPreviewBodyText"
                                   MaxWidth="316"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource ReaderMutedBrush}"
                                   FontSize="11"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   MaxLines="4"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="False" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
        </ThemeVariantScope>
        </Grid>
    </Border>

        <!-- First-run setup is a full-window, three-step surface. It sits above
             the regular shell so the user can finish the minimum setup before
             interacting with the bookshelf. -->
        <Grid x:Name="OnboardingOverlay"
              Background="{DynamicResource SoftHoverBrush}"
              IsVisible="False"
              ZIndex="200"
              Focusable="True"
              KeyDown="OnboardingOverlay_KeyDown">
            <Border Width="760"
                    MaxWidth="760"
                    MaxHeight="650"
                    Margin="24"
                    Background="{DynamicResource PaperBrush}"
                    BorderBrush="{DynamicResource InkBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0"
                            Padding="28,24,28,20"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="OnboardingStepText"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBlock Text="Kkindle"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           LetterSpacing="1.08" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    Background="{DynamicResource InkBrush}">
                                <TextBlock Text="K"
                                           Foreground="{DynamicResource PaperBrush}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="28,28,28,24"
                              MinHeight="360">
                            <Grid x:Name="OnboardingWelcomePage"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="18"
                                  HorizontalAlignment="Stretch">
                                <TextBlock Text="{DynamicResource Ui.Onboarding.WelcomeTitle}"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left" />
                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource Ui.Onboarding.WelcomeSubtitle}"
                                           FontSize="17"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2"
                                           Text="{DynamicResource Ui.Onboarding.WelcomeDescription}"
                                           FontSize="14"
                                           LineHeight="23"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                                <Border Grid.Row="3"
                                        Margin="0,12,0,0"
                                        Padding="16"
                                        Background="{DynamicResource SoftHoverBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="1">
                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                          RowSpacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Onboarding.LanguageLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="OnboardingLanguageBox"
                                                  Grid.Row="1"
                                                  Width="260"
                                                  HorizontalAlignment="Left"
                                                  HorizontalContentAlignment="Left"
                                                  SelectedIndex="0"
                                                  SelectionChanged="OnboardingLanguageBox_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource Ui.Auto.9937E365AAF3A085}"
                                                          Tag="zh-CN" />
                                            <ComboBoxItem Content="{DynamicResource Ui.Auto.348EA84C60466C77}"
                                                          Tag="en-US" />
                                        </ComboBox>
                                        <TextBlock Grid.Row="2"
                                                   Text="{DynamicResource Ui.Onboarding.LanguageHint}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedInkBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Left"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="OnboardingDisclaimerPage"
                                  IsVisible="False"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  RowSpacing="16"
                                  HorizontalAlignment="Stretch">
                                <TextBlock Text="{DynamicResource Ui.Onboarding.DisclaimerTitle}"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left" />
                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource Ui.Onboarding.DisclaimerSubtitle}"
                                           FontSize="17"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                                <Border Grid.Row="2"
                                        Padding="18"
                                        Background="{DynamicResource SoftHoverBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{DynamicResource Ui.Onboarding.DisclaimerBody}"
                                               FontSize="14"
                                               LineHeight="23"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Justify"
                                               TextWrapping="Wrap" />
                                </Border>
                                <CheckBox x:Name="OnboardingDisclaimerCheckBox"
                                          Grid.Row="3"
                                          IsChecked="False"
                                          IsTabStop="True"
                                          IsCheckedChanged="OnboardingDisclaimerCheckBox_IsCheckedChanged">
                                    <TextBlock Text="{DynamicResource Ui.Onboarding.DisclaimerAcknowledgement}"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock x:Name="OnboardingDisclaimerStatusText"
                                           Grid.Row="4"
                                           Text="{DynamicResource Ui.Onboarding.DisclaimerRequired}"
                                           IsVisible="False"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid x:Name="OnboardingDevicePage"
                                  IsVisible="False"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  RowSpacing="18"
                                  HorizontalAlignment="Stretch">
                                <TextBlock Text="{DynamicResource Ui.Onboarding.DeviceTitle}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left" />
                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource Ui.Onboarding.DeviceDescription}"
                                           FontSize="14"
                                           LineHeight="23"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Onboarding.VendorLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="OnboardingVendorBox"
                                                  HorizontalContentAlignment="Left"
                                                  SelectionChanged="OnboardingVendorBox_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Onboarding.ModelLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="OnboardingDeviceModelBox"
                                                  IsEnabled="False"
                                                  HorizontalContentAlignment="Left"
                                                  SelectionChanged="OnboardingDeviceModelBox_SelectionChanged" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="3"
                                        Padding="16"
                                        Background="{DynamicResource SoftHoverBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{DynamicResource Ui.Onboarding.SelectionLabel}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedInkBrush}" />
                                        <TextBlock x:Name="OnboardingSelectedDeviceText"
                                                   Text="{DynamicResource Ui.Onboarding.NoModelSelected}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Left"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="OnboardingDeviceStatusText"
                                           Grid.Row="4"
                                           Text="{DynamicResource Ui.Onboarding.SelectionRequired}"
                                           IsVisible="False"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="2"
                          Margin="28,18,28,24"
                          ColumnDefinitions="*,Auto,Auto,Auto"
                          ColumnSpacing="8">
                        <Button x:Name="OnboardingBackButton"
                                Grid.Column="0"
                                Content="{DynamicResource Ui.Onboarding.BackButton}"
                                Classes="quiet"
                                HorizontalAlignment="Left"
                                Padding="13,7"
                                IsVisible="False"
                                Click="OnboardingBackButton_Click" />
                        <Button x:Name="OnboardingSkipButton"
                                Grid.Column="1"
                                Content="{DynamicResource Ui.Onboarding.SkipButton}"
                                Classes="quiet"
                                Padding="13,7"
                                IsVisible="False"
                                Click="OnboardingSkipButton_Click" />
                        <Button x:Name="OnboardingNextButton"
                                Grid.Column="3"
                                Content="{DynamicResource Ui.Onboarding.NextButton}"
                                Padding="13,7"
                                Click="OnboardingNextButton_Click" />
                        <Button x:Name="OnboardingFinishButton"
                                Grid.Column="3"
                                Content="{DynamicResource Ui.Onboarding.FinishButton}"
                                Padding="13,7"
                                IsVisible="False"
                                Click="OnboardingFinishButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Keep the message dialog at the window content layer, above both
             the library and reader roots. A child of LibraryRoot is hidden
             behind ReaderRoot whenever a reader is visible. -->
        <Grid x:Name="MessageOverlay"
              Grid.ColumnSpan="3"
              Background="#66000000"
              IsVisible="False"
              ZIndex="110"
              Focusable="True"
              KeyDown="MessageOverlay_KeyDown">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Grid.Transitions>
            <Border Width="500"
                    MaxWidth="500"
                    MaxHeight="640"
                    Margin="24"
                    Background="{DynamicResource PaperBrush}"
                    BorderBrush="{DynamicResource InkBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0"
                                Margin="24,20,24,14"
                                Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10"
                                       Height="21"
                                       Margin="0,-2,0,0"
                                       Fill="{DynamicResource InkBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="MessageTitleText"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="440"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="24,0,24,4">
                        <TextBlock x:Name="MessageBodyText"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="24,14,24,20"
                          Background="{DynamicResource PaperBrush}">
                        <Button x:Name="MessageOkButton"
                                Content="{DynamicResource Ui.Auto.DE32E20193AD1042}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="MessageOkButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Device connection/eject floating bubble: a hollow paper-white
             toast with a 1-DIP black outline and a matching outlined pointer
             aligned to the sidebar eject button's triangle apex. The
             host positions it in window coordinates (PositionDeviceStatusToast)
             and it floats above the whole UI, never clipped by the sidebar. -->
        <StackPanel x:Name="DeviceStatusToast"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    MaxWidth="360"
                    RenderTransformOrigin="0,0"
                    IsVisible="False"
                    IsHitTestVisible="False">
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                </Transitions>
            </StackPanel.Transitions>
            <Border Padding="8,7"
                    Background="{DynamicResource PaperBrush}"
                    BorderBrush="{DynamicResource InkBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="DeviceStatusToastText"
                           MaxWidth="342"
                           Text="{DynamicResource Ui.Auto.BD94EEB3FD1C6354}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Foreground="{DynamicResource InkBrush}"
                           FontSize="11" />
            </Border>
            <!-- The filled triangle masks the bubble's bottom border, then the
                 open path draws both sides from the exact border break points.
                 Keeping fill and outline separate avoids erasing the joins. -->
            <Grid x:Name="DeviceStatusToastPointer"
                  Width="12"
                  Height="6"
                  Margin="0,-1,0,0"
                  UseLayoutRounding="True"
                  RenderTransformOrigin="0,0"
                  HorizontalAlignment="Left">
                <Polygon Points="0,0 12,0 6,6"
                         Fill="{DynamicResource PaperBrush}"
                         Stretch="Fill" />
                <Path Data="M 0,0 L 6,6 L 12,0"
                      Stroke="{DynamicResource InkBrush}"
                      StrokeThickness="1"
                      StrokeLineCap="Square"
                      StrokeJoin="Miter" />
            </Grid>
        </StackPanel>

        <!-- Zen controls must use a native popup: the full-screen WebView is
             an HWND island and otherwise paints over Avalonia title content. -->
        <Popup x:Name="ReaderZenControlsPopup"
               IsOpen="False"
               IsLightDismissEnabled="False"
               ShouldUseOverlayLayer="False"
               TakesFocusFromNativeControl="True">
            <!-- NativeWebView is a child window on Windows and paints over the
                 ordinary title-bar grid. Keep the complete old title-button
                 row in one native popup so Zen mode never leaves a black gap
                 or splits the controls across two composition surfaces.
                 The popup lives outside the reader shell, so explicitly use
                 its page background and caption styles here. -->
            <Grid Classes="readerChrome"
                  Background="{DynamicResource ReaderPageBrush}"
                  PointerEntered="ReaderTitleControls_PointerEntered"
                  PointerExited="ReaderTitleControls_PointerExited">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button x:Name="ReaderZenPopupTocButton"
                            Classes="caption"
                            Width="92"
                            Height="38"
                            Padding="0"
                            FontSize="11"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.0474752B788B123E}"
                            ToolTip.Tip="{DynamicResource Ui.Auto.4CC0023B765B0A72}"
                            Click="ReaderZenMinimalTocButton_Click">
                        <TextBlock x:Name="ReaderZenPopupTocText"
                                   Text="{DynamicResource Ui.Auto.B543AF1F9821E137}"
                                   Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button x:Name="ReaderZenPopupExitButton"
                            Classes="caption"
                            Width="104"
                            Height="38"
                            Padding="0"
                            FontSize="11"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.AF30F6FFB6EA23CF}"
                            ToolTip.Tip="{DynamicResource Ui.Auto.987BA0B5C2710754}"
                            Click="ReaderExitZenButton_Click">
                        <TextBlock Text="{DynamicResource Ui.Auto.AF30F6FFB6EA23CF}"
                                   Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button x:Name="ReaderZenPopupMinimizeButton"
                            Classes="caption"
                            Width="46"
                            Height="38"
                            Padding="0"
                            Click="MinimizeWindowButton_Click"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.AC29E57A46F41C30}">
                        <Path Data="M 0,0 H 10" />
                    </Button>
                    <Button x:Name="ReaderZenPopupMaximizeButton"
                            Classes="caption"
                            Width="46"
                            Height="38"
                            Padding="0"
                            Click="MaximizeWindowButton_Click"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.82C4AA13B7CA109E}">
                        <Path x:Name="ReaderZenPopupMaximizeGlyph"
                              Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                    </Button>
                    <Button x:Name="ReaderZenPopupCloseButton"
                            Classes="caption"
                            Width="46"
                            Height="38"
                            Padding="0"
                            Click="CloseWindowButton_Click"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.3FD47EDCE45B3603}">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Popup>

        <!-- Draw the frame as a sibling above the content. The native WebView
             is a separate child window and can cover WindowShadowHost's own
             right stroke; this overlay keeps all four sides on one geometry. -->
        <Border x:Name="WindowFrameOverlay"
                Margin="0"
                Background="Transparent"
                BorderBrush="{DynamicResource InkBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"
                ZIndex="1000" />

        <!-- Invisible resize handles around the window edge. They hand the
             gesture to the platform so native window resizing stays atomic. -->
        <Grid x:Name="WindowResizeLayer">
            <Rectangle Fill="Transparent"
                       Width="8"
                       HorizontalAlignment="Left"
                       Cursor="SizeWestEast"
                       Tag="Left"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="8"
                       HorizontalAlignment="Right"
                       Cursor="SizeWestEast"
                       Tag="Right"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Height="8"
                       VerticalAlignment="Top"
                       Cursor="SizeNorthSouth"
                       Tag="Top"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Height="8"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNorthSouth"
                       Tag="Bottom"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Cursor="TopLeftCorner"
                       Tag="TopLeft"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Cursor="TopRightCorner"
                       Tag="TopRight"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Cursor="BottomLeftCorner"
                       Tag="BottomLeft"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="BottomRightCorner"
                       Tag="BottomRight"
                       PointerPressed="WindowResize_PointerPressed" />
        </Grid>
    </Grid>
</Window>
