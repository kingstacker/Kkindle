                                <Expander x:Name="SettingsTrashExpander" Classes="settingsExpander" Header="{DynamicResource Ui.Auto.BA35DC23B245E61E}" Tag="{DynamicResource Ui.Auto.B05633D82AC7B603}" AutomationProperties.Name="{DynamicResource Ui.Auto.BA35DC23B245E61E}" Expanded="SettingsExpander_Expanded" Collapsed="SettingsExpander_Collapsed">
                                    <Border>
                                        <StackPanel Spacing="9">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <StackPanel Spacing="3">
                                                    <TextBlock x:Name="SettingsTrashTitleText" Text="回收站" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="SettingsTrashDescriptionText" Text="删除的书籍和格式会暂存于此，可恢复或永久清理。" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button x:Name="RefreshTrashButton" Grid.Column="1" Content="刷新" Classes="quiet" Click="RefreshTrashButton_Click" />
                                            </Grid>
                                            <ListBox x:Name="LibraryTrashList" ItemsSource="{Binding LibraryTrashItems}" MaxHeight="220" SelectionMode="Single" AutomationProperties.Name="回收站为空。" FontSize="14">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="local:LibraryTrashItemViewModel">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7" Margin="0,3">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DetailText}" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="{Binding RestoreLabel}" Classes="quiet" Padding="8,4" Tag="{Binding}" Click="RestoreTrashButton_Click" />
                                                            <Button Grid.Column="2" Content="{Binding PurgeLabel}" Classes="quiet" Padding="8,4" Tag="{Binding}" Click="PurgeTrashButton_Click" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="LibraryTrashEmptyText" Text="回收站为空。" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" IsVisible="True" TextWrapping="Wrap" />
                                            <TextBlock x:Name="LibraryTrashStatusText" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                            <StackPanel Spacing="12" x:Name="SettingsAboutSection" IsVisible="False">
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
