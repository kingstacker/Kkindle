<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Kkindle"
        xmlns:core="using:Kkindle.Core"
        xmlns:infra="using:Kkindle.Infrastructure"
        xmlns:converters="using:Avalonia.Data.Converters"
        mc:Ignorable="d"
        d:DesignWidth="1294"
        d:DesignHeight="804"
        x:Class="Kkindle.MainWindow"
        x:DataType="local:MainWindow"
        Title="Kkindle"
        Width="1294"
        Height="804"
        MinWidth="1024"
        MinHeight="664"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        UseLayoutRounding="True"
        ShowInTaskbar="True"
        WindowDecorations="None"
        DragDrop.AllowDrop="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        KeyDown="MainWindow_KeyDown">

    <Window.Resources>
        <!-- Sidebar outlines adapted from Lucide (https://lucide.dev).
             License: Assets/Icons/Lucide-LICENSE.txt. Reader text and the Aa
             letterforms are adapted for this app. Small translations centre
             the slanted book and pen silhouettes on the shared 24px canvas. -->
        <PathGeometry x:Key="SidebarBooksGeometry" Transform="1,0,0,1,0.27,0" Figures="
                M4,3 H10 A1,1 0 0 1 11,4 V20 A1,1 0 0 1 10,21 H4 A1,1 0 0 1 3,20 V4 A1,1 0 0 1 4,3 Z M7,3 V21
                M20.4,18.9 c.2,.5 -.1,1.1 -.6,1.3 l-1.9,.7 c-.5,.2 -1.1,-.1 -1.3,-.6 L11.1,5.1 c-.2,-.5 .1,-1.1 .6,-1.3 l1.9,-.7 c.5,-.2 1.1,.1 1.3,.6 Z" />
        <PathGeometry x:Key="SidebarComputerGeometry" Figures="
            M4,3 H20 A2,2 0 0 1 22,5 V15 A2,2 0 0 1 20,17 H4 A2,2 0 0 1 2,15 V5 A2,2 0 0 1 4,3 Z M8,21 H16 M12,17 V21" />
        <PathGeometry x:Key="SidebarDeviceLibraryGeometry" Figures="
            M6,2 H18 A2,2 0 0 1 20,4 V20 A2,2 0 0 1 18,22 H6 A2,2 0 0 1 4,20 V4 A2,2 0 0 1 6,2 Z M8,7 H16 M8,11 H13 M12,18 h.01" />
        <PathGeometry x:Key="SidebarDevicesGeometry" Figures="
            M5,8 H11 A2,2 0 0 1 13,10 V20 A2,2 0 0 1 11,22 H5 A2,2 0 0 1 3,20 V10 A2,2 0 0 1 5,8 Z
            M5,4 a2,2 0 0 1 2,-2 h12 a2,2 0 0 1 2,2 v16 a2,2 0 0 1 -2,2 h-2.4 M8,18 h.01" />
        <PathGeometry x:Key="SidebarFontsGeometry" Figures="
            M2,20 L7,4 L12,20 M3.875,14 H10.125 M22,10 V20 M22,15 A3.5,5 0 1 0 15,15 A3.5,5 0 1 0 22,15 Z" />
        <PathGeometry x:Key="SidebarDictionaryGeometry" Figures="
            M4,19.5 v-15 A2.5,2.5 0 0 1 6.5,2 H19 a1,1 0 0 1 1,1 v18 a1,1 0 0 1 -1,1 H6.5 a2.5,2.5 0 0 1 0,-5 H20 M8,13 l4,-7 4,7 M9.1,11 h5.7" />
        <PathGeometry x:Key="SidebarReadingGeometry" Figures="
            M12,5 V21 M20,19 a2,2 0 0 0 2,-2 V5 a2,2 0 0 0 -2,-2 H16 a5,5 0 0 0 -4,2 a5,5 0 0 0 -4,-2 H4 a2,2 0 0 0 -2,2 v12 a2,2 0 0 0 2,2 H8 a5,5 0 0 1 4,2 a5,5 0 0 1 4,-2 Z" />
        <PathGeometry x:Key="SidebarNotesGeometry" Transform="1,0,0,1,-0.5,0.5" Figures="
                M12,3 H5 a2,2 0 0 0 -2,2 v14 a2,2 0 0 0 2,2 h14 a2,2 0 0 0 2,-2 v-7
                M18.375,2.625 a1,1 0 0 1 3,3 l-9.013,9.014 a2,2 0 0 1 -.853,.505 l-2.873,.84 a.5,.5 0 0 1 -.62,-.62 l.84,-2.873 a2,2 0 0 1 .506,-.852 Z" />
        <PathGeometry x:Key="SidebarStatisticsGeometry" Figures="
            M13,17 V9 M18,17 V5 M3,3 v16 a2,2 0 0 0 2,2 h16 M8,17 v-3" />
        <PathGeometry x:Key="SidebarSettingsGeometry" Figures="
            M9.671,4.136 a2.34,2.34 0 0 1 4.659,0 a2.34,2.34 0 0 0 3.319,1.915 a2.34,2.34 0 0 1 2.33,4.033 a2.34,2.34 0 0 0 0,3.831 a2.34,2.34 0 0 1 -2.33,4.033 a2.34,2.34 0 0 0 -3.319,1.915 a2.34,2.34 0 0 1 -4.659,0 a2.34,2.34 0 0 0 -3.32,-1.915 a2.34,2.34 0 0 1 -2.33,-4.033 a2.34,2.34 0 0 0 0,-3.831 A2.34,2.34 0 0 1 6.35,6.051 a2.34,2.34 0 0 0 3.319,-1.915 Z
            M15,12 A3,3 0 1 0 9,12 A3,3 0 1 0 15,12 Z" />

        <!-- Book-location indicators use tightly fitted silhouettes. Navigation
             uses optically padded paths centred on a 24px canvas instead. -->
        <StreamGeometry x:Key="ComputerGlyphGeometry">M 4,5 H 20 V 15 H 4 Z M 2,19 H 22</StreamGeometry>
        <StreamGeometry x:Key="DeviceGlyphGeometry">M 7,3 H 17 V 21 H 7 Z M 10,17 H 14</StreamGeometry>
        <!-- Minimal library-presence glyph shared by the PC grid/list and the
             Kindle cards. Every state uses the same centred optical box. -->
        <DataTemplate x:Key="LibraryPresenceGlyph" x:CompileBindings="False">
            <Border Classes="libraryPresenceHitTarget" Width="22" Height="22" Background="Transparent">
                <Grid Classes="libraryPresenceGlyph" Width="20" Height="20">
                    <Path Classes="libraryGlyph"
                          Data="{StaticResource ComputerGlyphGeometry}"
                          Stroke="{DynamicResource InkBrush}"
                          IsVisible="{Binding ComputerOnlyPresenceVisibility}" />
                    <Path Classes="libraryGlyph"
                          Data="{StaticResource DeviceGlyphGeometry}"
                          Stroke="{DynamicResource InkBrush}"
                          IsVisible="{Binding KindleOnlyPresenceVisibility}" />
                    <Path Classes="libraryGlyph"
                          Data="M 3,5 H 17 V 15 H 3 Z M 2,18 H 17 M 15,9 H 21 V 21 H 15 Z"
                          Stroke="{DynamicResource InkBrush}"
                          IsVisible="{Binding BothLibrariesPresenceVisibility}" />
                </Grid>
            </Border>
        </DataTemplate>
        <StreamGeometry x:Key="BookSyncNotSyncedGlyphGeometry">M 12,17 V 5 M 7,10 L 12,5 L 17,10 M 4,19 H 20</StreamGeometry>
        <StreamGeometry x:Key="BookSyncSyncedGlyphGeometry">M 4,12 L 9,17 L 20,6</StreamGeometry>
        <StreamGeometry x:Key="BookSyncNotDownloadedGlyphGeometry">M 12,5 V 17 M 7,12 L 12,17 L 17,12 M 4,19 H 20</StreamGeometry>
        <DataTemplate x:Key="BookSyncStatusGlyph" x:CompileBindings="False">
            <Border Classes="libraryPresenceHitTarget" Width="22" Height="22" Background="Transparent">
                <Grid Classes="libraryPresenceGlyph" Width="20" Height="20">
                    <Path Classes="libraryGlyph"
                          Data="{StaticResource BookSyncNotSyncedGlyphGeometry}"
                          Stroke="{DynamicResource InkBrush}"
                          IsVisible="{Binding SyncNotSyncedVisibility}">
                        <Path.RenderTransform>
                            <TranslateTransform Y="-2" />
                        </Path.RenderTransform>
                    </Path>
                    <Path Classes="libraryGlyph"
                          Data="{StaticResource BookSyncSyncedGlyphGeometry}"
                          Stroke="{DynamicResource InkBrush}"
                          IsVisible="{Binding SyncSyncedVisibility}" />
                    <Path Classes="libraryGlyph"
                          Data="{StaticResource BookSyncNotDownloadedGlyphGeometry}"
                          Stroke="{DynamicResource InkBrush}"
                          IsVisible="{Binding SyncNotDownloadedVisibility}">
                        <Path.RenderTransform>
                            <TranslateTransform Y="-2" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="LibraryImportActionContent" x:CompileBindings="False">
            <Path Classes="libraryGlyph" Width="16" Height="16" Data="M 12,4 V 20 M 4,12 H 20" />
        </DataTemplate>
        <DataTemplate x:Key="LibraryExportActionContent" x:CompileBindings="False">
            <Path Classes="libraryGlyph" Data="M 12,16 V 3 M 7,8 L 12,3 L 17,8 M 4,14 V 21 H 20 V 14" />
        </DataTemplate>
        <DataTemplate x:Key="LibraryExportMarkdownActionContent">
            <Path Classes="libraryGlyph"
                  Width="18"
                  Height="18"
                  Stretch="None"
                  Data="M 1,1 H 17 V 17 H 1 Z M 4,13 V 6 L 7,9 L 10,6 V 13 M 14,6 V 13 M 12,9 L 14,13 L 16,9" />
        </DataTemplate>
        <DataTemplate x:Key="LibraryExportTextActionContent">
            <Path Classes="libraryGlyph"
                  Width="18"
                  Height="18"
                  Stretch="None"
                  Data="M 1,1 H 12 L 17,6 V 17 H 1 Z M 12,1 V 6 H 17 M 4,10 H 14 M 4,14 H 14" />
        </DataTemplate>
        <DataTemplate x:Key="LibraryDeleteActionContent" x:CompileBindings="False">
            <Path Classes="libraryGlyph" Data="M 4,6 H 20 M 9,6 V 3 H 15 V 6 M 6,6 L 7,21 H 17 L 18,6 M 10,10 V 17 M 14,10 V 17" />
        </DataTemplate>
        <DataTemplate x:Key="LibraryRefreshActionContent" x:CompileBindings="False">
            <Path Classes="libraryGlyph" Data="M 20,8 A 9,9 0 1,0 20,16 M 20,8 V 3 M 20,8 H 15" />
        </DataTemplate>
        <DataTemplate x:Key="LibraryLocateActionContent" x:CompileBindings="False">
            <Path Classes="libraryGlyph" Data="M 12,6 A 6,6 0 1,0 12,18 A 6,6 0 1,0 12,6 M 12,2 V 7 M 12,17 V 22 M 2,12 H 7 M 17,12 H 22" />
        </DataTemplate>
        <DataTemplate x:Key="LibrarySelectAllActionContent" x:CompileBindings="False">
            <Path Classes="libraryGlyph" Data="M 5,3 H 21 V 19 H 5 Z M 2,8 V 22 H 16 M 8,10 L 11,13 L 18,6" />
        </DataTemplate>
        <DataTemplate x:Key="LibraryCancelActionContent" x:CompileBindings="False">
            <Path Classes="libraryGlyph" Data="M 5,5 L 19,19 M 19,5 L 5,19" />
        </DataTemplate>
        <DataTemplate x:Key="LibrarySortActionContent">
            <Path Classes="libraryGlyph" Stroke="{DynamicResource InkBrush}"
                  Data="M 7,3 V 21 M 3,7 L 7,3 L 11,7 M 17,3 V 21 M 13,17 L 17,21 L 21,17" />
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ComboBox.librarySort /template/ Path#DropDownGlyph, ComboBox.librarySort /template/ PathIcon#DropDownGlyph">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.librarySort">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.librarySort Path.libraryGlyph">
            <Setter Property="Stroke" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Border.librarySort:pointerover">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
        </Style>
        <Style Selector="ComboBox.librarySort /template/ Border#Background, ComboBox.librarySort /template/ Border#HighlightBackground">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.libraryToolbar">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="ToolTip.Tip" Value="{ReflectionBinding Content, RelativeSource={RelativeSource Self}}" />
            <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Content, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style Selector="Button.libraryToolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button.libraryToolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button.libraryToolbar.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftHoverBrush}" />
        </Style>
        <Style Selector="Button.readingExportToggle">
            <Setter Property="ContentTemplate" Value="{StaticResource LibraryExportActionContent}" />
        </Style>
        <Style Selector="Button.readingExportToggle.active">
            <Setter Property="ContentTemplate" Value="{StaticResource LibraryCancelActionContent}" />
        </Style>
        <Style Selector="ComboBox.librarySort ComboBoxItem">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ContextMenu.shelfViewMenu MenuItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="{DynamicResource ComboBoxItemThemePadding}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ContextMenu.shelfViewMenu MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource InkBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        </Style>
        <Style Selector="ContextMenu.shelfViewMenu MenuItem:pointerover /template/ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        </Style>
    </Window.Styles>

    <!-- The content reaches the client-area edges. Resize handles are layered
         over those edges instead of reserving a transparent outer gutter; on
         Windows that gutter can be composed as an opaque white strip. -->
    <Grid>
        <Border x:Name="WindowShadowHost"
                Margin="0"
                Background="{DynamicResource PaperBrush}"
                BorderBrush="{DynamicResource InkBrush}"
                BorderThickness="1">
        <Grid Background="{DynamicResource PaperBrush}">
        <!-- Self-drawn square title bar. It is kept for the normal window,
             but zen mode hides this whole layer and leaves the reader's own
             exit controls as the only way to leave distraction-free mode. -->
        <Grid x:Name="ReaderWindowTitleBar"
              Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Background="Transparent"
              Height="38"
              VerticalAlignment="Top"
              ZIndex="50">
            <Grid Grid.Column="0">
                <Border x:Name="TitleBarDragRegion"
                        Background="Transparent"
                        PointerPressed="TitleBarDragRegion_PointerPressed" />
                <TextBlock x:Name="WindowBrandText"
                           Text="Kreader"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           LetterSpacing="1.08"
                           IsHitTestVisible="False"
                           IsVisible="False" />
            </Grid>

            <Border x:Name="ReaderZenActivationRegion"
                    Grid.ColumnSpan="2"
                    Width="380"
                    Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    IsVisible="False"
                    ZIndex="0"
                    PointerEntered="ReaderTitleControls_PointerEntered"
                    PointerExited="ReaderTitleControls_PointerExited" />

            <StackPanel x:Name="ReaderTitleControls"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="0"
                        ZIndex="1"
                        PointerEntered="ReaderTitleControls_PointerEntered"
                        PointerExited="ReaderTitleControls_PointerExited">
                <Button x:Name="ReaderZenTitleTocButton"
                        Classes="caption"
                        Width="92"
                        Height="38"
                        Padding="0"
                        FontSize="11"
                        AutomationProperties.Name="{DynamicResource Ui.Auto.0474752B788B123E}"
                        ToolTip.Tip="{DynamicResource Ui.Auto.4CC0023B765B0A72}"
                        IsVisible="False"
                        Click="ReaderZenMinimalTocButton_Click">
                    <TextBlock x:Name="ReaderZenTitleTocText"
                               Text="{DynamicResource Ui.Auto.73C9B3F7F3A16007}"
                               Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button x:Name="ReaderZenTitleExitButton"
                        Classes="caption"
                        Width="104"
                        Height="38"
                        Padding="0"
                        FontSize="11"
                        AutomationProperties.Name="{DynamicResource Ui.Auto.AF30F6FFB6EA23CF}"
                        ToolTip.Tip="{DynamicResource Ui.Auto.987BA0B5C2710754}"
                        IsVisible="False"
                        Click="ReaderExitZenButton_Click">
                    <TextBlock Text="{DynamicResource Ui.Auto.AF30F6FFB6EA23CF}"
                               Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button x:Name="MinimizeWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="MinimizeWindowButton_Click"
                        AutomationProperties.Name="{DynamicResource Ui.Auto.AC29E57A46F41C30}">
                    <Path Data="M 0,0 H 10" />
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="MaximizeWindowButton_Click"
                        AutomationProperties.Name="{DynamicResource Ui.Auto.82C4AA13B7CA109E}">
                    <Path x:Name="MaximizeWindowGlyph" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                </Button>
                <Button x:Name="CloseWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="CloseWindowButton_Click"
                        AutomationProperties.Name="{DynamicResource Ui.Auto.3FD47EDCE45B3603}">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                </Button>
            </StackPanel>
            <!-- Content dialogs sit below the title bar. Mirror their brush,
                 visibility and animated opacity so the caption buttons dim
                 with the rest of the window, including the first fade-in frame. -->
            <Grid x:Name="CaptionModalOverlays" Grid.Column="1" ZIndex="100">
                <Border Background="{Binding Background, ElementName=DevicePromptOverlay}"
                        IsVisible="{Binding IsVisible, ElementName=DevicePromptOverlay}"
                        Opacity="{Binding Opacity, ElementName=DevicePromptOverlay}" />
                <Border Background="{Binding Background, ElementName=ConfirmationOverlay}"
                        IsVisible="{Binding IsVisible, ElementName=ConfirmationOverlay}"
                        Opacity="{Binding Opacity, ElementName=ConfirmationOverlay}" />
                <Border Background="{Binding Background, ElementName=CollectionNameOverlay}"
                        IsVisible="{Binding IsVisible, ElementName=CollectionNameOverlay}"
                        Opacity="{Binding Opacity, ElementName=CollectionNameOverlay}" />
                <Border Background="{Binding Background, ElementName=DeviceModelInputOverlay}"
                        IsVisible="{Binding IsVisible, ElementName=DeviceModelInputOverlay}"
                        Opacity="{Binding Opacity, ElementName=DeviceModelInputOverlay}" />
                <Border Background="{Binding Background, ElementName=DoubanCandidateOverlay}"
                        IsVisible="{Binding IsVisible, ElementName=DoubanCandidateOverlay}"
                        Opacity="{Binding Opacity, ElementName=DoubanCandidateOverlay}" />
                <Border Background="{Binding Background, ElementName=DoubanPreviewOverlay}"
                        IsVisible="{Binding IsVisible, ElementName=DoubanPreviewOverlay}"
                        Opacity="{Binding Opacity, ElementName=DoubanPreviewOverlay}" />
                <Border Background="{Binding Background, ElementName=ImportFormatSelectionOverlay}"
                        IsVisible="{Binding IsVisible, ElementName=ImportFormatSelectionOverlay}"
                        Opacity="{Binding Opacity, ElementName=ImportFormatSelectionOverlay}" />
                <Border Background="{Binding Background, ElementName=ImportConflictOverlay}"
                        IsVisible="{Binding IsVisible, ElementName=ImportConflictOverlay}"
                        Opacity="{Binding Opacity, ElementName=ImportConflictOverlay}" />
                <!-- MessageOverlay and the native ReaderLayoutSettingsPopup
                     already cover the title bar; mirroring them would dim it twice. -->
            </Grid>
        </Grid>

        <Grid x:Name="LibraryRoot"
              Classes="libraryShell"
              Grid.Row="0"
              ColumnDefinitions="200,*,0"
              Background="{DynamicResource PaperBrush}"
              ZIndex="0"
              SizeChanged="LibraryRoot_SizeChanged">
            <!-- Left navigation -->
            <Border x:Name="LibrarySidebar" Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="18,24,18,18">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="34" Height="34" Background="{DynamicResource InkBrush}">
                            <TextBlock Text="K"
                                       Foreground="{DynamicResource PaperBrush}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="0"
                                    Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="Kkindle"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <!-- Update badge: hovering shows the release notes; after
                                     download, clicking opens the exit/install confirmation. -->
                                <Button x:Name="UpdateBadgeButton"
                                        IsVisible="False"
                                        Click="UpdateBadgeButton_Click"
                                        Cursor="Hand"
                                        Padding="3"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Focusable="False">
                                        <Ellipse Width="8" Height="8" Fill="#E0A100" />
                                    </Button>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Ui.Auto.61CD63ABFA7D1DAD}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedInkBrush}" />
                        </StackPanel>
                        <Button x:Name="S3SyncIndicatorButton"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Classes="syncIndicator"
                                Click="S3SyncIndicatorButton_Click"
                                Cursor="Hand"
                                ToolTip.Tip="{DynamicResource Ui.Auto.08E9893FADDB6B0C}"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.D530725A500152B4}"
                                VerticalAlignment="Center">
                            <Grid Width="28" Height="28">
                                <Path x:Name="S3SyncCloudIcon"
                                      Data="M 4.6,18.5 H 18.4 C 21.1,18.5 23.2,16.5 23.2,14 C 23.2,11.7 21.4,9.8 19.1,9.5 C 18.4,6.4 15.7,4.1 12.3,4.1 C 8.5,4.1 5.4,6.8 4.9,10.4 C 2.4,10.7 0.5,12.4 0.5,14.6 C 0.5,16.8 2.3,18.5 4.6,18.5 Z"
                                      Width="25"
                                      Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource SoftHoverBrush}"
                                      Stroke="{DynamicResource MutedInkBrush}"
                                      StrokeThickness="1.75"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      RenderTransformOrigin="50%,50%" />
                                <Path x:Name="S3SyncSpinnerIcon"
                                      Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 H 17.65 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 H 20 V 4 Z"
                                      Width="15"
                                      Height="15"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource InkBrush}"
                                      RenderTransformOrigin="50%,50%"
                                      IsVisible="False"
                                      IsHitTestVisible="False" />
                                <Path x:Name="S3SyncSuccessGlyph"
                                      Data="M 9,16.17 L 4.83,12 L 3.41,13.41 L 9,19 L 21,7 L 19.59,5.59 Z"
                                      Width="15"
                                      Height="15"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource InkBrush}"
                                      IsVisible="False"
                                      IsHitTestVisible="False" />
                                <Path x:Name="S3SyncFailureGlyph"
                                      Data="M 5.5,0.5 H 9.5 L 8.9,8.5 H 6.1 Z M 5.5,10.5 H 9.5 V 14.5 H 5.5 Z"
                                      Width="15"
                                      Height="15"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="None"
                                      Fill="{DynamicResource InkBrush}"
                                      IsVisible="False"
                                      IsHitTestVisible="False" />
                            </Grid>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,24,0,16"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="3">
                                <Button x:Name="BookManagementSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid Classes="sidebarEntry" ColumnDefinitions="24,8,*,Auto">
                                            <local:SidebarGlyph Classes="libraryGlyph sidebarGlyph" Stroke="{DynamicResource InkBrush}" Data="{StaticResource SidebarBooksGeometry}" />
                                            <TextBlock Grid.Column="2" Classes="sidebarLabel" Text="{DynamicResource Ui.Auto.FB55F8EAEF4BB602}" />
                                            <Path x:Name="BookManagementChevron"
                                                  Grid.Column="3"
                                                  Data="M 1,2 L 5,6 L 9,2"
                                                  Width="10"
                                                  Height="8"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="BookManagementChildren" Spacing="3">
                                    <Button x:Name="AllBooksButton"
                                            Classes="sidebarItem active"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.FAFE70E30BE14271}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.AA12555D73B23489}"
                                            Click="ShowAllBooksButton_Click">
                                        <Grid Classes="sidebarEntry" ColumnDefinitions="24,8,*,Auto">
                                            <local:SidebarGlyph Classes="libraryGlyph sidebarGlyph" IconScale="0.9" Stroke="{DynamicResource InkBrush}" Data="{StaticResource SidebarComputerGeometry}" />
                                            <TextBlock Grid.Column="2" Classes="sidebarLabel" Text="{DynamicResource Ui.Auto.FAFE70E30BE14271}" />
                                            <Border Grid.Column="3"
                                                    Margin="6,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="9"
                                                    Background="#10000000"
                                                    Padding="6,1">
                                                <TextBlock x:Name="SidebarCountText" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="KindleBooksButton"
                                            Classes="sidebarItem"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.EC63017A628AB5D9}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.4897495CB792933E}"
                                            Click="KindleBooksButton_Click">
                                        <Grid Classes="sidebarEntry" ColumnDefinitions="24,8,*,Auto">
                                            <local:SidebarGlyph Classes="libraryGlyph sidebarGlyph" IconScale="0.9" Stroke="{DynamicResource InkBrush}" Data="{StaticResource SidebarDeviceLibraryGeometry}" />
                                            <TextBlock Grid.Column="2" Classes="sidebarLabel" Text="{DynamicResource Ui.Auto.EC63017A628AB5D9}" />
                                            <Border Grid.Column="3"
                                                    Margin="6,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="9"
                                                    Background="#10000000"
                                                    Padding="6,1">
                                                <TextBlock x:Name="DeviceBookCountText" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="DeviceManagementSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid Classes="sidebarEntry" ColumnDefinitions="24,8,*,Auto">
                                            <local:SidebarGlyph Classes="libraryGlyph sidebarGlyph" Stroke="{DynamicResource InkBrush}" Data="{StaticResource SidebarDevicesGeometry}" />
                                            <TextBlock Grid.Column="2" Classes="sidebarLabel" Text="{DynamicResource Ui.Auto.7E708DD49F0A4215}" />
                                            <Path x:Name="DeviceManagementChevron"
                                                  Grid.Column="3"
                                                  Data="M 2,1 L 6,5 L 2,9"
                                                  Width="10"
                                                  Height="10"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="DeviceManagementChildren" Spacing="3" IsVisible="False">
                                    <Button x:Name="FontManagementButton"
                                            Classes="sidebarItem"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.A654447A8C906AB1}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.2E572B6D78B5FE75}"
                                            Click="FontManagementButton_Click">
                                        <Grid Classes="sidebarEntry" ColumnDefinitions="24,8,*,Auto">
                                            <local:SidebarGlyph Classes="libraryGlyph sidebarGlyph" IconScale="0.9" Stroke="{DynamicResource InkBrush}" Data="{StaticResource SidebarFontsGeometry}" />
                                            <TextBlock Grid.Column="2" Classes="sidebarLabel" Text="{DynamicResource Ui.Auto.A654447A8C906AB1}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="DictionaryManagementButton"
                                            Classes="sidebarItem"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.8B62411F753D8465}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.27D8F6DDB26F435B}"
                                            Click="DictionaryManagementButton_Click">
                                        <Grid Classes="sidebarEntry" ColumnDefinitions="24,8,*,Auto">
                                            <local:SidebarGlyph Classes="libraryGlyph sidebarGlyph" IconScale="0.9" Stroke="{DynamicResource InkBrush}" Data="{StaticResource SidebarDictionaryGeometry}" />
                                            <TextBlock Grid.Column="2" Classes="sidebarLabel" Text="{DynamicResource Ui.Auto.8B62411F753D8465}" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="ReadingSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid Classes="sidebarEntry" ColumnDefinitions="24,8,*,Auto">
                                            <local:SidebarGlyph Classes="libraryGlyph sidebarGlyph" Stroke="{DynamicResource InkBrush}" Data="{StaticResource SidebarReadingGeometry}" />
                                            <TextBlock Grid.Column="2" Classes="sidebarLabel" Text="{DynamicResource Ui.Auto.7EDB884BEE9690C4}" />
                                            <Path x:Name="ReadingChevron"
                                                  Grid.Column="3"
                                                  Data="M 1,2 L 5,6 L 9,2"
                                                  Width="10"
                                                  Height="8"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="ReadingChildren" Spacing="3" IsVisible="False">
                                    <Button x:Name="ReaderNotesNavigationButton"
                                            Classes="sidebarItem"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.8A7525B1492FB848}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.477A9BD5C415C9E7}"
                                            Click="ReaderNotesNavigationButton_Click">
                                        <Grid Classes="sidebarEntry" ColumnDefinitions="24,8,*,Auto">
                                            <local:SidebarGlyph Classes="libraryGlyph sidebarGlyph" IconScale="0.9" Stroke="{DynamicResource InkBrush}" Data="{StaticResource SidebarNotesGeometry}" />
                                            <TextBlock Grid.Column="2" Classes="sidebarLabel" Text="{DynamicResource Ui.Auto.8A7525B1492FB848}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="ReadingDashboardButton"
                                            Classes="sidebarItem"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.440C143379A34160}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.A6F23A1728A8C25E}"
                                            Click="ReadingDashboardButton_Click">
                                        <Grid Classes="sidebarEntry" ColumnDefinitions="24,8,*,Auto">
                                            <local:SidebarGlyph Classes="libraryGlyph sidebarGlyph" IconScale="0.9" Stroke="{DynamicResource InkBrush}" Data="{StaticResource SidebarStatisticsGeometry}" />
                                            <TextBlock Grid.Column="2" Classes="sidebarLabel" Text="{DynamicResource Ui.Auto.440C143379A34160}" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="SettingsNavigationButton"
                                    Classes="sidebarPrimaryItem"
                                    AutomationProperties.Name="{DynamicResource Ui.Auto.DF3D58C7D84B85F2}"
                                    Click="SettingsButton_Click">
                                <Grid Classes="sidebarEntry" ColumnDefinitions="24,8,*,Auto">
                                    <local:SidebarGlyph Classes="libraryGlyph sidebarGlyph" Stroke="{DynamicResource InkBrush}" Data="{StaticResource SidebarSettingsGeometry}" />
                                    <TextBlock Grid.Column="2" Classes="sidebarLabel" Text="{DynamicResource Ui.Auto.DF3D58C7D84B85F2}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="DeviceStatusBox"
                            Grid.Row="2"
                            Padding="10"
                            Background="Transparent">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                                <TextBlock x:Name="KindleStatusText"
                                           Classes="kindleStatusTrigger"
                                           Text="{DynamicResource Ui.Auto.92424890EA6A8543}"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Tapped="DeviceStatusBox_Tapped"
                                           ToolTip.Tip="{DynamicResource Ui.Auto.562195D98680EA3D}" />
                                <TextBlock x:Name="KindleConnectionText"
                                            Grid.Row="1"
                                            Margin="0,2,0,0"
                                            Foreground="{DynamicResource MutedInkBrush}"
                                            FontSize="10"
                                            TextWrapping="Wrap"
                                            HorizontalAlignment="Stretch" />
                                <Border Grid.Column="1"
                                        Grid.Row="0"
                                        Classes="ejectHoverArea"
                                        Width="25"
                                        Height="23"
                                        Background="Transparent"
                                        VerticalAlignment="Center">
                                    <Button x:Name="DeviceStatusEjectButton"
                                            Classes="eject"
                                            Width="25"
                                            MinWidth="25"
                                            Height="23"
                                            IsEnabled="False"
                                            LayoutUpdated="DeviceStatusEjectButton_LayoutUpdated"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.73238927F76F6BD2}"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.E77633A0AFCAACCE}"
                                            Click="EjectDeviceButton_Click">
                                        <Polygon x:Name="DeviceEjectTriangleGlyph"
                                                 Classes="ejectGlyph"
                                                 Points="0,8 7,0 14,8"
                                                 Width="14"
                                                 Height="8"
                                                 Stroke="{DynamicResource InkBrush}"
                                                 StrokeThickness="1"
                                                 Stretch="Fill"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Button>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="DeviceStorageText"
                                       Text="{DynamicResource Ui.Auto.55DCD2D20A544E05}"
                                       Foreground="{DynamicResource MutedInkBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <Grid x:Name="DeviceStorageBar"
                                  Height="10"
                                  Background="{DynamicResource PaperBrush}"
                                  SizeChanged="DeviceStorageBar_SizeChanged">
                                <Rectangle x:Name="DeviceStorageUsedBar" HorizontalAlignment="Left" Fill="{DynamicResource InkBrush}" Width="0" />
                                <Border BorderBrush="{DynamicResource InkBrush}" BorderThickness="1" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Local library -->
            <Grid x:Name="LibraryWorkspace"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  RowDefinitions="Auto,Auto,Auto,*,Auto">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid x:Name="LibraryHeader" ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="{DynamicResource Ui.Auto.FAFE70E30BE14271}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="LibraryToolbar"
                      Grid.Row="1"
                      Margin="0,22,0,18"
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="24"
                      LayoutUpdated="LibraryToolbar_LayoutUpdated"
                      SizeChanged="LibraryToolbar_SizeChanged">
                    <TextBox x:Name="SearchBox"
                             Width="420"
                             HorizontalAlignment="Left"
                             Height="38"
                             Padding="13,7"
                             PlaceholderText="{DynamicResource Ui.Auto.168A769EBA62A8E8}"
                             Text="{Binding ViewModel.SearchText, Mode=TwoWay}"
                             TextChanged="SearchBox_TextChanged" />
                    <StackPanel x:Name="LibraryToolbarActions"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8"
                                SizeChanged="LibraryToolbar_SizeChanged">
                        <Button x:Name="FilterButton" Classes="quiet libraryToolbar" ToolTip.Tip="{DynamicResource Ui.Auto.0289E5BA6BFEA5E2}" Click="FilterButton_Click" AutomationProperties.Name="{DynamicResource Ui.Auto.B5F15473FDC0FEFE}">
                            <Path Classes="libraryGlyph"
                                  Data="M 5,5.4 H 19 L 14.2,11 V 17.6 L 9.8,19.8 V 11 Z" />
                        </Button>
                        <Border Classes="librarySort" Width="38" Height="38"
                                VerticalAlignment="Center" PointerPressed="LibrarySort_PointerPressed">
                            <ComboBox x:Name="LibrarySortBox"
                                      Classes="filterCombo librarySort"
                                      Background="Transparent"
                                      MinWidth="0"
                                      Width="38"
                                      Height="38"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      FontSize="13"
                                      BorderThickness="0"
                                      Padding="0"
                                      SelectionBoxItemTemplate="{StaticResource LibrarySortActionContent}"
                                      PlaceholderText="{DynamicResource Ui.Auto.A96C9A854190874D}"
                                      ToolTip.Tip="{DynamicResource Ui.Auto.A96C9A854190874D}"
                                      AutomationProperties.Name="{DynamicResource Ui.Auto.A96C9A854190874D}"
                                      SelectionChanged="FilterComboBox_SelectionChanged" />
                        </Border>
                        <Button x:Name="LibraryViewToggleButton"
                                Classes="quiet libraryToolbar"
                                ToolTip.Tip="{DynamicResource Ui.Auto.EE20B1318E9AFE1B}"
                                Click="LibraryViewToggleButton_Click"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.EE20B1318E9AFE1B}">
                            <Button.ContextMenu>
                                <ContextMenu Classes="shelfViewMenu" Placement="BottomEdgeAlignedRight">
                                    <MenuItem x:Name="LibraryGridViewMenuItem" Header="{DynamicResource Ui.Auto.A35441DB5CD16882}" Tag="Grid" ToggleType="Radio" Click="LibraryViewMenuItem_Click" />
                                    <MenuItem x:Name="LibraryListViewMenuItem" Header="{DynamicResource Ui.Auto.D56220435194BC1E}" Tag="List" ToggleType="Radio" Click="LibraryViewMenuItem_Click" />
                                    <MenuItem x:Name="LibraryCollectionsViewMenuItem" Header="{DynamicResource Ui.Auto.5495D963C9CA791A}" Tag="Collections" ToggleType="Radio" Click="LibraryViewMenuItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Path x:Name="LibraryViewToggleIcon"
                                  Classes="libraryGlyph"
                                  Data="M 3,3 H 9 V 9 H 3 Z M 15,3 H 21 V 9 H 15 Z M 3,15 H 9 V 21 H 3 Z M 15,15 H 21 V 21 H 15 Z" />
                        </Button>
                        <Button x:Name="SendToKindleWebButton"
                                Classes="quiet libraryToolbar"
                                ToolTip.Tip="{DynamicResource Ui.KindleWeb.Title}"
                                AutomationProperties.Name="{DynamicResource Ui.KindleWeb.Title}"
                                Click="OpenSendToKindleWebButton_Click">
                            <Path Classes="libraryGlyph" Width="17" Height="17"
                                  Data="M 22,2 L 15,22 L 11,13 L 2,9 Z M 22,2 L 11,13" />
                        </Button>
                        <Button x:Name="ImportButton"
                                Classes="quiet libraryToolbar"
                                Height="38"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{DynamicResource Ui.Auto.A76D4E4052F3FA6F}"
                                Click="ImportButton_Click"
                                AutomationProperties.Name="{DynamicResource Ui.Library.ImportBooks}">
                            <Path Classes="libraryGlyph" Width="16" Height="16" Data="M 12,4 V 20 M 4,12 H 20" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="FilterPanel"
                        Classes="flatSubsection"
                        Grid.Row="2"
                        Margin="0,0,0,12"
                        Padding="10"
                        IsVisible="False">
                    <!-- English labels need more room than the Chinese labels. Let
                         the controls wrap as a group at narrow window widths so no
                         filter or action is pushed outside the visible panel. -->
                    <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center">
                        <ComboBox x:Name="AuthorFilterBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.89050DD0FBDA32A3}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="TagFilterBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.B709CB12F0ABA6BE}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="FormatFilterBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.CCCB7189507A26E7}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="CategoryFilterBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.A1054434857F0A98}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="ReadingStatusFilterBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.0A379C1E7398FBA1}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <CheckBox x:Name="FavoritesOnlyCheckBox"
                                  Content="{DynamicResource Ui.Auto.60A53514EB9228A2}"
                                  Margin="0,0,12,6"
                                  VerticalAlignment="Center"
                                  Click="FavoritesOnlyCheckBox_Click" />
                        <Button Classes="quiet"
                                Content="{DynamicResource Ui.Auto.657D9CBF45EC9E6A}"
                                Margin="0,0,0,6"
                                Click="ClearFiltersButton_Click" />
                    </WrapPanel>
                </Border>

            <Grid x:Name="LibraryBody" Grid.Row="3" ColumnDefinitions="*,Auto" ClipToBounds="True">
            <Grid x:Name="LibraryContentHost"
                  RowDefinitions="Auto,*,Auto"
                  Background="Transparent">
                    <!-- Collection breadcrumb header: the active collection
                         title on the left and a single back action on the right. -->
                    <Border x:Name="CollectionHeader"
                            Margin="0,0,0,4"
                            Padding="0,2,0,12"
                            BorderBrush="{DynamicResource InkBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <TextBlock x:Name="ActiveCollectionTitleText" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="BackToCollectionsButton"
                                        Classes="quiet"
                                        Padding="12,6"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.94DC4D657CA6C6C6}"
                                        Click="BackToCollectionsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="libraryGlyph" Width="13" Height="13" Data="M 15,4 L 7,12 L 15,20" />
                                        <TextBlock Text="{DynamicResource Ui.Auto.5A24236E1754E954}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CreateCollectionButton" Content="{DynamicResource Ui.Auto.FDF0B569D820ADE8}" Padding="12,6" Click="CreateCollectionButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="BookGrid" Classes="bookGrid" ItemsSource="{Binding ViewModel.Books}" SelectionMode="Multiple" SelectionChanged="BookList_SelectionChanged" PointerPressed="BookGrid_PointerPressed" PointerMoved="BookGrid_PointerMoved" PointerReleased="BookGrid_PointerReleased" PointerCaptureLost="BookGrid_PointerCaptureLost" KeyDown="BookGrid_KeyDown" Focusable="True" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><local:VirtualizingWrapPanel Orientation="Horizontal" ItemWidth="166" ItemHeight="304" CacheLength="0.5" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate>                                 <DataTemplate x:DataType="local:BookCardViewModel">                                     <Grid Width="154"                                           Height="{Binding CardHeight}"                                           Margin="6"                                           RowDefinitions="214,Auto"                                           PointerPressed="BookCard_PointerPressed"                                           ContextRequested="BookCard_ContextRequested"                                           DoubleTapped="BookCard_DoubleTapped" AttachedToVisualTree="BookCard_AttachedToVisualTree" DetachedFromVisualTree="BookCard_DetachedFromVisualTree">                                         <Border Grid.Row="0"                                                 Classes="bookCover"                                                 Background="{DynamicResource PressedBrush}"                                                 BorderThickness="1">                                             <Grid Background="Transparent">                                                 <TextBlock Text="BOOK"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center"                                                            Foreground="{DynamicResource MutedInkBrush}"                                                            FontSize="17"                                                            IsHitTestVisible="False" />                                                 <Image Source="{Binding CoverImage}" Stretch="UniformToFill" /></Grid>                                         </Border>                                         <Grid Grid.Row="1" Margin="2,8,2,0" ColumnDefinitions="*,58" RowDefinitions="40,16,14" IsVisible="{Binding GalleryTextVisibility}">                                             <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="15" LineHeight="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />                                             <TextBlock Grid.Row="1" Text="{Binding Authors}" FontSize="11" LineHeight="14" Foreground="{DynamicResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />                                             <TextBlock Grid.Row="2" Text="{Binding FormatLabel}" FontSize="10" LineHeight="12" Foreground="{DynamicResource SubtleInkBrush}" TextTrimming="CharacterEllipsis" />                                         <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="52" ColumnDefinitions="24,24" ColumnSpacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                             <ContentControl Grid.Column="0" Width="24" Height="24" Content="{Binding}" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ContentTemplate="{StaticResource BookSyncStatusGlyph}" ToolTip.Tip="{Binding SyncStatusLabel}" AutomationProperties.Name="{Binding SyncStatusLabel}" Tapped="BookSyncStatusIcon_Tapped" IsVisible="{Binding SyncStatusVisibility}" />
                                             <ContentControl Grid.Column="1" Width="24" Height="24" Content="{Binding}" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ContentTemplate="{StaticResource LibraryPresenceGlyph}" ToolTip.Tip="{Binding PresenceLabel}" AutomationProperties.Name="{Binding PresenceLabel}" IsVisible="{Binding PresenceVisibility}" />
                                         </Grid>                                         </Grid>                                         <!-- 格式转换进度徽标：点击可恢复转换弹窗 -->                                         <Border Grid.Row="0"                                                 Width="68"                                                 Height="25"                                                 Margin="0,0,5,38"                                                 HorizontalAlignment="Right"                                                 VerticalAlignment="Bottom"                                                 Background="{DynamicResource PaperBrush}"                                                 BorderBrush="{DynamicResource InkBrush}"                                                 BorderThickness="1"                                                 Tapped="BookConversionProgressIndicator_Tapped"                                                 AutomationProperties.Name="{DynamicResource Ui.Auto.2BAA9E126F060708}"                                                 ToolTip.Tip="{DynamicResource Ui.Auto.10F6BFF0084F60EF}"                                                 IsVisible="{Binding ConversionProgressVisibility}">                                             <Grid Width="66" Height="23">                                                 <ProgressBar Minimum="0"                                                              Maximum="100"                                                              Value="{Binding ConversionProgress}"                                                              Height="5"                                                              Margin="5,0,5,3"                                                              VerticalAlignment="Bottom"                                                              Background="{DynamicResource PaperBrush}" />                                                 <TextBlock Text="{Binding ConversionProgressLabel}"                                                            FontSize="10"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center" />                                             </Grid>                                         </Border>                                         <Border Grid.RowSpan="2"                                                 Classes="bookOutline"                                                 BorderBrush="{DynamicResource CardBorderBrush}"                                                 BorderThickness="1"                                                 IsHitTestVisible="False" />                                         <Border Grid.RowSpan="2"                                                 BorderBrush="{DynamicResource InkBrush}"                                                 BorderThickness="1.5"                                                 IsVisible="{Binding IsMultiSelected}"                                                 IsHitTestVisible="False">                                             <Border Width="22"                                                     Height="22"                                                     Margin="6"                                                     HorizontalAlignment="Left"                                                     VerticalAlignment="Top"                                                     Background="{DynamicResource InkBrush}">                                                 <TextBlock Text="✓"                                                            Foreground="{DynamicResource PaperBrush}"                                                            FontSize="14"                                                            FontWeight="Bold"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center" />                                             </Border>                                         </Border>                                     </Grid></DataTemplate>                             </ListBox.ItemTemplate>
                        </ListBox>

                        <Canvas IsHitTestVisible="False" ZIndex="25">
                            <Border x:Name="RubberBandRectangle"
                                    Background="#33000000"
                                    BorderBrush="{DynamicResource InkBrush}"
                                    BorderThickness="1"
                                    IsVisible="False" />
                        </Canvas>

                        <ListBox x:Name="BookList"
                                 Classes="bookList"
                                 ItemsSource="{Binding ViewModel.Books}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="BookList_SelectionChanged"
                                 IsVisible="False"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:BookCardViewModel">
                                        <Border Margin="0,0,0,7"
                                                Classes="bookRow flatRow"
                                                Padding="10"
                                                Background="{DynamicResource PaperBrush}"
                                                PointerPressed="BookCard_PointerPressed"
                                            ContextRequested="BookCard_ContextRequested"
                                            DoubleTapped="BookCard_DoubleTapped" AttachedToVisualTree="BookCard_AttachedToVisualTree" DetachedFromVisualTree="BookCard_DetachedFromVisualTree">
                                        <Grid ColumnDefinitions="48,1.55*,1.65*,1.2*,140" ColumnSpacing="12">
                                            <Border Width="40" Height="56" VerticalAlignment="Center" Background="{DynamicResource SoftHoverBrush}" BorderBrush="{DynamicResource InkBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                </Grid>
                                             </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Title}" />
                                                <TextBlock Text="{Binding Authors}" Foreground="{DynamicResource MutedInkBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Authors}" />
                                                <TextBlock Text="{Binding FileSummaryLabel}" FontSize="10" Foreground="{DynamicResource SubtleInkBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileSummaryLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding OrganizationLabel}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OrganizationLabel}" />
                                                <TextBlock Text="{Binding PublicationLabel}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PublicationLabel}" />
                                                <TextBlock Text="{Binding IdentifierLabel}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IdentifierLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding ReadingStateLabel}" Foreground="{DynamicResource MutedInkBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReadingStateLabel}" />
                                                <TextBlock Text="{Binding DescriptionSummaryLabel}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="10" TextTrimming="CharacterEllipsis" MaxLines="2" ToolTip.Tip="{Binding DescriptionSummaryLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="5">
                                                <TextBlock Text="{Binding UpdatedLabel}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UpdatedLabel}" />
                                                <Grid Width="52" ColumnDefinitions="24,24" ColumnSpacing="4" HorizontalAlignment="Right">
                                                    <ContentControl Width="24"
                                                                    Grid.Column="0"
                                                                    Height="24"
                                                                    Content="{Binding}"
                                                                    Padding="0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalContentAlignment="Center"
                                                                    VerticalContentAlignment="Center"
                                                                    ContentTemplate="{StaticResource BookSyncStatusGlyph}"
                                                                    ToolTip.Tip="{Binding SyncStatusLabel}"
                                                                    AutomationProperties.Name="{Binding SyncStatusLabel}"
                                                                    Tapped="BookSyncStatusIcon_Tapped"
                                                                    IsVisible="{Binding SyncStatusVisibility}" />
                                                    <ContentControl Width="24"
                                                                    Grid.Column="1"
                                                                    Height="24"
                                                                    Content="{Binding}"
                                                                    Padding="0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalContentAlignment="Center"
                                                                    VerticalContentAlignment="Center"
                                                                    ContentTemplate="{StaticResource LibraryPresenceGlyph}"
                                                                    ToolTip.Tip="{Binding PresenceLabel}"
                                                                    AutomationProperties.Name="{Binding PresenceLabel}"
                                                                    IsVisible="{Binding PresenceVisibility}" />
                                                </Grid>
                                            </StackPanel>
                                            <Border Grid.ColumnSpan="5"
                                                    BorderBrush="{DynamicResource InkBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding IsSelected}"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer x:Name="CollectionScroll"
                                      IsVisible="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ContextRequested="CollectionScroll_ContextRequested">
                            <ItemsControl x:Name="CollectionList" ItemsSource="{Binding FilteredCollectionFolders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemWidth="210" ItemHeight="142" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:BookCollectionFolderViewModel">
                                        <Grid Width="210"
                                              Height="142"
                                              Classes="collectionFolder"
                                              Tapped="CollectionFolder_Tapped"
                                              ContextRequested="CollectionFolder_ContextRequested"
                                              PointerPressed="CollectionFolder_PointerPressed"
                                              PointerMoved="CollectionFolder_PointerMoved"
                                              PointerReleased="CollectionFolder_PointerReleased"
                                              PointerCaptureLost="CollectionFolder_PointerCaptureLost">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="94" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <!-- Folder icon: light-grey body, top tab and
                                                 three overlapping cover thumbnails. -->
                                            <Grid Width="174" Height="86" Margin="8,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Border Margin="0,14,0,0"
                                                        Background="{DynamicResource SoftHoverBrush}"
                                                        BorderBrush="{DynamicResource InkBrush}"
                                                        BorderThickness="1" />
                                                <Border Width="72"
                                                        Height="21"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource SoftHoverBrush}"
                                                        BorderBrush="{DynamicResource InkBrush}"
                                                        BorderThickness="1,1,1,0" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="-6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="0,6,0,0">
                                                    <Border Width="44"
                                                            Height="62"
                                                            Background="{DynamicResource CoverBrush}"
                                                            BorderBrush="{DynamicResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource MutedInkBrush}"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover1}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="44"
                                                            Height="62"
                                                            Margin="0,4,0,0"
                                                            Background="{DynamicResource CoverBrush}"
                                                            BorderBrush="{DynamicResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource MutedInkBrush}"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover2}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="44"
                                                            Height="62"
                                                            Background="{DynamicResource CoverBrush}"
                                                            BorderBrush="{DynamicResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource MutedInkBrush}"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover3}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="9,7,1,0" Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Name}" />
                                                <TextBlock Text="{Binding BookCountLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedInkBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Canvas x:Name="CollectionDragOverlay"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                ClipToBounds="False"
                                ZIndex="60">
                            <Border x:Name="CollectionDragPreview"
                                    Width="210"
                                    Height="142"
                                    Background="{DynamicResource PaperBrush}"
                                    Opacity="0.94"
                                    BoxShadow="{DynamicResource CardHoverShadow}">
                                <Grid Width="210" Height="142">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="94" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Width="174" Height="86" Margin="8,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Border Margin="0,14,0,0"
                                                Background="{DynamicResource SoftHoverBrush}"
                                                BorderBrush="{DynamicResource InkBrush}"
                                                BorderThickness="1" />
                                        <Border Width="72"
                                                Height="21"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource SoftHoverBrush}"
                                                BorderBrush="{DynamicResource InkBrush}"
                                                BorderThickness="1,1,1,0" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="-6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0,6,0,0">
                                            <Border Width="44"
                                                    Height="62"
                                                    Background="{DynamicResource CoverBrush}"
                                                    BorderBrush="{DynamicResource InkBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="BOOK"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedInkBrush}"
                                                               FontSize="8" />
                                                    <Image x:Name="CollectionDragPreviewCover1" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <Border Width="44"
                                                    Height="62"
                                                    Margin="0,4,0,0"
                                                    Background="{DynamicResource CoverBrush}"
                                                    BorderBrush="{DynamicResource InkBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="BOOK"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedInkBrush}"
                                                               FontSize="8" />
                                                    <Image x:Name="CollectionDragPreviewCover2" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <Border Width="44"
                                                    Height="62"
                                                    Background="{DynamicResource CoverBrush}"
                                                    BorderBrush="{DynamicResource InkBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="BOOK"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedInkBrush}"
                                                               FontSize="8" />
                                                    <Image x:Name="CollectionDragPreviewCover3" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="9,7,1,0" Spacing="2">
                                        <TextBlock x:Name="CollectionDragPreviewTitle"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="CollectionDragPreviewCount"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedInkBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Canvas>

                        <Grid x:Name="EmptyLibraryState"
                              Margin="24,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              IsVisible="False"
                              IsHitTestVisible="False">
                            <StackPanel MaxWidth="320"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <Path Data="M 3.5,6.5 C 6.5,5.4 9.9,5.9 12,7.8 C 14.1,5.9 17.5,5.4 20.5,6.5 V 18.2 C 17.5,17.1 14.1,17.6 12,19.4 C 9.9,17.6 6.5,17.1 3.5,18.2 Z M 12,7.8 V 19.4"
                                      Width="48"
                                      Height="48"
                                      Margin="0,0,0,4"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      UseLayoutRounding="True"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource InkBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Fill="Transparent" />
                                <TextBlock x:Name="EmptyLibraryTitleText"
                                           Text="{DynamicResource Ui.Auto.CFEEF6870D35C4EA}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="20"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="EmptyLibraryMessageText"
                                           Text="{DynamicResource Ui.Auto.A1D2A323B5C89F04}"
                                           HorizontalAlignment="Stretch"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="LibraryDropOverlay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                        Padding="34,24"
                        Background="{DynamicResource PaperBrush}"
                        BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                ZIndex="30">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource Ui.Auto.606C52C9D9ACCF69}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Ui.Auto.F7824158AAA04D87}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MultiSelectionBar"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,16"
                                Padding="14,8"
                                Background="{DynamicResource PaperBrush}"
                                BorderBrush="{DynamicResource InkBrush}"
                                BorderThickness="1"
                                BoxShadow="0 6 16 0 #22000000"
                                IsVisible="False"
                                ZIndex="20">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="MultiSelectionText" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Content="{DynamicResource Ui.Auto.4528DB10180F641B}" Padding="12,6" Click="SendSelectedBooksToKindleBatchButton_Click" />
                                <Button Content="{DynamicResource Ui.Auto.1579F7B476E86BFF}" Padding="12,6" Click="SendSelectedBooksByEmailBatchButton_Click" />
                                <Button x:Name="DeleteSelectedBooksButton" Content="{DynamicResource Ui.Auto.435BF8A234FDE6F2}" Padding="12,6" Click="DeleteSelectedBooksButton_Click" />
                                <Button Content="{DynamicResource Ui.Auto.74966E20DF2EA9FD}" Padding="12,6" Click="ClearMultiSelectionButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="LibraryPaginationBar"
                      Grid.Row="2"
                      ColumnDefinitions="Auto,*,Auto"
                      Margin="0,8,0,0"
                      IsVisible="False">
                    <Button x:Name="LibraryPreviousPageButton"
                            Content="上一页"
                            Classes="quiet"
                            Padding="10,5"
                            Click="LibraryPreviousPageButton_Click" />
                    <TextBlock x:Name="LibraryPageText"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource MutedInkBrush}" />
                    <Button x:Name="LibraryNextPageButton"
                            Grid.Column="2"
                            Content="下一页"
                            Classes="quiet"
                            Padding="10,5"
                            Click="LibraryNextPageButton_Click" />
                    </Grid>
                </Grid>

            <!-- Details share the book area so the header and toolbar remain
                 accessible. The auto column returns its width when closed. -->
            <Border x:Name="LibraryDetailPane"
                    Grid.Column="1"
                    Width="320"
                    Margin="24,0,0,0"
                    HorizontalAlignment="Right"
                    ZIndex="40"
                    Background="{DynamicResource PaperBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="20,0,4,8">
                        <TextBlock Text="{DynamicResource Ui.Auto.326DE7898C2A6278}"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="LibraryDetailCloseButton"
                                Grid.Column="1"
                                Classes="icon"
                                ToolTip.Tip="{DynamicResource Ui.Auto.D7B60ECE792129FF}"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.D7B60ECE792129FF}"
                                Click="LibraryDetailCloseButton_Click">
                            <Path Classes="libraryGlyph" Width="13" Height="13" Data="M 4,4 L 20,20 M 20,4 L 4,20" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DetailContentStack" Margin="24,0,24,24" Spacing="13">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="180,34" ColumnSpacing="12">
                                <Border Width="180"
                                        Height="250"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource PaperBrush}">
                                    <Grid>
                                        <Image x:Name="DetailCoverImage" Stretch="UniformToFill" />
                                        <TextBlock x:Name="DetailCoverPlaceholder"
                                                   Text="{DynamicResource Ui.Auto.646F56BD61A92E84}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedInkBrush}" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1"
                                      Height="250"
                                      VerticalAlignment="Top"
                                      RowDefinitions="*,*,*">
                                    <Button x:Name="DetailDoubanButton"
                                            Classes="quiet"
                                            BorderThickness="0"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.C2F860918778ACC8}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.AB328F6F9A71D0E7}"
                                            Click="DoubanMatchButton_Click">
                                        <!-- Magnifier glyph (WinUI E721). -->
                                        <Path Classes="libraryGlyph"
                                              Data="M 11,4 A 7,7 0 1,0 11,18 A 7,7 0 1,0 11,4 M 16,16 L 21,21" />
                                    </Button>
                                    <Button x:Name="DetailFavoriteButton"
                                            Grid.Row="1"
                                            Classes="quiet"
                                            BorderThickness="0"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.77196E6DEB2195FA}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.77196E6DEB2195FA}"
                                            Click="DetailFavoriteButton_Click">
                                        <Path x:Name="DetailFavoriteIcon"
                                              Classes="libraryGlyph"
                                              Data="M 12,3 L 14.8,8.7 L 21,9.6 L 16.5,14 L 17.6,20.2 L 12,17.3 L 6.4,20.2 L 7.5,14 L 3,9.6 L 9.2,8.7 Z" />
                                    </Button>
                                    <Button x:Name="DetailReadingStatusButton"
                                            Grid.Row="2"
                                            Classes="quiet"
                                            BorderThickness="0"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.CAF07AC99C9DE865}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.CAF07AC99C9DE865}"
                                            Click="DetailReadingStatusButton_Click">
                                        <Path x:Name="DetailReadingStatusIcon"
                                              Classes="libraryGlyph"
                                              Data="M 12,4 A 8,8 0 1 0 12,20 A 8,8 0 1 0 12,4" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <TextBlock x:Name="DetailFormatText" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.C3405F8C7D9D392A}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBox x:Name="DetailTitleText" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.7D4146CA082798F0}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBox x:Name="DetailAuthorsText" FontSize="13" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.0213F653036C18BA}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBox x:Name="DetailDoubanRatingBox" IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.1D0FD5F9336D9103}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBox x:Name="DetailTagsBox" PlaceholderText="{DynamicResource Ui.Auto.42F1A31C725F5D65}" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.515559957FD3ACBD}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBox x:Name="DetailCategoryBox" PlaceholderText="{DynamicResource Ui.Auto.0C9D7F0CA37B2C93}" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.649F19CE8EB1CEE9}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBox x:Name="DetailCollectionsText" IsReadOnly="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.8131EAFD02396E6A}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBox x:Name="DetailDescriptionBox" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="{DynamicResource Ui.Auto.D0976E76BF2566C5}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedInkBrush}" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.232527192F3462A3}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBox x:Name="DetailSeriesBox" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.1107B9A98AD38DB6}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBox x:Name="DetailPublisherBox" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.D6D0F10A7D96A8D2}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailPublishDateBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="ISBN" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailIsbnBox" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.560630BA0C84322E}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailPageCountBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.5A0E877ACFB138E4}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailBindingBox" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,8,0,2" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button x:Name="SaveDetailsButton"
                                        Classes="detailSave"
                                        Content="{DynamicResource Ui.Auto.991BB7CFE5A81550}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="SaveDetailsButton_Click" />
                                <Button Grid.Column="1"
                                        Classes="detailDelete"
                                        Content="{DynamicResource Ui.Auto.AAAAB2436F31B66E}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="DeleteSelectedBookButton_Click" />
                            </Grid>

                            <!-- Compatibility fields used by the current
                                 Avalonia handlers but hidden because the old
                                 detail pane does not show these sections. -->
                            <StackPanel IsVisible="False">
                                <TextBlock x:Name="DetailStateText" />
                                <TextBlock x:Name="DetailOrganizationText" />
                                <TextBlock x:Name="DetailPublicationText" />
                                <TextBlock x:Name="DetailIdentifierText" />
                                <TextBlock x:Name="DetailDescriptionText" />
                                <ItemsControl x:Name="DetailFiles" />
                                <ComboBox x:Name="DetailCollectionBox" />
                                <Button x:Name="CollectionMembershipButton" Click="CollectionMembershipButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>
            </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock x:Name="TaskStatusText"
                               Text="{DynamicResource Ui.Auto.1BD1893C09003D8A}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedInkBrush}"
                               VerticalAlignment="Center"
                               IsVisible="False" />
                    <ProgressBar x:Name="LibraryBusyProgress" Grid.Column="1" Width="120" Height="5" IsIndeterminate="True" IsVisible="False" />
                </Grid>
            </Grid>

            <!-- Stage 3: Kindle book library. The page stays deliberately
                 simple and monochrome; all device work is performed by the
                 platform service behind the portable UI. -->
            <Grid x:Name="DevicePage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,Auto,*,Auto">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel x:Name="DeviceHeader" Spacing="3" Margin="6,14,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="{DynamicResource Ui.Auto.EC63017A628AB5D9}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <Button x:Name="DeviceNameButton"
                                Classes="quiet"
                                Padding="6,3"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.13E641A3EA2095DF}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.C2191B865B0112F8}"
                                Click="DeviceNameButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="DevicePageDeviceText" Text="{DynamicResource Ui.Auto.9514487168A00698}" Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center" />
                                <Path Data="M 1,2 L 5,6 L 9,2" Width="10" Height="8" Stroke="{DynamicResource MutedInkBrush}" StrokeThickness="1.25" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="DevicePageStatusText" Text="{DynamicResource Ui.Auto.92424890EA6A8543}" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="DeviceToolbar" Grid.Row="1" Margin="6,22,6,18"
                      ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="24"
                      SizeChanged="DeviceToolbar_SizeChanged" LayoutUpdated="DeviceToolbar_LayoutUpdated">
                    <TextBox x:Name="DeviceBookSearchBox"
                             Width="420" HorizontalAlignment="Left"
                             Height="38"
                             Padding="13,7"
                             PlaceholderText="{DynamicResource Ui.Auto.168A769EBA62A8E8}"
                             TextChanged="DeviceBookSearchBox_TextChanged" />
                    <StackPanel x:Name="DeviceToolbarActions" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center" SizeChanged="DeviceToolbar_SizeChanged">
                        <Button x:Name="DeviceBookFilterButton" Classes="quiet libraryToolbar" ToolTip.Tip="{DynamicResource Ui.Auto.0289E5BA6BFEA5E2}" Click="DeviceBookFilterButton_Click" AutomationProperties.Name="{DynamicResource Ui.Auto.B5F15473FDC0FEFE}">
                            <Path Classes="libraryGlyph" Data="M 5,5.4 H 19 L 14.2,11 V 17.6 L 9.8,19.8 V 11 Z" />
                        </Button>
                        <Border Classes="librarySort" Width="38" Height="38" VerticalAlignment="Center" PointerPressed="LibrarySort_PointerPressed">
                            <ComboBox x:Name="DeviceBookSortBox" Classes="filterCombo librarySort" MinWidth="0" Width="38" Height="38"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                      FontSize="13" BorderThickness="0" Padding="0" SelectedIndex="0"
                                      SelectionBoxItemTemplate="{StaticResource LibrarySortActionContent}"
                                      AutomationProperties.Name="{DynamicResource Ui.Auto.A96C9A854190874D}"
                                      ToolTip.Tip="{DynamicResource Ui.Auto.A96C9A854190874D}" SelectionChanged="DeviceBookFilter_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Ui.Auto.C3405F8C7D9D392A}" Tag="title" />
                                <ComboBoxItem Content="{DynamicResource Ui.Auto.7D4146CA082798F0}" Tag="author" />
                                <ComboBoxItem Content="{DynamicResource Ui.Auto.AD3BF1EEA84B70E4}" Tag="modified" />
                                <ComboBoxItem Content="{DynamicResource Ui.Auto.B9BF6916437A77EB}" Tag="size" />
                            </ComboBox>
                        </Border>
                        <Button x:Name="DeviceViewToggleButton" Classes="quiet libraryToolbar" ToolTip.Tip="{DynamicResource Ui.Auto.EE20B1318E9AFE1B}" AutomationProperties.Name="{DynamicResource Ui.Auto.EE20B1318E9AFE1B}" Click="DeviceViewToggleButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Classes="shelfViewMenu" Placement="BottomEdgeAlignedRight">
                                    <MenuItem x:Name="DeviceGridViewMenuItem" Header="{DynamicResource Ui.Auto.A35441DB5CD16882}" Tag="Grid" ToggleType="Radio" Click="DeviceViewMenuItem_Click" />
                                    <MenuItem x:Name="DeviceListViewMenuItem" Header="{DynamicResource Ui.Auto.D56220435194BC1E}" Tag="List" ToggleType="Radio" Click="DeviceViewMenuItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Path x:Name="DeviceViewToggleIcon" Classes="libraryGlyph" />
                        </Button>
                        <Button x:Name="RefreshDeviceBooksButton" Classes="quiet libraryToolbar" ToolTip.Tip="{DynamicResource Ui.Auto.4470BFD2C729D4A2}" AutomationProperties.Name="{DynamicResource Ui.Auto.4470BFD2C729D4A2}" Click="RefreshDevicesButton_Click">
                            <Path Classes="libraryGlyph" Data="M 20,8 A 9,9 0 1,0 20,16 M 20,8 V 3 M 20,8 H 15" />
                        </Button>
                        <Button x:Name="EjectDeviceButton" Classes="quiet libraryToolbar" ToolTip.Tip="{DynamicResource Ui.Auto.F78C515D501BF2E0}" AutomationProperties.Name="{DynamicResource Ui.Auto.F78C515D501BF2E0}" Click="EjectDeviceButton_Click" IsEnabled="False">
                            <Path Classes="libraryGlyph" Data="M 6,15 L 12,9 L 18,15 M 6,20 H 18" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="DeviceBookFilterPanel" Classes="flatSubsection" Grid.Row="2" Margin="0,0,0,12" Padding="10" IsVisible="False">
                    <WrapPanel Orientation="Horizontal">
                        <ComboBox x:Name="DeviceBookFormatFilterBox" Classes="filterCombo" Width="145" Margin="0,0,8,6" PlaceholderText="{DynamicResource Ui.Auto.CCCB7189507A26E7}" SelectionChanged="DeviceBookFilter_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.CCCB7189507A26E7}" Tag="" />
                            <ComboBoxItem Content="EPUB" Tag="epub" />
                            <ComboBoxItem Content="PDF" Tag="pdf" />
                            <ComboBoxItem Content="MOBI" Tag="mobi" />
                            <ComboBoxItem Content="AZW3" Tag="azw3" />
                            <ComboBoxItem Content="AZW" Tag="azw" />
                            <ComboBoxItem Content="KFX" Tag="kfx" />
                        </ComboBox>
                        <ComboBox x:Name="DeviceBookPresenceFilterBox" Classes="filterCombo" Width="190" Margin="0,0,8,6" PlaceholderText="{DynamicResource Ui.Auto.A744BEE37217BB09}" SelectionChanged="DeviceBookFilter_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.A744BEE37217BB09}" Tag="" />
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.F740B51A0AB65B6D}" Tag="kindle" />
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.50890E7E9E083DF7}" Tag="both" />
                        </ComboBox>
                        <Button Classes="quiet" Margin="0,0,0,6" Content="{DynamicResource Ui.Auto.657D9CBF45EC9E6A}" Click="ClearDeviceBookFiltersButton_Click" />
                    </WrapPanel>
                </Border>
                <ScrollViewer x:Name="DeviceBookGridScroll"
                              Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PointerPressed="DeviceBookGrid_PointerPressed"
                              PointerMoved="DeviceBookGrid_PointerMoved"
                              PointerReleased="DeviceBookGrid_PointerReleased"
                              PointerCaptureLost="DeviceBookGrid_PointerCaptureLost">
                    <ItemsControl x:Name="DeviceBookGridItems" ItemsSource="{Binding VisibleDeviceBooks}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="166" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:KindleBookCardViewModel">
                                <Grid Width="154"
                                      Height="{Binding CardHeight}"
                                      Margin="6"
                                      RowDefinitions="214,Auto"
                                      PointerPressed="DeviceBook_PointerPressed"
                                      PointerEntered="DeviceBook_PointerEntered"
                                      PointerExited="DeviceBook_PointerExited"
                                      DoubleTapped="DeviceBook_DoubleTapped"
                                      ContextRequested="DeviceBook_ContextRequested">
                                    <Border Grid.Row="0" Classes="bookCover" Background="{DynamicResource PressedBrush}" BorderThickness="1">
                                        <ToolTip.Tip>
                                            <ToolTip>
                                                <StackPanel MaxWidth="360" Spacing="4">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Authors}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding RelativePath}" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ToolTip>
                                        </ToolTip.Tip>
                                        <Grid Background="Transparent">
                                            <TextBlock Text="BOOK" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedInkBrush}" FontSize="17" IsHitTestVisible="False" />
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                        </Grid>
                                         </Border>
                                          <Grid Grid.Row="1" Margin="2,8,2,0" ColumnDefinitions="*,30" RowDefinitions="40,16,14" IsVisible="{Binding GalleryTextVisibility}">
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="15" LineHeight="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                        <TextBlock Grid.Row="1" Text="{Binding Authors}" FontSize="11" LineHeight="14" Foreground="{DynamicResource MutedInkBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Authors}" />
                                        <TextBlock Grid.Row="2" Text="{Binding FormatLabel}" FontSize="10" LineHeight="12" Foreground="{DynamicResource SubtleInkBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FormatLabel}" />
                                    </Grid>
                                    <ContentControl Grid.RowSpan="2"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,5,5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Content="{Binding}"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ContentTemplate="{StaticResource LibraryPresenceGlyph}"
                                                    ToolTip.Tip="{Binding PresenceLabel}"
                                                    AutomationProperties.Name="{Binding PresenceLabel}"
                                                    IsVisible="{Binding PresenceVisibility}" />
                                    <Border Grid.RowSpan="2"
                                            Classes="bookOutline"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            IsHitTestVisible="False" />
                                    <Border Grid.RowSpan="2"
                                            BorderBrush="{DynamicResource InkBrush}"
                                            BorderThickness="1.5"
                                            IsVisible="{Binding IsMultiSelected}"
                                            IsHitTestVisible="False">
                                        <Border Width="22" Height="22" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource InkBrush}">
                                            <TextBlock Text="✓" Foreground="{DynamicResource PaperBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Canvas Grid.Row="3" IsHitTestVisible="False" ZIndex="25">
                    <Border x:Name="DeviceRubberBandRectangle"
                            Background="#33000000"
                            BorderBrush="{DynamicResource InkBrush}"
                            BorderThickness="1"
                            IsVisible="False" />
                </Canvas>
                <ScrollViewer x:Name="DeviceBookListScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                    <ItemsControl ItemsSource="{Binding VisibleDeviceBooks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:KindleBookCardViewModel">
                                <Border BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,9"
                                        PointerPressed="DeviceBook_PointerPressed"
                                        PointerEntered="DeviceBook_PointerEntered"
                                        PointerExited="DeviceBook_PointerExited"
                                        DoubleTapped="DeviceBook_DoubleTapped"
                                        ContextRequested="DeviceBook_ContextRequested">
                                    <Grid ColumnDefinitions="54,2*,*,180" ColumnSpacing="10" MinHeight="72">
                                        <Grid Width="42" Height="56" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource PressedBrush}" BorderBrush="{DynamicResource InkBrush}" BorderThickness="1">
                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border Width="18"
                                                    Height="18"
                                                    Margin="0,0,0,2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Background="{DynamicResource PaperBrush}"
                                                    BorderBrush="{DynamicResource InkBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding PresenceVisibility}"
                                                    ToolTip.Tip="{Binding PresenceLabel}"
                                                    AutomationProperties.Name="{Binding PresenceLabel}">
                                                <ContentControl Content="{Binding}"
                                                                Padding="0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                ContentTemplate="{StaticResource LibraryPresenceGlyph}"
                                                                RenderTransformOrigin="0.5,0.5">
                                                    <ContentControl.RenderTransform>
                                                        <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                                                    </ContentControl.RenderTransform>
                                                </ContentControl>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding GalleryTextVisibility}">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Title}" />
                                            <TextBlock Text="{Binding Authors}" Foreground="{DynamicResource MutedInkBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Authors}" />
                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding InfoLabel}" Foreground="{DynamicResource MutedInkBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InfoLabel}" />
                                            <TextBlock Text="{Binding ModifiedLabel}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModifiedLabel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding RelativePath}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip.Tip="{Binding RelativePath}" />
                                            <TextBlock Text="{Binding HashLabel}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip.Tip="{Binding HashLabel}" />
                                        </StackPanel>
                                        <Border Grid.ColumnSpan="4" BorderBrush="{DynamicResource InkBrush}" BorderThickness="1" IsVisible="{Binding IsFrameVisible}" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border x:Name="DeviceBookSelectionBar"
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        Padding="14,8"
                        Background="{DynamicResource PaperBrush}"
                        BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="1"
                        BoxShadow="0 6 16 0 #22000000"
                        IsVisible="False"
                        ZIndex="20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="DeviceBookSelectionText" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Content="{DynamicResource Ui.Auto.CFE6A637EB2B50A8}" Padding="11,6" Click="ExportSelectedDeviceBooksButton_Click" />
                        <Button Content="{DynamicResource Ui.Auto.435BF8A234FDE6F2}" Padding="11,6" Click="DeleteSelectedDeviceBooksButton_Click" />
                        <Button Content="{DynamicResource Ui.Auto.74966E20DF2EA9FD}" Padding="11,6" Click="ClearDeviceBookSelectionButton_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="DeviceBookEmptyState" Grid.Row="3" Background="{DynamicResource PaperBrush}" IsVisible="True" ZIndex="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
                        <Path Width="46" Height="46" Stretch="Uniform" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              Data="M 3.5,6.5 C 6.5,5.4 9.9,5.9 12,7.8 C 14.1,5.9 17.5,5.4 20.5,6.5 V 18.2 C 17.5,17.1 14.1,17.6 12,19.4 C 9.9,17.6 6.5,17.1 3.5,18.2 Z M 12,7.8 V 19.4" />
                        <TextBlock x:Name="DeviceBookEmptyText" Text="{DynamicResource Ui.Auto.C08FBC67C501FB6A}" Foreground="{DynamicResource MutedInkBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Stage 3: fonts and dictionaries on the connected Kindle. -->
            <Grid x:Name="DeviceResourcePage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*"
                  DragDrop.AllowDrop="True">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <StackPanel Spacing="3" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock x:Name="DeviceResourcePageTitle" Text="{DynamicResource Ui.Auto.F15EE48ED5493552}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Name="DeviceResourceDeviceText" Text="{DynamicResource Ui.Auto.9514487168A00698}" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="·" Foreground="{DynamicResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="{DynamicResource Ui.Auto.05F75734785394FA}" Foreground="{DynamicResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="·" Foreground="{DynamicResource MutedInkBrush}" FontSize="12" />
                            <TextBlock x:Name="DeviceResourcePathText" Foreground="{DynamicResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="·" Foreground="{DynamicResource MutedInkBrush}" FontSize="12" />
                            <TextBlock x:Name="DeviceResourceCountText" Text="{DynamicResource Ui.Auto.0399514D6A1113C3}" Foreground="{DynamicResource MutedInkBrush}" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="DeviceResourceStatusText" Text="{DynamicResource Ui.Auto.DD4E63F4F9C0F4B5}" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*">
                        <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="4">
                            <Button x:Name="ImportDeviceResourceButton"
                                    Content="{DynamicResource Ui.Auto.F1675F4522D5A149}"
                                    ContentTemplate="{StaticResource LibraryImportActionContent}"
                                    Classes="quiet libraryToolbar"
                                    Click="ImportDeviceResourceButton_Click" />
                            <Button x:Name="ExportDeviceResourceButton"
                                    Content="{DynamicResource Ui.Auto.DAB0F7CAA4DEA42D}"
                                    ContentTemplate="{StaticResource LibraryExportActionContent}"
                                    Classes="quiet libraryToolbar"
                                    IsEnabled="False"
                                    Click="ExportDeviceResourceButton_Click" />
                            <Button x:Name="DeleteDeviceResourceButton"
                                    Content="{DynamicResource Ui.Auto.435BF8A234FDE6F2}"
                                    ContentTemplate="{StaticResource LibraryDeleteActionContent}"
                                    Classes="quiet libraryToolbar"
                                    IsEnabled="False"
                                    Click="DeleteDeviceResourceButton_Click" />
                            <Button x:Name="RefreshDeviceResourcesButton" Content="{DynamicResource Ui.Auto.AEE88743413144A2}"
                                    ContentTemplate="{StaticResource LibraryRefreshActionContent}"
                                    Classes="quiet libraryToolbar"
                                    Click="RefreshDeviceResourcesButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <ListBox x:Name="DeviceResourceList"
                             ItemsSource="{Binding DeviceResources}"
                             SelectionMode="Single"
                             SelectionChanged="DeviceResourceList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <!-- Selected Kindle resources stay paper-white and
                                 use a hollow ink rectangle instead of
                                 Fluent's accent selection fill. -->
                            <Style Selector="ListBoxItem:selected,
                                             ListBoxItem:selected:pointerover,
                                             ListBoxItem:selected:focus">
                                <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected Border.flatRow,
                                             ListBoxItem:selected:pointerover Border.flatRow,
                                             ListBoxItem:selected:focus Border.flatRow">
                                <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:KindleDeviceResource">
                    <Border Classes="flatRow" Padding="10,8">
                                    <Grid ColumnDefinitions="2*,90,110" ColumnSpacing="16">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Format}" Foreground="{DynamicResource MutedInkBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{DynamicResource MutedInkBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="DeviceResourceEmptyText"
                               Text="{DynamicResource Ui.Auto.4304C61806C743C1}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedInkBrush}" />
                </Grid>
            </Grid>

            <!-- Stage 3: local and Kindle reading materials. -->
            <Grid x:Name="ReadingMaterialsPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,Auto,Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock x:Name="ReadingMaterialsPageTitle" Text="{DynamicResource Ui.Auto.9CD1F9CD7B9AC663}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock x:Name="ReadingMaterialsStatusText" Text="{DynamicResource Ui.Auto.5F83A944D270ED82}" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ReadingMaterialsNotesActions" Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                        <Button x:Name="ExportReadingMaterialsToggleButton"
                                Content="{DynamicResource Ui.Auto.B4FBE589C50EE54E}"
                                Classes="quiet libraryToolbar readingExportToggle"
                                Click="ExportReadingMaterialsToggleButton_Click" />
                        <Button x:Name="SelectAllReadingMaterialsButton"
                                Content="{DynamicResource Ui.Auto.3A5040B68ABF75F9}"
                                ContentTemplate="{StaticResource LibrarySelectAllActionContent}"
                                Classes="quiet libraryToolbar"
                                IsVisible="False"
                                Click="SelectAllReadingMaterialsButton_Click" />
                        <Button x:Name="ReadingMaterialsLocateButton" Content="{DynamicResource Ui.Auto.6F789DCD99E5FE34}" ContentTemplate="{StaticResource LibraryLocateActionContent}" Classes="quiet libraryToolbar" IsEnabled="False" Click="ReadingMaterialsLocateButton_Click" />
                        <Button x:Name="DeleteReadingMaterialsButton" Content="{DynamicResource Ui.Auto.435BF8A234FDE6F2}" ContentTemplate="{StaticResource LibraryDeleteActionContent}" Classes="quiet libraryToolbar" IsEnabled="False" Click="DeleteReadingMaterialsButton_Click" />
                        <Button x:Name="RefreshReadingMaterialsButton" Content="{DynamicResource Ui.Auto.AEE88743413144A2}" ContentTemplate="{StaticResource LibraryRefreshActionContent}" Classes="quiet libraryToolbar" Click="RefreshReadingMaterialsButton_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="6,14,6,14" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                        <StackPanel Spacing="11">
                            <TextBlock Text="{DynamicResource Ui.Auto.A488E93D69CC1296}" FontSize="12" />
                            <ComboBox x:Name="ReadingMaterialsSourceBox" SelectedIndex="0" SelectionChanged="ReadingMaterialsSourceBox_SelectionChanged">
                                <ComboBoxItem Content="Any source" Tag="all" />
                                <ComboBoxItem Content="Local library" Tag="local" />
                                <ComboBoxItem Content="{DynamicResource Ui.Device.Current}" Tag="device" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="11">
                            <TextBlock Text="{DynamicResource Ui.Auto.44CE7AE909BBB28B}" FontSize="12" />
                            <TextBox x:Name="ReadingMaterialsSearchBox" PlaceholderText="{DynamicResource Ui.Auto.D62E57A56D744F50}" TextChanged="ReadingMaterialsSearchBox_TextChanged" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border x:Name="ReadingMaterialsSummaryBorder"
                        Classes="flatPanel"
                        Grid.Row="2"
                        Margin="6,0,6,0"
                        Padding="16,12"
                        Background="{DynamicResource PaperBrush}">
                    <TextBlock x:Name="ReadingMaterialsSummaryText" Text="{DynamicResource Ui.Auto.023CAEED6A29333F}" FontSize="16" FontWeight="Bold" />
                </Border>
                <Border x:Name="ReadingMaterialsExportSummaryBorder"
                        Classes="flatPanel"
                        Grid.Row="3"
                        Margin="6,18,6,0"
                        Padding="16,12"
                        Background="{DynamicResource PaperBrush}"
                        IsVisible="False">
                    <TextBlock x:Name="ReadingMaterialsExportSummaryText" Text="{DynamicResource Ui.Auto.6525A0357C7682BE}" FontSize="16" FontWeight="Bold" />
                </Border>
                <Grid Grid.Row="4" Margin="6,0,6,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReadingMaterialGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:Stage3ReadingMaterialGroupViewModel">
                                    <Border Classes="flatRow" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,58,*,Auto" ColumnSpacing="12" Margin="12">
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsVisible="{Binding IsExportMode}"
                                                          AutomationProperties.Name="{Binding BookTitle}"
                                                          VerticalAlignment="Center"
                                                          Click="ReadingMaterialSelectionChanged" />
                                                <Border Grid.Column="1" Width="48" Height="64" Background="{DynamicResource CoverBrush}" BorderBrush="{DynamicResource InkBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="BOOK" FontSize="8" Foreground="{DynamicResource MutedInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoCover}" />
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BookTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                                        <TextBlock Text="{Binding CountLabel}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="3"
                                                        Tag="{Binding}"
                                                        AutomationProperties.Name="{Binding ExpandLabel}"
                                                        ToolTip.Tip="{Binding ExpandLabel}"
                                                        Classes="quiet libraryToolbar"
                                                        VerticalAlignment="Center"
                                                        Click="ReadingMaterialGroupToggleButton_Click">
                                                    <Grid Width="18" Height="18">
                                                        <Path Classes="libraryGlyph" Data="M 5,8 L 12,15 L 19,8" IsVisible="{Binding IsCollapsed}" />
                                                        <Path Classes="libraryGlyph" Data="M 5,15 L 12,8 L 19,15" IsVisible="{Binding IsExpanded}" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:Stage3ReadingMaterialViewModel">
                                                        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="12,10" DoubleTapped="ReadingMaterialEntry_DoubleTapped">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                                          VerticalAlignment="Top"
                                                                          Click="ReadingMaterialSelectionChanged" />
                                                                <StackPanel Grid.Column="1" Spacing="5">
                                                                    <TextBlock Text="{Binding SourceLabel}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource MutedInkBrush}" />
                                                                    <TextBlock Text="{Binding ChapterDisplayLabel}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding SelectedContentLabel}"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding NoteLabel}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource MutedInkBrush}"
                                                                               IsVisible="{Binding HasNote}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border x:Name="ReadingMaterialsExportPanel"
                            Padding="4"
                            Background="{DynamicResource PaperBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,12,12"
                            IsVisible="False"
                            ZIndex="10">
                        <Grid ColumnDefinitions="Auto,38,38"
                              ColumnSpacing="4"
                              VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Ui.Notes.ExportLabel}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="4,0,4,0"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ExportReadingMaterialsMarkdownButton"
                                    Grid.Column="1"
                                    Width="38"
                                    Height="38"
                                    MinWidth="38"
                                    Content="{DynamicResource Ui.Auto.AC8B027CC1E3A493}"
                                    ContentTemplate="{StaticResource LibraryExportMarkdownActionContent}"
                                    Classes="quiet libraryToolbar"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="ExportReadingMaterialsMarkdownButton_Click" />
                            <Button x:Name="ExportReadingMaterialsTextButton"
                                    Grid.Column="2"
                                    Width="38"
                                    Height="38"
                                    MinWidth="38"
                                    Content="{DynamicResource Ui.Auto.8E1B126E634DCA98}"
                                    ContentTemplate="{StaticResource LibraryExportTextActionContent}"
                                    Classes="quiet libraryToolbar"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="ExportReadingMaterialsTextButton_Click" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ReadingMaterialsEmptyText" Text="{DynamicResource Ui.Auto.E2D121364FBE830A}" Foreground="{DynamicResource MutedInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Reading dashboard keeps the WinUI statistics surface separate
                 from editable application settings. -->
            <Grid x:Name="ReadingDashboardPage"
                  Grid.Column="1"
                  Margin="30,48,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{DynamicResource Ui.Auto.440C143379A34160}" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource Ui.Device.ReadingDataScope}" FontSize="11"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                        <TextBlock x:Name="DashboardStatusText"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button x:Name="RefreshReadingDashboardButton" Content="{DynamicResource Ui.Auto.BC87A4121A0873B3}" ContentTemplate="{StaticResource LibraryRefreshActionContent}" Classes="quiet libraryToolbar" Click="RefreshReadingDashboardButton_Click" />
                        <Button x:Name="ExportReadingDashboardButton" Content="{DynamicResource Ui.Auto.E40A628FFEC72072}" ContentTemplate="{StaticResource LibraryExportActionContent}" Classes="quiet libraryToolbar" Click="ExportReadingDashboardButton_Click" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ReadingDashboardScrollViewer" Classes="dashboardScroll"
                              Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                            <Border Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Ui.Auto.3CCEA88494F876E9}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardTotalTimeText" Text="0" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashboardDailyAverageText" Text="{DynamicResource Ui.Auto.E1FD8BC385380027}" FontSize="10" Foreground="{DynamicResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Ui.Auto.A4D3E9ED3C64AE28}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardStreakText" Text="{DynamicResource Ui.Auto.2E878CA6410E7711}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Ui.Auto.FBD5755F75159075}" FontSize="10" Foreground="{DynamicResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Ui.Auto.39198D42F3794824}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBooksStartedText" Text="{DynamicResource Ui.Auto.106392390AAB29EF}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashboardAverageProgressText" Text="{DynamicResource Ui.Auto.4CDF93F7A6D263FC}" FontSize="10" Foreground="{DynamicResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Ui.Auto.8F8C2CA5EC429922}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBooksFinishedText" Text="{DynamicResource Ui.Auto.106392390AAB29EF}" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Ui.Auto.7B77D050A183CB98}" FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBookmarksText" Text="0 / 0" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <Border Classes="flatPanel" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{DynamicResource Ui.Auto.7644551F37492A5D}" FontSize="14" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding DashboardDays}" AutomationProperties.Name="{DynamicResource Ui.Auto.83A25C492C9A33C4}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardDayViewModel">
                                                <Grid Width="30" Height="170" RowDefinitions="*,Auto,Auto" Margin="0,0,4,0">
                                                    <Border VerticalAlignment="Bottom"
                                                            Height="{Binding BarHeight}"
                                                            CornerRadius="2"
                                                            Opacity="{Binding BarOpacity}"
                                                            Background="{DynamicResource InkBrush}"
                                                            ToolTip.Tip="{Binding TimeLabel}" />
                                                    <TextBlock Grid.Row="1" Text="{Binding TimeLabel}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <TextBlock Grid.Row="2" Text="{Binding DateLabel}" FontSize="9" Foreground="{DynamicResource MutedInkBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="flatPanel" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Ui.Auto.57A00AA8DDA6EA8E}" FontSize="14" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding DashboardBookTimes}" AutomationProperties.Name="{DynamicResource Ui.Auto.FB37D1646C81A5BA}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardBarViewModel">
                                                <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8" Margin="0,4" ToolTip.Tip="{Binding ValueLabel}">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Label}" />
                                                    <Border Grid.Column="1" Width="{Binding BarWidth}" Height="10" CornerRadius="2" Background="{DynamicResource InkBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="10" Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Classes="flatPanel" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Ui.Auto.C89EA308CEDC2ECC}" FontSize="14" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding DashboardProgressBuckets}" AutomationProperties.Name="{DynamicResource Ui.Auto.A0994B78FD83CF3A}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardBarViewModel">
                                                <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8" Margin="0,4" ToolTip.Tip="{Binding ValueLabel}">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Width="{Binding BarWidth}" Height="10" CornerRadius="2" Background="{DynamicResource InkBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="10" Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Classes="flatPanel" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Ui.Auto.E06FCFAF83B0B55C}" FontSize="14" FontWeight="SemiBold" />
                                    <ScrollViewer x:Name="DashboardRecentScrollViewer" Classes="dashboardScroll"
                                                  MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto"
                                                  AutomationProperties.Name="{DynamicResource Ui.Auto.914F86CA5C6739D9}">
                                        <ItemsControl ItemsSource="{Binding DashboardRecentItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:Stage3DashboardRecentViewModel">
                                                    <Border Padding="0,8"
                                                            BorderBrush="{DynamicResource HairlineBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                                                <TextBlock Text="{Binding UpdatedLabel}" FontSize="10" Foreground="{DynamicResource MutedInkBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DurationLabel}" FontSize="10" Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ProgressLabel}" FontSize="12" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="DashboardRecentEmptyText"
                                               Text="{DynamicResource Ui.Auto.DF7356640E9FC306}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedInkBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="False" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- One settings destination; inactive categories and collapsed forms leave the focus tree. -->
            <Grid x:Name="SettingsPage" Classes="settingsPage" Grid.Column="1" Margin="30,24,30,18" IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,*,Auto" MaxWidth="820" HorizontalAlignment="Left" Width="{Binding Bounds.Width, ElementName=SettingsPage}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Ui.Auto.DF3D58C7D84B85F2}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SettingsStatusText" Text="{DynamicResource Ui.Auto.709BDE6F962E3F2A}" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel x:Name="SettingsCategoryButtons" Grid.Row="1" Margin="0,20,0,16" Orientation="Horizontal">
                        <Button x:Name="SettingsLibraryButton" Content="{DynamicResource Ui.Auto.979ACDE39C51149E}" Classes="settingsCategory" Tag="Library" Click="SettingsCategoryButton_Click" />
                        <Button x:Name="SettingsReadingButton" Content="{DynamicResource Ui.Auto.959378340D4DE6CD}" Classes="settingsCategory" Tag="Reading" Click="SettingsCategoryButton_Click" />
                        <Button x:Name="SettingsKindleButton" Content="{DynamicResource Ui.Auto.795007E173C70289}" Classes="settingsCategory" Tag="Kindle" Click="SettingsCategoryButton_Click" />
                        <Button x:Name="SettingsDataButton" Content="{DynamicResource Ui.Auto.1173D06BC2EA23F0}" Classes="settingsCategory" Tag="Data" Click="SettingsCategoryButton_Click" />
                        <Button x:Name="SettingsAboutButton" Content="{DynamicResource Ui.Auto.0A114F362A5F259E}" Classes="settingsCategory" Tag="About" Click="SettingsCategoryButton_Click" />
                    </WrapPanel>
                    <ScrollViewer x:Name="SettingsScrollViewer" Classes="settingsScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,12,20">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8" x:Name="SettingsLibrarySection" IsVisible="False">
                                <TextBlock Text="{DynamicResource Ui.Auto.835B700E028C9B20}" Classes="settingsSectionTitle" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{DynamicResource Ui.Auto.3D13868593AE4EEB}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox x:Name="UiLanguageBox" Grid.Column="1" Width="180" SelectedIndex="0" SelectionChanged="UiLanguageBox_SelectionChanged" AutomationProperties.Name="{DynamicResource Ui.Auto.3D13868593AE4EEB}" FontSize="14">
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.9937E365AAF3A085}" Tag="zh-CN" />
                                        <ComboBoxItem Content="English" Tag="en-US" />
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,4">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ui.Appearance.MainTheme}" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Ui.Appearance.MainThemeHint}" FontSize="11"
                                                   Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="MainThemeBox" Grid.Column="1" Width="180" SelectedIndex="0"
                                              VerticalAlignment="Center" FontSize="14"
                                              SelectionChanged="MainThemeBox_SelectionChanged"
                                              AutomationProperties.Name="{DynamicResource Ui.Appearance.MainTheme}">
                                        <ComboBoxItem Content="{DynamicResource Ui.Appearance.Classic}" Tag="Classic" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Appearance.Night}" Tag="Night" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Appearance.Green}" Tag="Green" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Appearance.WarmBrown}" Tag="WarmBrown" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Appearance.Ivory}" Tag="Ivory" />
                                    </ComboBox>
                                </Grid>
                                <ToggleSwitch x:Name="NetworkEnabledCheck" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.D7842A57D154C697}" Classes="settingsToggle" Content="{DynamicResource Ui.Auto.098925F827B88E7A}" AutomationProperties.Name="{DynamicResource Ui.Auto.098925F827B88E7A}" />
                                <TextBlock Text="{DynamicResource Ui.Auto.A183CEACD829707F}" Classes="settingsSectionTitle" TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="GridGalleryDisplayCheck" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.694BA13A98D0252A}" Classes="settingsToggle" Content="{DynamicResource Ui.Auto.DA96E037499D9296}" AutomationProperties.Name="{DynamicResource Ui.Auto.DA96E037499D9296}" />
                                <ToggleSwitch x:Name="ShowSyncStatusIconCheck" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Library.ShowSyncStatusIconHelp}" Classes="settingsToggle" Content="{DynamicResource Ui.Library.ShowSyncStatusIcon}" AutomationProperties.Name="{DynamicResource Ui.Library.ShowSyncStatusIcon}" />
                                <ToggleSwitch x:Name="ShowLibraryPresenceIconCheck" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Library.ShowPresenceIconHelp}" Classes="settingsToggle" Content="{DynamicResource Ui.Library.ShowPresenceIcon}" AutomationProperties.Name="{DynamicResource Ui.Library.ShowPresenceIcon}" />
                                <ToggleSwitch x:Name="CollectionsMutuallyExclusiveCheck" VerticalAlignment="Center" Classes="settingsToggle" Content="{DynamicResource Ui.Auto.F6A273284E344858}" AutomationProperties.Name="{DynamicResource Ui.Auto.F6A273284E344858}" />
                                <ToggleSwitch x:Name="AutoDoubanMatchCheck" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.4799DAF25FD6C6CC}" Classes="settingsToggle" Content="{DynamicResource Ui.Auto.07F4A49C6D9FCA72}" AutomationProperties.Name="{DynamicResource Ui.Auto.07F4A49C6D9FCA72}" />
                                <ToggleSwitch x:Name="AutoGenerateReaderFormatsCheck" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.8B0CC19DB0791E72}" Classes="settingsToggle" Content="{DynamicResource Ui.Auto.55A2226420BCBF78}" AutomationProperties.Name="{DynamicResource Ui.Auto.55A2226420BCBF78}" />
                                <Expander x:Name="SettingsCalibreExpander" Classes="settingsExpander" Header="{DynamicResource Ui.Auto.39F073ED740B19B8}" Tag="{DynamicResource Ui.Auto.76B87E0C608BEE4A}" AutomationProperties.Name="{DynamicResource Ui.Auto.39F073ED740B19B8}" Expanded="SettingsExpander_Expanded" Collapsed="SettingsExpander_Collapsed">
                                    <Border x:Name="SettingsCalibreSection" Padding="0">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="{DynamicResource Ui.Auto.68DBD3556A19C150}" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{DynamicResource Ui.Auto.6160F42DABA0438E}" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <Ellipse x:Name="CalibreDetectionStatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="#D6A100" ToolTip.Tip="{DynamicResource Ui.Auto.FE66F3C4D3165B5D}" AutomationProperties.Name="{DynamicResource Ui.Auto.FE66F3C4D3165B5D}" />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBox x:Name="CalibrePathBox" PlaceholderText="{DynamicResource Ui.Auto.A5D0920936DC7153}" AutomationProperties.Name="{DynamicResource Ui.Auto.68DBD3556A19C150}" FontSize="14" />
                                                    <Button Grid.Column="1" Content="{DynamicResource Ui.Auto.A8C81F93F2E0E3B6}" Classes="quiet" Click="BrowseCalibreButton_Click" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                    <Button x:Name="InstallCalibreButton" Content="{DynamicResource Ui.Auto.53E06E722B8528B0}" Classes="quiet" Click="InstallCalibreButton_Click" />
                                                    <Button x:Name="InstallKfxInputButton" Content="{DynamicResource Ui.Auto.E1D76CA786897DA7}" Classes="quiet" Click="InstallKfxInputButton_Click" />
                                                </StackPanel>
                                                <ProgressBar x:Name="CalibreSetupProgressBar" Height="3" Minimum="0" Maximum="100" IsVisible="False" />
                                                <TextBlock x:Name="CalibreSetupStatusText" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
