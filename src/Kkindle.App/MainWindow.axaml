<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Kkindle"
        xmlns:core="using:Kkindle.Core"
        xmlns:infra="using:Kkindle.Infrastructure"
        xmlns:converters="using:Avalonia.Data.Converters"
        mc:Ignorable="d"
        d:DesignWidth="1294"
        d:DesignHeight="804"
        x:Class="Kkindle.MainWindow"
        x:DataType="local:MainWindow"
        Title="Kkindle"
        Width="1294"
        Height="804"
        MinWidth="1024"
        MinHeight="664"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        UseLayoutRounding="True"
        WindowDecorations="None"
        DragDrop.AllowDrop="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        KeyDown="MainWindow_KeyDown">

    <Window.Resources>
        <!-- Minimal library-presence glyph shared by the PC grid/list and the
             Kindle cards. Every state uses the same centred optical box. -->
        <DataTemplate x:Key="LibraryPresenceGlyph" x:CompileBindings="False">
            <Grid Classes="libraryPresenceGlyph" Width="20" Height="20">
                <Path Classes="libraryGlyph"
                      Data="M 4,5 H 20 V 15 H 4 Z M 2,19 H 22"
                      Stroke="{StaticResource InkBrush}"
                      IsVisible="{Binding ComputerOnlyPresenceVisibility}" />
                <Path Classes="libraryGlyph"
                      Data="M 7,3 H 17 V 21 H 7 Z M 10,17 H 14"
                      Stroke="{StaticResource InkBrush}"
                      IsVisible="{Binding KindleOnlyPresenceVisibility}" />
                <Path Classes="libraryGlyph"
                      Data="M 3,5 H 17 V 15 H 3 Z M 2,18 H 17 M 15,9 H 21 V 21 H 15 Z"
                      Stroke="{StaticResource InkBrush}"
                      IsVisible="{Binding BothLibrariesPresenceVisibility}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- The content reaches the client-area edges. Resize handles are layered
         over those edges instead of reserving a transparent outer gutter; on
         Windows that gutter can be composed as an opaque white strip. -->
    <Grid>
        <Border x:Name="WindowShadowHost"
                Margin="0"
                Background="{StaticResource PaperBrush}"
                BorderBrush="#000000"
                BorderThickness="1">
        <Grid Background="{StaticResource PaperBrush}">
        <!-- Self-drawn square title bar. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Background="Transparent"
              Height="38"
              VerticalAlignment="Top"
              ZIndex="50">
            <Grid Grid.Column="0">
                <Border x:Name="TitleBarDragRegion"
                        Background="Transparent"
                        PointerPressed="TitleBarDragRegion_PointerPressed" />
                <TextBlock x:Name="WindowBrandText"
                           Text="Kreader"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           LetterSpacing="1.08"
                           IsHitTestVisible="False"
                           IsVisible="False" />
            </Grid>

            <Border x:Name="ReaderZenActivationRegion"
                    Grid.ColumnSpan="2"
                    Width="380"
                    Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    IsVisible="False"
                    ZIndex="0"
                    PointerEntered="ReaderTitleControls_PointerEntered"
                    PointerExited="ReaderTitleControls_PointerExited" />

            <StackPanel x:Name="ReaderTitleControls"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="0"
                        ZIndex="1"
                        PointerEntered="ReaderTitleControls_PointerEntered"
                        PointerExited="ReaderTitleControls_PointerExited">
                <Button x:Name="ReaderZenTitleTocButton"
                        Classes="caption"
                        Width="92"
                        Height="38"
                        Padding="0"
                        FontSize="11"
                        AutomationProperties.Name="{DynamicResource Ui.Auto.0474752B788B123E}"
                        ToolTip.Tip="{DynamicResource Ui.Auto.4CC0023B765B0A72}"
                        IsVisible="False"
                        Click="ReaderZenMinimalTocButton_Click">
                    <TextBlock x:Name="ReaderZenTitleTocText"
                               Text="{DynamicResource Ui.Auto.73C9B3F7F3A16007}"
                               Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button x:Name="ReaderZenTitleExitButton"
                        Classes="caption"
                        Width="104"
                        Height="38"
                        Padding="0"
                        FontSize="11"
                        AutomationProperties.Name="{DynamicResource Ui.Auto.AF30F6FFB6EA23CF}"
                        ToolTip.Tip="{DynamicResource Ui.Auto.987BA0B5C2710754}"
                        IsVisible="False"
                        Click="ReaderExitZenButton_Click">
                    <TextBlock Text="{DynamicResource Ui.Auto.AF30F6FFB6EA23CF}"
                               Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button x:Name="MinimizeWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="MinimizeWindowButton_Click"
                        AutomationProperties.Name="{DynamicResource Ui.Auto.AC29E57A46F41C30}">
                    <Path Data="M 0,0 H 10" />
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="MaximizeWindowButton_Click"
                        AutomationProperties.Name="{DynamicResource Ui.Auto.82C4AA13B7CA109E}">
                    <Path x:Name="MaximizeWindowGlyph" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                </Button>
                <Button x:Name="CloseWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="CloseWindowButton_Click"
                        AutomationProperties.Name="{DynamicResource Ui.Auto.3FD47EDCE45B3603}">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                </Button>
            </StackPanel>
            <!-- Modal overlays live in the content layer below this custom
                 title bar. Mirror their visibility over the caption-button
                 column so minimize/maximize/close are dimmed and blocked too. -->
            <Border Grid.Column="1"
                    Background="#66000000"
                    ZIndex="100">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static converters:BoolConverters.Or}">
                        <Binding Path="IsVisible" ElementName="DevicePromptOverlay" />
                        <Binding Path="IsVisible" ElementName="ConfirmationOverlay" />
                        <Binding Path="IsVisible" ElementName="CollectionNameOverlay" />
                        <Binding Path="IsVisible" ElementName="DeviceModelInputOverlay" />
                        <Binding Path="IsVisible" ElementName="DoubanCandidateOverlay" />
                        <Binding Path="IsVisible" ElementName="DoubanPreviewOverlay" />
                        <Binding Path="IsVisible" ElementName="ImportFormatSelectionOverlay" />
                        <!-- MessageOverlay lives above the complete window content
                             layer, so it already covers the caption column and
                             must not be mirrored here a second time. -->
                        <!-- ReaderLayoutSettingsPopup is intentionally absent:
                             its own dim overlay is a native popup window that
                             already covers the caption column; adding it here
                             stacks a second mask and darkens the corner. -->
                    </MultiBinding>
                </Border.IsVisible>
            </Border>
        </Grid>

        <Grid x:Name="LibraryRoot"
              Classes="libraryShell"
              Grid.Row="0"
              ColumnDefinitions="200,*,0"
              Background="{StaticResource PaperBrush}"
              ZIndex="0"
              SizeChanged="LibraryRoot_SizeChanged">
            <!-- Left navigation -->
            <Border Grid.Column="0"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="18,24,18,18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="34" Height="34" Background="{StaticResource InkBrush}">
                            <TextBlock Text="K"
                                       Foreground="{StaticResource PaperBrush}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="Kkindle"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <!-- Update badge: hovering shows the release notes; after
                                     download, clicking starts the explicit exit/install flow. -->
                                <Button x:Name="UpdateBadgeButton"
                                        IsVisible="False"
                                        Click="UpdateBadgeButton_Click"
                                        Cursor="Hand"
                                        Padding="3"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Focusable="False">
                                    <Ellipse Width="8" Height="8" Fill="#E0A100" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Ui.Auto.61CD63ABFA7D1DAD}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,24,0,16"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="3">
                                <Button x:Name="BookManagementSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Ui.Auto.FB55F8EAEF4BB602}" />
                                            <Path x:Name="BookManagementChevron"
                                                  Data="M 1,2 L 5,6 L 9,2"
                                                  Width="10"
                                                  Height="8"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="BookManagementChildren" Spacing="3">
                                    <Button x:Name="AllBooksButton"
                                            Classes="sidebarItem active"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.AA12555D73B23489}"
                                            Click="ShowAllBooksButton_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <TextBlock Text="{DynamicResource Ui.Auto.FAFE70E30BE14271}" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="9"
                                                    Background="#10000000"
                                                    Padding="6,1">
                                                <TextBlock x:Name="SidebarCountText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="KindleBooksButton"
                                            Classes="sidebarItem"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.DE3DC0150A6B3949}"
                                            Click="KindleBooksButton_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <TextBlock Text="{DynamicResource Ui.Auto.471BDA92F71A1882}" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="9"
                                                    Background="#10000000"
                                                    Padding="6,1">
                                                <TextBlock x:Name="DeviceBookCountText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="ZLibraryBooksButton"
                                            Classes="sidebarItem"
                                            Content="{DynamicResource Ui.Auto.C75E6F50F3BD2F17}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.C8EA76F5CCA7AE85}"
                                            Click="ZLibraryBooksButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="DeviceManagementSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Ui.Auto.7E708DD49F0A4215}" />
                                            <Path x:Name="DeviceManagementChevron"
                                                  Data="M 2,1 L 6,5 L 2,9"
                                                  Width="10"
                                                  Height="10"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="DeviceManagementChildren" Spacing="3" IsVisible="False">
                                <Button x:Name="FontManagementButton"
                                            Classes="sidebarItem"
                                            Content="{DynamicResource Ui.Auto.A654447A8C906AB1}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.1F58A78826EAB7D0}"
                                            Click="FontManagementButton_Click" />
                                <Button x:Name="DictionaryManagementButton"
                                            Classes="sidebarItem"
                                            Content="{DynamicResource Ui.Auto.8B62411F753D8465}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.2A3E14BD213AC42D}"
                                            Click="DictionaryManagementButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="ReadingSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Ui.Auto.7EDB884BEE9690C4}" />
                                            <Path x:Name="ReadingChevron"
                                                  Data="M 1,2 L 5,6 L 9,2"
                                                  Width="10"
                                                  Height="8"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="ReadingChildren" Spacing="3" IsVisible="False">
                                    <Button x:Name="ReaderNotesNavigationButton"
                                            Classes="sidebarItem"
                                            Content="{DynamicResource Ui.Auto.8A7525B1492FB848}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.910C576626CD0BAA}"
                                            Click="ReaderNotesNavigationButton_Click" />
                                    <Button x:Name="ReaderExportNavigationButton"
                                            Classes="sidebarItem"
                                            Content="{DynamicResource Ui.Auto.B4FBE589C50EE54E}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.79C2AA25294BFC84}"
                                            Click="ReaderExportNavigationButton_Click" />
                                    <Button x:Name="ReadingDashboardButton"
                                            Classes="sidebarItem"
                                            Content="{DynamicResource Ui.Auto.440C143379A34160}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.A6F23A1728A8C25E}"
                                            Click="ReadingDashboardButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="SystemSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Ui.Auto.68EA5DD4D7AF20E6}" />
                                            <Path x:Name="SystemChevron"
                                                  Data="M 2,1 L 6,5 L 2,9"
                                                  Width="10"
                                                  Height="10"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="SystemChildren" Spacing="3" IsVisible="False">
                                    <Button x:Name="SettingsNavigationButton"
                                            Classes="sidebarItem"
                                            Content="{DynamicResource Ui.Auto.692873DDD8F40E66}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.4EDA7761B6EB0BF3}"
                                            Click="SettingsButton_Click" />
                                    <Button x:Name="KindleEmailSettingsNavigationButton"
                                            Classes="sidebarItem"
                                            Content="{DynamicResource Ui.Auto.1EF0F672AC552C01}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.D45E65951D169D87}"
                                            Click="KindleEmailSettingsButton_Click" />
                                    <Button x:Name="ZLibraryAccountNavigationButton"
                                            Classes="sidebarItem"
                                            Content="{DynamicResource Ui.Auto.DEC3634BEDD23D3D}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.937B60677348A858}"
                                            Click="ZLibraryAccountButton_Click" />
                                    <Button x:Name="ReaderAiSettingsNavigationButton"
                                            Classes="sidebarItem"
                                            Content="{DynamicResource Ui.Auto.377C481D3C31ACE2}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.59D7AD70A4016DE6}"
                                            Click="ReaderAiSettingsButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="DeviceStatusBox"
                            Grid.Row="2"
                            Padding="10"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                                <TextBlock x:Name="KindleStatusText"
                                           Classes="kindleStatusTrigger"
                                           Text="{DynamicResource Ui.Auto.92424890EA6A8543}"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Tapped="DeviceStatusBox_Tapped"
                                           ToolTip.Tip="{DynamicResource Ui.Auto.7A64BC5E494194A4}" />
                                <TextBlock x:Name="KindleConnectionText"
                                           Grid.Row="1"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="10" />
                                <Border Grid.Column="1"
                                        Grid.Row="0"
                                        Classes="ejectHoverArea"
                                        Width="25"
                                        Height="23"
                                        Background="Transparent"
                                        VerticalAlignment="Center">
                                    <Button x:Name="DeviceStatusEjectButton"
                                            Classes="eject"
                                            Width="25"
                                            MinWidth="25"
                                            Height="23"
                                            IsEnabled="False"
                                            LayoutUpdated="DeviceStatusEjectButton_LayoutUpdated"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.73238927F76F6BD2}"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.E77633A0AFCAACCE}"
                                            Click="EjectDeviceButton_Click">
                                        <Polygon x:Name="DeviceEjectTriangleGlyph"
                                                 Classes="ejectGlyph"
                                                 Points="0,8 7,0 14,8"
                                                 Width="14"
                                                 Height="8"
                                                 Stroke="{StaticResource InkBrush}"
                                                 StrokeThickness="1"
                                                 Stretch="Fill"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Button>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="DeviceStorageText"
                                       Text="{DynamicResource Ui.Auto.55DCD2D20A544E05}"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <Grid x:Name="DeviceStorageBar"
                                  Height="10"
                                  Background="{StaticResource PaperBrush}"
                                  SizeChanged="DeviceStorageBar_SizeChanged">
                                <Rectangle x:Name="DeviceStorageUsedBar" HorizontalAlignment="Left" Fill="{StaticResource InkBrush}" Width="0" />
                                <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="1" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Local library -->
            <Grid x:Name="LibraryWorkspace"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  RowDefinitions="Auto,Auto,Auto,*,Auto">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Ui.Auto.BF4AD761840FCD0A}" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{DynamicResource Ui.Auto.FAFE70E30BE14271}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="LibrarySummaryText"
                               Text="{Binding ViewModel.StatusText}"
                               FontSize="12"
                               Foreground="#666666"
                               IsVisible="False" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,18" ColumnDefinitions="420,*">
                    <TextBox x:Name="SearchBox"
                             Height="38"
                             Padding="13,7"
                             PlaceholderText="{DynamicResource Ui.Auto.168A769EBA62A8E8}"
                             Text="{Binding ViewModel.SearchText, Mode=TwoWay}"
                             TextChanged="SearchBox_TextChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                        <Button x:Name="FilterButton" Classes="icon" ToolTip.Tip="{DynamicResource Ui.Auto.0289E5BA6BFEA5E2}" Click="FilterButton_Click" AutomationProperties.Name="{DynamicResource Ui.Auto.B5F15473FDC0FEFE}">
                            <Path Classes="libraryGlyph"
                                  UseLayoutRounding="True"
                                  Data="M 5,5.4 H 19 L 14.2,11 V 17.6 L 9.8,19.8 V 11 Z" />
                        </Button>
                        <!-- One click cycles 网格 → 列表 → 收藏夹; the glyph
                             mirrors the active view and the tooltip names what
                             the next click switches to. -->
                        <Button x:Name="LibraryViewToggleButton"
                                Classes="icon"
                                ToolTip.Tip="{DynamicResource Ui.Auto.8882BD88D4E7E80F}"
                                Click="LibraryViewToggleButton_Click"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.EE20B1318E9AFE1B}">
                            <Path x:Name="LibraryViewToggleIcon"
                                  Classes="libraryGlyph"
                                  Data="M 3,3 H 9 V 9 H 3 Z M 15,3 H 21 V 9 H 15 Z M 3,15 H 9 V 21 H 3 Z M 15,15 H 21 V 21 H 15 Z" />
                        </Button>
                        <Button x:Name="ImportButton" Classes="icon" ToolTip.Tip="{DynamicResource Ui.Auto.A76D4E4052F3FA6F}" Click="ImportButton_Click" AutomationProperties.Name="{DynamicResource Ui.Auto.576D81BB0631B165}">
                            <Path Classes="libraryGlyph"
                                  Data="M 12,3 V 16 M 7,11 L 12,16 L 17,11 M 4,21 H 20" />
                        </Button>
                        <Button x:Name="DoubanBatchMatchButton"
                                Classes="icon"
                                ToolTip.Tip="{DynamicResource Ui.Auto.6F8656E318CB926A}"
                                Click="DoubanBatchMatchButton_Click"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.7E332D1630BA5CBC}">
                            <Path Classes="libraryGlyph"
                                  UseLayoutRounding="True"
                                  Data="M 11,4.5 L 12.6,9.4 L 17.5,11 L 12.6,12.6 L 11,17.5 L 9.4,12.6 L 4.5,11 L 9.4,9.4 Z M 18.5,15.5 L 19.3,17.7 L 21.5,18.5 L 19.3,19.3 L 18.5,21.5 L 17.7,19.3 L 15.5,18.5 L 17.7,17.7 Z" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="FilterPanel"
                        Classes="flatSubsection"
                        Grid.Row="2"
                        Margin="0,0,0,12"
                        Padding="10"
                        IsVisible="False">
                    <!-- English labels need more room than the Chinese labels. Let
                         the controls wrap as a group at narrow window widths so no
                         filter or action is pushed outside the visible panel. -->
                    <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center">
                        <ComboBox x:Name="AuthorFilterBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.89050DD0FBDA32A3}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="TagFilterBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.B709CB12F0ABA6BE}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="FormatFilterBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.CCCB7189507A26E7}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="CategoryFilterBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.A1054434857F0A98}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="ReadingStatusFilterBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.0A379C1E7398FBA1}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="LibrarySortBox"
                                  Classes="filterCombo"
                                  Width="145"
                                  FontSize="12"
                                  Margin="0,0,6,6"
                                  PlaceholderText="{DynamicResource Ui.Auto.A96C9A854190874D}"
                                  SelectionChanged="FilterComboBox_SelectionChanged" />
                        <CheckBox x:Name="FavoritesOnlyCheckBox"
                                  Content="{DynamicResource Ui.Auto.60A53514EB9228A2}"
                                  Margin="0,0,12,6"
                                  VerticalAlignment="Center"
                                  Click="FavoritesOnlyCheckBox_Click" />
                        <Button Classes="quiet"
                                Content="{DynamicResource Ui.Auto.657D9CBF45EC9E6A}"
                                Margin="0,0,0,6"
                                Click="ClearFiltersButton_Click" />
                    </WrapPanel>
                </Border>

            <Grid x:Name="LibraryContentHost"
                  Grid.Row="3"
                  RowDefinitions="Auto,*"
                  Background="Transparent">
                    <Border x:Name="CollectionHeader"
                            Padding="0,0,0,10"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="BackToCollectionsButton"
                                    Content="{DynamicResource Ui.Auto.5A24236E1754E954}"
                                    Padding="10,5"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.94DC4D657CA6C6C6}"
                                    Click="BackToCollectionsButton_Click" />
                            <Button Content="{DynamicResource Ui.Auto.D35813D68B11A471}" Padding="10,5" Click="ShowAllBooksButton_Click" />
                            <TextBlock x:Name="ActiveCollectionTitleText" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                            <Button x:Name="CreateCollectionButton" Content="{DynamicResource Ui.Auto.FDF0B569D820ADE8}" Padding="10,5" Click="CreateCollectionButton_Click" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="BookGrid" Classes="bookGrid" ItemsSource="{Binding ViewModel.Books}" SelectionMode="Multiple" SelectionChanged="BookList_SelectionChanged" PointerPressed="BookGrid_PointerPressed" PointerMoved="BookGrid_PointerMoved" PointerReleased="BookGrid_PointerReleased" PointerCaptureLost="BookGrid_PointerCaptureLost" KeyDown="BookGrid_KeyDown" Focusable="True" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="166" ItemHeight="304" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate>                                 <DataTemplate x:DataType="local:BookCardViewModel">                                     <Grid Width="154"                                           Height="{Binding CardHeight}"                                           Margin="6"                                           RowDefinitions="214,Auto"                                           PointerPressed="BookCard_PointerPressed"                                           ContextRequested="BookCard_ContextRequested"                                           DoubleTapped="BookCard_DoubleTapped">                                         <Border Grid.Row="0"                                                 Classes="bookCover"                                                 Background="#D9D9D9"                                                 BorderThickness="1">                                             <Grid Background="Transparent">                                                 <TextBlock Text="BOOK"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center"                                                            Foreground="{StaticResource MutedInkBrush}"                                                            FontSize="17"                                                            IsHitTestVisible="False" />                                                 <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />                                             </Grid>                                         </Border>                                         <Grid Grid.Row="1" Margin="2,8,2,0" ColumnDefinitions="*,30" RowDefinitions="40,16,14" IsVisible="{Binding GalleryTextVisibility}">                                             <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="15" LineHeight="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />                                             <TextBlock Grid.Row="1" Text="{Binding Authors}" FontSize="11" LineHeight="14" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />                                             <TextBlock Grid.Row="2" Text="{Binding FormatLabel}" FontSize="10" LineHeight="12" Foreground="#777777" TextTrimming="CharacterEllipsis" />                                         </Grid>                                         <ContentControl Grid.RowSpan="2"                                                 Width="24"                                                 Height="24"                                                 Margin="0,0,5,5"                                                 HorizontalAlignment="Right"                                                 VerticalAlignment="Bottom"                                                 Content="{Binding}"                                                 Padding="0"                                                 HorizontalContentAlignment="Center"                                                 VerticalContentAlignment="Center"                                                 ContentTemplate="{StaticResource LibraryPresenceGlyph}"                                                 ToolTip.Tip="{Binding PresenceLabel}"                                                 AutomationProperties.Name="{Binding PresenceLabel}"                                                 IsVisible="{Binding PresenceVisibility}" />                                         <!-- 格式转换进度徽标：点击可恢复转换弹窗 -->                                         <Border Grid.Row="0"                                                 Width="68"                                                 Height="25"                                                 Margin="0,0,5,38"                                                 HorizontalAlignment="Right"                                                 VerticalAlignment="Bottom"                                                 Background="{StaticResource PaperBrush}"                                                 BorderBrush="{StaticResource InkBrush}"                                                 BorderThickness="1"                                                 Tapped="BookConversionProgressIndicator_Tapped"                                                 AutomationProperties.Name="{DynamicResource Ui.Auto.2BAA9E126F060708}"                                                 ToolTip.Tip="{DynamicResource Ui.Auto.10F6BFF0084F60EF}"                                                 IsVisible="{Binding ConversionProgressVisibility}">                                             <Grid Width="66" Height="23">                                                 <ProgressBar Minimum="0"                                                              Maximum="100"                                                              Value="{Binding ConversionProgress}"                                                              Height="5"                                                              Margin="5,0,5,3"                                                              VerticalAlignment="Bottom"                                                              Background="{StaticResource PaperBrush}" />                                                 <TextBlock Text="{Binding ConversionProgressLabel}"                                                            FontSize="10"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center" />                                             </Grid>                                         </Border>                                         <Border Grid.RowSpan="2"                                                 Classes="bookOutline"                                                 BorderBrush="{StaticResource CardBorderBrush}"                                                 BorderThickness="1"                                                 IsHitTestVisible="False" />                                         <Border Grid.RowSpan="2"                                                 BorderBrush="{StaticResource InkBrush}"                                                 BorderThickness="1.5"                                                 IsVisible="{Binding IsMultiSelected}"                                                 IsHitTestVisible="False">                                             <Border Width="22"                                                     Height="22"                                                     Margin="6"                                                     HorizontalAlignment="Left"                                                     VerticalAlignment="Top"                                                     Background="{StaticResource InkBrush}">                                                 <TextBlock Text="✓"                                                            Foreground="{StaticResource PaperBrush}"                                                            FontSize="14"                                                            FontWeight="Bold"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center" />                                             </Border>                                         </Border>                                     </Grid></DataTemplate>                             </ListBox.ItemTemplate>
                        </ListBox>

                        <Canvas IsHitTestVisible="False" ZIndex="25">
                            <Border x:Name="RubberBandRectangle"
                                    Background="#33000000"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1"
                                    IsVisible="False" />
                        </Canvas>

                        <ListBox x:Name="BookList"
                                 Classes="bookList"
                                 ItemsSource="{Binding ViewModel.Books}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="BookList_SelectionChanged"
                                 IsVisible="False"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:BookCardViewModel">
                                        <Border Margin="0,0,0,7"
                                                Classes="bookRow flatRow"
                                                Padding="10"
                                                Background="{StaticResource PaperBrush}"
                                                PointerPressed="BookCard_PointerPressed"
                                            ContextRequested="BookCard_ContextRequested"
                                            DoubleTapped="BookCard_DoubleTapped">
                                        <Grid ColumnDefinitions="48,1.55*,1.65*,1.2*,140" ColumnSpacing="12">
                                            <Border Width="40" Height="56" VerticalAlignment="Center" Background="#F2F2F2" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Title}" />
                                                <TextBlock Text="{Binding Authors}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Authors}" />
                                                <TextBlock Text="{Binding FileSummaryLabel}" FontSize="10" Foreground="#777777" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileSummaryLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding OrganizationLabel}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OrganizationLabel}" />
                                                <TextBlock Text="{Binding PublicationLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PublicationLabel}" />
                                                <TextBlock Text="{Binding IdentifierLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IdentifierLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding ReadingStateLabel}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReadingStateLabel}" />
                                                <TextBlock Text="{Binding DescriptionSummaryLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" MaxLines="2" ToolTip.Tip="{Binding DescriptionSummaryLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="5">
                                                <TextBlock Text="{Binding UpdatedLabel}" Foreground="#777777" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UpdatedLabel}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Border Width="26"
                                                            Height="26"
                                                            Background="{StaticResource PaperBrush}"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1"
                                                            ToolTip.Tip="{Binding PresenceLabel}"
                                                            AutomationProperties.Name="{Binding PresenceLabel}"
                                                            IsVisible="{Binding PresenceVisibility}">
                                                        <ContentControl Content="{Binding}"
                                                       Padding="0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       HorizontalContentAlignment="Center"
                                                       VerticalContentAlignment="Center"
                                                       ContentTemplate="{StaticResource LibraryPresenceGlyph}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.ColumnSpan="5"
                                                    BorderBrush="{StaticResource InkBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding IsSelected}"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer x:Name="CollectionScroll"
                                      IsVisible="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ContextRequested="CollectionScroll_ContextRequested">
                            <ItemsControl x:Name="CollectionList" ItemsSource="{Binding CollectionFolders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemWidth="210" ItemHeight="142" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:BookCollectionFolderViewModel">
                                        <Grid Width="210"
                                              Height="142"
                                              Tapped="CollectionFolder_Tapped"
                                              ContextRequested="CollectionFolder_ContextRequested">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="94" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <!-- Folder icon: light-grey body, top tab and
                                                 three overlapping cover thumbnails. -->
                                            <Grid Width="174" Height="86" Margin="8,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Border Margin="0,14,0,0"
                                                        Background="#F1F1F1"
                                                        BorderBrush="{StaticResource InkBrush}"
                                                        BorderThickness="1" />
                                                <Border Width="72"
                                                        Height="21"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="#F1F1F1"
                                                        BorderBrush="{StaticResource InkBrush}"
                                                        BorderThickness="1,1,1,0" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="-6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="0,6,0,0">
                                                    <Border Width="44"
                                                            Height="62"
                                                            Background="#E4E4E4"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#5A5A5A"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover1}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="44"
                                                            Height="62"
                                                            Margin="0,4,0,0"
                                                            Background="#E4E4E4"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#5A5A5A"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover2}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="44"
                                                            Height="62"
                                                            Background="#E4E4E4"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#5A5A5A"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover3}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="9,7,1,0" Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Name}" />
                                                <TextBlock Text="{Binding BookCountLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid x:Name="EmptyLibraryState"
                              Margin="24,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              IsVisible="False"
                              IsHitTestVisible="False">
                            <StackPanel MaxWidth="320"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <Path Data="M 3.5,6.5 C 6.5,5.4 9.9,5.9 12,7.8 C 14.1,5.9 17.5,5.4 20.5,6.5 V 18.2 C 17.5,17.1 14.1,17.6 12,19.4 C 9.9,17.6 6.5,17.1 3.5,18.2 Z M 12,7.8 V 19.4"
                                      Width="48"
                                      Height="48"
                                      Margin="0,0,0,4"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      UseLayoutRounding="True"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource InkBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Fill="Transparent" />
                                <TextBlock x:Name="EmptyLibraryTitleText"
                                           Text="{DynamicResource Ui.Auto.CFEEF6870D35C4EA}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="20"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="EmptyLibraryMessageText"
                                           Text="{DynamicResource Ui.Auto.A1D2A323B5C89F04}"
                                           HorizontalAlignment="Stretch"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="LibraryDropOverlay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                        Padding="34,24"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                ZIndex="30">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource Ui.Auto.606C52C9D9ACCF69}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Ui.Auto.F7824158AAA04D87}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MultiSelectionBar"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,16"
                                Padding="14,8"
                                Background="{StaticResource PaperBrush}"
                                BorderBrush="{StaticResource InkBrush}"
                                BorderThickness="1"
                                BoxShadow="0 6 16 0 #22000000"
                                IsVisible="False"
                                ZIndex="20">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="MultiSelectionText" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Content="{DynamicResource Ui.Auto.31D905D0198B0956}" Padding="12,6" Click="SendSelectedBooksToKindleBatchButton_Click" />
                                <Button Content="{DynamicResource Ui.Auto.1579F7B476E86BFF}" Padding="12,6" Click="SendSelectedBooksByEmailBatchButton_Click" />
                                <Button x:Name="DeleteSelectedBooksButton" Content="{DynamicResource Ui.Auto.435BF8A234FDE6F2}" Padding="12,6" Click="DeleteSelectedBooksButton_Click" />
                                <Button Content="{DynamicResource Ui.Auto.74966E20DF2EA9FD}" Padding="12,6" Click="ClearMultiSelectionButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock x:Name="TaskStatusText"
                               Text="{DynamicResource Ui.Auto.1BD1893C09003D8A}"
                               FontSize="11"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               IsVisible="False" />
                    <ProgressBar x:Name="LibraryBusyProgress" Grid.Column="1" Width="120" Height="5" IsIndeterminate="True" IsVisible="False" />
                </Grid>
            </Grid>

            <!-- Details panel: the layout follows the old WinUI detail pane:
                 cover and three square action buttons first, then labelled
                 metadata fields and the save/delete row. -->
            <Border x:Name="LibraryDetailPane"
                    Grid.Column="1"
                    Width="320"
                    HorizontalAlignment="Right"
                    ZIndex="40"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DetailContentStack" Margin="24,70,24,24" Spacing="13">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="180,34" ColumnSpacing="12">
                                <Border Width="180"
                                        Height="250"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource PaperBrush}"
                                        BorderBrush="{StaticResource InkBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="DetailCoverImage" Stretch="UniformToFill" />
                                        <TextBlock x:Name="DetailCoverPlaceholder"
                                                   Text="{DynamicResource Ui.Auto.646F56BD61A92E84}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1"
                                      Height="250"
                                      VerticalAlignment="Top"
                                      RowDefinitions="*,*,*">
                                    <Button x:Name="DetailDoubanButton"
                                            Classes="quiet"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.C2F860918778ACC8}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.AB328F6F9A71D0E7}"
                                            Click="DoubanMatchButton_Click">
                                        <!-- Magnifier glyph (WinUI E721). -->
                                        <Path Classes="libraryGlyph"
                                              Data="M 11,4 A 7,7 0 1,0 11,18 A 7,7 0 1,0 11,4 M 16,16 L 21,21" />
                                    </Button>
                                    <Button x:Name="DetailFavoriteButton"
                                            Grid.Row="1"
                                            Classes="quiet"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.77196E6DEB2195FA}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.77196E6DEB2195FA}"
                                            Click="DetailFavoriteButton_Click">
                                        <Path x:Name="DetailFavoriteIcon"
                                              Classes="libraryGlyph"
                                              Data="M 12,3 L 14.8,8.7 L 21,9.6 L 16.5,14 L 17.6,20.2 L 12,17.3 L 6.4,20.2 L 7.5,14 L 3,9.6 L 9.2,8.7 Z" />
                                    </Button>
                                    <Button x:Name="DetailReadingStatusButton"
                                            Grid.Row="2"
                                            Classes="quiet"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="{DynamicResource Ui.Auto.CAF07AC99C9DE865}"
                                            ToolTip.Tip="{DynamicResource Ui.Auto.CAF07AC99C9DE865}"
                                            Click="DetailReadingStatusButton_Click">
                                        <Path x:Name="DetailReadingStatusIcon"
                                              Classes="libraryGlyph"
                                              Data="M 12,4 A 8,8 0 1 0 12,20 A 8,8 0 1 0 12,4" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.C3405F8C7D9D392A}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailTitleText" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.7D4146CA082798F0}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailAuthorsText" FontSize="13" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.0213F653036C18BA}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailDoubanRatingBox" IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.1D0FD5F9336D9103}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailTagsBox" PlaceholderText="{DynamicResource Ui.Auto.42F1A31C725F5D65}" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.515559957FD3ACBD}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailCategoryBox" PlaceholderText="{DynamicResource Ui.Auto.0C9D7F0CA37B2C93}" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.8131EAFD02396E6A}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailDescriptionBox" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="{DynamicResource Ui.Auto.D0976E76BF2566C5}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedInkBrush}" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.232527192F3462A3}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailSeriesBox" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.1107B9A98AD38DB6}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailPublisherBox" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.D6D0F10A7D96A8D2}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailPublishDateBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="ISBN" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailIsbnBox" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.560630BA0C84322E}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailPageCountBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.5A0E877ACFB138E4}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailBindingBox" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,8,0,2" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button x:Name="SaveDetailsButton"
                                        Classes="detailSave"
                                        Content="{DynamicResource Ui.Auto.991BB7CFE5A81550}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="SaveDetailsButton_Click" />
                                <Button Grid.Column="1"
                                        Classes="detailDelete"
                                        Content="{DynamicResource Ui.Auto.AAAAB2436F31B66E}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="DeleteSelectedBookButton_Click" />
                            </Grid>

                            <!-- Compatibility fields used by the current
                                 Avalonia handlers but hidden because the old
                                 detail pane does not show these sections. -->
                            <StackPanel IsVisible="False">
                                <TextBlock x:Name="DetailStateText" />
                                <TextBlock x:Name="DetailOrganizationText" />
                                <TextBlock x:Name="DetailPublicationText" />
                                <TextBlock x:Name="DetailIdentifierText" />
                                <TextBlock x:Name="DetailDescriptionText" />
                                <ItemsControl x:Name="DetailFiles" />
                                <ComboBox x:Name="DetailCollectionBox" />
                                <Button x:Name="CollectionMembershipButton" Click="CollectionMembershipButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Keep scrolled detail content out of the custom title-bar
                         drag area, as in the old WinUI pane. -->
                    <Border Height="38"
                            VerticalAlignment="Top"
                            Background="{StaticResource PaperBrush}"
                            IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Stage 3: Kindle book library. The page stays deliberately
                 simple and monochrome; all device work is performed by the
                 platform service behind the portable UI. -->
            <Grid x:Name="DevicePage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Ui.Auto.E1506406A5BD8F02}" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{DynamicResource Ui.Auto.471BDA92F71A1882}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <Button x:Name="DeviceNameButton"
                                Classes="quiet"
                                Padding="6,3"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.13E641A3EA2095DF}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.C2191B865B0112F8}"
                                Click="DeviceNameButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="DevicePageDeviceText" Text="{DynamicResource Ui.Auto.9514487168A00698}" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                <Path Data="M 1,2 L 5,6 L 9,2" Width="10" Height="8" Stroke="{StaticResource MutedInkBrush}" StrokeThickness="1.25" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="DevicePageStatusText" Text="{DynamicResource Ui.Auto.92424890EA6A8543}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,18" ColumnDefinitions="420,*">
                    <TextBox x:Name="DeviceBookSearchBox"
                             Height="38"
                             Padding="13,7"
                             PlaceholderText="{DynamicResource Ui.Auto.168A769EBA62A8E8}"
                             TextChanged="DeviceBookSearchBox_TextChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                        <Button x:Name="DeviceBookFilterButton" Classes="icon" ToolTip.Tip="{DynamicResource Ui.Auto.0289E5BA6BFEA5E2}" Click="DeviceBookFilterButton_Click" AutomationProperties.Name="{DynamicResource Ui.Auto.B5F15473FDC0FEFE}">
                            <Path Classes="libraryGlyph" UseLayoutRounding="True" Data="M 5,5.4 H 19 L 14.2,11 V 17.6 L 9.8,19.8 V 11 Z" />
                        </Button>
                        <!-- One click cycles 网格 ↔ 列表; the glyph mirrors the
                             active view and the tooltip names the next one. -->
                        <Button x:Name="DeviceViewToggleButton" Classes="icon" ToolTip.Tip="{DynamicResource Ui.Auto.AB24E81DE1CF2D4F}" AutomationProperties.Name="{DynamicResource Ui.Auto.EE20B1318E9AFE1B}" Click="DeviceViewToggleButton_Click">
                            <Path x:Name="DeviceViewToggleIcon" Classes="libraryGlyph" Data="M 3,3 H 9 V 9 H 3 Z M 15,3 H 21 V 9 H 15 Z M 3,15 H 9 V 21 H 3 Z M 15,15 H 21 V 21 H 15 Z" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{DynamicResource Ui.Auto.4470BFD2C729D4A2}" AutomationProperties.Name="{DynamicResource Ui.Auto.4470BFD2C729D4A2}" Click="RefreshDevicesButton_Click">
                            <Path Classes="libraryGlyph" Data="M 20,8 A 9,9 0 1,0 20,16 M 20,8 V 3 M 20,8 H 15" />
                        </Button>
                        <Button x:Name="EjectDeviceButton" Classes="icon" ToolTip.Tip="{DynamicResource Ui.Auto.F78C515D501BF2E0}" AutomationProperties.Name="{DynamicResource Ui.Auto.F78C515D501BF2E0}" Click="EjectDeviceButton_Click" IsEnabled="False">
                            <Path Classes="libraryGlyph" Data="M 6,15 L 12,9 L 18,15 M 6,20 H 18" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="DeviceBookFilterPanel" Classes="flatSubsection" Grid.Row="2" Margin="0,0,0,12" Padding="10" IsVisible="False">
                    <Grid ColumnDefinitions="128,150,150,Auto" ColumnSpacing="8">
                        <ComboBox x:Name="DeviceBookFormatFilterBox" Classes="filterCombo" PlaceholderText="{DynamicResource Ui.Auto.CCCB7189507A26E7}" SelectionChanged="DeviceBookFilter_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.CCCB7189507A26E7}" Tag="" />
                            <ComboBoxItem Content="EPUB" Tag="epub" />
                            <ComboBoxItem Content="PDF" Tag="pdf" />
                            <ComboBoxItem Content="MOBI" Tag="mobi" />
                            <ComboBoxItem Content="AZW3" Tag="azw3" />
                            <ComboBoxItem Content="AZW" Tag="azw" />
                            <ComboBoxItem Content="KFX" Tag="kfx" />
                        </ComboBox>
                        <ComboBox x:Name="DeviceBookPresenceFilterBox" Classes="filterCombo" Grid.Column="1" PlaceholderText="{DynamicResource Ui.Auto.A744BEE37217BB09}" SelectionChanged="DeviceBookFilter_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.A744BEE37217BB09}" Tag="" />
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.D262E439AACBFA82}" Tag="kindle" />
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.D5FF4A035E34D3C3}" Tag="both" />
                        </ComboBox>
                        <ComboBox x:Name="DeviceBookSortBox" Classes="filterCombo" Grid.Column="2" PlaceholderText="{DynamicResource Ui.Auto.A96C9A854190874D}" SelectionChanged="DeviceBookFilter_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.C3405F8C7D9D392A}" Tag="title" />
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.7D4146CA082798F0}" Tag="author" />
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.AD3BF1EEA84B70E4}" Tag="modified" />
                            <ComboBoxItem Content="{DynamicResource Ui.Auto.B9BF6916437A77EB}" Tag="size" />
                        </ComboBox>
                        <Button Grid.Column="3" Classes="quiet" Content="{DynamicResource Ui.Auto.657D9CBF45EC9E6A}" Click="ClearDeviceBookFiltersButton_Click" />
                    </Grid>
                </Border>
                <ScrollViewer x:Name="DeviceBookGridScroll"
                              Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PointerPressed="DeviceBookGrid_PointerPressed"
                              PointerMoved="DeviceBookGrid_PointerMoved"
                              PointerReleased="DeviceBookGrid_PointerReleased"
                              PointerCaptureLost="DeviceBookGrid_PointerCaptureLost">
                    <ItemsControl x:Name="DeviceBookGridItems" ItemsSource="{Binding VisibleDeviceBooks}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="166" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:KindleBookCardViewModel">
                                <Grid Width="154"
                                      Height="{Binding CardHeight}"
                                      Margin="6"
                                      RowDefinitions="214,Auto"
                                      PointerPressed="DeviceBook_PointerPressed"
                                      PointerEntered="DeviceBook_PointerEntered"
                                      PointerExited="DeviceBook_PointerExited"
                                      DoubleTapped="DeviceBook_DoubleTapped"
                                      ContextRequested="DeviceBook_ContextRequested">
                                    <Border Grid.Row="0" Classes="bookCover" Background="#D9D9D9" BorderThickness="1">
                                        <ToolTip.Tip>
                                            <ToolTip>
                                                <StackPanel MaxWidth="360" Spacing="4">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Authors}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding RelativePath}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ToolTip>
                                        </ToolTip.Tip>
                                        <Grid Background="Transparent">
                                            <TextBlock Text="BOOK" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" FontSize="17" IsHitTestVisible="False" />
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="2,8,2,0" ColumnDefinitions="*,30" RowDefinitions="40,16,14" IsVisible="{Binding GalleryTextVisibility}">
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="15" LineHeight="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                        <TextBlock Grid.Row="1" Text="{Binding Authors}" FontSize="11" LineHeight="14" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Authors}" />
                                        <TextBlock Grid.Row="2" Text="{Binding FormatLabel}" FontSize="10" LineHeight="12" Foreground="#777777" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FormatLabel}" />
                                    </Grid>
                                    <ContentControl Grid.RowSpan="2"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,5,5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Content="{Binding}"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ContentTemplate="{StaticResource LibraryPresenceGlyph}"
                                                    ToolTip.Tip="{Binding PresenceLabel}"
                                                    AutomationProperties.Name="{Binding PresenceLabel}"
                                                    IsVisible="{Binding PresenceVisibility}" />
                                    <Border Grid.RowSpan="2"
                                            Classes="bookOutline"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            IsHitTestVisible="False" />
                                    <Border Grid.RowSpan="2"
                                            BorderBrush="{StaticResource InkBrush}"
                                            BorderThickness="1.5"
                                            IsVisible="{Binding IsMultiSelected}"
                                            IsHitTestVisible="False">
                                        <Border Width="22" Height="22" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource InkBrush}">
                                            <TextBlock Text="✓" Foreground="{StaticResource PaperBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Canvas Grid.Row="3" IsHitTestVisible="False" ZIndex="25">
                    <Border x:Name="DeviceRubberBandRectangle"
                            Background="#33000000"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1"
                            IsVisible="False" />
                </Canvas>
                <ScrollViewer x:Name="DeviceBookListScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                    <ItemsControl ItemsSource="{Binding VisibleDeviceBooks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:KindleBookCardViewModel">
                                <Border BorderBrush="{StaticResource HairlineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,9"
                                        PointerPressed="DeviceBook_PointerPressed"
                                        PointerEntered="DeviceBook_PointerEntered"
                                        PointerExited="DeviceBook_PointerExited"
                                        DoubleTapped="DeviceBook_DoubleTapped"
                                        ContextRequested="DeviceBook_ContextRequested">
                                    <Grid ColumnDefinitions="54,2*,*,180" ColumnSpacing="10" MinHeight="72">
                                        <Grid Width="42" Height="56" VerticalAlignment="Center">
                                            <Border Background="#D9D9D9" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border Width="18"
                                                    Height="18"
                                                    Margin="0,0,0,2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Background="{StaticResource PaperBrush}"
                                                    BorderBrush="{StaticResource InkBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding PresenceVisibility}"
                                                    ToolTip.Tip="{Binding PresenceLabel}"
                                                    AutomationProperties.Name="{Binding PresenceLabel}">
                                                <ContentControl Content="{Binding}"
                                                                Padding="0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                ContentTemplate="{StaticResource LibraryPresenceGlyph}"
                                                                RenderTransformOrigin="0.5,0.5">
                                                    <ContentControl.RenderTransform>
                                                        <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                                                    </ContentControl.RenderTransform>
                                                </ContentControl>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding GalleryTextVisibility}">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Title}" />
                                            <TextBlock Text="{Binding Authors}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Authors}" />
                                            <TextBlock Text="{Binding FileName}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding InfoLabel}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InfoLabel}" />
                                            <TextBlock Text="{Binding ModifiedLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModifiedLabel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding RelativePath}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip.Tip="{Binding RelativePath}" />
                                            <TextBlock Text="{Binding HashLabel}" Foreground="#999999" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip.Tip="{Binding HashLabel}" />
                                        </StackPanel>
                                        <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" IsVisible="{Binding IsFrameVisible}" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border x:Name="DeviceBookSelectionBar"
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        Padding="14,8"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        BoxShadow="0 6 16 0 #22000000"
                        IsVisible="False"
                        ZIndex="20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="DeviceBookSelectionText" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Content="{DynamicResource Ui.Auto.CFE6A637EB2B50A8}" Padding="11,6" Click="ExportSelectedDeviceBooksButton_Click" />
                        <Button Content="{DynamicResource Ui.Auto.435BF8A234FDE6F2}" Padding="11,6" Click="DeleteSelectedDeviceBooksButton_Click" />
                        <Button Content="{DynamicResource Ui.Auto.74966E20DF2EA9FD}" Padding="11,6" Click="ClearDeviceBookSelectionButton_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="DeviceBookEmptyState" Grid.Row="3" Background="{StaticResource PaperBrush}" IsVisible="True" ZIndex="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
                        <Path Width="46" Height="46" Stretch="Uniform" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              Data="M 3.5,6.5 C 6.5,5.4 9.9,5.9 12,7.8 C 14.1,5.9 17.5,5.4 20.5,6.5 V 18.2 C 17.5,17.1 14.1,17.6 12,19.4 C 9.9,17.6 6.5,17.1 3.5,18.2 Z M 12,7.8 V 19.4" />
                        <TextBlock x:Name="DeviceBookEmptyText" Text="{DynamicResource Ui.Auto.436148ECA038EE4F}" Foreground="{StaticResource MutedInkBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Stage 3: fonts and dictionaries on the connected Kindle. -->
            <Grid x:Name="DeviceResourcePage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*,Auto"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragOver="DeviceResourcePage_DragOver"
                  DragDrop.Drop="DeviceResourcePage_Drop">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Ui.Auto.E1506406A5BD8F02}" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="DeviceResourcePageTitle" Text="{DynamicResource Ui.Auto.267DBF8C2A617630}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Name="DeviceResourceDeviceText" Text="{DynamicResource Ui.Auto.9514487168A00698}" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="{DynamicResource Ui.Auto.05F75734785394FA}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock x:Name="DeviceResourcePathText" Text="Kindle\fonts" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock x:Name="DeviceResourceCountText" Text="{DynamicResource Ui.Auto.0399514D6A1113C3}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="DeviceResourceStatusText" Text="{DynamicResource Ui.Auto.B5B59EF7D3AF6071}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ImportDeviceResourceButton" Content="{DynamicResource Ui.Auto.3C652C6EFD4EB3F8}" Margin="0,0,8,0" Padding="11,6" Click="ImportDeviceResourceButton_Click" />
                        <Button x:Name="ExportDeviceResourceButton" Content="{DynamicResource Ui.Auto.DAB0F7CAA4DEA42D}" Classes="quiet" IsEnabled="False" Margin="0,0,8,0" Padding="11,6" Click="ExportDeviceResourceButton_Click" />
                        <Button x:Name="DeleteDeviceResourceButton" Content="{DynamicResource Ui.Auto.435BF8A234FDE6F2}" Classes="quiet" IsEnabled="False" Margin="0,0,8,0" Padding="11,6" Click="DeleteDeviceResourceButton_Click" />
                        <Button Content="{DynamicResource Ui.Auto.AEE88743413144A2}" Classes="quiet" Margin="0,0,8,0" Padding="11,6" Click="RefreshDeviceResourcesButton_Click" />
                        <Button Content="{DynamicResource Ui.Auto.A51CE8191584FCF7}" Padding="11,6" Click="ShowAllBooksButton_Click" />
                    </WrapPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <ListBox x:Name="DeviceResourceList"
                             ItemsSource="{Binding DeviceResources}"
                             SelectionMode="Single"
                             SelectionChanged="DeviceResourceList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:KindleDeviceResource">
                    <Border Classes="flatRow" Padding="10,8">
                                    <Grid ColumnDefinitions="2*,90,110" ColumnSpacing="16">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Format}" Foreground="{StaticResource MutedInkBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="DeviceResourceEmptyText"
                               Text="{DynamicResource Ui.Auto.4304C61806C743C1}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedInkBrush}" />
                </Grid>
                <TextBlock Grid.Row="2" x:Name="DeviceResourceSafetyText" Margin="0,12,0,0" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
            </Grid>

            <!-- Stage 3: local and Kindle reading materials. -->
            <Grid x:Name="ReadingMaterialsPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,Auto,Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Ui.Auto.CBA1EC75F4CA2162}" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="ReadingMaterialsPageTitle" Text="{DynamicResource Ui.Auto.9CD1F9CD7B9AC663}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock x:Name="ReadingMaterialsStatusText" Text="{DynamicResource Ui.Auto.D406419777B46CF3}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ReadingMaterialsNotesActions" Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Name="ReadingMaterialsLocateButton" Content="{DynamicResource Ui.Auto.6F789DCD99E5FE34}" Classes="quiet" IsEnabled="False" Padding="11,6" Click="ReadingMaterialsLocateButton_Click" />
                        <Button x:Name="DeleteReadingMaterialsButton" Content="{DynamicResource Ui.Auto.435BF8A234FDE6F2}" Classes="quiet" IsEnabled="False" Padding="11,6" Click="DeleteReadingMaterialsButton_Click" />
                        <Button Content="{DynamicResource Ui.Auto.AEE88743413144A2}" Classes="quiet" Padding="11,6" Click="RefreshReadingMaterialsButton_Click" />
                        <Button x:Name="ReadingMaterialsBackButton" Content="{DynamicResource Ui.Auto.A51CE8191584FCF7}" Padding="11,6" Click="ShowAllBooksButton_Click" />
                    </StackPanel>
                    <StackPanel x:Name="ReadingMaterialsExportActions" Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" IsVisible="False">
                        <Button x:Name="SelectAllReadingMaterialsButton" Content="{DynamicResource Ui.Auto.3A5040B68ABF75F9}" Classes="quiet" Padding="11,6" Click="SelectAllReadingMaterialsButton_Click" />
                        <Button Content="{DynamicResource Ui.Auto.E604A9509264DE7F}" Classes="quiet" Padding="11,6" Click="RefreshReadingMaterialsButton_Click" />
                        <Button Content="{DynamicResource Ui.Auto.A51CE8191584FCF7}" Padding="11,6" Click="ShowAllBooksButton_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,14,0,14" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                        <StackPanel Spacing="11">
                            <TextBlock Text="{DynamicResource Ui.Auto.A488E93D69CC1296}" FontSize="12" />
                            <ComboBox x:Name="ReadingMaterialsSourceBox" SelectedIndex="0" SelectionChanged="ReadingMaterialsSourceBox_SelectionChanged">
                                <ComboBoxItem Content="Any source" Tag="all" />
                                <ComboBoxItem Content="Local library" Tag="local" />
                                <ComboBoxItem Content="Kindle" Tag="kindle" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="11">
                            <TextBlock Text="{DynamicResource Ui.Auto.44CE7AE909BBB28B}" FontSize="12" />
                            <TextBox x:Name="ReadingMaterialsSearchBox" PlaceholderText="{DynamicResource Ui.Auto.D62E57A56D744F50}" TextChanged="ReadingMaterialsSearchBox_TextChanged" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border x:Name="ReadingMaterialsSummaryBorder"
                        Classes="flatPanel"
                        Grid.Row="2"
                        Padding="16,12"
                        Background="{StaticResource PaperBrush}">
                    <TextBlock x:Name="ReadingMaterialsSummaryText" Text="{DynamicResource Ui.Auto.3AFCB2852BD8B47A}" FontSize="16" FontWeight="Bold" />
                </Border>
                <Border x:Name="ReadingMaterialsExportPanel"
                        Classes="flatPanel"
                        Grid.Row="2"
                        Padding="16,14"
                        Background="{StaticResource PaperBrush}"
                        IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource Ui.Auto.F67D55C3531FBD5C}" FontSize="16" FontWeight="Bold" />
                            <TextBlock x:Name="ReadingMaterialsExportScopeText"
                                       Text="{DynamicResource Ui.Auto.835E544AC5A9E6B1}"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Ui.Auto.0F02DA7B32BA56DE}"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="{DynamicResource Ui.Auto.AC8B027CC1E3A493}" Padding="11,6" Click="ExportReadingMaterialsMarkdownButton_Click" />
                            <Button Content="{DynamicResource Ui.Auto.8E1B126E634DCA98}" Classes="quiet" Padding="11,6" Click="ExportReadingMaterialsTextButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="ReadingMaterialsExportSummaryBorder"
                        Classes="flatPanel"
                        Grid.Row="3"
                        Margin="0,18,0,0"
                        Padding="16,12"
                        Background="{StaticResource PaperBrush}"
                        IsVisible="False">
                    <TextBlock x:Name="ReadingMaterialsExportSummaryText" Text="{DynamicResource Ui.Auto.183EFD534E3EBB7E}" FontSize="16" FontWeight="Bold" />
                </Border>
                <Grid Grid.Row="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReadingMaterialGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:Stage3ReadingMaterialGroupViewModel">
                                    <Border Classes="flatRow" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="12" Margin="12">
                                                <Border Width="48" Height="64" Background="#E4E4E4" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="BOOK" FontSize="8" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoCover}" />
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BookTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                                        <TextBlock Text="{Binding CountLabel}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Tag="{Binding}"
                                                        Content="{Binding ExpandLabel}"
                                                        Classes="quiet"
                                                        Padding="10,5"
                                                        VerticalAlignment="Center"
                                                        Click="ReadingMaterialGroupToggleButton_Click" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:Stage3ReadingMaterialViewModel">
                                                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="12,10" DoubleTapped="ReadingMaterialEntry_DoubleTapped">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                                          VerticalAlignment="Top"
                                                                          Click="ReadingMaterialSelectionChanged" />
                                                                <StackPanel Grid.Column="1" Spacing="5">
                                                                    <TextBlock Text="{Binding SourceLabel}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource MutedInkBrush}" />
                                                                    <TextBlock Text="{Binding ChapterDisplayLabel}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding SelectedContentLabel}"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding NoteLabel}"
                                                                               FontSize="11"
                                                                               Foreground="#555555"
                                                                               IsVisible="{Binding HasNote}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="ReadingMaterialsEmptyText" Text="{DynamicResource Ui.Auto.E2D121364FBE830A}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Reading dashboard keeps the WinUI statistics surface separate
                 from editable application settings. -->
            <Grid x:Name="ReadingDashboardPage"
                  Grid.Column="1"
                  Margin="30,48,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{DynamicResource Ui.Auto.440C143379A34160}" FontSize="28" FontWeight="Bold" />
                        <TextBlock x:Name="DashboardStatusText"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="{DynamicResource Ui.Auto.BC87A4121A0873B3}" Click="RefreshReadingDashboardButton_Click" />
                        <Button Content="{DynamicResource Ui.Auto.E40A628FFEC72072}" Classes="quiet" Click="ExportReadingDashboardButton_Click" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                            <Border Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Ui.Auto.3CCEA88494F876E9}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardTotalTimeText" Text="0" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashboardDailyAverageText" Text="{DynamicResource Ui.Auto.E1FD8BC385380027}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Ui.Auto.A4D3E9ED3C64AE28}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardStreakText" Text="{DynamicResource Ui.Auto.2E878CA6410E7711}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Ui.Auto.FBD5755F75159075}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Ui.Auto.39198D42F3794824}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBooksStartedText" Text="{DynamicResource Ui.Auto.106392390AAB29EF}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashboardAverageProgressText" Text="{DynamicResource Ui.Auto.4CDF93F7A6D263FC}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Ui.Auto.8F8C2CA5EC429922}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBooksFinishedText" Text="{DynamicResource Ui.Auto.106392390AAB29EF}" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Classes="flatMetric" Padding="14,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Ui.Auto.7B77D050A183CB98}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBookmarksText" Text="0 / 0" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <Border Classes="flatPanel" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{DynamicResource Ui.Auto.7644551F37492A5D}" FontSize="14" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding DashboardDays}" AutomationProperties.Name="{DynamicResource Ui.Auto.83A25C492C9A33C4}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardDayViewModel">
                                                <Grid Width="30" Height="170" RowDefinitions="*,Auto,Auto" Margin="0,0,4,0">
                                                    <Border VerticalAlignment="Bottom"
                                                            Height="{Binding BarHeight}"
                                                            CornerRadius="2"
                                                            Opacity="{Binding BarOpacity}"
                                                            Background="{StaticResource InkBrush}"
                                                            ToolTip.Tip="{Binding TimeLabel}" />
                                                    <TextBlock Grid.Row="1" Text="{Binding TimeLabel}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <TextBlock Grid.Row="2" Text="{Binding DateLabel}" FontSize="9" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="flatPanel" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Ui.Auto.57A00AA8DDA6EA8E}" FontSize="14" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding DashboardBookTimes}" AutomationProperties.Name="{DynamicResource Ui.Auto.FB37D1646C81A5BA}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardBarViewModel">
                                                <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8" Margin="0,4" ToolTip.Tip="{Binding ValueLabel}">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Label}" />
                                                    <Border Grid.Column="1" Width="{Binding BarWidth}" Height="10" CornerRadius="2" Background="{StaticResource InkBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Classes="flatPanel" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Ui.Auto.C89EA308CEDC2ECC}" FontSize="14" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding DashboardProgressBuckets}" AutomationProperties.Name="{DynamicResource Ui.Auto.A0994B78FD83CF3A}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardBarViewModel">
                                                <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8" Margin="0,4" ToolTip.Tip="{Binding ValueLabel}">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Width="{Binding BarWidth}" Height="10" CornerRadius="2" Background="{StaticResource InkBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Classes="flatPanel" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Ui.Auto.E06FCFAF83B0B55C}" FontSize="14" FontWeight="SemiBold" />
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto"
                                                  AutomationProperties.Name="{DynamicResource Ui.Auto.914F86CA5C6739D9}">
                                        <ItemsControl ItemsSource="{Binding DashboardRecentItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:Stage3DashboardRecentViewModel">
                                                    <Border Padding="0,8"
                                                            BorderBrush="{StaticResource HairlineBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                                                <TextBlock Text="{Binding UpdatedLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DurationLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ProgressLabel}" FontSize="12" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="DashboardRecentEmptyText"
                                               Text="{DynamicResource Ui.Auto.DF7356640E9FC306}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="False" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Stage 3: Z-Library search and download. -->
            <Grid x:Name="ZLibraryPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,*,Auto">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Ui.Auto.B9086662B1DF1F20}" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{DynamicResource Ui.Auto.6C1BAA83960E7BC6}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="ZLibraryStatusText"
                               Margin="0,3,0,0"
                               Text="{DynamicResource Ui.Auto.7831C76AF1C21CE6}"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,22,0,18">
                    <TextBox x:Name="ZLibrarySearchBox"
                             Height="38"
                             Padding="13,7"
                             PlaceholderText="{DynamicResource Ui.Auto.EB050FA14D0DA6AB}"
                             KeyDown="ZLibrarySearchBox_KeyDown" />
                    <ComboBox x:Name="ZLibraryExtensionBox"
                              Grid.Column="1"
                              Width="140"
                              Height="38"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Any format" Tag="" />
                        <ComboBoxItem Content="EPUB" Tag="epub" />
                        <ComboBoxItem Content="PDF" Tag="pdf" />
                        <ComboBoxItem Content="MOBI" Tag="mobi" />
                        <ComboBoxItem Content="AZW3" Tag="azw3" />
                        <ComboBoxItem Content="FB2" Tag="fb2" />
                        <ComboBoxItem Content="DJVU" Tag="djvu" />
                        <ComboBoxItem Content="TXT" Tag="txt" />
                    </ComboBox>
                    <ComboBox x:Name="ZLibraryLanguageBox"
                              Grid.Column="2"
                              Width="150"
                              Height="38"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Any language" Tag="" />
                        <ComboBoxItem Content="Chinese" Tag="chinese" />
                        <ComboBoxItem Content="English" Tag="english" />
                        <ComboBoxItem Content="Japanese" Tag="japanese" />
                        <ComboBoxItem Content="Korean" Tag="korean" />
                        <ComboBoxItem Content="Russian" Tag="russian" />
                        <ComboBoxItem Content="German" Tag="german" />
                        <ComboBoxItem Content="French" Tag="french" />
                        <ComboBoxItem Content="Spanish" Tag="spanish" />
                    </ComboBox>
                    <Button x:Name="ZLibrarySearchButton"
                            Classes="icon"
                            Grid.Column="3"
                            Width="38"
                            Height="38"
                            Padding="0"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.44CE7AE909BBB28B}"
                            ToolTip.Tip="{DynamicResource Ui.Auto.44CE7AE909BBB28B}"
                            Click="ZLibrarySearchButton_Click">
                        <Path Classes="libraryGlyph"
                              Data="M 11,4 A 7,7 0 1,0 11,18 A 7,7 0 1,0 11,4 M 16,16 L 21,21" />
                    </Button>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding ZLibraryBooks}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ZLibraryBookCardViewModel">
                                            <Border Classes="flatRow"
                                                    Margin="0,0,0,8"
                                            Padding="10,10,22,10"
                                            MinHeight="112"
                                            Tapped="ZLibraryBookRow_Tapped">
                                        <Grid ColumnDefinitions="66,*,Auto" ColumnSpacing="14">
                                            <Border Width="66"
                                                    Height="92"
                                                    VerticalAlignment="Center"
                                                    Background="#D9D9D9"
                                                    BorderBrush="{StaticResource HairlineBrush}"
                                                    BorderThickness="1">
                                                <Grid Background="Transparent">
                                                    <TextBlock Text="BOOK"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="#5A5A5A"
                                                               FontSize="10" />
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           ToolTip.Tip="{Binding Title}" />
                                                <TextBlock Text="{Binding Authors}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Authors}" />
                                                <TextBlock Text="{Binding PublicationLabel}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding PublicationLabel}" />
                                                <TextBlock Text="{Binding InfoLabel}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding InfoLabel}" />
                                                <TextBlock Text="{Binding ExtraInfoLabel}"
                                                           Foreground="#777777"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding ExtraInfoLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Width="110" VerticalAlignment="Center" Spacing="5">
                                                <Grid Width="110" Height="38">
                                                    <Button Width="110"
                                                            Height="38"
                                                            Padding="0"
                                                            Classes="quiet"
                                                            Background="{StaticResource PaperBrush}"
                                                            Foreground="{StaticResource InkBrush}"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="0"
                                                            Tag="{Binding}"
                                                            IsVisible="{Binding IsDownloadIdle}"
                                                            AutomationProperties.Name="{DynamicResource Ui.Auto.4673A23061656125}"
                                                            ToolTip.Tip="{DynamicResource Ui.Auto.4673A23061656125}"
                                                            Click="ZLibraryDownloadButton_Click">
                                                        <Path Width="18"
                                                              Height="18"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding $parent[Button].Foreground}"
                                                              StrokeThickness="1.5"
                                                              Fill="Transparent"
                                                              Data="M 9,2 L 9,12 M 5,8 L 9,12 L 13,8 M 3,15 L 15,15" />
                                                    </Button>
                                                    <Border Width="110"
                                                            Height="38"
                                                            Background="{StaticResource PaperBrush}"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1"
                                                            IsVisible="{Binding IsDownloading}">
                                                        <Grid ClipToBounds="True">
                                                            <Border Width="{Binding DownloadFillWidth}"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{StaticResource InkBrush}" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="110"
                                                            Height="38"
                                                            Background="{StaticResource InkBrush}"
                                                            IsVisible="{Binding IsDownloadCompleted}"
                                                            AutomationProperties.Name="{DynamicResource Ui.Auto.C1C79B63F418FD14}">
                                                        <Path Width="18"
                                                              Height="14"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Stretch="Uniform"
                                                              Stroke="{StaticResource PaperBrush}"
                                                              StrokeThickness="2"
                                                              StrokeLineCap="Round"
                                                              StrokeJoin="Round"
                                                              Fill="Transparent"
                                                              Data="M 2,7 L 7,12 L 16,2" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding StatusMessage}"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="110"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="ZLibraryDetailPanel"
                            x:DataType="local:ZLibraryBookCardViewModel"
                            Grid.Column="1"
                            Width="330"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            IsVisible="False">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Margin="16,12,10,10" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource Ui.Auto.326DE7898C2A6278}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="icon" Content="×" Click="ZLibraryDetailCloseButton_Click" AutomationProperties.Name="{DynamicResource Ui.Auto.D7B60ECE792129FF}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,4,16,16" Spacing="10">
                                    <Border Width="112" Height="156" HorizontalAlignment="Left" Background="#D9D9D9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="BOOK" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666" FontSize="11" />
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Authors}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailMetadataLabel}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Text="{DynamicResource Ui.Auto.722EE0542BAF2C56}" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding VolumeLabel}" FontSize="11" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Ui.Auto.8131EAFD02396E6A}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding DetailDescription}"
                                               Foreground="#555555"
                                               FontSize="11"
                                               LineHeight="18"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Margin="16,12,16,16" Spacing="7">
                                <Button Content="{DynamicResource Ui.Auto.93E94127FD6DDD49}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanOpenOfficialDetail}" Click="ZLibraryOfficialDetailButton_Click" />
                                <Button Content="{DynamicResource Ui.Auto.E47D06BF2E51D2C4}" Classes="quiet" HorizontalAlignment="Stretch" IsEnabled="{Binding CanReadOnline}" Click="ZLibraryReadOnlineButton_Click" />
                                <Button Content="{DynamicResource Ui.Auto.8F043961C898554D}" Classes="quiet" HorizontalAlignment="Stretch" IsEnabled="{Binding CanSendToEmail}" Click="ZLibrarySendEmailButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                    <TextBlock Grid.Column="0"
                               x:Name="ZLibraryResultText"
                               Text="{DynamicResource Ui.Auto.CAF22EACE474E406}"
                               Foreground="{StaticResource MutedInkBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ZLibraryPrevPageButton"
                                Content="{DynamicResource Ui.Auto.C9B9AE7A61444AB7}"
                                Classes="quiet"
                                IsEnabled="False"
                                Click="ZLibraryPrevPageButton_Click" />
                        <TextBlock x:Name="ZLibraryPageText"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ZLibraryNextPageButton"
                                Content="{DynamicResource Ui.Auto.8A8542F6964852DC}"
                                Classes="quiet"
                                IsEnabled="False"
                                Click="ZLibraryNextPageButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Stage 3: the settings surface follows the WinUI reference:
                 title/subtitle, a narrow category rail, and one focused card
                 at a time. All fields remain in this view so the Avalonia port
                 stays testable without platform-specific flyouts. -->
            <Grid x:Name="SettingsPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="{DynamicResource Ui.Auto.692873DDD8F40E66}" FontSize="28" FontWeight="Bold" />
                    <TextBlock x:Name="SettingsStatusText"
                               Text="{DynamicResource Ui.Auto.6426A1A2141ECAD5}"
                               FontSize="12"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,0" RowDefinitions="*,Auto" ColumnDefinitions="168,*" ColumnSpacing="26">
                    <StackPanel Grid.RowSpan="2" Spacing="2">
                        <StackPanel x:Name="SettingsCategoryButtons" Spacing="2">
                            <Button x:Name="SettingsLibraryButton"
                                    Classes="settingsCategory active"
                                    Content="{DynamicResource Ui.Auto.C7FBA69838474F08}"
                                    Tag="Library"
                                    Click="SettingsCategoryButton_Click" />
                            <Button x:Name="SettingsReadingButton"
                                    Classes="settingsCategory"
                                    Content="{DynamicResource Ui.Auto.CE9B12499C471759}"
                                    Tag="Reading"
                                    Click="SettingsCategoryButton_Click" />
                            <Button x:Name="SettingsCalibreButton"
                                    Classes="settingsCategory"
                                    Content="Calibre"
                                    Tag="Calibre"
                                    Click="SettingsCategoryButton_Click" />
                            <Button x:Name="SettingsKindleButton"
                                    Classes="settingsCategory"
                                    Content="Kindle"
                                    Tag="Kindle"
                                    Click="SettingsCategoryButton_Click" />
                            <Button x:Name="SettingsBackupButton"
                                    Classes="settingsCategory"
                                    Content="{DynamicResource Ui.Auto.70E372ABBAE5F619}"
                                    Tag="Backup"
                                    Click="SettingsCategoryButton_Click" />
                            <Button x:Name="SettingsAboutButton"
                                    Classes="settingsCategory"
                                    Content="{DynamicResource Ui.Auto.52D25A9E30BA94F1}"
                                    Tag="About"
                                    Click="SettingsCategoryButton_Click" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Row="0"
                               Grid.Column="1"
                               Width="1"
                               Height="{Binding Bounds.Height, ElementName=SettingsCategoryButtons}"
                               Margin="0,20,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Fill="{StaticResource HairlineBrush}"
                               IsHitTestVisible="False"
                               ZIndex="1" />

                    <ScrollViewer x:Name="SettingsScrollViewer"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                <Border x:Name="SettingsLibrarySection"
                        Classes="flatPanel"
                        BorderThickness="0"
                        IsVisible="False"
                        Padding="18,18,18,32"
                        Background="{StaticResource PaperBrush}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{DynamicResource Ui.Auto.C7FBA69838474F08}" FontSize="18" FontWeight="SemiBold" />
                                    <StackPanel Spacing="15">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{DynamicResource Ui.Auto.098925F827B88E7A}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="NetworkEnabledCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.D7842A57D154C697}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{DynamicResource Ui.Auto.07F4A49C6D9FCA72}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="AutoDoubanMatchCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.4799DAF25FD6C6CC}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{DynamicResource Ui.Auto.55A2226420BCBF78}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="AutoGenerateReaderFormatsCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.8B0CC19DB0791E72}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{DynamicResource Ui.Auto.F6A273284E344858}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="CollectionsMutuallyExclusiveCheck" Grid.Column="1" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{DynamicResource Ui.Auto.2C8CB9CA53BDD3AB}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="CompareKindleLibraryCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.813C2B04E300E455}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{DynamicResource Ui.Auto.DA96E037499D9296}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="GridGalleryDisplayCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.694BA13A98D0252A}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                <Border x:Name="SettingsCalibreSection"
                        Classes="flatPanel"
                        BorderThickness="0"
                        IsVisible="False"
                        Padding="18,18,18,32"
                        Background="{StaticResource PaperBrush}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Calibre" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Ui.Auto.68DBD3556A19C150}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{DynamicResource Ui.Auto.6160F42DABA0438E}" FontSize="12" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                <Ellipse x:Name="CalibreDetectionStatusDot"
                                         Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"
                                         Fill="#D6A100"
                                         ToolTip.Tip="{DynamicResource Ui.Auto.FE66F3C4D3165B5D}"
                                         AutomationProperties.Name="{DynamicResource Ui.Auto.FE66F3C4D3165B5D}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="CalibrePathBox" PlaceholderText="{DynamicResource Ui.Auto.A5D0920936DC7153}" />
                                <Button Grid.Column="1" Content="{DynamicResource Ui.Auto.A8C81F93F2E0E3B6}" Classes="quiet" Click="BrowseCalibreButton_Click" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button x:Name="InstallCalibreButton"
                                        Content="{DynamicResource Ui.Auto.53E06E722B8528B0}"
                                        Classes="quiet"
                                        Click="InstallCalibreButton_Click" />
                                <Button x:Name="InstallKfxInputButton"
                                        Content="{DynamicResource Ui.Auto.E1D76CA786897DA7}"
                                        Classes="quiet"
                                        Click="InstallKfxInputButton_Click" />
                            </StackPanel>
                            <ProgressBar x:Name="CalibreSetupProgressBar"
                                         Height="3"
                                         Minimum="0"
                                         Maximum="100"
                                         IsVisible="False" />
                            <TextBlock x:Name="CalibreSetupStatusText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="SettingsKindleSection"
                        Classes="flatPanel"
                        BorderThickness="0"
                        IsVisible="False"
                        Padding="18"
                        Background="{StaticResource PaperBrush}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Kindle" FontSize="18" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,11,0,0">
                                        <TextBlock Text="{DynamicResource Ui.Auto.272F8ECF4B340534}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="AutoConnectDeviceCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.6EEF43E0AC64D477}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                <Border x:Name="SettingsReadingSection"
                        Classes="flatPanel"
                        BorderThickness="0"
                        IsVisible="False"
                        Padding="18"
                        Background="{StaticResource PaperBrush}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{DynamicResource Ui.Auto.6FA2075CA9C20775}" FontSize="12" Foreground="{StaticResource MutedInkBrush}" />
                                        <ComboBox x:Name="PreferredOpenFormatBox" SelectedIndex="0" MaxWidth="360" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="EPUB" Tag="epub" />
                                            <ComboBoxItem Content="PDF" Tag="pdf" />
                                            <ComboBoxItem Content="AZW3" Tag="azw3" />
                                            <ComboBoxItem Content="{DynamicResource Ui.Auto.F117607AC0E397F4}" Tag="mobi" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{DynamicResource Ui.Auto.E0119B0BA5ACFA0F}" FontSize="13" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="DefaultVerticalWritingCheck" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{DynamicResource Ui.Auto.538FD705CD18A10F}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="AiEnabledCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.0998EF96E5ED903E}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="False">
                                        <TextBlock Text="{DynamicResource Ui.Auto.737AC585CF7AD245}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="ReadingMaterialsCollapsedByDefaultCheck" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                            <Border x:Name="LocalResourcesSettingsSection"
                                    Classes="flatSubsection"
                                    Margin="0,11,0,0"
                                    Padding="0,12,0,0">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{DynamicResource Ui.Auto.DB96383CD775A45D}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource Ui.Auto.8ACD464842C7EACB}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap" />
                                            <ListBox x:Name="ManagedFontList" ItemsSource="{Binding ManagedFonts}" MaxHeight="150" SelectionMode="Single">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="core:ManagedFont">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="{DynamicResource Ui.Auto.50751AA95894C7DB}" Click="ImportFontButton_Click" />
                                                <Button Content="{DynamicResource Ui.Auto.A194128B29390AEF}" Classes="quiet" Click="RemoveFontButton_Click" />
                                                <Button Content="{DynamicResource Ui.Auto.AEE88743413144A2}" Classes="quiet" IsVisible="False" Click="RefreshLocalResourcesButton_Click" />
                                                <TextBlock x:Name="FontManagementStatusText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                            <Border x:Name="DictionaryManagementSection"
                                    Classes="flatSubsection"
                                    Padding="0,12,0,0">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{DynamicResource Ui.Auto.F0486713A9BABBE5}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource Ui.Auto.7C456B8E16853FCF}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap" />
                                            <ListBox x:Name="ManagedDictionaryList" ItemsSource="{Binding ManagedDictionaries}" MaxHeight="150" SelectionMode="Single">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="core:DictionaryDefinition">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="{DynamicResource Ui.Auto.48C0179637D1C190}" Click="ImportDictionaryButton_Click" />
                                                <Button Content="{DynamicResource Ui.Auto.A194128B29390AEF}" Classes="quiet" Click="RemoveDictionaryButton_Click" />
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox x:Name="DictionaryTestBox" PlaceholderText="{DynamicResource Ui.Auto.50C7ED7A45E82B5E}" KeyDown="DictionaryTestBox_KeyDown" />
                                                <Button Grid.Column="1" Content="{DynamicResource Ui.Auto.BCD6771E08EC7CC7}" Classes="quiet" Click="DictionaryTestButton_Click" />
                                            </Grid>
                                            <TextBlock x:Name="DictionaryResultText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                <Border x:Name="SettingsBackupSection"
                        Classes="flatPanel"
                        BorderThickness="0"
                        IsVisible="False"
                        Padding="18"
                        Background="{StaticResource PaperBrush}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{DynamicResource Ui.Auto.4F5B1DE92F8004CA}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Ui.Auto.9DD9F8A0E4DE0220}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Ui.Auto.330BB890965835F9}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{DynamicResource Ui.Auto.E4AD8CC2EC98305C}" FontSize="13" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="AutoBackupCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.D4B94B23423B837F}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                                        <TextBlock Text="{DynamicResource Ui.Auto.E5243ABDEA37FB82}" FontSize="13" VerticalAlignment="Center" />
                                        <NumericUpDown x:Name="AutoBackupRetentionBox" Grid.Column="1" Minimum="1" Maximum="30" Increment="1" Value="5" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{DynamicResource Ui.Auto.E9D3DD690A4E2593}" Click="ExportBackupButton_Click" />
                                        <Button Content="{DynamicResource Ui.Auto.EC217804074AC0BD}" Classes="quiet" Click="ImportBackupButton_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsBackupStatusText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="SettingsAboutSection"
                                        IsVisible="False"
                                        Spacing="16">
                                <Border Classes="flatPanel"
                                        BorderThickness="0"
                                        Padding="18"
                                        Background="{StaticResource PaperBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Auto.0A5C9BAD2BB94FF4}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SettingsDataPathText"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Ui.Auto.70B1291920CFED90}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{DynamicResource Ui.Auto.DA99EA1331DC3046}" Classes="quiet" Click="OpenDataDirectoryButton_Click" />
                                            <Button Content="{DynamicResource Ui.Auto.D10D728410A62401}" Classes="quiet" Click="MigrateDataDirectoryButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="flatPanel"
                                        BorderThickness="0"
                                        Padding="18"
                                        Background="{StaticResource PaperBrush}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{DynamicResource Ui.Auto.52D25A9E30BA94F1}" FontSize="18" FontWeight="SemiBold" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource Ui.Auto.38084D301E3F1A31}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                                        <TextBlock Text="kingstacker" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{DynamicResource Ui.Auto.3D13868593AE4EEB}" FontSize="13" VerticalAlignment="Center" />
                                            <ComboBox x:Name="UiLanguageBox"
                                                      Grid.Column="1"
                                                      Width="180"
                                                      SelectedIndex="0"
                                                      SelectionChanged="UiLanguageBox_SelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource Ui.Auto.9937E365AAF3A085}" Tag="zh-CN" />
                                                <ComboBoxItem Content="English" Tag="en-US" />
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock x:Name="AboutVersionText"
                                                   Text="{DynamicResource Ui.Auto.DC730979055D9FEF}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{DynamicResource Ui.Auto.4A09393CF96D5F86}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="AutoUpdateCheck" Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.Auto.85D1563FE0079783}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock x:Name="AboutUpdateStatusText"
                                                       Text="{DynamicResource Ui.Auto.8642A3F7563F3F16}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button x:Name="CheckForUpdatesButton"
                                                    Grid.Column="1"
                                                    Content="{DynamicResource Ui.Auto.7F68EBAD19BA6BCD}"
                                                    Classes="quiet"
                                                    Click="CheckForUpdatesButton_Click" />
                                        </Grid>
                                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <!-- Minimal black-and-white cat: outline, eyes and nose only. -->
                                                <Grid Width="32" Height="30">
                                                    <Polygon Points="4,11 6,2 13,8" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                                    <Polygon Points="19,8 26,2 28,11" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                                    <Ellipse Margin="3,6,3,1" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                                    <Ellipse Width="2.5" Height="3" Margin="9,14,0,0" Fill="{StaticResource InkBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    <Ellipse Width="2.5" Height="3" Margin="0,14,9,0" Fill="{StaticResource InkBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                    <Polygon Points="14,20 18,20 16,22.5" Fill="{StaticResource InkBrush}" />
                                                </Grid>
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Ui.Auto.EF51FA34002047BB}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="{DynamicResource Ui.Auto.2D1996A469BDAB92}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Width="88"
                                                    Height="88"
                                                    Background="{StaticResource PaperBrush}"
                                                    BorderBrush="{StaticResource InkBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{DynamicResource Ui.Auto.D84ED132DAB019E5}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- The three system-setting forms are separate right-side panes in
                 the reference UI. Keeping them outside the Kindle category
                 preserves the same navigation flow on Avalonia. -->
            <Border x:Name="KindleEmailSettingsPane"
                    Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,50,20,12">
                        <TextBlock Text="{DynamicResource Ui.Auto.5F52884AFBDA326B}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,0" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,14" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Ui.Auto.8609EBA830E79233}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <Button Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Focusable="False"
                                    Click="KindleEmailGuideLink_Click">
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource InkBrush}"
                                           TextDecorations="Underline"
                                           Text="{DynamicResource Ui.Auto.F5C62A45859955BB}" />
                            </Button>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.4B4D02F3724BBD50}" FontSize="11" />
                                <TextBox x:Name="KindleEmailRecipientBox" PlaceholderText="{DynamicResource Ui.Auto.88D320044CFC5366}" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.F4D19C9EF4B8D010}" FontSize="11" />
                                <TextBox x:Name="KindleEmailSenderBox" PlaceholderText="{DynamicResource Ui.Auto.B24BB0C6CC545A3A}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.6A85554C141A6383}" FontSize="11" />
                                    <TextBox x:Name="KindleEmailSmtpHostBox" PlaceholderText="smtp.example.com" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.E71AC32B544B0EBF}" FontSize="11" />
                                    <TextBox x:Name="KindleEmailSmtpPortBox" Text="587" PlaceholderText="587" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.CB6DE497BBC98EBB}" FontSize="11" />
                                <TextBox x:Name="KindleEmailUsernameBox" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.8F6290CB91E90FFB}" FontSize="11" />
                                <TextBox x:Name="KindleEmailPasswordBox" PasswordChar="●" PlaceholderText="{DynamicResource Ui.Auto.8CB9B8C5CF47397A}" />
                            </StackPanel>
                            <CheckBox x:Name="KindleEmailSslCheck" Content="{DynamicResource Ui.Auto.98BFA63342D1FDA2}" IsChecked="True" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="20,12,20,20"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock x:Name="KindleEmailSettingsStatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}" Classes="quiet" Click="KindleEmailSettingsCancelButton_Click" />
                        <Button Grid.Column="2" Content="{DynamicResource Ui.Auto.A3030BF8F16DC63C}" Click="KindleEmailSettingsSaveButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ZLibraryAccountPane"
                    Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,50,20,12">
                        <TextBlock Text="{DynamicResource Ui.Auto.04C7E918A97AA2D2}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,14" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Ui.Auto.643DE2DA68E1AE9F}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.780A8542C562FD78}" FontSize="11" />
                                <TextBox x:Name="ZLibraryEmailBox" PlaceholderText="{DynamicResource Ui.Auto.CDB45C04FD8D14BE}" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.A621AB606DB2A11F}" FontSize="11" />
                                <TextBox x:Name="ZLibraryPasswordBox" PasswordChar="●" PlaceholderText="{DynamicResource Ui.Auto.5A2773913717DBD3}" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.34218E41087E6165}" FontSize="11" />
                                <TextBox x:Name="ZLibraryBaseUrlBox" PlaceholderText="https://api.z-lib.org" />
                                <TextBlock Text="{DynamicResource Ui.Auto.464EB73BC23E797A}"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="20,12,20,20"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock x:Name="ZLibraryAccountStatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}" Classes="quiet" Click="ZLibraryAccountCancelButton_Click" />
                        <Button Grid.Column="2" Content="{DynamicResource Ui.Auto.31C1468A6EA3BBF1}" Click="ZLibraryAccountSaveButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ReaderAiSettingsPane"
                    Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,50,20,12">
                        <TextBlock Text="{DynamicResource Ui.Auto.6F5D72AA32F2C95E}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,14" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Ui.Auto.753CC20E7DA80BB0}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.EC309AB207EF7FA3}" FontSize="11" />
                                <ComboBox x:Name="MainReaderAiProviderBox"
                                          SelectedIndex="0"
                                          SelectionChanged="MainReaderAiProviderBox_SelectionChanged">
                                    <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                    <ComboBoxItem Content="OpenAI" Tag="openai" />
                                    <ComboBoxItem Content="{DynamicResource Ui.Auto.988FB59B290B037D}" Tag="custom" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Base URL" FontSize="11" />
                                <TextBox x:Name="MainReaderAiBaseUrlBox" PlaceholderText="https://api.deepseek.com" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Ui.Auto.C98E118E0A43F078}" FontSize="11" />
                                <TextBox x:Name="MainReaderAiModelBox" PlaceholderText="{DynamicResource Ui.Auto.CB2F1709F983D2F4}" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="API Key" FontSize="11" />
                                <TextBox x:Name="MainReaderAiApiKeyBox" PasswordChar="●" PlaceholderText="{DynamicResource Ui.Auto.CA478C91D3839A44}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Ui.Auto.52DEA0A73AA860E1}"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="20,12,20,20"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock x:Name="MainReaderAiSettingsStatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}" Classes="quiet" Click="MainReaderAiSettingsCancelButton_Click" />
                        <Button Grid.Column="2" Content="{DynamicResource Ui.Auto.A3030BF8F16DC63C}" Click="MainReaderAiSettingsSaveButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Format conversion progress, anchored bottom-right like the
                 WinUI reference. Tapping the card badge restores this popup;
                 tapping the popup background sends it back to the card. -->
            <Border x:Name="BookConversionPopup"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1"
                    IsVisible="False"
                    ZIndex="80"
                    Tapped="BookConversionPopup_Tapped">
                <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="BookConversionPopupTitleText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock x:Name="BookConversionPopupFormatText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <Button x:Name="BookConversionBackgroundButton"
                                    Classes="quiet"
                                    Content="{DynamicResource Ui.Auto.F97DE1B381D60005}"
                                    Padding="8,4"
                                    Click="BookConversionBackgroundButton_Click" />
                            <Button x:Name="BookConversionCancelButton"
                                    Classes="quiet"
                                    Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                    Padding="8,4"
                                    Click="BookConversionCancelButton_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ProgressBar x:Name="BookConversionPopupProgress"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="10"
                                     VerticalAlignment="Center" />
                        <TextBlock x:Name="BookConversionPopupPercentageText"
                                   Grid.Column="1"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   MinWidth="28"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="BookConversionPopupMessageText"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Unified task progress surface for import/backup/douban/email
                 and other long operations, matching the WinUI reference. -->
            <Border x:Name="TaskProgressPopup"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1"
                    IsVisible="False"
                    ZIndex="75"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="9">
                    <TextBlock Text="{DynamicResource Ui.Auto.B341B84A73883BDA}" FontSize="15" FontWeight="SemiBold" />
                    <Border Height="10"
                            Padding="1"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1">
                        <ProgressBar x:Name="TaskProgressPopupBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Background="Transparent"
                                     IsIndeterminate="False" />
                    </Border>
                    <TextBlock x:Name="TaskProgressPopupText"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Transfer toast: the progress surface for Kindle send/export
                 operations. It replaces the generic task popup while active. -->
            <Border x:Name="TransferToast"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1"
                    IsVisible="False"
                    ZIndex="90"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="7">
                    <TextBlock x:Name="TransferToastTitleText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TransferToastMessageText"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="TransferToastProgress"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="5"
                                 Background="{StaticResource PaperBrush}"
                                 IsVisible="False" />
                </StackPanel>
            </Border>

            <!-- Settings feedback capsule: a bottom-center pill for auto-save
                 confirmations ("设置已保存", 1 s) and longer-lived settings
                 notices. It rises into place, then sinks away after a delay;
                 the check glyph only appears for success messages. -->
            <Border x:Name="SettingsSavedCapsule"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,34"
                    Padding="20,9"
                    CornerRadius="999"
                    Background="{StaticResource InkBrush}"
                    BoxShadow="0 6 18 0 #26000000"
                    RenderTransform="translateY(12px)"
                    IsVisible="False"
                    Opacity="0"
                    ZIndex="95"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path x:Name="SettingsCapsuleCheckIcon"
                          Data="M 1,5.5 L 4.5,9 L 11,1.5"
                          Stroke="{StaticResource PaperBrush}"
                          StrokeThickness="2"
                          Width="12"
                          Height="11"
                          Stretch="None"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="SettingsSavedCapsuleText"
                               Foreground="{StaticResource PaperBrush}"
                               FontSize="12"
                               MaxWidth="460"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Device connection confirmation from the WinUI reference. Keep
                 this separate from destructive confirmations so the two
                 actions retain their original labels and keyboard behavior. -->
            <Grid x:Name="DevicePromptOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100"
                  Focusable="True"
                  KeyDown="DevicePromptOverlay_KeyDown">
                <Border Width="560"
                        MaxWidth="560"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10"
                                           Height="24"
                                           Margin="0,-2,0,0"
                                           Fill="{StaticResource InkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DevicePromptTitleText"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DevicePromptMessageText"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="28,18,28,22"
                              Background="{StaticResource PaperBrush}"
                              ColumnDefinitions="*,12,*">
                            <Button x:Name="DevicePromptPrimaryButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DevicePromptPrimaryButton_Click" />
                            <Button x:Name="DevicePromptCancelButton"
                                    Grid.Column="2"
                                    Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                    Classes="quiet"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DevicePromptCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Confirmation overlay -->
            <Grid x:Name="ConfirmationOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="430"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ConfirmationTitleText" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="ConfirmationMessageText" TextWrapping="Wrap" Foreground="#555555" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7" Margin="0,8,0,0">
                            <Button Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}" Padding="13,7" Click="ConfirmationCancelButton_Click" />
                            <Button x:Name="ConfirmationOkButton" Content="{DynamicResource Ui.Auto.A3EA3C17B401BD2F}" Padding="13,7" Click="ConfirmationOkButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Collection-name overlay -->
            <Grid x:Name="CollectionNameOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="101">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="430"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Ui.Auto.FDF0B569D820ADE8}" FontSize="18" FontWeight="Bold" />
                        <TextBox x:Name="CollectionNameBox" PlaceholderText="{DynamicResource Ui.Auto.B161B3F76A603FB9}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7" Margin="0,8,0,0">
                            <Button Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}" Padding="13,7" Click="CollectionNameCancelButton_Click" />
                            <Button Content="{DynamicResource Ui.Auto.CDE2CD071D25BBAB}" Padding="13,7" Click="CollectionNameOkButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Device model editor opened from the lower-left Kindle card. -->
            <Grid x:Name="DeviceModelInputOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100">
                <Border Width="560"
                        MaxWidth="560"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10"
                                           Height="24"
                                           Margin="0,-2,0,0"
                                           Fill="{StaticResource InkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DeviceModelInputTitleText"
                                           Text="{DynamicResource Ui.Auto.D1ECEBCCE6DFA757}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceModelInputMessageText"
                                       Text="{DynamicResource Ui.Auto.1FB528C81918B9CC}"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                            <TextBox x:Name="DeviceModelInputBox"
                                     FontSize="15"
                                     Padding="10,7"
                                     MaxLength="80"
                                     PlaceholderText="{DynamicResource Ui.Auto.3056B0365B9EBEC8}"
                                     KeyDown="DeviceModelInputBox_KeyDown" />
                            <TextBlock x:Name="DeviceModelInputStatusText"
                                       IsVisible="False"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="28,18,28,22"
                              Background="{StaticResource PaperBrush}"
                              ColumnDefinitions="*,12,*">
                            <Button x:Name="DeviceModelInputOkButton"
                                    Content="{DynamicResource Ui.Auto.FAC2A67AD87807C4}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DeviceModelInputOkButton_Click" />
                            <Button Grid.Column="2"
                                    Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                    Classes="quiet"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DeviceModelInputCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Douban candidate picker: keep the old version's explicit
                 choice instead of silently applying the first search hit. -->
            <Grid x:Name="DoubanCandidateOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="102">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="760"
                        MaxHeight="680"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                        <TextBlock Text="{DynamicResource Ui.Auto.70CB42E21940694F}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1"
                                   Text="{DynamicResource Ui.Auto.E5327DA0211C4F19}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="DoubanSearchBox"
                                     PlaceholderText="{DynamicResource Ui.Auto.DFFE0AC3F6015D93}"
                                     KeyDown="DoubanSearchBox_KeyDown" />
                            <Button x:Name="DoubanResearchButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource Ui.Auto.44CE7AE909BBB28B}"
                                    MinWidth="72"
                                    Padding="13,7"
                                    Click="DoubanResearchButton_Click" />
                        </Grid>
                        <ListBox x:Name="DoubanCandidateList"
                                 Grid.Row="3"
                                 ItemsSource="{Binding DoubanCandidates}"
                                 SelectionChanged="DoubanCandidateList_SelectionChanged"
                                 DoubleTapped="DoubanCandidateList_DoubleTapped"
                                 Background="Transparent"
                                 BorderBrush="{StaticResource HairlineBrush}"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:DoubanCandidateViewModel">
                                    <Border Padding="12,10"
                                            Margin="0,0,0,8"
                                            Background="{StaticResource PaperBrush}"
                                            BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="14">
                                            <Border Width="68"
                                                    Height="96"
                                                    Background="#E4E4E4"
                                                    BorderBrush="{StaticResource HairlineBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="BOOK"
                                                               FontSize="9"
                                                               Foreground="{StaticResource MutedInkBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           MaxLines="2"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Abstract}"
                                                           FontSize="11"
                                                           Foreground="#505050"
                                                           MaxLines="3"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SubjectText}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    MinWidth="92"
                                                    Padding="9,6"
                                                    Background="{StaticResource InkBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RatingText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource PaperBrush}"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <Button Grid.Column="1"
                                    Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                    Classes="quiet"
                                    MinWidth="72"
                                    Padding="13,7"
                                    Click="DoubanCandidateCancelButton_Click" />
                            <Button x:Name="DoubanCandidateSourceButton"
                                    Grid.Column="2"
                                    Content="{DynamicResource Ui.Auto.EEA44F68ED6CD8BF}"
                                    Classes="quiet"
                                    MinWidth="116"
                                    Padding="13,7"
                                    IsEnabled="False"
                                    Click="DoubanCandidateSourceButton_Click" />
                            <Button x:Name="DoubanCandidateApplyButton"
                                    Grid.Column="3"
                                    Content="{DynamicResource Ui.Auto.A748CC074F78DE00}"
                                    MinWidth="92"
                                    Padding="13,7"
                                    IsEnabled="False"
                                    Click="DoubanCandidateApplyButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Douban metadata preview: shows the fetched details and lets the
                 user choose which fields are written back, with a back button
                 to return to the candidate list (WinUI reference flow). -->
            <Grid x:Name="DoubanPreviewOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="102"
                  Focusable="True"
                  KeyDown="DoubanPreviewOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="720"
                        MaxHeight="660"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10"
                                       Height="24"
                                       Fill="{StaticResource InkBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Ui.Auto.FC131B57EB71A076}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{DynamicResource Ui.Auto.01E2B52FC5974BB9}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Grid.Row="2" ColumnDefinitions="104,*" ColumnSpacing="14" Margin="0,4,0,2">
                            <Border Width="96" Height="132" HorizontalAlignment="Left" Background="#E4E4E4" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="BOOK"
                                               FontSize="9"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image x:Name="DoubanPreviewCoverImage" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Column="1" MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="DoubanPreviewSummaryText"
                                           FontSize="12"
                                           LineHeight="20"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      BorderBrush="{StaticResource HairlineBrush}"
                                      BorderThickness="1"
                                      Padding="12,8">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="DoubanUpdateTitleCheck" Content="{DynamicResource Ui.Auto.7E1BB8CB2E864B77}" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateAuthorsCheck" Content="{DynamicResource Ui.Auto.D5BAD65FDC48569A}" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateSeriesCheck" Content="{DynamicResource Ui.Auto.D9100FAC799FD371}" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateDescriptionCheck" Content="{DynamicResource Ui.Auto.1FFF8D91DB541377}" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdatePublicationCheck" Content="{DynamicResource Ui.Auto.F44DC9D32AA88EB1}" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateCoverCheck" Content="{DynamicResource Ui.Auto.A050FE75C024404B}" FontSize="13" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                            <TextBlock x:Name="DoubanPreviewStatusText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="DoubanPreviewSourceButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource Ui.Auto.EEA44F68ED6CD8BF}"
                                    Classes="quiet"
                                    Padding="13,7"
                                    Click="DoubanPreviewSourceButton_Click" />
                            <Button x:Name="DoubanPreviewBackButton"
                                    Grid.Column="2"
                                    Content="{DynamicResource Ui.Auto.B062EE4E5C2C9E1B}"
                                    Classes="quiet"
                                    Padding="13,7"
                                    Click="DoubanPreviewBackButton_Click" />
                            <Button x:Name="DoubanPreviewApplyButton"
                                    Grid.Column="3"
                                    Content="{DynamicResource Ui.Auto.2326E4996E2C8C85}"
                                    Padding="13,7"
                                    Click="DoubanPreviewApplyButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ImportFormatSelectionOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="105"
                  Focusable="True"
                  KeyDown="ImportFormatSelectionOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="620"
                        MaxHeight="650"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10" Height="24" Fill="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Ui.Auto.038105A4C83EB5F0}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ImportFormatSelectionSummaryText" FontSize="14" TextWrapping="Wrap" />
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ImportFormatSelectionList" Spacing="10" />
                            </ScrollViewer>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="28,18,28,22" ColumnDefinitions="*,12,*">
                            <Button Content="{DynamicResource Ui.Auto.576D81BB0631B165}" HorizontalAlignment="Stretch" Click="ImportFormatSelectionPrimaryButton_Click" />
                            <Button Grid.Column="2" Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}" Classes="quiet" HorizontalAlignment="Stretch" Click="ImportFormatSelectionCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
        <!-- Stage 4: the EPUB reader surface. Two native webview hosts
             stay attached so the next chapter can be prepared offscreen.
             Layout mirrors the WinUI reference: three fixed columns
             (TOC 286 / content * / assistant 360), a 52-DIP header bar and
             50-DIP footer bar inside the content column, and a six-row TOC
             panel ending in the full-width 返回书架 button. -->
        <Grid x:Name="ReaderRoot"
              Classes="readerShell"
              Grid.Row="0"
              Grid.ColumnSpan="3"
              IsVisible="False"
              Margin="0"
              ZIndex="40"
              Background="{StaticResource PaperBrush}"
              PointerMoved="ReaderRoot_PointerMoved">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Opaque transition cover used when leaving zen mode: the reader
                 pane sits above the library, so fading the pane itself would
                 reveal the bookshelf behind it. This cover hides the layout
                 restore/window resize instead and is faded away afterwards. -->
            <Border x:Name="ReaderTransitionCover"
                    Grid.ColumnSpan="3"
                    Background="{StaticResource PaperBrush}"
                    Opacity="0"
                    IsHitTestVisible="False"
                    ZIndex="200" />

            <!-- Table of contents and reading progress. -->
            <Border x:Name="ReaderTocPanel"
                    Grid.Column="0"
                    Margin="0,38,0,0"
                    Background="#FFFFFF"
                    ZIndex="10">
                <Border.Resources>
                    <!-- Softer, quieter scrollbar for the TOC so the side
                         panel stays out of the reading flow (WinUI values). -->
                    <SolidColorBrush x:Key="KkindleScrollBarBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="KkindleScrollBarExpandedBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="KkindleScrollBarBorderBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbBrush" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbPointerOverBrush" Color="#B4B4B0" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbPressedBrush" Color="#A4A4A0" />
                    <SolidColorBrush x:Key="KkindleScrollBarThumbDisabledBrush" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#777777" />
                </Border.Resources>
                <Grid RowDefinitions="52,Auto,Auto,*,Auto,50">
                    <!-- Start the divider below the shared header rule. Keep it
                         above search content so it remains continuous. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="5"
                               Width="1"
                               HorizontalAlignment="Right"
                               Fill="#EEEEEA"
                               IsHitTestVisible="False"
                               ZIndex="100" />

                    <Border Padding="14,8"
                            BorderBrush="#EEEEEA"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                            <TextBlock x:Name="ReaderBookInfoText"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        <Button x:Name="ReaderTocMinimalToggleButton"
                                Grid.Column="1"
                                Classes="icon"
                                Width="38"
                                MinWidth="38"
                                Height="34"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.0474752B788B123E}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.0474752B788B123E}"
                                Click="ReaderTocMinimalToggleButton_Click">
                            <Path Width="13"
                                  Height="13"
                                  Data="M 1.5,1.5 H 11.5 V 11.5 H 1.5 Z M 3.2,4 H 9.8 M 3.2,6.5 H 9.8 M 3.2,9 H 9.8"
                                  Stroke="#242424"
                                  StrokeThickness="0.85"
                                  StrokeLineCap="Square"
                                  StrokeJoin="Miter"
                                  IsHitTestVisible="False" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="icon"
                                Width="38"
                                MinWidth="38"
                                Height="34"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.47C91FADCC3E4775}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.47C91FADCC3E4775}"
                                Click="ReaderTocButton_Click">
                            <Path Width="12"
                                  Height="12"
                                  Data="M 3,1.5 L 9,6 L 3,10.5"
                                  Stroke="#242424"
                                  StrokeThickness="0.85"
                                  StrokeLineCap="Square"
                                  StrokeJoin="Miter"
                                  IsHitTestVisible="False" />
                        </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid x:Name="ReaderTocView">
                            <ListBox x:Name="ReaderTocList"
                                     Classes="readerTocList"
                                     Background="#FFFFFF"
                                     AttachedToVisualTree="ReaderTocList_AttachedToVisualTree"
                                     TemplateApplied="ReaderTocList_TemplateApplied"
                                     SelectionChanged="ReaderTocList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="infra:EpubReaderNavigationItem">
                                        <Grid ColumnDefinitions="3,*">
                                            <Rectangle Fill="#5E5E5E"
                                                       IsVisible="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="13,9,11,9"
                                                       Text="{Binding Title}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ReaderTocEmptyText"
                                       Margin="20"
                                       Text="{DynamicResource Ui.Auto.A37165A983502AE5}"
                                       FontSize="12"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="False" />
                        </Grid>

                        <Grid x:Name="ReaderBookmarkPane"
                              Background="#FFFFFF"
                              IsVisible="False">
                            <ListBox x:Name="ReaderBookmarkList"
                                     Classes="readerTocList"
                                     Background="#FFFFFF"
                                     ItemsSource="{Binding ReaderBookmarks}"
                                     SelectionMode="Single"
                                     SelectionChanged="ReaderBookmarkList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:ReaderBookmark">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                            <StackPanel Grid.Column="0" Margin="12,7,4,7" Spacing="3">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34" />
                                                <TextBlock Text="{Binding DisplayQuote}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34" />
                                                <TextBlock Text="{Binding DisplayTime}"
                                                           FontSize="9" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="icon"
                                                    Width="28"
                                                    MinWidth="28"
                                                    Height="28"
                                                    Margin="0,0,6,0"
                                                    Content="×"
                                                    Tag="{Binding}"
                                                    Click="ReaderBookmarkDeleteButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ReaderBookmarkEmptyText"
                                       Margin="20"
                                       Text="{DynamicResource Ui.Auto.F0389D3DDD00BD1D}"
                                       FontSize="12"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Whole-book search reuses the normal TOC surface. -->
                        <Grid x:Name="ReaderSearchPanel" IsVisible="False">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <TextBox x:Name="ReaderTocSearchBox"
                                         Margin="14,4,14,10"
                                         Height="34"
                                         Padding="10,5"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="{DynamicResource Ui.Auto.64295B76D26336F3}"
                                         TextChanged="ReaderTocSearchBox_TextChanged" />
                                <TextBlock x:Name="ReaderWholeSearchCountText"
                                           Grid.Row="1"
                                           Margin="14,0,14,8"
                                           FontSize="10"
                                           Foreground="#5E5E5E" />
                                <Grid Grid.Row="2">
                                    <ScrollViewer Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ReaderSearchResultList"
                                                      ItemsSource="{Binding ReaderSearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ReaderSearchResultViewModel">
                                                    <Button Classes="readerSearchResult"
                                                            Margin="0,0,14,6"
                                                            Padding="0"
                                                            BorderBrush="{Binding ResultBorderBrush}"
                                                            BorderThickness="{Binding ResultBorderThickness}"
                                                            Background="#FFFFFF"
                                                            Tag="{Binding}"
                                                            Click="ReaderSearchResultButton_Click">
                                                        <Border Padding="14,9,14,9">
                                                            <StackPanel Spacing="3"
                                                                        HorizontalAlignment="Stretch">
                                                            <local:ReaderSearchHighlightTextBlock Source="{Binding Title}"
                                                                                                  Query="{Binding Query}"
                                                                                                  FontSize="12"
                                                                                                  FontWeight="SemiBold"
                                                                                                  TextWrapping="Wrap"
                                                                                                  TextTrimming="CharacterEllipsis"
                                                                                                  MaxLines="2" />
                                                            <local:ReaderSearchHighlightTextBlock Source="{Binding Excerpt}"
                                                                                                  Query="{Binding Query}"
                                                                                                  HighlightRanges="{Binding ExcerptHighlightRanges}"
                                                                                                  FontSize="10"
                                                                                                  LineHeight="15"
                                                                                                  TextWrapping="Wrap"
                                                                                                  TextTrimming="CharacterEllipsis"
                                                                                                  MaxLines="4" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="ReaderSearchStatusText"
                                               Margin="20"
                                               Text="{DynamicResource Ui.Auto.2B1CF18C033FE28A}"
                                               TextAlignment="Center"
                                               FontSize="11"
                                               Foreground="#5E5E5E"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="ReaderReadingInfoPanel"
                                Grid.Row="4"
                                Margin="14,4,14,8"
                                Spacing="2">
                        <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                            <TextBlock x:Name="ReaderReadingProgressText"
                                       Text="{DynamicResource Ui.Auto.1E2EEF3DABC2ECB5}"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="ReaderProgressPercentText"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock x:Name="ReaderStatsText"
                                   FontSize="10"
                                   Foreground="#5E5E5E"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="5"
                            BorderBrush="#E2E2DE"
                            BorderThickness="1"
                            CornerRadius="0">
                        <Button Content="{DynamicResource Ui.Auto.A51CE8191584FCF7}"
                                Margin="0"
                                Height="48"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                Classes="readerToolbar"
                                Click="CloseReaderButton_Click" />
                    </Border>
                </Grid>
            </Border>

            <!-- Minimal TOC rail (极简目录): a 52-DIP marker rail that keeps the
                 chapter map visible without taking the reading column away. -->
            <Border x:Name="ReaderTocCompactPanel"
                    Grid.Column="0"
                    Width="52"
                    Margin="0,38,0,0"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="#D8D8D4"
                    BorderThickness="0,0,1,0"
                    ZIndex="10"
                    Loaded="ReaderTocCompactPanel_Loaded"
                    IsVisible="False">
                <Grid RowDefinitions="52,*,50">
                    <Grid Grid.Row="0"
                          Width="28"
                          HorizontalAlignment="Center"
                          RowDefinitions="34,18">
                        <Button x:Name="ReaderTocCompactExpandButton"
                                Grid.Row="0"
                                Classes="icon"
                                Width="28"
                                MinWidth="28"
                                Height="34"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.EDCDBACEBE531DBF}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.EDCDBACEBE531DBF}"
                                Click="ReaderTocCompactExpandButton_Click">
                            <Path Width="13"
                                  Height="13"
                                  Data="M 1.5,1.5 H 11.5 V 11.5 H 1.5 Z M 3.2,4 H 9.8 M 3.2,6.5 H 9.8 M 3.2,9 H 9.8"
                                  Stroke="#242424"
                                  StrokeThickness="0.85"
                                  StrokeLineCap="Square"
                                  StrokeJoin="Miter"
                                  IsHitTestVisible="False" />
                        </Button>
                        <TextBlock x:Name="ReaderTocCompactUpIndicator"
                                   Grid.Row="1"
                                   Text="△"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer x:Name="ReaderTocCompactScrollViewer"
                                  Grid.Row="1"
                                  HorizontalContentAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="0,8"
                                  ScrollChanged="ReaderTocCompactScrollViewer_ScrollChanged"
                                  PointerMoved="ReaderTocCompactScrollViewer_PointerMoved"
                                  PointerExited="ReaderTocCompactScrollViewer_PointerExited"
                                  PointerWheelChanged="ReaderTocCompactScrollViewer_PointerWheelChanged">
                        <ItemsControl x:Name="ReaderTocCompactList"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ReaderTocMarker">
                                    <Button Width="50"
                                            Height="10"
                                            MinWidth="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="{Binding Title}"
                                            IsTabStop="False">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalContentAlignment="Center"
                                                                  VerticalContentAlignment="Center" />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Border Width="8"
                                                Height="2"
                                                Background="{Binding Fill}"
                                                BorderThickness="0"
                                                IsHitTestVisible="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="ReaderTocCompactDownIndicator"
                               Grid.Row="2"
                               Text="▽"
                               FontFamily="Segoe UI Symbol"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Reading canvas and compact controls. -->
            <Grid x:Name="ReaderContentPanel"
                  Grid.Column="1"
                  Margin="0,38,0,0"
                  Background="{StaticResource PaperBrush}"
                  ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Border x:Name="ReaderHeaderBar"
                        BorderBrush="#E2E2DE"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="ReaderTocToggleButton"
                                    Classes="readerHeader"
                                    Content="{DynamicResource Ui.Auto.ECDD3E4A16F4CD30}"
                                    Width="64"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.741925AF773FDAE3}"
                                    Click="ReaderTocButton_Click" />
                            <Button x:Name="ReaderSearchToolbarButton"
                                    Classes="readerHeader"
                                    Content="{DynamicResource Ui.Auto.44CE7AE909BBB28B}"
                                    AutomationProperties.Name="{DynamicResource Ui.Auto.D40E1B4E4A622EB2}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.43A641217D7F134F}"
                                    Click="ReaderSearchToolbarButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ReaderStatusText"
                                   Grid.Column="1"
                                   Margin="4,0"
                                   FontSize="10"
                                   Foreground="#858585"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <ScrollViewer Grid.Column="2"
                                      MaxWidth="920"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Button x:Name="ReaderZoomOutButton"
                                        Classes="readerHeaderIcon"
                                        Content="A−"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.F9A21B596D67D9C4}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.F9A21B596D67D9C4}"
                                        Click="ReaderDecreaseFontButton_Click" />
                                <TextBlock x:Name="ReaderZoomText"
                                           Width="44"
                                           Text="100%"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ReaderZoomInButton"
                                        Classes="readerHeaderIcon"
                                        Content="A+"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.8B247B82F012C614}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.8B247B82F012C614}"
                                        Click="ReaderIncreaseFontButton_Click" />
                                <Rectangle Width="1" Height="20" Margin="12,0" Fill="#E2E2DE" VerticalAlignment="Center" />
                                <Button x:Name="ReaderFlowButton"
                                        Classes="readerHeader"
                                        Content="{DynamicResource Ui.Auto.5E23EC6A300DC60A}"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.12856C8BCE9C08EF}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.0498D4E5A749540F}">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem x:Name="ReaderScrollModeItem"
                                                      Header="{DynamicResource Ui.Auto.34DEDAFFD3CC55F0}"
                                                      ToggleType="Radio"
                                                      IsChecked="True"
                                                      Tag="scroll"
                                                      Click="ReaderFlowModeItem_Click" />
                                            <MenuItem x:Name="ReaderSinglePageModeItem"
                                                      Header="{DynamicResource Ui.Auto.5407E215AEF82C28}"
                                                      ToggleType="Radio"
                                                      Tag="single"
                                                      Click="ReaderFlowModeItem_Click" />
                                            <MenuItem x:Name="ReaderTwoPageModeItem"
                                                      Header="{DynamicResource Ui.Auto.8F1387BE20D72938}"
                                                      ToggleType="Radio"
                                                      Tag="double"
                                                      Click="ReaderFlowModeItem_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="ReaderMoreButton"
                                        Classes="readerHeader"
                                        Content="{DynamicResource Ui.Auto.38844B135CF70DFC}"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.863C2A1656503DF6}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.863C2A1656503DF6}">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem x:Name="ReaderZenMenuItem"
                                                      Header="{DynamicResource Ui.Auto.DA97EC360354D5D9}"
                                                      ToggleType="CheckBox"
                                                      ToolTip.Tip="{DynamicResource Ui.Auto.1DD7FE5E8D54B499}"
                                                      Click="ReaderZenMenuItem_Click" />
                                            <MenuItem Header="{DynamicResource Ui.Auto.77AC05AA34080C2C}"
                                                      ToolTip.Tip="{DynamicResource Ui.Auto.08C4E230A0A0C905}"
                                                      Click="ReaderLayoutSettingsMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Ui.Auto.CFC1C4D46546AA1B}">
                                                <MenuItem x:Name="ReaderAnimationNoneItem"
                                                          Header="{DynamicResource Ui.Auto.75C526D48AF0482C}"
                                                          ToggleType="Radio"
                                                          Tag="none"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationFadeItem"
                                                          Header="{DynamicResource Ui.Auto.CB8E98402CFBCDF5}"
                                                          ToggleType="Radio"
                                                          IsChecked="True"
                                                          Tag="fade"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationSlideItem"
                                                          Header="{DynamicResource Ui.Auto.453D08190DDC92EB}"
                                                          ToggleType="Radio"
                                                          Tag="slide"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationWaveItem"
                                                          Header="{DynamicResource Ui.Auto.365742C670872BDF}"
                                                          ToggleType="Radio"
                                                          Tag="wave"
                                                          Click="ReaderAnimationItem_Click" />
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="ReaderBookmarkButton"
                                        Classes="readerHeader"
                                        Content="{DynamicResource Ui.Auto.65479E3E408A6E35}"
                                        AutomationProperties.Name="{DynamicResource Ui.Auto.3FF66E53453FEC82}"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.3FF66E53453FEC82}"
                                        Click="ReaderBookmarkButton_Click" />
                                <Rectangle Width="1" Height="20" Margin="12,0" Fill="#E2E2DE" VerticalAlignment="Center" />
                                <Button x:Name="ReaderAssistantToggleButton"
                                        Classes="readerHeader"
                                        Content="{DynamicResource Ui.Auto.11FB682BE0A0233D}"
                                        ToolTip.Tip="{DynamicResource Ui.Auto.90298AE01BB88F61}"
                                        Click="ReaderAssistantToggleButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="{StaticResource PaperBrush}">
                    <Grid x:Name="ReaderWebViewHost"
                          Margin="0,12,2,10"
                          Background="{StaticResource PaperBrush}"
                          SizeChanged="ReaderWebViewHost_SizeChanged">
                        <ContentControl x:Name="ReaderActiveHostSlot"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                        <ContentControl x:Name="ReaderPreloadHostSlot"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                        <!-- Native page-turn transition overlay for the
                             self-drawn reader surface. The captured old-page
                             snapshot sits above the live content while fade,
                             slide or e-ink wave animations reveal the new
                             page; the band/edge rectangles are driven by
                             ReaderTransitionPlayer. -->
                        <Panel x:Name="ReaderNativeTransitionLayer"
                               IsHitTestVisible="False"
                               ClipToBounds="True"
                               ZIndex="25">
                            <Image x:Name="ReaderNativeTransitionGhost"
                                   IsHitTestVisible="False"
                                   IsVisible="False" />
                            <Image x:Name="ReaderNativeTransitionSnapshot"
                                   IsHitTestVisible="False"
                                   IsVisible="False" />
                            <Rectangle x:Name="ReaderNativeTransitionTrail"
                                       IsHitTestVisible="False"
                                       IsVisible="False" />
                            <Rectangle x:Name="ReaderNativeTransitionFront"
                                       IsHitTestVisible="False"
                                       IsVisible="False" />
                            <Rectangle x:Name="ReaderNativeTransitionEdge"
                                       IsHitTestVisible="False"
                                       IsVisible="False"
                                       Fill="#22000000" />
                        </Panel>
                        <!-- Chapter-switch hold layer: freezes the outgoing page
                             bitmap above the webview while the next chapter is
                             loading and configuring, so the reader never shows
                             the blank navigation gap. -->
                        <Border x:Name="ReaderChapterHoldLayer"
                                Background="{StaticResource PaperBrush}"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                ZIndex="30">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.18" />
                                </Transitions>
                            </Border.Transitions>
                            <Image x:Name="ReaderChapterHoldImage" Stretch="Fill" />
                        </Border>
                    </Grid>

                    <Border x:Name="ReaderLinuxTextFallbackOverlay"
                            Margin="0,12,2,10"
                            Background="{StaticResource PaperBrush}"
                            ClipToBounds="True"
                            IsVisible="False"
                            Focusable="True"
                            Tapped="ReaderLinuxTextFallback_Tapped"
                            PointerMoved="ReaderLinuxTextFallback_PointerMoved"
                            PointerWheelChanged="ReaderLinuxTextFallback_PointerWheelChanged"
                            KeyDown="ReaderLinuxTextFallback_KeyDown"
                            ZIndex="25">
                        <Grid x:Name="ReaderLinuxTextFallbackContent">
                            <ScrollViewer x:Name="ReaderLinuxTextFallbackScroll"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="24,18"
                                          ScrollChanged="ReaderLinuxTextFallbackScroll_ScrollChanged">
                                <StackPanel Spacing="0">
                                    <SelectableTextBlock x:Name="ReaderLinuxTextFallbackText"
                                                        IsVisible="False" />
                                    <ItemsControl ItemsSource="{Binding ReaderLinuxTextFallbackBlocks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="{Binding DisplayMargin}">
                                                    <Grid>
                                                        <local:ReaderLinuxTextFallbackTextBlock Block="{Binding}"
                                                                                                  IsVisible="{Binding IsText}"
                                                                                                  FontFamily="{StaticResource DefaultAppFontFamily}"
                                                                                                  FontSize="{Binding FontSize}"
                                                                                                  LineHeight="{Binding LineHeight}"
                                                                                                  MaxWidth="{Binding MaxWidth}"
                                                                                                  Width="{Binding Width}"
                                                                                                  Foreground="{StaticResource InkBrush}"
                                                                                                  SelectionBrush="#C9C9C9"
                                                                                                  AnnotationRanges="{Binding AnnotationRanges}"
                                                                                                  InvertedSelectionBackground="{StaticResource InkBrush}"
                                                                                                  InvertedSelectionForeground="{StaticResource PaperBrush}"
                                                                                                  TextWrapping="Wrap"
                                                                                                  HorizontalAlignment="Center"
                                                                                                  PointerReleased="ReaderLinuxTextFallback_ContentPointerReleased"
                                                                                                  FootnotePointerEntered="ReaderLinuxTextFallbackFootnoteButton_PointerEntered"
                                                                                                  FootnotePointerExited="ReaderLinuxTextFallbackFootnoteButton_PointerExited" />
                                                        <Image Source="{Binding Image.Source}"
                                                               IsVisible="{Binding IsImage}"
                                                               MaxWidth="{Binding Image.MaxWidth}"
                                                               MaxHeight="{Binding Image.MaxHeight}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="ReaderLinuxTextFallbackPagedRoot"
                                    IsVisible="False"
                                    Padding="24">
                                <Grid x:Name="ReaderLinuxTextFallbackPagedContent"
                                      ColumnDefinitions="*,28,*">
                                    <Image x:Name="ReaderLinuxTextFallbackPageImageLeft"
                                           Grid.Column="0"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="False" />
                                    <local:ReaderLinuxTextFallbackTextBlock x:Name="ReaderLinuxTextFallbackPageLeft"
                                                        Grid.Column="0"
                                                        FontFamily="{StaticResource DefaultAppFontFamily}"
                                                        Foreground="{StaticResource InkBrush}"
                                                        SelectionBrush="#C9C9C9"
                                                        InvertedSelectionBackground="{StaticResource InkBrush}"
                                                        InvertedSelectionForeground="{StaticResource PaperBrush}"
                                                        TextAlignment="Left"
                                                        TextWrapping="Wrap"
                                                        HorizontalAlignment="Stretch"
                                                        PointerReleased="ReaderLinuxTextFallback_ContentPointerReleased" />
                                    <Button x:Name="ReaderLinuxTextFallbackPageFootnoteLeft"
                                            Grid.Column="0"
                                            Classes="readerFootnoteMarker"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="False"
                                            PointerEntered="ReaderLinuxTextFallbackFootnoteButton_PointerEntered"
                                            PointerExited="ReaderLinuxTextFallbackFootnoteButton_PointerExited" />
                                    <Image x:Name="ReaderLinuxTextFallbackPageImageRight"
                                           Grid.Column="2"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="False" />
                                    <local:ReaderLinuxTextFallbackTextBlock x:Name="ReaderLinuxTextFallbackPageRight"
                                                        Grid.Column="2"
                                                        FontFamily="{StaticResource DefaultAppFontFamily}"
                                                        Foreground="{StaticResource InkBrush}"
                                                        SelectionBrush="#C9C9C9"
                                                        InvertedSelectionBackground="{StaticResource InkBrush}"
                                                        InvertedSelectionForeground="{StaticResource PaperBrush}"
                                                        TextAlignment="Left"
                                                        TextWrapping="Wrap"
                                                        HorizontalAlignment="Stretch"
                                                        IsVisible="False"
                                                        PointerReleased="ReaderLinuxTextFallback_ContentPointerReleased" />
                                    <Button x:Name="ReaderLinuxTextFallbackPageFootnoteRight"
                                            Grid.Column="2"
                                            Classes="readerFootnoteMarker"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="False"
                                            PointerEntered="ReaderLinuxTextFallbackFootnoteButton_PointerEntered"
                                            PointerExited="ReaderLinuxTextFallbackFootnoteButton_PointerExited" />
                                    <!-- Vertical writing renders through a custom
                                         drawing surface: Avalonia's text stack has no
                                         vertical layout. Single page only — the
                                         layout defaults force vertical into paged
                                         single-page mode on every platform. -->
                                    <local:ReaderLinuxTextFallbackVerticalPage x:Name="ReaderLinuxTextFallbackPageVertical"
                                                        Grid.Column="0"
                                                        FontFamily="{StaticResource DefaultAppFontFamily}"
                                                        Foreground="{StaticResource InkBrush}"
                                                        InvertedSelectionBackground="{StaticResource InkBrush}"
                                                        InvertedSelectionForeground="{StaticResource PaperBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="False" />
                                </Grid>
                            </Border>
                            <!-- Native page-turn transition overlay for the
                                 fallback reader. The captured old-page snapshot
                                 sits above the live content while fade, slide or
                                 e-ink wave animations reveal the new page; the
                                 band/edge rectangles are driven by
                                 ReaderTransitionPlayer. -->
                            <Panel x:Name="ReaderLinuxTextFallbackTransitionLayer"
                                   IsVisible="True"
                                   IsHitTestVisible="False"
                                   ClipToBounds="True">
                                <Image x:Name="ReaderLinuxTextFallbackTransitionGhost"
                                       IsHitTestVisible="False"
                                       IsVisible="False" />
                                <Image x:Name="ReaderLinuxTextFallbackTransitionSnapshot"
                                       IsHitTestVisible="False"
                                       IsVisible="False" />
                                <Rectangle x:Name="ReaderLinuxTextFallbackTransitionTrail"
                                           IsHitTestVisible="False"
                                           IsVisible="False" />
                                <Rectangle x:Name="ReaderLinuxTextFallbackTransitionFront"
                                           IsHitTestVisible="False"
                                           IsVisible="False" />
                                <Rectangle x:Name="ReaderLinuxTextFallbackTransitionEdge"
                                           IsHitTestVisible="False"
                                           IsVisible="False"
                                           Fill="#22000000" />
                            </Panel>
                        </Grid>
                    </Border>

                    <!-- Native webviews paint over child Avalonia content. Keep
                         these decorations as later siblings so they render on
                         top of the active reading surface, matching WinUI. -->
                    <Border x:Name="ReaderWebViewBottomCover"
                            Height="2"
                            Margin="0,0,0,10"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource PaperBrush}"
                            IsHitTestVisible="False"
                            ZIndex="30" />
                    <Border x:Name="ReaderBookmarkCornerButton"
                            Width="34"
                            Height="34"
                            Margin="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ZIndex="40"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.1A1C1F1C22E9FD05}"
                            ToolTip.Tip="{DynamicResource Ui.Auto.1A1C1F1C22E9FD05}"
                            Cursor="Hand"
                            IsVisible="False"
                            PointerPressed="ReaderBookmarkCornerButton_PointerPressed">
                        <Path x:Name="ReaderBookmarkCornerMarker"
                              Width="26"
                              Height="26"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Data="M 0,0 L 26,0 L 26,26 Z"
                              Fill="#000000"
                              Stretch="None"
                              IsHitTestVisible="False"
                              IsVisible="False" />
                    </Border>

                    <!-- This must remain a sibling after the native WebView
                         slots. Native child windows paint over Avalonia
                         children, so an in-page search bar nested inside
                         ReaderWebViewHost is not reliably visible/clickable. -->
                    <Border x:Name="ReaderInPageSearchBar"
                            Width="430"
                            Padding="10,8"
                            Margin="0,16,24,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="#000000"
                            BorderThickness="1"
                            IsVisible="False"
                            ZIndex="45">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <TextBox x:Name="ReaderInPageSearchBox"
                                     Height="32"
                                     Padding="8,4"
                                     PlaceholderText="{DynamicResource Ui.Auto.74433F289DA5E5AD}"
                                     TextChanged="ReaderInPageSearchBox_TextChanged"
                                     KeyDown="ReaderInPageSearchBox_KeyDown" />
                            <TextBlock x:Name="ReaderInPageSearchCountText"
                                       Grid.Column="1"
                                       MinWidth="48"
                                       Text="0/0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="icon" Width="32" MinWidth="32" Height="32" Content="↑" Click="ReaderInPageSearchPreviousButton_Click" />
                            <Button Grid.Column="3" Classes="icon" Width="32" MinWidth="32" Height="32" Content="↓" Click="ReaderInPageSearchNextButton_Click" />
                            <Button Grid.Column="4" Classes="icon" Width="32" MinWidth="32" Height="32" Content="×" Click="ReaderInPageSearchCloseButton_Click" />
                        </Grid>
                    </Border>

                    <!-- Slim floating bar shown only in zen mode. -->
                    <Border x:Name="ReaderZenBar"
                            Padding="2,2,2,2"
                            Margin="0,16,24,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="#000000"
                            BorderThickness="1"
                            IsVisible="False"
                            ZIndex="70">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{DynamicResource Ui.Auto.DA97EC360354D5D9}"
                                       Margin="10,0,2,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ReaderZenTocButton"
                                    Classes="readerToolbar"
                                    Content="{DynamicResource Ui.Auto.73C9B3F7F3A16007}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.73D49673812F4264}"
                                    Click="ReaderZenMinimalTocButton_Click" />
                            <Button x:Name="ReaderExitZenButton"
                                    Classes="readerToolbar"
                                    Content="{DynamicResource Ui.Auto.AF30F6FFB6EA23CF}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.987BA0B5C2710754}"
                                    Click="ReaderExitZenButton_Click" />
                            <Button x:Name="ReaderZenCloseButton"
                                    Classes="icon"
                                    Content="×"
                                    FontSize="15"
                                    AutomationProperties.Name="{DynamicResource Ui.Auto.A8B1F579ACBCC5D5}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.A51CE8191584FCF7}"
                                    Click="CloseReaderButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="ReaderFooterBar"
                        Grid.Row="2"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#E2E2DE"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="14,4" ColumnDefinitions="34,34,*,Auto,Auto" ColumnSpacing="10">
                        <Button x:Name="ReaderPreviousButton"
                                Classes="readerToolbar"
                                Content="‹"
                                FontSize="16"
                                Width="34"
                                Height="30"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.393F2A5120AC2098}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.393F2A5120AC2098}"
                                Click="ReaderPreviousButton_Click" />
                        <Button x:Name="ReaderNextButton"
                                Grid.Column="1"
                                Classes="readerToolbar"
                                Content="›"
                                FontSize="16"
                                Width="34"
                                Height="30"
                                AutomationProperties.Name="{DynamicResource Ui.Auto.9443994BC3B186C5}"
                                ToolTip.Tip="{DynamicResource Ui.Auto.9443994BC3B186C5}"
                                Click="ReaderNextButton_Click" />
                        <Slider x:Name="ReaderProgressSlider"
                                Grid.Column="2"
                                Classes="noAutoToolTip"
                                Margin="6,0,14,0"
                                MinWidth="120"
                                Minimum="1"
                                Maximum="1"
                                Value="1"
                                VerticalAlignment="Center"
                                Loaded="ReaderProgressSlider_Loaded"
                                ValueChanged="ReaderProgressSlider_ValueChanged"
                                PointerPressed="ReaderProgressSlider_PointerPressed"
                                PointerMoved="ReaderProgressSlider_PointerMoved"
                                PointerReleased="ReaderProgressSlider_PointerReleased"
                                PointerExited="ReaderProgressSlider_PointerExited">
                            <Slider.Resources>
                                <CornerRadius x:Key="SliderThumbCornerRadius">999</CornerRadius>
                            </Slider.Resources>
                            <Slider.Styles>
                                <Style Selector="Slider /template/ Thumb">
                                    <Setter Property="Width" Value="12" />
                                    <Setter Property="Height" Value="12" />
                                    <Setter Property="MinWidth" Value="12" />
                                    <Setter Property="MinHeight" Value="12" />
                                    <Setter Property="MaxWidth" Value="12" />
                                    <Setter Property="MaxHeight" Value="12" />
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Slider.Styles>
                        </Slider>
                        <TextBlock x:Name="ReaderChapterText"
                                   Grid.Column="4"
                                   MinWidth="44"
                                   FontSize="11"
                                   Foreground="#5E5E5E"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Border x:Name="ReaderPdfBadge"
                                Grid.Column="3"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="#F2F2F0"
                                BorderBrush="#D5D5D1"
                                BorderThickness="1">
                            <TextBlock x:Name="ReaderPdfBottomText"
                                       Text="PDF"
                                       FontSize="9"
                                       Foreground="#5E5E5E" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- AI conversation and persistent annotations. -->
            <Border x:Name="ReaderAssistantPanel"
                    Grid.Column="2"
                    Margin="0,38,0,0"
                    IsVisible="False"
                    Background="{StaticResource PaperBrush}">
                <Grid RowDefinitions="52,42,*,Auto">
                    <!-- Long separator below the assistant header. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="3"
                               Width="1"
                               HorizontalAlignment="Left"
                               Fill="#EEEEEA"
                               IsHitTestVisible="False" />

                    <Border Background="{StaticResource PaperBrush}"
                            BorderBrush="#EEEEEA"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="14,8" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Ui.Auto.1B0049FCFD4163FE}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ReaderAiProviderText"
                                           Text="{DynamicResource Ui.Auto.95537256AF757996}"
                                           FontSize="9"
                                           MaxWidth="150"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon"
                                    Width="38"
                                    MinWidth="38"
                                    Height="34"
                                    AutomationProperties.Name="{DynamicResource Ui.Auto.2CCF650A61080689}"
                                    ToolTip.Tip="{DynamicResource Ui.Auto.2CCF650A61080689}"
                                    Click="ReaderAssistantToggleButton_Click">
                                <Path Width="12"
                                      Height="12"
                                      Data="M 9,1.5 L 3,6 L 9,10.5"
                                      Stroke="{StaticResource InkBrush}"
                                      StrokeThickness="0.85"
                                      StrokeLineCap="Square"
                                      StrokeJoin="Miter"
                                      IsHitTestVisible="False" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="18,2,18,0" ColumnSpacing="12">
                        <Button x:Name="ReaderAiTabButton"
                                Classes="readerAssistantTab active"
                                Content="{DynamicResource Ui.Auto.69825479A95E6330}"
                                HorizontalAlignment="Stretch"
                                Click="ReaderAiTabButton_Click" />
                        <Button x:Name="ReaderNotesTabButton"
                                Grid.Column="1"
                                Classes="readerAssistantTab"
                                Content="{DynamicResource Ui.Auto.3062C477D4C1E1FA}"
                                HorizontalAlignment="Stretch"
                                Click="ReaderNotesTabButton_Click" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid x:Name="ReaderAiView" RowDefinitions="*,Auto">
                            <ScrollViewer x:Name="ReaderAiScrollViewer" Padding="20,18,20,8" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="18">
                                    <StackPanel x:Name="ReaderAiEmptyState" Spacing="4">
                                        <TextBlock Text="{DynamicResource Ui.Auto.FBCA6604A6DC8F48}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                        <Button Classes="readerMinimalAction" Content="{DynamicResource Ui.Auto.E687BAF44D22C09D}" HorizontalAlignment="Stretch" Click="ReaderAiSummarizeChapterButton_Click" />
                                        <Button Grid.Column="1" Classes="readerMinimalAction" Content="{DynamicResource Ui.Auto.93ACD7FCCB3F0D76}" HorizontalAlignment="Stretch" Click="ReaderAiExplainSelectionButton_Click" />
                                        <Button Grid.Row="1" Classes="readerMinimalAction" Content="{DynamicResource Ui.Auto.D65CE013C49D1834}" HorizontalAlignment="Stretch" Click="ReaderAiSummarizeBookButton_Click" />
                                        <Button Grid.Row="1" Grid.Column="1" Classes="readerMinimalAction" Content="{DynamicResource Ui.Auto.C7D90AE040169512}" HorizontalAlignment="Stretch" Click="ReaderAiClearButton_Click" />
                                    </Grid>
                                    <ItemsControl x:Name="ReaderChatMessagesPanel" ItemsSource="{Binding ReaderAiMessages}" Margin="0,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:ReaderAiMessageViewModel">
                                                <Border MaxWidth="306"
                                                        Padding="2,9,2,10"
                                                        Margin="0,1"
                                                        HorizontalAlignment="{Binding BubbleAlignment}"
                                                        Background="Transparent"
                                                        BorderBrush="{StaticResource HairlineBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        CornerRadius="0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding RoleLabel}" FontSize="9" Foreground="{Binding RoleBrush}" Opacity="0.72" />
                                                        <TextBlock Text="{Binding Reasoning}" IsVisible="{Binding IsReasoningVisible}" FontSize="10" Foreground="#5F5F5F" TextWrapping="Wrap" />
                                                        <local:KreaderMarkdownTextBlock Text="{Binding Content}" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ReaderAiStatusText"
                                               Text="{DynamicResource Ui.Auto.D4DCD9B74693BD4C}"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <StackPanel x:Name="ReaderAiSourcesPanel" Spacing="5" IsVisible="False">
                                        <TextBlock Text="{DynamicResource Ui.Auto.DA3968C80FE7A060}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                        <ItemsControl ItemsSource="{Binding ReaderAiSources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ReaderAiSourceViewModel">
                                                    <Button Classes="readerNoteItem" Tag="{Binding}" HorizontalContentAlignment="Left" Click="ReaderAiSourceButton_Click">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="10" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid x:Name="ReaderAiComposer" Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="12" Margin="20,8,20,14">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{DynamicResource Ui.Auto.2FD1FCDA22E20FF7}" FontSize="11" />
                                        <ComboBox x:Name="ReaderAiReasoningDepthBox" Classes="readerMinimalField" MinHeight="32" FontSize="10" SelectionChanged="ReaderAiReasoningDepthBox_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="{DynamicResource Ui.Auto.C98E118E0A43F078}" FontSize="11" />
                                        <ComboBox x:Name="ReaderAiModelSelectorBox" Classes="readerMinimalField" MinHeight="32" FontSize="10" PlaceholderText="{DynamicResource Ui.Auto.1AFED6A81A2512D2}" SelectionChanged="ReaderAiModelSelectorBox_SelectionChanged" />
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="ReaderAiQuestionBox"
                                         Grid.Row="1"
                                         Classes="readerMinimalField"
                                         MinHeight="130"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         PlaceholderText="{DynamicResource Ui.Auto.2884AF5B8126BF7B}"
                                         KeyDown="ReaderAiQuestionBox_KeyDown" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="ReaderNotesView" IsVisible="False" RowDefinitions="*,Auto">
                            <ScrollViewer Grid.Row="0" Padding="20,18,20,12" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <TextBlock x:Name="ReaderAnnotationEmptyText"
                                               Text="{DynamicResource Ui.Auto.E801393E50EE0F3D}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="False" />
                                    <ItemsControl x:Name="ReaderAnnotationList" ItemsSource="{Binding ReaderAnnotations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:ReaderAnnotation">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                                                    <Button Classes="readerNoteItem"
                                                            Tag="{Binding}"
                                                            HorizontalContentAlignment="Stretch"
                                                            Click="ReaderAnnotationItemButton_Click">
                                                        <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding DisplayQuote}" FontSize="11" FontWeight="SemiBold" MaxHeight="54" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding DisplayNote}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" MaxHeight="54" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Classes="icon"
                                                            Width="30"
                                                            MinWidth="30"
                                                            Height="30"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Top"
                                                            AutomationProperties.Name="{DynamicResource Ui.Auto.E06985CB8EEAACEB}"
                                                            ToolTip.Tip="{DynamicResource Ui.Auto.E06985CB8EEAACEB}"
                                                            Tag="{Binding}"
                                                            Click="ReaderAnnotationItemDeleteButton_Click">
                                                        <Path Width="10"
                                                              Height="10"
                                                              Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                                              Stroke="{StaticResource InkBrush}"
                                                              StrokeThickness="1.2"
                                                              StrokeLineCap="Square"
                                                              IsHitTestVisible="False" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ReaderExportStatusText" FontSize="10" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer x:Name="ReaderAiSettingsView"
                                      IsVisible="False"
                                      Padding="18,16,18,18"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{DynamicResource Ui.Auto.6F5D72AA32F2C95E}" FontSize="16" FontWeight="SemiBold" />
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.EC309AB207EF7FA3}" FontSize="11" />
                                    <ComboBox x:Name="ReaderAiProviderBox"
                                              Classes="readerSettingsField"
                                              SelectedIndex="0"
                                              SelectionChanged="ReaderAiProviderBox_SelectionChanged">
                                        <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                        <ComboBoxItem Content="OpenAI" Tag="openai" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.988FB59B290B037D}" Tag="custom" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Base URL" FontSize="11" />
                                    <TextBox x:Name="ReaderAiBaseUrlBox"
                                             Classes="readerSettingsField"
                                             PlaceholderText="https://api.deepseek.com" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.C98E118E0A43F078}" FontSize="11" />
                                    <TextBox x:Name="ReaderAiModelBox"
                                             Classes="readerSettingsField"
                                             PlaceholderText="{DynamicResource Ui.Auto.CB2F1709F983D2F4}" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="API Key" FontSize="11" />
                                    <TextBox x:Name="ReaderAiApiKeyBox"
                                             Classes="readerSettingsField"
                                             PasswordChar="●"
                                             PlaceholderText="{DynamicResource Ui.Auto.CA478C91D3839A44}" />
                                    <TextBlock Text="{DynamicResource Ui.Auto.7BCD9260C3109BB3}"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ReaderAiSettingsStatusText"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <Button Grid.Column="1"
                                            Classes="quiet"
                                            Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                            Click="ReaderAiSettingsCancelButton_Click" />
                                    <Button Grid.Column="2"
                                            Content="{DynamicResource Ui.Auto.A3030BF8F16DC63C}"
                                            Click="ReaderAiSettingsSaveButton_Click" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Bottom strip. No top hairline by design; the two bars
                         measure 49 DIP tall (6 + 36 + 7). -->
                    <Border Grid.Row="3">
                        <Grid>
                            <Grid x:Name="ReaderAiSendBar" Margin="20,6,20,7" IsVisible="False">
                                <Button x:Name="ReaderAiSendButton"
                                        Classes="readerMinimalAction"
                                        Content="{DynamicResource Ui.Auto.EDECF0AE6E5144F9}"
                                        MinWidth="66"
                                        HorizontalAlignment="Right"
                                        Click="ReaderAiSendButton_Click" />
                            </Grid>
                            <Grid x:Name="ReaderNotesExportBar" Margin="20,6,20,7" IsVisible="False">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Button Classes="readerMinimalAction" Content="{DynamicResource Ui.Auto.AC8B027CC1E3A493}" HorizontalAlignment="Stretch" Click="ReaderExportMarkdownButton_Click" />
                                    <Button Grid.Column="1" Classes="readerMinimalAction" Content="{DynamicResource Ui.Auto.8E1B126E634DCA98}" HorizontalAlignment="Stretch" Click="ReaderExportTextButton_Click" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Reading layout settings. Typography remains per book while
                 the vertical-writing switch is global. A native popup is required:
                 the WebView2 HWND island covers ordinary Avalonia overlays. -->
            <Popup x:Name="ReaderLayoutSettingsPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="True">
                <Grid x:Name="ReaderLayoutSettingsOverlay"
                      Background="#66000000">
                <Border Width="580"
                        MaxHeight="760"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#000000"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Margin="22,20" Spacing="12">
                                <TextBlock Text="{DynamicResource Ui.Auto.77AC05AA34080C2C}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Ui.Auto.C66EF0B208DF7017}"
                                           FontSize="11"
                                           Foreground="#666666"
                                           TextWrapping="Wrap" />
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Auto.F71561B5AF0ABCED}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderFontScaleValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderFontScaleSlider" Minimum="0.8" Maximum="1.8" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="1" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Auto.6B44B7BA432ABF47}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderLineHeightValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderLineHeightSlider" Minimum="1.3" Maximum="2.6" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1.88" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Auto.598EA039C0563336}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderMaxWidthValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderMaxWidthSlider" Minimum="480" Maximum="3840" TickFrequency="20" IsSnapToTickEnabled="True" Value="800" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Auto.93DCCA57490B4267}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderBodyPaddingValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderBodyPaddingSlider" Minimum="24" Maximum="160" TickFrequency="8" IsSnapToTickEnabled="True" Value="68" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource Ui.Auto.F818CA93CE983E65}" FontSize="11" />
                                    <ComboBox x:Name="ReaderFontFamilyBox"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="ReaderFontFamilyBox_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.97F24E62001955CC}" Tag="京华老宋体" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.709E6BFBD8FBEF3E}" Tag="Microsoft YaHei UI" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.67ABB8F1EFAC16D0}" Tag="SimSun" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.FE154AC80068C997}" Tag="SimHei" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.9BACE6A0041701EC}" Tag="KaiTi" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.94CC5EA6C71365C7}" Tag="DengXian" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Auto.41BE03CE89F68E74}" Tag="Source Han Serif SC, Noto Serif CJK SC" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="ReaderVerticalWritingCheck"
                                          Classes="readerLayoutCheck"
                                          Content="{DynamicResource Ui.Auto.FA133D5DE7088336}"
                                          FontSize="12"
                                          IsCheckedChanged="ReaderVerticalWritingCheck_IsCheckedChanged" />
                                <StackPanel x:Name="ReaderVerticalDebugBoxesPanel" Spacing="2">
                                    <CheckBox x:Name="ReaderVerticalDebugBoxesCheck"
                                              Classes="readerLayoutCheck"
                                              Content="{DynamicResource Ui.Auto.E0467D21F32857C0}"
                                              FontSize="12"
                                              IsCheckedChanged="ReaderVerticalDebugBoxesCheck_IsCheckedChanged" />
                                    <TextBlock Margin="26,0,0,0"
                                               Text="{DynamicResource Ui.Auto.53526B79F9CAAB14}"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox x:Name="ReaderParagraphIndentCheck"
                                          Classes="readerLayoutCheck"
                                          Content="{DynamicResource Ui.Auto.F7044E3D685ABD03}"
                                          FontSize="12"
                                          IsCheckedChanged="ReaderParagraphIndentCheck_IsCheckedChanged" />
                                <TextBlock x:Name="ReaderLayoutSettingsStatusText"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                                <Button Classes="quiet"
                                        Content="{DynamicResource Ui.Auto.F242C947972CE621}"
                                        HorizontalAlignment="Left"
                                        Click="ReaderLayoutResetButton_Click" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="22,14,22,20">
                                <Button Classes="quiet"
                                        Content="{DynamicResource Ui.Auto.3FD47EDCE45B3603}"
                                        HorizontalAlignment="Right"
                                        Click="ReaderLayoutSettingsCloseButton_Click" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
                </Grid>
            </Popup>

            <Popup x:Name="ReaderSelectionHostPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="True"
                   OverlayDismissEventPassThrough="True"
                   ShouldUseOverlayLayer="True"
                   TakesFocusFromNativeControl="False">
                <Border x:Name="ReaderSelectionPopupBar"
                        Padding="3"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#000000"
                        BorderThickness="1"
                        CornerRadius="0">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button Content="{DynamicResource Ui.Auto.63D90D977348AB1F}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionCopyButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                        <Button x:Name="ReaderSelectionHighlightMenuButton"
                                Content="{DynamicResource Ui.Auto.830CB845237C81B5}"
                                Classes="readerSelectionAction"
                                PointerEntered="ReaderSelectionHighlightMenuButton_PointerEntered">
                            <Button.Flyout>
                                <MenuFlyout ShowMode="Transient"
                                            Placement="Bottom"
                                            VerticalOffset="4"
                                            OverlayDismissEventPassThrough="True">
                                    <MenuItem x:Name="ReaderSelectionHighlightSolidItem" Header="{DynamicResource Ui.Auto.91F5C1B272FBDAFD}" Classes="readerSelectionStyle" Tag="solid" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="{DynamicResource Ui.Auto.A6698E0626B4FA35}" Classes="readerSelectionStyle" Tag="double" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="{DynamicResource Ui.Auto.91B03E325F4CA55F}" Classes="readerSelectionStyle" Tag="dashed" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="{DynamicResource Ui.Auto.BDDE3C3FF3DD4E89}" Classes="readerSelectionStyle" Tag="dotted" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <MenuItem Header="{DynamicResource Ui.Auto.B601C29A9B51CF20}" Classes="readerSelectionStyle" Tag="wavy" Click="ReaderSelectionHighlightStyleItem_Click" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource Ui.Auto.30A96F7A6D6F3C86}" Classes="readerSelectionStyle" Tag="marker" Click="ReaderSelectionHighlightStyleItem_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Ui.Auto.85C5C1F5567B4D67}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionAnnotateButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Ui.Auto.A264DF6D2A1F209D}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionAiButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Ui.Auto.44CE7AE909BBB28B}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionSearchButton_Click" />
                        <Rectangle Width="1" Height="18" Margin="2,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Ui.Auto.854581A8F04CE575}"
                                Classes="readerSelectionAction"
                                Click="ReaderSelectionDictionaryButton_Click" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- In-body annotation editor: picking 批注 on a selection opens
                 this small input window right at the selection instead of
                 routing through the notes pane. It needs the same native
                 popup treatment as the selection bar to paint over the
                 HWND-backed reader surface. -->
            <Popup x:Name="ReaderAnnotationInputPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="True"
                   OverlayDismissEventPassThrough="True"
                   ShouldUseOverlayLayer="True"
                   TakesFocusFromNativeControl="False"
                   Closed="ReaderAnnotationInputPopup_Closed">
                <Border x:Name="ReaderAnnotationInputPanel"
                        Width="320"
                        Padding="12"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#000000"
                        BorderThickness="1"
                        CornerRadius="0">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ReaderAnnotationInputQuote"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   MaxHeight="40"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="ReaderAnnotationInputBox"
                                 Classes="readerMinimalField"
                                 MinHeight="64"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 PlaceholderText="{DynamicResource Ui.Auto.39700B6351624E48}"
                                 KeyDown="ReaderAnnotationInputBox_KeyDown" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Classes="readerMinimalAction"
                                    Content="{DynamicResource Ui.Auto.2CD0F3BE8738A86C}"
                                    HorizontalAlignment="Stretch"
                                    Click="ReaderAnnotationInputCancelButton_Click" />
                            <Button Grid.Column="1"
                                    Classes="readerMinimalAction"
                                    Content="{DynamicResource Ui.Auto.49DD2BD35DD7E743}"
                                    HorizontalAlignment="Stretch"
                                    Click="ReaderAnnotationInputSaveButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- A native popup keeps the footnote above the HWND-backed
                 WebView2 surface, matching the WinUI reference reader. -->
            <Popup x:Name="ReaderFootnoteHostPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="False"
                   IsHitTestVisible="False">
                <Border x:Name="ReaderFootnotePopup"
                        Width="360"
                        MaxHeight="260"
                        Padding="12,10"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#000000"
                        BorderThickness="2"
                        CornerRadius="0"
                        IsHitTestVisible="False"
                        IsVisible="False">
                    <ScrollViewer MaxHeight="236"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReaderFootnoteText"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="12"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Annotation hover preview over the reading surface. Same native
                 popup treatment as the footnote preview: the reading surface
                 would cover an ordinary overlay. -->
            <Popup x:Name="ReaderAnnotationHoverHostPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="False"
                   IsHitTestVisible="False">
                <Border x:Name="ReaderAnnotationHoverPopup"
                        Width="360"
                        MaxHeight="260"
                        Padding="12,10"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#000000"
                        BorderThickness="2"
                        CornerRadius="0"
                        IsHitTestVisible="False"
                        IsVisible="False">
                    <ScrollViewer MaxHeight="236"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="ReaderAnnotationHoverQuote"
                                       Foreground="{StaticResource InkBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       LineHeight="20"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ReaderAnnotationHoverNote"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="11"
                                       LineHeight="18"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- A native popup is required here: the reading surface is an
                 embedded WebView2 HWND and would cover a normal Avalonia
                 overlay regardless of ZIndex. -->
            <Popup x:Name="ReaderChapterPreviewPopup"
                   IsOpen="False"
                   IsLightDismissEnabled="False"
                   ShouldUseOverlayLayer="False"
                   TakesFocusFromNativeControl="False">
                <Border MinWidth="150"
                        MaxWidth="340"
                        Padding="12,8"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#000000"
                        BorderThickness="1"
                        CornerRadius="0"
                        IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock x:Name="ReaderChapterPreviewTitleText"
                                   MaxWidth="316"
                                   Foreground="#222222"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ReaderChapterPreviewBodyText"
                                   MaxWidth="316"
                                   Margin="0,6,0,0"
                                   Foreground="#666666"
                                   FontSize="11"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   MaxLines="4"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="False" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
        </Grid>
    </Border>

        <!-- First-run setup is a full-window, two-step surface. It sits above
             the regular shell so the user can finish the minimum setup before
             interacting with the bookshelf. -->
        <Grid x:Name="OnboardingOverlay"
              Background="#F7F7F5"
              IsVisible="False"
              ZIndex="200"
              Focusable="True"
              KeyDown="OnboardingOverlay_KeyDown">
            <Border Width="760"
                    MaxWidth="760"
                    MaxHeight="650"
                    Margin="24"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0"
                            Padding="28,24,28,20"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="OnboardingStepText"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedInkBrush}" />
                                <TextBlock Text="Kkindle"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           LetterSpacing="1.08" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    Background="{StaticResource InkBrush}">
                                <TextBlock Text="K"
                                           Foreground="{StaticResource PaperBrush}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="28,28,28,24"
                              MinHeight="360">
                            <Grid x:Name="OnboardingWelcomePage"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="18"
                                  HorizontalAlignment="Stretch">
                                <TextBlock Text="{DynamicResource Ui.Onboarding.WelcomeTitle}"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left" />
                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource Ui.Onboarding.WelcomeSubtitle}"
                                           FontSize="17"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2"
                                           Text="{DynamicResource Ui.Onboarding.WelcomeDescription}"
                                           FontSize="14"
                                           LineHeight="23"
                                           MaxWidth="620"
                                           HorizontalAlignment="Left"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                                <Border Grid.Row="3"
                                        Margin="0,12,0,0"
                                        Padding="16"
                                        Background="#F7F7F5"
                                        BorderBrush="{StaticResource HairlineBrush}"
                                        BorderThickness="1">
                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                          RowSpacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Onboarding.LanguageLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="OnboardingLanguageBox"
                                                  Grid.Row="1"
                                                  Width="260"
                                                  HorizontalAlignment="Left"
                                                  HorizontalContentAlignment="Left"
                                                  SelectedIndex="0"
                                                  SelectionChanged="OnboardingLanguageBox_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource Ui.Auto.9937E365AAF3A085}"
                                                          Tag="zh-CN" />
                                            <ComboBoxItem Content="{DynamicResource Ui.Auto.348EA84C60466C77}"
                                                          Tag="en-US" />
                                        </ComboBox>
                                        <TextBlock Grid.Row="2"
                                                   Text="{DynamicResource Ui.Onboarding.LanguageHint}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Left"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="OnboardingDevicePage"
                                  IsVisible="False"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  RowSpacing="18"
                                  HorizontalAlignment="Stretch">
                                <TextBlock Text="{DynamicResource Ui.Onboarding.DeviceTitle}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left" />
                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource Ui.Onboarding.DeviceDescription}"
                                           FontSize="14"
                                           LineHeight="23"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Onboarding.VendorLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="OnboardingVendorBox"
                                                  HorizontalContentAlignment="Left"
                                                  SelectionChanged="OnboardingVendorBox_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="{DynamicResource Ui.Onboarding.ModelLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="OnboardingDeviceModelBox"
                                                  IsEnabled="False"
                                                  HorizontalContentAlignment="Left"
                                                  SelectionChanged="OnboardingDeviceModelBox_SelectionChanged" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="3"
                                        Padding="16"
                                        Background="#F7F7F5"
                                        BorderBrush="{StaticResource HairlineBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{DynamicResource Ui.Onboarding.SelectionLabel}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                        <TextBlock x:Name="OnboardingSelectedDeviceText"
                                                   Text="{DynamicResource Ui.Onboarding.NoModelSelected}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Left"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="OnboardingDeviceStatusText"
                                           Grid.Row="4"
                                           Text="{DynamicResource Ui.Onboarding.SelectionRequired}"
                                           IsVisible="False"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="2"
                          Margin="28,18,28,24"
                          ColumnDefinitions="*,Auto,Auto,Auto"
                          ColumnSpacing="8">
                        <Button x:Name="OnboardingBackButton"
                                Grid.Column="0"
                                Content="{DynamicResource Ui.Onboarding.BackButton}"
                                Classes="quiet"
                                HorizontalAlignment="Left"
                                Padding="13,7"
                                IsVisible="False"
                                Click="OnboardingBackButton_Click" />
                        <Button x:Name="OnboardingSkipButton"
                                Grid.Column="1"
                                Content="{DynamicResource Ui.Onboarding.SkipButton}"
                                Classes="quiet"
                                Padding="13,7"
                                IsVisible="False"
                                Click="OnboardingSkipButton_Click" />
                        <Button x:Name="OnboardingNextButton"
                                Grid.Column="3"
                                Content="{DynamicResource Ui.Onboarding.NextButton}"
                                Padding="13,7"
                                Click="OnboardingNextButton_Click" />
                        <Button x:Name="OnboardingFinishButton"
                                Grid.Column="3"
                                Content="{DynamicResource Ui.Onboarding.FinishButton}"
                                Padding="13,7"
                                IsVisible="False"
                                Click="OnboardingFinishButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Keep the message dialog at the window content layer, above both
             the library and reader roots. A child of LibraryRoot is hidden
             behind ReaderRoot whenever a reader is visible. -->
        <Grid x:Name="MessageOverlay"
              Grid.ColumnSpan="3"
              Background="#66000000"
              IsVisible="False"
              ZIndex="110"
              Focusable="True"
              KeyDown="MessageOverlay_KeyDown">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Grid.Transitions>
            <Border Width="560"
                    MaxWidth="560"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto">
                    <StackPanel Margin="28,24,28,22" Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10"
                                       Height="24"
                                       Margin="0,-2,0,0"
                                       Fill="{StaticResource InkBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="MessageTitleText"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="MessageBodyText"
                                   FontSize="15"
                                   LineHeight="23"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1"
                          Margin="28,18,28,22"
                          Background="{StaticResource PaperBrush}">
                        <Button x:Name="MessageOkButton"
                                Content="{DynamicResource Ui.Auto.DE32E20193AD1042}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="MessageOkButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Device connection/eject floating bubble: a hollow paper-white
             toast with a 1-DIP black outline and a matching outlined pointer
             aligned to the sidebar eject button's triangle apex. The
             host positions it in window coordinates (PositionDeviceStatusToast)
             and it floats above the whole UI, never clipped by the sidebar. -->
        <StackPanel x:Name="DeviceStatusToast"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    MaxWidth="360"
                    RenderTransformOrigin="0,0"
                    IsVisible="False"
                    IsHitTestVisible="False">
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                </Transitions>
            </StackPanel.Transitions>
            <Border Padding="8,7"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="DeviceStatusToastText"
                           MaxWidth="342"
                           Text="{DynamicResource Ui.Auto.BD94EEB3FD1C6354}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Foreground="{StaticResource InkBrush}"
                           FontSize="11" />
            </Border>
            <!-- The filled triangle masks the bubble's bottom border, then the
                 open path draws both sides from the exact border break points.
                 Keeping fill and outline separate avoids erasing the joins. -->
            <Grid x:Name="DeviceStatusToastPointer"
                  Width="12"
                  Height="6"
                  Margin="0,-1,0,0"
                  UseLayoutRounding="True"
                  RenderTransformOrigin="0,0"
                  HorizontalAlignment="Left">
                <Polygon Points="0,0 12,0 6,6"
                         Fill="{StaticResource PaperBrush}"
                         Stretch="Fill" />
                <Path Data="M 0,0 L 6,6 L 12,0"
                      Stroke="{StaticResource InkBrush}"
                      StrokeThickness="1"
                      StrokeLineCap="Square"
                      StrokeJoin="Miter" />
            </Grid>
        </StackPanel>

        <!-- Zen controls must use a native popup: the full-screen WebView is
             an HWND island and otherwise paints over Avalonia title content. -->
        <Popup x:Name="ReaderZenControlsPopup"
               IsOpen="False"
               IsLightDismissEnabled="False"
               ShouldUseOverlayLayer="False"
               TakesFocusFromNativeControl="True">
            <!-- NativeWebView is a child window on Windows and paints over the
                 ordinary title-bar grid. Keep the complete old title-button
                 row in one native popup so Zen mode never leaves a black gap
                 or splits the controls across two composition surfaces. -->
            <Border Background="{StaticResource PaperBrush}"
                    PointerEntered="ReaderTitleControls_PointerEntered"
                    PointerExited="ReaderTitleControls_PointerExited">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button x:Name="ReaderZenPopupTocButton"
                            Classes="caption"
                            Width="92"
                            Height="38"
                            Padding="0"
                            FontSize="11"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.0474752B788B123E}"
                            ToolTip.Tip="{DynamicResource Ui.Auto.4CC0023B765B0A72}"
                            Click="ReaderZenMinimalTocButton_Click">
                        <TextBlock x:Name="ReaderZenPopupTocText"
                                   Text="{DynamicResource Ui.Auto.B543AF1F9821E137}"
                                   Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button x:Name="ReaderZenPopupExitButton"
                            Classes="caption"
                            Width="104"
                            Height="38"
                            Padding="0"
                            FontSize="11"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.AF30F6FFB6EA23CF}"
                            ToolTip.Tip="{DynamicResource Ui.Auto.987BA0B5C2710754}"
                            Click="ReaderExitZenButton_Click">
                        <TextBlock Text="{DynamicResource Ui.Auto.AF30F6FFB6EA23CF}"
                                   Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button x:Name="ReaderZenPopupMinimizeButton"
                            Classes="caption"
                            Width="46"
                            Height="38"
                            Padding="0"
                            Click="MinimizeWindowButton_Click"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.AC29E57A46F41C30}">
                        <Path Data="M 0,0 H 10" />
                    </Button>
                    <Button x:Name="ReaderZenPopupMaximizeButton"
                            Classes="caption"
                            Width="46"
                            Height="38"
                            Padding="0"
                            Click="MaximizeWindowButton_Click"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.82C4AA13B7CA109E}">
                        <Path x:Name="ReaderZenPopupMaximizeGlyph"
                              Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                    </Button>
                    <Button x:Name="ReaderZenPopupCloseButton"
                            Classes="caption"
                            Width="46"
                            Height="38"
                            Padding="0"
                            Click="CloseWindowButton_Click"
                            AutomationProperties.Name="{DynamicResource Ui.Auto.3FD47EDCE45B3603}">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Draw the frame as a sibling above the content. The native WebView
             is a separate child window and can cover WindowShadowHost's own
             right stroke; this overlay keeps all four sides on one geometry. -->
        <Border x:Name="WindowFrameOverlay"
                Margin="0"
                Background="Transparent"
                BorderBrush="#000000"
                BorderThickness="1"
                IsHitTestVisible="False"
                ZIndex="1000" />

        <!-- Invisible resize handles around the window edge. They hand the
             gesture to the platform so native window resizing stays atomic. -->
        <Grid x:Name="WindowResizeLayer">
            <Rectangle Fill="Transparent"
                       Width="8"
                       HorizontalAlignment="Left"
                       Cursor="SizeWestEast"
                       Tag="Left"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="8"
                       HorizontalAlignment="Right"
                       Cursor="SizeWestEast"
                       Tag="Right"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Height="8"
                       VerticalAlignment="Top"
                       Cursor="SizeNorthSouth"
                       Tag="Top"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Height="8"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNorthSouth"
                       Tag="Bottom"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Cursor="TopLeftCorner"
                       Tag="TopLeft"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Cursor="TopRightCorner"
                       Tag="TopRight"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Cursor="BottomLeftCorner"
                       Tag="BottomLeft"
                       PointerPressed="WindowResize_PointerPressed" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="BottomRightCorner"
                       Tag="BottomRight"
                       PointerPressed="WindowResize_PointerPressed" />
        </Grid>
    </Grid>
</Window>
